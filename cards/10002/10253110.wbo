wbo 0.1.0;

card 10253110 {
    type follower;
    cost 3;
    stats 3/2;

    effect {
        fanfare {
            choose target from own.field.followers other;
            add bane to target;
        }
        superevolve {
            choose target from own.field.followers other;
            add storm to target;
        }
    }

    meta {
        pack 10002;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "悲惨战争·萝拉";
        text """
【<color=Keyword>入场曲</color>】选择自己的战场上的1个其他随从，使其获得【<color=Keyword>毁灭</color>】。
<hr><sev>【<color=Keyword>超进化时</color>】选择自己的战场上的1个其他随从，使其获得【<color=Keyword>疾驰</color>】。</sev>
""";
    }

    locale eng {
        name "Laura, Cruel Commander";
        text """
<b><color=Keyword>Fanfare</color></b>: Select another allied follower on the field and give it <b><color=Keyword>Bane</color></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Select another allied follower on the field and give it <b><color=Keyword>Storm</color></b>.</sev>
""";
    }

    locale jpn {
        name "クルーエルウォー・ラウラ";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の他のフォロワー1枚を選ぶ。それは【<color=Keyword>必殺</color>】を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】自分の場の他のフォロワー1枚を選ぶ。それは【<color=Keyword>疾走</color>】を持つ。</sev>
""";
    }

    locale kor {
        name "잔학한 전쟁 라우라";
        text """
[<color=Keyword>출격</color>] 내 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 [<color=Keyword>필살</color>]을 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 내 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.</sev>
""";
    }

    locale cht {
        name "殘虐戰爭‧蘿拉";
        text """
【<color=Keyword>入場曲</color>】指定1張自己戰場上的其他從者卡。使其獲得【<color=Keyword>必殺</color>】。
<hr><sev>【<color=Keyword>超進化時</color>】指定1張自己戰場上的其他從者卡。使其獲得【<color=Keyword>疾馳</color>】。</sev>
""";
    }

}
