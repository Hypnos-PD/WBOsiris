wbo 0.1.0;

card 10251110 {
    type follower;
    cost 5;
    stats 3/4;

    effect {
        bane;
        evolve {
            choose targets from oppo.field.followers count 2;
            destroy targets;
            damage own.leader 2;
        }
    }

    meta {
        pack 10002;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "银色子弹·雷文";
        text """
【<color=Keyword>毁灭</color>】
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的2个随从，破坏这些随从。对自己的主战者造成2点伤害。</ev>
""";
    }

    locale eng {
        name "Rayvn, the Silver Bullet";
        text """
<b><color=Keyword>Bane</color></b>
<hr><ev><b><color=Keyword>Evolve</color></b>: Select 2 enemy followers on the field and destroy them. Deal 2 damage to your leader.</ev>
""";
    }

    locale jpn {
        name "シルバーバレット・レイヴン";
        text """
【<color=Keyword>必殺</color>】
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー2枚を選ぶ。それを破壊。自分のリーダーに2ダメージ。</ev>
""";
    }

    locale kor {
        name "은빛 탄환 레이븐";
        text """
[<color=Keyword>필살</color>]
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 2장을 선택한다. 그 추종자를 파괴. 내 리더에게 2 피해.</ev>
""";
    }

    locale cht {
        name "白銀槍彈‧雷文";
        text """
【<color=Keyword>必殺</color>】
<hr><ev>【<color=Keyword>進化時</color>】指定2張敵方戰場上的從者卡。將其破壞。給予自己的主戰者2點傷害。</ev>
""";
    }

}
