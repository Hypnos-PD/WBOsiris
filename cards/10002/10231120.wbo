wbo 0.1.0;

card 10231120 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            choose target from own.hand;
            return target to deck;
            draw 1 from deck where type spell;
        }
    }

    meta {
        pack 10002;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "魔导图书管理员";
        text """
【<color=Keyword>入场曲</color>】选择自己的1张手牌，使其返回牌组。抽取1张法术。
""";
    }

    locale eng {
        name "Arcane Archivist";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a card in your hand and return it to deck. Draw a spell.
""";
    }

    locale jpn {
        name "<rub=\"まどう\">魔導</rub>の<rub=\"ししょ\">司書</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札1枚を選ぶ。それをデッキに戻す。自分のデッキからスペル1枚を引く。
""";
    }

    locale kor {
        name "마법 도서관 사서";
        text """
[<color=Keyword>출격</color>] 내 패에서 1장을 선택한다. 그 카드를 덱으로 되돌린다. 내 덱에서 주문 1장을 뽑는다.
""";
    }

    locale cht {
        name "魔導圖書館員";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中的卡片。使其返回牌堆中。由自己的牌堆中抽取1張法術卡。
""";
    }

}
