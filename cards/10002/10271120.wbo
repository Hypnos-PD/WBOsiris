wbo 0.1.0;

card 10271120 {
    type follower;
    cost 1;
    stats 1/1;

    effect {
        rush;
        fanfare {
            if count(own.field.followers where form super_evolved) >= 1 {
                add 1 card 90071110 to hand;
                buff added +3/+0;
            }
        }
    }

    meta {
        pack 10002;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "猫偶";
        text """
【<color=Keyword>入场曲</color>】若自己的战场上有超进化后的随从，则将1张『<color=Keyword>悬丝傀儡</color>』加入手牌，使其+3/+0。
<hr>【<color=Keyword>突进</color>】
""";
    }

    locale eng {
        name "Puppet Cat";
        text """
<b><color=Keyword>Fanfare</color></b>: If there's a super-evolved allied follower on the field, add a <b><i><color=Keyword>Puppet</color></i></b> to your hand and give it +3/+0.
<hr><b><color=Keyword>Rush</color></b>
""";
    }

    locale jpn {
        name "パペットキャット";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場に超進化後のフォロワーがあるなら、『<color=Keyword>操り人形</color>』1枚を自分の手札に加える。それは+3/+0する。
<hr>【<color=Keyword>突進</color>】
""";
    }

    locale kor {
        name "퍼펫 캣";
        text """
[<color=Keyword>출격</color>] 내 전장에 초진화후인 추종자가 있다면, <color=Keyword>꼭두각시 인형</color> 1장을 내 패에 넣는다. 그 추종자는 +3/+0.
<hr>[<color=Keyword>돌진</color>]
""";
    }

    locale cht {
        name "線偶貓";
        text """
【<color=Keyword>入場曲</color>】如果自己戰場上有已超進化的從者卡，則會增加1張『<color=Keyword>懸絲人偶</color>』到自己的手牌中。使其+3/+0。
<hr>【<color=Keyword>突進</color>】
""";
    }

}
