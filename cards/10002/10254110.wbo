wbo 0.1.0;

card 10254110 {
    type follower;
    cost 9;
    stats 5/9;

    effect {
        fanfare {
            mode {
                option 1 {
                    label chs "召唤4个『一尾狐』。";
                    label eng "Summon 4 copies of One-Tailed Fox.";
                    label jpn "『一ツ尾狐』4枚を自分の場に出す。";
                    label kor "일미호 4장을 내 전장에 소환.";
                    label cht "召喚4張『一尾狐』到自己的戰場上。";
                    summon 4 card 90054130;
                }
                option 2 {
                    label chs "破坏对手的战场上的随机4个随从。回复自己的主战者4点生命值。";
                    label eng "Destroy 4 random enemy followers. Restore 4 defense to your leader.";
                    label jpn "相手の場のフォロワーからランダム4枚を破壊。自分のリーダーを4回復。";
                    label kor "상대방 전장의 추종자 중 무작위로 4장을 파괴. 내 리더를 4 회복.";
                    label cht "隨機破壞4張敵方戰場上的從者卡。回復自己的主戰者4點生命值。";
                    random targets from oppo.field.followers count 4;
                    destroy targets;
                    heal own.leader 4;
                }
            }
        }
    }

    meta {
        pack 10002;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "双轮夜行·吟雪&夕月";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）召唤4个『<color=Keyword>一尾狐</color>』。</ridx>
<ridx=1>（2）破坏对手的战场上的随机4个随从。回复自己的主战者4点生命值。</ridx>
""";
    }

    locale eng {
        name "Ginsetsu & Yuzuki, Twin Calamities";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Summon 4 copies of <b><i><color=Keyword>One-Tailed Fox</color></i></b>.</ridx>
<ridx=1>2. Destroy 4 random enemy followers. Restore 4 defense to your leader.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"そうりんやこう\">双輪夜行</rub>・ギンセツ＆ユヅキ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）『<color=Keyword>一ツ尾狐</color>』4枚を自分の場に出す。</ridx>
<ridx=1>（2）相手の場のフォロワーからランダム4枚を破壊。自分のリーダーを4回復。</ridx>
""";
    }

    locale kor {
        name "쌍륜야행 긴세츠&유즈키";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) <color=Keyword>일미호</color> 4장을 내 전장에 소환.</ridx>
<ridx=1>(2) 상대방 전장의 추종자 중 무작위로 4장을 파괴. 내 리더를 4 회복.</ridx>
""";
    }

    locale cht {
        name "雙禍夜行‧吟雪＆夕月";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）召喚4張『<color=Keyword>一尾狐</color>』到自己的戰場上。</ridx>
<ridx=1>（2）隨機破壞4張敵方戰場上的從者卡。回復自己的主戰者4點生命值。</ridx>
""";
    }

}
