wbo 0.1.0;

card 10243110 {
    type follower;
    cost 7;
    stats 5/5;

    effect {
        ward;
        fanfare {
            gain own crest 10243110;
            summon 2 card 90041130;
        }
        superevolve {
            summon 2 card 90041130;
        }
    }

    crest {
        when own follower summoned where trait marine {
            heal own.leader 1;
        }

        locale chs {
            name "纹章：苍海的制裁·尼普顿";
            text """
自己的海洋·随从进入战场时，回复自己的主战者1点生命值。
""";
        }

        locale eng {
            name "Crest: Neptune, Arbiter of Tides";
            text """
Whenever an allied Marine follower enters the field, restore 1 defense to your leader.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"そうかい\">蒼海</rub>の<rub=\"さば\">裁</rub>き・ネプチューン";
            text """
自分の海洋・フォロワーが場に出たとき、自分のリーダーを1回復。
""";
        }

        locale kor {
            name "크레스트: 창해의 심판 넵튠";
            text """
내 바다 추종자가 전장에 소환되었을 때, 내 리더를 1 회복.
""";
        }

        locale cht {
            name "紋章：蒼海的制裁‧尼普頓";
            text """
當自己的海洋‧從者卡進入戰場時，回復自己的主戰者1點生命值。
""";
        }

    }

    meta {
        pack 10002;
        class dragoncraft;
        rarity gold;
    }

    locale chs {
        name "苍海的制裁·尼普顿";
        text """
【<color=Keyword>入场曲</color>】使自己获得『纹章：苍海的制裁·尼普顿』。召唤2个『<color=Keyword>大海虎鲸</color>』。
<hr>【<color=Keyword>守护</color>】
<hr><sev>【<color=Keyword>超进化时</color>】召唤2个『<color=Keyword>大海虎鲸</color>』。</sev>
""";
    }

    locale eng {
        name "Neptune, Arbiter of Tides";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain <b><i>Crest: Neptune, Arbiter of Tides</i></b>. Summon 2 copies of <b><i><color=Keyword>Majestic Megalorca</color></i></b>.
<hr><b><color=Keyword>Ward</color></b>
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Summon 2 copies of <b><i><color=Keyword>Majestic Megalorca</color></i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"そうかい\">蒼海</rub>の<rub=\"さば\">裁</rub>き・ネプチューン";
        text """
【<color=Keyword>ファンファーレ</color>】自分は『クレスト：蒼海の裁き・ネプチューン』を持つ。『<color=Keyword>大海のオルカ</color>』2枚を自分の場に出す。
<hr>【<color=Keyword>守護</color>】
<hr><sev>【<color=Keyword>超進化時</color>】『<color=Keyword>大海のオルカ</color>』2枚を自分の場に出す。</sev>
""";
    }

    locale kor {
        name "창해의 심판 넵튠";
        text """
[<color=Keyword>출격</color>] 나는 「크레스트: 창해의 심판 넵튠」을 갖는다. <color=Keyword>대해의 오르카</color> 2장을 내 전장에 소환.
<hr>[<color=Keyword>수호</color>]
<hr><sev>[<color=Keyword>초진화시</color>] <color=Keyword>대해의 오르카</color> 2장을 내 전장에 소환.</sev>
""";
    }

    locale cht {
        name "蒼海的制裁‧尼普頓";
        text """
【<color=Keyword>入場曲</color>】使自己獲得『紋章：蒼海的制裁‧尼普頓』。召喚2張『<color=Keyword>滄海虎鯨</color>』到自己的戰場上。
<hr>【<color=Keyword>守護</color>】
<hr><sev>【<color=Keyword>超進化時</color>】召喚2張『<color=Keyword>滄海虎鯨</color>』到自己的戰場上。</sev>
""";
    }

}
