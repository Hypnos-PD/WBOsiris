wbo 0.1.0;

card 10274110 {
    type follower;
    cost 5;
    stats 3/3;

    effect {
        fanfare {
            summon 1 card 90074130;
        }
        when own follower summoned where trait puppetry {
            add ward to summoned;
        }
        evolve {
            summon 1 card 90071120;
        }
    }

    meta {
        pack 10002;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "交响之心·枷薇";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>维多利亚</color>』。
<hr>自己的人偶·随从进入战场时，使其获得【<color=Keyword>守护</color>】。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>改良型·悬丝傀儡</color>』。</ev>
""";
    }

    locale eng {
        name "Zwei, Symphonic Heart";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Victoria</color></i></b>.
<hr>Whenever an allied Puppetry follower enters the field, give it <b><color=Keyword>Ward</color></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon an <b><i><color=Keyword>Enhanced Puppet</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "シンフォニアハート・ツヴァイ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>ヴィクトリア</color>』1枚を自分の場に出す。
<hr>自分の人形・フォロワーが場に出たとき、それは【<color=Keyword>守護</color>】を持つ。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>改良型・操り人形</color>』1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "합주하는 마음 츠바이";
        text """
[<color=Keyword>출격</color>] <color=Keyword>빅토리아</color> 1장을 내 전장에 소환.
<hr>내 인형 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>개량형 꼭두각시 인형</color> 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "交響之心‧枷薇";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>維多利亞</color>』到自己的戰場上。 
<hr>當自己的人偶‧從者卡進入戰場時，使其獲得【<color=Keyword>守護</color>】。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>改良型‧懸絲人偶</color>』到自己的戰場上。 </ev>
""";
    }

}
