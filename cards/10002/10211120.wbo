wbo 0.1.0;

card 10211120 {
    type follower;
    cost 5;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10002;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "木锤矮人";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。【<color=Keyword>连击</color>_3】改为对对手的战场上的所有随从造成4点伤害。
""";
    }

    locale eng {
        name "Dwarven Malletman";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage. <b><color=Keyword>Combo</color> (3)</b> - Deal damage to all enemy followers instead.
""";
    }

    locale jpn {
        name "<rub=\"きづち\">木槌</rub>のドワーフ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。【<color=Keyword>コンボ</color>_3】1枚を選ぶのではなくすべて。
""";
    }

    locale kor {
        name "나무망치 드워프";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해. [<color=Keyword>콤보</color> 3] 1장을 선택하는 대신 모두.
""";
    }

    locale cht {
        name "木槌矮人";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。【<color=Keyword>連擊</color>_3】由原本的指定1張轉變為全部。
""";
    }

}
