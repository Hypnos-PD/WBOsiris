wbo 0.1.0;

card 10214120 {
    type follower;
    cost 7;
    stats 7/7;

    effect {
        fanfare {
            choose targets from oppo.field.followers count 2;
            add cannot_attack to targets until oppo turn ends;
        }

        superevolve {
            choose targets from oppo.field.followers count 2;
            grant targets {
                label chs "回合结束时，对自己的主战者造成1点伤害，对本随从造成2点伤害。";
                label eng "At the end of each turn, deal 1 damage to your leader and 2 damage to this follower.";
                label jpn "ターン終了時、自分のリーダーに1ダメージ。これに2ダメージ。";
                label kor "턴 종료시, 내 리더에게 1 피해. 이 추종자에게 2 피해.";
                label cht "回合結束時，給予自己的主戰者1點傷害。給予這張卡片2點傷害。";
                when own turn ends {
                    damage own.leader 1;
                    damage self 2;
                }
            }
        }
    }

    meta {
        pack 10002;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "缠绕密林·丽梅格";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的2个随从，对手的回合结束前，使其获得「无法攻击随从或主战者」。
<hr><sev>【<color=Keyword>超进化时</color>】选择对手的战场上的2个随从，使其获得「回合结束时，对自己的主战者造成1点伤害，对本随从造成2点伤害」。</sev>
""";
    }

    locale eng {
        name "Lymaga, Untamed Wild";
        text """
<b><color=Keyword>Fanfare</color></b>: Select 2 enemy followers on the field and give them \"Can't attack followers or leaders\" until the end of your opponent's turn.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Select 2 enemy followers on the field and give them \"At the end of each turn, deal 1 damage to your leader and 2 damage to this follower.\"</sev>
""";
    }

    locale jpn {
        name "<rub=\"から\">絡</rub>み<rub=\"つ\">付</rub>く<rub=\"みつりん\">密林</rub>・リマーガ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー2枚を選ぶ。相手のターン終了まで、それは「フォロワーやリーダーを攻撃できない。」を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】相手の場のフォロワー2枚を選ぶ。それは「ターン終了時、自分のリーダーに1ダメージ。これに2ダメージ。」を持つ。</sev>
""";
    }

    locale kor {
        name "휘감는 밀림 리마가";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 2장을 선택한다. 상대방 턴 종료까지 그 추종자는 「추종자나 리더 공격 불가」를 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 상대방 전장에서 추종자 2장을 선택한다. 그 추종자는 「턴 종료시, 내 리더에게 1 피해. 이 추종자에게 2 피해」를 갖는다.</sev>
""";
    }

    locale cht {
        name "纏枝密林‧麗梅格";
        text """
【<color=Keyword>入場曲</color>】指定2張敵方戰場上的從者卡。到敵方的回合結束為止，使其獲得「無法攻擊從者或主戰者」。
<hr><sev>【<color=Keyword>超進化時</color>】指定2張敵方戰場上的從者卡。使其獲得「回合結束時，給予自己的主戰者1點傷害。給予這張卡片2點傷害」。</sev>
""";
    }

}
