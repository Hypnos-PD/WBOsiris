wbo 0.1.0;

card 10201110 {
    type follower;
    cost 1;
    stats 1/1;

    effect {
        fanfare {
            if count(own.field.followers where form super_evolved) >= 1 {
                choose target from oppo.field.followers;
                damage target 4;
            }
        }
    }

    meta {
        pack 10002;
        class neutral;
        rarity bronze;
    }

    locale chs {
        name "双刀哥布林";
        text """
【<color=Keyword>入场曲</color>】若自己的战场上有超进化后的随从，则选择对手的战场上的1个随从，对其造成4点伤害。
""";
    }

    locale eng {
        name "Twinblade Goblin";
        text """
<b><color=Keyword>Fanfare</color></b>: If there's a super-evolved allied follower on the field, select an enemy follower on the field and deal it 4 damage.
""";
    }

    locale jpn {
        name "<rub=\"にとう\">二刀</rub>のゴブリン";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場に超進化後のフォロワーがあるなら、相手の場のフォロワー1枚を選ぶ。それに4ダメージ。
""";
    }

    locale kor {
        name "쌍검 고블린";
        text """
[<color=Keyword>출격</color>] 내 전장에 초진화후인 추종자가 있다면, 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해.
""";
    }

    locale cht {
        name "雙刃哥布林";
        text """
【<color=Keyword>入場曲</color>】如果自己戰場上有已超進化的從者卡，則會指定1張敵方戰場上的從者卡。給予其4點傷害。
""";
    }

}
