wbo 0.1.0;

card 10254120 {
    type follower;
    cost 5;
    stats 4/4;

    effect {
        unplayable;
    }

    meta {
        pack 10002;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "流动堕落的冥河·凯伦";
        text """
【<color=Keyword>入场曲</color>】发动【<color=Keyword>亡者召还</color>_2】和【<color=Keyword>亡者召还</color>_1】。
<hr>自己的亡者·随从进入战场时，使其获得【<color=Keyword>守护</color>】。
<hr><sev>【<color=Keyword>超进化时</color>】使自己获得『纹章：流动堕落的冥河·凯伦』。</sev>
""";
    }

    locale eng {
        name "Charon, Stygian Oarswoman";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Reanimate</color> (2)</b> and <b><color=Keyword>Reanimate</color> (1)</b>.
<hr>Whenever an allied Departed follower enters the field, give it <b><color=Keyword>Ward</color></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Gain <b><i>Crest: Charon, Stygian Oarswoman</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"なが\">流</rub>れ<rub=\"お\">堕</rub>つ<rub=\"めいが\">冥河</rub>・カローン";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>リアニメイト</color>_2】と【<color=Keyword>リアニメイト</color>_1】を行う。
<hr>自分の死者・フォロワーが場に出たとき、それは【<color=Keyword>守護</color>】を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】自分は『クレスト：流れ堕つ冥河・カローン』を持つ。</sev>
""";
    }

    locale kor {
        name "명계로 이끄는 강 카론";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>소생</color> 2], [<color=Keyword>소생</color> 1]을 발동.
<hr>내 망자 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 나는 「크레스트: 명계로 이끄는 강 카론」을 갖는다.</sev>
""";
    }

    locale cht {
        name "流墮的冥河‧凱倫";
        text """
【<color=Keyword>入場曲</color>】發動【<color=Keyword>亡者召還</color>_2】與【<color=Keyword>亡者召還</color>_1】。
<hr>當自己的死者‧從者卡進入戰場時，使其獲得【<color=Keyword>守護</color>】。
<hr><sev>【<color=Keyword>超進化時</color>】使自己獲得『紋章：流墮的冥河‧凱倫』。</sev>
""";
    }

}
