wbo 0.1.0;

card 10274120 {
    type follower;
    cost 5;
    stats 5/4;

    effect {
        fanfare {
            choose target from own.hand.followers where trait artifact and cost <= 5;
            summon copies of target;
        }
        superevolve {
            set_attack_limit self 2;
        }
    }

    meta {
        pack 10002;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "精神武艺·迦尔拉";
        text """
【<color=Keyword>入场曲</color>】选择自己的手牌中的1张费用为5或以下的创造物·随从，召唤对应数量的复制随从。
<hr><sev>【<color=Keyword>超进化时</color>】本随从获得「1回合可以攻击2次」。</sev>
""";
    }

    locale eng {
        name "Karula, Eternal Arts";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an Artifact follower in your hand that costs 5 or less and summon an exact copy of it.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give this follower \"Can attack 2 times per turn.\"</sev>
""";
    }

    locale jpn {
        name "マインドアーツ・カルラ";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札のコスト5以下のアーティファクト・フォロワー1枚を選ぶ。それのコピー1枚を自分の場に出す。
<hr><sev>【<color=Keyword>超進化時</color>】これは「1ターンに2回攻撃できる。」を持つ。</sev>
""";
    }

    locale kor {
        name "마인드 아츠 카르라";
        text """
[<color=Keyword>출격</color>] 내 패에서 비용이 5 이하인 아티팩트 추종자 1장을 선택한다. 그 추종자의 복사본 1장을 내 전장에 소환.
<hr><sev>[<color=Keyword>초진화시</color>] 이 추종자는 「1턴에 2회 공격 가능」을 갖는다.</sev>
""";
    }

    locale cht {
        name "心魂武藝‧迦爾拉";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中消費為5以下的創造物‧從者卡。將其複製1張並召喚到自己的戰場上。
<hr><sev>【<color=Keyword>超進化時</color>】使這張卡片獲得「1回合中可進行2次攻擊」。</sev>
""";
    }

}
