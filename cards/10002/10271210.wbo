wbo 0.1.0;

card 10271210 {
    type amulet;
    cost 1;

    effect {
        unplayable;
    }

    meta {
        pack 10002;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "创造物弹射器";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>未来核心</color>』和1张『<color=Keyword>过往核心</color>』加入手牌。
<hr>费用3【<color=Keyword>启动</color>】破坏本卡牌。选择自己的手牌中的1张费用为5或以下的创造物·随从，召唤对应数量的复制随从，使其获得「对手的回合结束时，破坏本卡牌」。
""";
    }

    locale eng {
        name "Artifact Catapult";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gear of Ambition</color></i></b> and <b><i><color=Keyword>Gear of Remembrance</color></i></b> to your hand.
<hr><b><color=Keyword>Engage</color> (3)</b>: Destroy this card. Select an Artifact follower in your hand that costs 5 or less, summon an exact copy of it, and give the exact copy \"At the end of your opponent's turn, destroy this card.\"
""";
    }

    locale jpn {
        name "アーティファクトカタパルト";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フューチャー・コア</color>』1枚と『<color=Keyword>パスト・コア</color>』1枚を自分の手札に加える。
<hr>コスト3【<color=Keyword>アクト</color>】これを破壊。自分の手札のコスト5以下のアーティファクト・フォロワー1枚を選ぶ。それのコピー1枚を自分の場に出す。それは「相手のターン終了時、これを破壊。」を持つ。
""";
    }

    locale kor {
        name "아티팩트 캐터펄트";
        text """
[<color=Keyword>출격</color>] <color=Keyword>퓨처 코어</color> 1장, <color=Keyword>패스트 코어</color> 1장을 내 패에 넣는다.
<hr>비용 3 [<color=Keyword>활성화</color>] 이 마법진을 파괴. 내 패에서 비용이 5 이하인 아티팩트 추종자 1장을 선택한다. 그 추종자의 복사본 1장을 내 전장에 소환. 그 추종자는 「상대방 턴 종료시, 이 추종자를 파괴」를 갖는다.
""";
    }

    locale cht {
        name "創造物彈射裝置";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>未來之核</color>』與1張『<color=Keyword>過往之核</color>』到自己的手牌中。
<hr>消費3【<color=Keyword>策動</color>】破壞這張卡片。指定1張自己手牌中消費為5以下的創造物‧從者卡。將其複製1張並召喚到自己的戰場上。使其獲得「敵方的回合結束時，破壞這張卡片」。
""";
    }

}
