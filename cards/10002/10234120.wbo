wbo 0.1.0;

card 10234120 {
    type follower;
    cost 6;
    stats 5/5;
    trait mysteria;

    effect {
        fanfare {
            earthrite 1 {
                mode {
                    option 1 {
                        label chs "召唤1个『守护者巨像』，使其获得【屏障】。";
                        label eng "Summon a Guardian Golem and give it Barrier.";
                        label jpn "『ガーディアンゴーレム』1枚を自分の場に出す。それに【バリア】を持つ。";
                        label kor "'가디언 골렘' 1장을 내 전장에 소환. 그 추종자는 [배리어]를 갖는다.";
                        label cht "召喚1張『守護者巨像』，使其獲得【屏障】。";
                        summon 1 card 90031120;
                        add barrier to summoned;
                    }
                    option 2 {
                        label chs "抽取3张卡牌。";
                        label eng "Draw 3 cards.";
                        label jpn "自分のデッキから3枚を引く。";
                        label kor "내 덱에서 3장을 뽑는다.";
                        label cht "抽取3張卡片。";
                        draw 3;
                    }
                    option 3 {
                        label chs "回复自己的主战者4点生命值。";
                        label eng "Restore 4 defense to your leader.";
                        label jpn "自分のリーダーを4回復。";
                        label kor "내 리더를 4 회복.";
                        label cht "回復自己的主戰者4點生命值。";
                        heal own.leader 4;
                    }
                }
            }
        }

        evolve {
            earthrite 1 {
                mode {
                    option 1 {
                        label chs "召唤1个『守护者巨像』，使其获得【屏障】。";
                        label eng "Summon a Guardian Golem and give it Barrier.";
                        label jpn "『ガーディアンゴーレム』1枚を自分の場に出す。それに【バリア】を持つ。";
                        label kor "'가디언 골렘' 1장을 내 전장에 소환. 그 추종자는 [배리어]를 갖는다.";
                        label cht "召喚1張『守護者巨像』，使其獲得【屏障】。";
                        summon 1 card 90031120;
                        add barrier to summoned;
                    }
                    option 2 {
                        label chs "抽取3张卡牌。";
                        label eng "Draw 3 cards.";
                        label jpn "自分のデッキから3枚を引く。";
                        label kor "내 덱에서 3장을 뽑는다.";
                        label cht "抽取3張卡片。";
                        draw 3;
                    }
                    option 3 {
                        label chs "回复自己的主战者4点生命值。";
                        label eng "Restore 4 defense to your leader.";
                        label jpn "自分のリーダーを4回復。";
                        label kor "내 리더를 4 회복.";
                        label cht "回復自己的主戰者4點生命值。";
                        heal own.leader 4;
                    }
                }
            }
        }
    }

    meta {
        pack 10002;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "精金炼金术师·诺曼";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>土之秘术</color>_1】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）召唤1个『<color=Keyword>守护者巨像</color>』，使其获得【<color=Keyword>屏障</color>】。</ridx>
<ridx=1>（2）抽取3张卡牌。</ridx>
<ridx=2>（3）回复自己的主战者4点生命值。</ridx>
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Norman, Adamant Alchemist";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Earth Rite</color> (1)</b> - Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Summon a <b><i><color=Keyword>Guardian Golem</color></i></b> and give it <b><color=Keyword>Barrier</color></b>.</ridx>
<ridx=1>2. Draw 3 cards.</ridx>
<ridx=2>3. Restore 4 defense to your leader.</ridx>
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "アダマントアルケミスト・ノーマン";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>土の秘術</color>_1】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）『<color=Keyword>ガーディアンゴーレム</color>』1枚を自分の場に出す。それは【<color=Keyword>バリア</color>】を持つ。</ridx>
<ridx=1>（2）自分のデッキから3枚を引く。</ridx>
<ridx=2>（3）自分のリーダーを4回復。</ridx>
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "아다만트 알케미스트 노만";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>대지의 비술</color> 1] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) <color=Keyword>수호 골렘</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>배리어</color>]를 갖는다.</ridx>
<ridx=1>(2) 내 덱에서 3장을 뽑는다.</ridx>
<ridx=2>(3) 내 리더를 4 회복.</ridx>
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "堅定的鍊金術師‧諾曼";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>土之秘術</color>_1】指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）召喚1張『<color=Keyword>守護者巨像</color>』到自己的戰場上。使其獲得【<color=Keyword>障壁</color>】。</ridx>
<ridx=1>（2）由自己的牌堆中抽取3張卡片。</ridx>
<ridx=2>（3）回復自己的主戰者4點生命值。</ridx>
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
