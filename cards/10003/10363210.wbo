wbo 0.1.0;

card 10363210 {
    type amulet;
    cost 4;

    effect {
        countdown 4;
        engage 0 {
            reduce countdown self own.crests;
        }
        lastwords {
            damage oppo.field.followers 4 distributed overflow oppo.leader;
            heal own.leader 4;
        }
    }

    meta {
        pack 10003;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "闪耀的失意";
        text """
【<color=Keyword>吟唱</color>_4】
【<color=Keyword>谢幕曲</color>】对对手的战场上的所有随从和对手的主战者分配4点伤害。回复自己的主战者4点生命值。
<hr>【<color=Keyword>启动</color>】本护符的倒计数-X。X为自己的纹章数。
""";
    }

    locale eng {
        name "Shining Disenchantment";
        text """
<b><color=Keyword>Countdown</color> (4)</b>
<b><color=Keyword>Last Words</color></b>: Deal 4 damage split between all enemies. Restore 4 defense to your leader.
<hr><b><color=Keyword>Engage</color></b>: Advance this amulet's count by X. X is the number of crests you have.
""";
    }

    locale jpn {
        name "<rub=\"かがや\">輝</rub>く<rub=\"しつい\">失意</rub>";
        text """
【<color=Keyword>カウントダウン</color>_4】
【<color=Keyword>ラストワード</color>】相手の場のフォロワーすべてと相手のリーダーに4ダメージを割りふる。自分のリーダーを4回復。
<hr>【<color=Keyword>アクト</color>】これのカウントを-Xする。Xは自分のクレストの数である。
""";
    }

    locale kor {
        name "빛나는 실의";
        text """
[<color=Keyword>카운트다운</color> 4]
[<color=Keyword>유언</color>] 상대방 전장의 추종자 모두와 상대방 리더에게 4 피해를 분배한다. 내 리더를 4 회복.
<hr>[<color=Keyword>활성화</color>] 이 마법진의 카운트를 -X. X는 내 크레스트 수.
""";
    }

    locale cht {
        name "閃耀的絕念";
        text """
【<color=Keyword>倒數</color>_4】
【<color=Keyword>謝幕曲</color>】對敵方戰場上全部的從者卡與敵方的主戰者分配4點傷害。回復自己的主戰者4點生命值。
<hr>【<color=Keyword>策動</color>】使這張卡片的倒數回合數-X。X為「自己的紋章數」。
""";
    }

}
