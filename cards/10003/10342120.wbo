wbo 0.1.0;

card 10342120 {
    type follower;
    cost 3;
    stats 1/1;

    effect {
        fanfare {
            if overflow {
                summon 2 card 90041130;
            } else {
                summon 1 card 90041130;
            }
        }
        when own follower summoned where trait marine {
            add ward to summoned;
        }
    }

    meta {
        pack 10003;
        class dragoncraft;
        rarity silver;
    }

    locale chs {
        name "海洋骑手";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>大海虎鲸</color>』。若为【<color=Keyword>觉醒</color>】，则改为召唤2个。
<hr>自己的海洋·随从进入战场时，使其获得【<color=Keyword>守护</color>】。
""";
    }

    locale eng {
        name "Ocean Rider";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Majestic Megalorca</color></i></b>. If you're in <b><color=Keyword>Overflow</color></b>, summon 2 instead.
<hr>Whenever an allied Marine follower enters the field, give it <b><color=Keyword>Ward</color></b>.
""";
    }

    locale jpn {
        name "オーシャンライダー";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>大海のオルカ</color>』1枚を自分の場に出す。【<color=Keyword>覚醒</color>】なら、1枚ではなく2枚。
<hr>自分の海洋・フォロワーが場に出たとき、それは【<color=Keyword>守護</color>】を持つ。
""";
    }

    locale kor {
        name "오션 라이더";
        text """
[<color=Keyword>출격</color>] <color=Keyword>대해의 오르카</color> 1장을 내 전장에 소환. [<color=Keyword>각성</color>]이라면, 1장 대신 2장.
<hr>내 바다 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
""";
    }

    locale cht {
        name "海洋騎手";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>滄海虎鯨</color>』到自己的戰場上。如果【<color=Keyword>覺醒</color>】已發動，則會由原本的1張轉變為2張。
<hr>當自己的海洋‧從者卡進入戰場時，使其獲得【<color=Keyword>守護</color>】。
""";
    }

}
