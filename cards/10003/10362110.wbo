wbo 0.1.0;

card 10362110 {
    type follower;
    cost 3;
    stats 1/4;

    effect {
        ward;
        fanfare {
            gain own crest 10362110;
        }
    }

    crest {
        countdown 4;

        when own turn ends if not own.attacked_this_turn {
            heal own.leader 1;
        }

        locale chs {
            name "纹章：安息的祈祷者";
            text """
【<color=Keyword>吟唱</color>_4】
自己的回合结束时，若本回合中自己的随从没有进行过攻击，则回复自己的主战者1点生命值。
""";
        }

        locale eng {
            name "Crest: Prayer of Repose";
            text """
<b><color=Keyword>Countdown</color> (4)</b>
At the end of your turn, if allied followers didn't attack this turn, restore 1 defense to your leader.
""";
        }

        locale jpn {
            name "クレスト：安息の祈祷者";
            text """
【<color=Keyword>カウントダウン</color>_4】
自分のターン終了時、このターン中に自分のフォロワーが攻撃していないなら、自分のリーダーを1回復。
""";
        }

        locale kor {
            name "크레스트: 안식의 기도자";
            text """
[<color=Keyword>카운트다운</color> 4]
내 턴 종료시 이번 턴에 내 추종자가 공격하지 않았다면, 내 리더를 1 회복.
""";
        }

        locale cht {
            name "紋章：安息的祈禱者";
            text """
【<color=Keyword>倒數</color>_4】
自己的回合結束時，如果本回合中自己的從者卡未進行攻擊，則會回復自己的主戰者1點生命值。
""";
        }
    }

    meta {
        pack 10003;
        class havencraft;
        rarity silver;
    }

    locale chs {
        name "安息的祈祷者";
        text """
【<color=Keyword>入场曲</color>】使自己获得『纹章：安息的祈祷者』。
<hr>【<color=Keyword>守护</color>】
""";
    }

    locale eng {
        name "Supplicant of Repose";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain <b><i>Crest: Supplicant of Repose</i></b>.
<hr><b><color=Keyword>Ward</color></b>
""";
    }

    locale jpn {
        name "<rub=\"あんそく\">安息</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分は『クレスト：安息の祈祷者』を持つ。
<hr>【<color=Keyword>守護</color>】
""";
    }

    locale kor {
        name "안식의 기도자";
        text """
[<color=Keyword>출격</color>] 나는 「크레스트: 안식의 기도자」를 갖는다.
<hr>[<color=Keyword>수호</color>]
""";
    }

    locale cht {
        name "安息的祈禱者";
        text """
【<color=Keyword>入場曲</color>】使自己獲得『紋章：安息的祈禱者』。
<hr>【<color=Keyword>守護</color>】
""";
    }

}
