wbo 0.1.0;

card 10352210 {
    type amulet;
    cost 2;

    effect {
        fanfare {
            mode {
                option 1 {
                    label chs "抽取1张卡牌。";
                    label eng "Draw a card.";
                    label jpn "自分のデッキから1枚を引く。";
                    label kor "내 덱에서 1장을 뽑는다.";
                    label cht "抽取1張卡片。";
                    draw 1;
                }
                option 2 {
                    label chs "使自己的战场上的随机1个随从+1/+1。";
                    label eng "Give a random allied follower +1/+1.";
                    label jpn "自分の場のフォロワーからランダム1枚は+1/+1する。";
                    label kor "내 전장의 추종자 하나를 무작위로 +1/+1.";
                    label cht "使自己的戰場上的隨機1張從者卡+1/+1。";
                    random ally from own.field.followers;
                    buff ally +1/+1;
                }
            }
        }
        engage 1 {
            destroy self;
            mode {
                option 1 {
                    label chs "抽取1张卡牌。";
                    label eng "Draw a card.";
                    label jpn "自分のデッキから1枚を引く。";
                    label kor "내 덱에서 1장을 뽑는다.";
                    label cht "抽取1張卡片。";
                    draw 1;
                }
                option 2 {
                    label chs "使自己的战场上的随机1个随从+1/+1。";
                    label eng "Give a random allied follower +1/+1.";
                    label jpn "自分の場のフォロワーからランダム1枚は+1/+1する。";
                    label kor "내 전장의 추종자 하나를 무작위로 +1/+1.";
                    label cht "使自己的戰場上的隨機1張從者卡+1/+1。";
                    random ally from own.field.followers;
                    buff ally +1/+1;
                }
            }
        }
    }

    meta {
        pack 10003;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "混融之城";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）抽取1张卡牌。</ridx>
<ridx=1>（2）使自己的战场上的随机1个随从+1/+1。</ridx>
<hr>费用1【<color=Keyword>启动</color>】破坏本卡牌。发动与【<color=Keyword>入场曲</color>】相同的能力。
""";
    }

    locale eng {
        name "Castle of Entwining";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Draw a card.</ridx>
<ridx=1>2. Give a random allied follower on the field +1/+1.</ridx>
<hr><b><color=Keyword>Engage</color> (1)</b>: Destroy this card. Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.
""";
    }

    locale jpn {
        name "<rub=\"こんゆう\">混融</rub>の<rub=\"しろ\">城</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）自分のデッキから1枚を引く。</ridx>
<ridx=1>（2）自分の場のフォロワーからランダム1枚は+1/+1する。</ridx>
<hr>コスト1【<color=Keyword>アクト</color>】これを破壊。【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。
""";
    }

    locale kor {
        name "혼융의 성";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 내 덱에서 1장을 뽑는다.</ridx>
<ridx=1>(2) 내 전장의 추종자 중 무작위로 1장은 +1/+1.</ridx>
<hr>비용 1 [<color=Keyword>활성화</color>] 이 마법진을 파괴. [<color=Keyword>출격</color>]과 같은 능력을 발동.
""";
    }

    locale cht {
        name "混融之城";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。 
<ridx=0>（1）由自己的牌堆中抽取1張卡片。</ridx>
<ridx=1>（2）隨機使1張自己戰場上的從者卡+1/+1。</ridx>
<hr>消費1【<color=Keyword>策動</color>】破壞這張卡片。發動與【<color=Keyword>入場曲</color>】相同的能力。
""";
    }

}
