wbo 0.1.0;

card 10364120 {
    type follower;
    cost 4;
    stats 4/4;

    effect {
        fanfare {
            add 1 card 90064310 to hand;
        }
        evolve {
            gain own crest 10364120;
        }
    }

    crest {
        when own turn ends if not own.attacked_this_turn {
            damage oppo.field.followers own.crests distributed overflow oppo.leader;
        }

        locale chs {
            name "纹章：绝望的显现·玛温";
            text """
自己的回合结束时，若本回合中自己的随从没有进行过攻击，则对对手的战场上的所有随从和对手的主战者分配X点伤害。X为自己的纹章数。
""";
        }

        locale eng {
            name "Crest: Marwynn, Despair Manifest";
            text """
At the end of your turn, if allied followers didn't attack this turn, deal X damage split between all enemies. X is the number of crests you have.
""";
        }

        locale jpn {
            name "クレスト：絶望の顕現・マーウィン";
            text """
自分のターン終了時、このターン中に自分のフォロワーが攻撃していないなら、相手の場のフォロワーすべてと相手のリーダーにXダメージを割りふる。Xは自分のクレストの数である。
""";
        }

        locale kor {
            name "크레스트: 절망의 현현 마윈";
            text """
내 턴 종료시 이번 턴에 내 추종자가 공격하지 않았다면, 상대방 전장의 추종자 모두와 상대방 리더에게 X 피해를 분배한다. X는 내 크레스트 수.
""";
        }

        locale cht {
            name "紋章：絕望的顯現‧瑪文";
            text """
自己的回合結束時，如果本回合中自己的從者卡未進行攻擊，則會對敵方戰場上全部的從者卡與敵方的主戰者分配X點傷害。X為「自己的紋章數」。
""";
        }
    }

    meta {
        pack 10003;
        class havencraft;
        rarity legendary;
    }

    locale chs {
        name "绝望的显现·玛温";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>绝望的奔流</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】使自己获得『纹章：绝望的显现·玛温』。</ev>
""";
    }

    locale eng {
        name "Marwynn, Despair Manifest";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Torrent of Despair</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Gain <b><i>Crest: Marwynn, Despair Manifest</i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ぜつぼう\">絶望</rub>の<rub=\"けんげん\">顕現</rub>・マーウィン";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>絶望の奔流</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】自分は『クレスト：絶望の顕現・マーウィン』を持つ。</ev>
""";
    }

    locale kor {
        name "절망의 현현 마윈";
        text """
[<color=Keyword>출격</color>] <color=Keyword>절망의 격류</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] 나는 「크레스트: 절망의 현현 마윈」을 갖는다.</ev>
""";
    }

    locale cht {
        name "絕望的顯現‧瑪文";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>絕望的奔流</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】使自己獲得『紋章：絕望的顯現‧瑪文』。</ev>
""";
    }

}
