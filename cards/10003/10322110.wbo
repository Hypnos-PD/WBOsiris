wbo 0.1.0;

card 10322110 {
    type follower;
    cost 2;
    stats 1/2;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "篡夺的祈祷者";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>黄金项链</color>』加入手牌。
<hr>【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>黄金短剑</color>』加入手牌。
""";
    }

    locale eng {
        name "Supplicant of Usurpation";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gilded Necklace</color></i></b> to your hand.
<hr><b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Gilded Blade</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"さんだつ\">簒奪</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>黄金の首飾り</color>』1枚を自分の手札に加える。
<hr>【<color=Keyword>ラストワード</color>】『<color=Keyword>黄金の小剣</color>』1枚を自分の手札に加える。
""";
    }

    locale kor {
        name "약탈의 기도자";
        text """
[<color=Keyword>출격</color>] <color=Keyword>황금 목걸이</color> 1장을 내 패에 넣는다.
<hr>[<color=Keyword>유언</color>] <color=Keyword>황금 단검</color> 1장을 내 패에 넣는다.
""";
    }

    locale cht {
        name "篡奪的祈禱者";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>黃金首飾</color>』到自己的手牌中。
<hr>【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>黃金短劍</color>』到自己的手牌中。
""";
