wbo 0.1.0;

card 10311110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "不弑的肯定者";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其-0/-1。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Devotee of Unkilling";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and give it -0/-1.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ふさつ\">不殺</rub>の<rub=\"こうていしゃ\">肯定者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それは-0/-1する。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "불살의 긍정자";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 -0/-1.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "不弒的肯定者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其-0/-1。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
