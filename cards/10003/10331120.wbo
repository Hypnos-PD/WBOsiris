wbo 0.1.0;

card 10331120 {
    type follower;
    cost 4;
    stats 3/3;

    effect {
        fanfare {
            summon 1 card 90031130;
        }
        evolve {
            summon 1 card 90031130;
        }
    }

    meta {
        pack 10003;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "五行修行者";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>式神·小纸人</color>』。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Ascetic of Wuxing";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Paper Shikigami</color></i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ごぎょう\">五行</rub>の<rub=\"しゅぎょうしゃ\">修行者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>式神・形代</color>』1枚を自分の場に出す。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "오행의 수행자";
        text """
[<color=Keyword>출격</color>] <color=Keyword>식신 종이인형</color> 1장을 내 전장에 소환.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "五行的修行者";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>式神‧小紙人</color>』到自己的戰場上。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
