wbo 0.1.0;

card 10312110 {
    type follower;
    cost 6;
    stats 5/6;

    effect {
        fanfare {
            buff oppo.field.followers +0/-3;
        }
        superevolve {
            buff oppo.field.followers +0/-3;
        }
    }

    meta {
        pack 10003;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "不弑的祈祷者";
        text """
【<color=Keyword>入场曲</color>】使对手的战场上的所有随从-0/-3。
<hr><sev>【<color=Keyword>超进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</sev>
""";
    }

    locale eng {
        name "Supplicant of Unkilling";
        text """
<b><color=Keyword>Fanfare</color></b>: Give all enemy followers on the field -0/-3.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</sev>
""";
    }

    locale jpn {
        name "<rub=\"ふさつ\">不殺</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーすべては-0/-3する。
<hr><sev>【<color=Keyword>超進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</sev>
""";
    }

    locale kor {
        name "불살의 기도자";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 모두는 -0/-3.
<hr><sev>[<color=Keyword>초진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</sev>
""";
    }

    locale cht {
        name "不弒的祈禱者";
        text """
【<color=Keyword>入場曲</color>】使敵方戰場上全部的從者卡-0/-3。
<hr><sev>【<color=Keyword>超進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</sev>
""";
    }

}
