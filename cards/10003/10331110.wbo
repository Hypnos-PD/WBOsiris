wbo 0.1.0;

card 10331110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            if self.cost != 2 {
                heal own.leader 3;
            }
        }
    }

    meta {
        pack 10003;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "真理的肯定者";
        text """
【<color=Keyword>入场曲</color>】若本卡牌的费用不为2，则回复自己的主战者3点生命值。
""";
    }

    locale eng {
        name "Devotee of Truth";
        text """
<b><color=Keyword>Fanfare</color></b>: If this card's cost isn't 2, restore 3 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"しんじつ\">真実</rub>の<rub=\"こうていしゃ\">肯定者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】これのコストが2でないなら、自分のリーダーを3回復。
""";
    }

    locale kor {
        name "진실의 긍정자";
        text """
[<color=Keyword>출격</color>] 이 추종자의 비용이 2가 아니라면, 내 리더를 3 회복.
""";
    }

    locale cht {
        name "真實的肯定者";
        text """
【<color=Keyword>入場曲</color>】如果這張卡片的消費不為2，則會回復自己的主戰者3點生命值。
""";
    }

}
