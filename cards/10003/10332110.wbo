wbo 0.1.0;

card 10332110 {
    type follower;
    cost 5;
    stats 3/2;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "真理的祈祷者";
        text """
【<color=Keyword>入场曲</color>】对战场上的其他所有随从造成3点伤害。若本随从的费用不为5，则抽取2张卡牌。
""";
    }

    locale eng {
        name "Supplicant of Truth";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 3 damage to all other followers. If this card's cost isn't 5, draw 2 cards.
""";
    }

    locale jpn {
        name "<rub=\"しんじつ\">真実</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】場の他のフォロワーすべてに3ダメージ。これのコストが5でないなら、自分のデッキから2枚を引く。
""";
    }

    locale kor {
        name "진실의 기도자";
        text """
[<color=Keyword>출격</color>] 전장의 다른 추종자 모두에게 3 피해. 이 추종자의 비용이 5가 아니라면, 내 덱에서 2장을 뽑는다.
""";
    }

    locale cht {
        name "真實的祈禱者";
        text """
【<color=Keyword>入場曲</color>】給予戰場上全部的其他從者卡3點傷害。如果這張卡片的消費不為5，則會由自己的牌堆中抽取2張卡片。
""";
    }

}
