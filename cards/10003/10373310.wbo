    locale chs {
        name "歼灭的歌声";
        text """
选择自己的战场上的1张卡牌，破坏该卡牌。召唤1张『<color=Keyword>新约·白之章</color>』。
""";
    }

    locale eng {
        name "Devastating Soprano";
        text """
Select an allied card on the field and destroy it. Summon a <b><i><color=Keyword>White Psalm, New Revelation</color></i></b>.
""";
