wbo 0.1.0;

card 10333110 {
    type follower;
    cost 3;
    stats 3/1;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "真理的团结者";
        text """
【<color=Keyword>入场曲</color>】若本随从的费用不为3，则召唤2个本随从的复制随从。
<hr>【<color=Keyword>突进</color>】
<hr><sev>【<color=Keyword>超进化时</color>】召唤1个本随从的复制随从。</sev>
""";
    }

    locale eng {
        name "Congregant of Truth";
        text """
<b><color=Keyword>Fanfare</color></b>: If this card's cost isn't 3, summon 2 exact copies of it.
<hr><b><color=Keyword>Rush</color></b>
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Summon an exact copy of this card.</sev>
""";
    }

    locale jpn {
        name "<rub=\"しんじつ\">真実</rub>の<rub=\"だんけつしゃ\">団結者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】これのコストが3でないなら、これのコピー2枚を自分の場に出す。
<hr>【<color=Keyword>突進</color>】
<hr><sev>【<color=Keyword>超進化時</color>】これのコピー1枚を自分の場に出す。</sev>
""";
    }

    locale kor {
        name "진실의 단결자";
        text """
[<color=Keyword>출격</color>] 이 추종자의 비용이 3이 아니라면, 이 추종자의 복사본 2장을 내 전장에 소환.
<hr>[<color=Keyword>돌진</color>]
<hr><sev>[<color=Keyword>초진화시</color>] 이 추종자의 복사본 1장을 내 전장에 소환.</sev>
""";
    }

    locale cht {
        name "真實的團結者";
        text """
【<color=Keyword>入場曲</color>】如果這張卡片的消費不為3，則會將這張卡片複製2張並召喚到自己的戰場上。
<hr>【<color=Keyword>突進</color>】
<hr><sev>【<color=Keyword>超進化時</color>】將這張卡片複製1張並召喚到自己的戰場上。</sev>
""";
    }

}
