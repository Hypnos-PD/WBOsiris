wbo 0.1.0;

card 10362220 {
    type amulet;
    cost 3;

    effect {
        countdown 3;
        engage 1 {
            reduce countdown self 1;
        }
        lastwords {
            summon 1 card 90061110;
            summon 1 card 90061120;
        }
    }

    meta {
        pack 10003;
        class havencraft;
        rarity silver;
    }

    locale chs {
        name "羽翼狮子像";
        text """
【<color=Keyword>吟唱</color>_3】
【<color=Keyword>谢幕曲</color>】召唤1个『<color=Keyword>神圣猎鹰</color>』和1个『<color=Keyword>圣炎猛虎</color>』。
<hr>费用1【<color=Keyword>启动</color>】本护符的倒计数-1。
""";
    }

    locale eng {
        name "Winged Lion Statue";
        text """
<b><color=Keyword>Countdown</color> (3)</b>
<b><color=Keyword>Last Words</color></b>: Summon a <b><i><color=Keyword>Holy Falcon</color></i></b> and <b><i><color=Keyword>Holyflame Tiger</color></i></b>.
<hr><b><color=Keyword>Engage</color> (1)</b>: Advance this amulet's count by 1.
""";
    }

    locale jpn {
        name "<rub=\"ゆうよく\">有翼</rub>の<rub=\"ししぞう\">獅子像</rub>";
        text """
【<color=Keyword>カウントダウン</color>_3】
【<color=Keyword>ラストワード</color>】『<color=Keyword>ホーリーファルコン</color>』1枚と『<color=Keyword>ホーリーフレイムタイガー</color>』1枚を自分の場に出す。
<hr>コスト1【<color=Keyword>アクト</color>】これのカウントを-1する。
""";
    }

    locale kor {
        name "날개 달린 사자상";
        text """
[<color=Keyword>카운트다운</color> 3]
[<color=Keyword>유언</color>] <color=Keyword>신성한 매</color> 1장, <color=Keyword>성화의 맹호</color> 1장을 내 전장에 소환.
<hr>비용 1 [<color=Keyword>활성화</color>] 이 마법진의 카운트를 -1.
""";
    }

    locale cht {
        name "展翼獅像";
        text """
【<color=Keyword>倒數</color>_3】
【<color=Keyword>謝幕曲</color>】召喚1張『<color=Keyword>神聖獵鷹</color>』與1張『<color=Keyword>聖炎猛虎</color>』到自己的戰場上。
<hr>消費1【<color=Keyword>策動</color>】使這張卡片的倒數回合數-1。
""";
    }

}
