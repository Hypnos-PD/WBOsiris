wbo 0.1.0;

card 10371310 {
    type spell;
    cost 4;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "丝线突袭";
        text """
选择对手的战场上的1个随从，破坏该随从。将2张『<color=Keyword>悬丝傀儡</color>』加入手牌。
""";
    }

    locale eng {
        name "Wired Assault";
        text """
Select an enemy follower on the field and destroy it. Add 2 copies of <b><i><color=Keyword>Puppet</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "ストリングアサルト";
        text """
相手の場のフォロワー1枚を選ぶ。それを破壊。『<color=Keyword>操り人形</color>』2枚を自分の手札に加える。
""";
    }

    locale kor {
        name "스트링 어썰트";
        text """
상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴. <color=Keyword>꼭두각시 인형</color> 2장을 내 패에 넣는다.
""";
    }

    locale cht {
        name "躍線狂襲";
        text """
指定1張敵方戰場上的從者卡。將其破壞。增加2張『<color=Keyword>懸絲人偶</color>』到自己的手牌中。
""";
    }

}
