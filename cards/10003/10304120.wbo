wbo 0.1.0;

card 10304120 {
    type follower;
    cost 3;
    stats 0/3;

    effect {
        fanfare {
            choose target from field.followers other;
            buff target +2/-2;
            if own.maxpp == 10 {
                if oppo.maxpp == 10 {
                    add 1 card 90004330 to hand;
                }
            }
        }
        drain;
        evolve {
            choose target from field.followers;
            buff target +2/-2;
        }
    }

    meta {
        pack 10003;
        class neutral;
        rarity legendary;
    }

    locale chs {
        name "涸绝的显现·吉尔内莉莎";
        text """
【<color=Keyword>入场曲</color>】选择战场上的1个其他随从，使其+2/-2。若自己和对手的能量点最大值为10，则将1张『<color=Keyword>涸绝的甘露</color>』加入手牌。
<hr>【<color=Keyword>虹吸</color>】
<hr><ev>【<color=Keyword>进化时</color>】选择战场上的1个随从，使其+2/-2。</ev>
""";
    }

    locale eng {
        name "Gilnelise, Voracity Manifest";
        text """
<b><color=Keyword>Fanfare</color></b>: Select another follower on the field and give it +2/-2. If both players have 10 max play points, add a <b><i><color=Keyword>Sweetness of Voracity</color></i></b> to your hand.
<hr><b><color=Keyword>Drain</color></b>
<hr><ev><b><color=Keyword>Evolve</color></b>: Select a follower on the field and give it +2/-2.</ev>
""";
    }

    locale jpn {
        name "<rub=\"かんぜつ\">干絶</rub>の<rub=\"けんげん\">顕現</rub>・ギルネリーゼ";
        text """
【<color=Keyword>ファンファーレ</color>】場の他のフォロワー1枚を選ぶ。それは+2/-2する。自分と相手のPP最大値が10なら、『<color=Keyword>干絶の甘露</color>』1枚を自分の手札に加える。
<hr>【<color=Keyword>ドレイン</color>】
<hr><ev>【<color=Keyword>進化時</color>】場のフォロワー1枚を選ぶ。それは+2/-2する。</ev>
""";
    }

    locale kor {
        name "갈증의 현현 기르네리제";
        text """
[<color=Keyword>출격</color>] 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 +2/-2. 나와 상대방의 PP 최대치가 10이라면, <color=Keyword>갈증의 감로</color> 1장을 내 패에 넣는다.
<hr>[<color=Keyword>흡혈</color>]
<hr><ev>[<color=Keyword>진화시</color>] 전장에서 추종자 1장을 선택한다. 그 추종자는 +2/-2.</ev>
""";
    }

    locale cht {
        name "涸絕的顯現‧吉魯涅莉婕";
        text """
【<color=Keyword>入場曲</color>】指定1張戰場上的其他從者卡。使其+2/-2。如果自己與敵方的PP最大值為10，則會增加1張『<color=Keyword>涸絕的甘露</color>』到自己的手牌中。
<hr>【<color=Keyword>吸血</color>】
<hr><ev>【<color=Keyword>進化時</color>】指定1張戰場上的從者卡。使其+2/-2。</ev>
""";
    }

}
