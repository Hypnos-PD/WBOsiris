wbo 0.1.0;

card 10312120 {
    type follower;
    cost 4;
    stats 4/4;

    effect {
        lastwords {
            add 1 card 90011310 to hand;
            add 1 card 90011110 to hand;
        }
    }

    meta {
        pack 10003;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "树海的战士";
        text """
【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>森林的奥秘</color>』和1张『<color=Keyword>妖精</color>』加入手牌。
""";
    }

    locale eng {
        name "Greatwood Warrior";
        text """
<b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Deepwood Bounty</color></i></b> and <b><i><color=Keyword>Fairy</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"じゅかい\">樹海</rub>の<rub=\"せんし\">戦士</rub>";
        text """
【<color=Keyword>ラストワード</color>】『<color=Keyword>森の神秘</color>』1枚と『<color=Keyword>フェアリー</color>』1枚を自分の手札に加える。
""";
    }

    locale kor {
        name "울창한 숲의 전사";
        text """
[<color=Keyword>유언</color>] <color=Keyword>숲의 신비</color> 1장, <color=Keyword>요정</color> 1장을 내 패에 넣는다.
""";
    }

    locale cht {
        name "樹海的戰士";
        text """
【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>森林的奧祕</color>』與1張『<color=Keyword>妖精</color>』到自己的手牌中。
""";
    }

}
