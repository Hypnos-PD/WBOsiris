wbo 0.1.0;

card 10352110 {
    type follower;
    cost 4;
    stats 4/4;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "混融的祈祷者";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）对对手的战场上的随机1个随从造成3点伤害。</ridx>
<ridx=1>（2）回复自己的主战者2点生命值。</ridx>
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Supplicant of Entwining";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Deal 3 damage to a random enemy follower.</ridx>
<ridx=1>2. Restore 2 defense to your leader.</ridx>
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"こんゆう\">混融</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）相手の場のフォロワーからランダム1枚に3ダメージ。</ridx>
<ridx=1>（2）自分のリーダーを2回復。</ridx>
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "혼융의 기도자";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 상대방 전장의 추종자 중 무작위로 1장에게 3 피해.</ridx>
<ridx=1>(2) 내 리더를 2 회복.</ridx>
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "混融的祈禱者";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。 
<ridx=0>（1）隨機給予1張敵方戰場上的從者卡3點傷害。</ridx>
<ridx=1>（2）回復自己的主戰者2點生命值。</ridx>
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
