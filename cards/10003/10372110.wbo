wbo 0.1.0;

card 10372110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            choose target from own.field other;
            destroy target;
            random victim from oppo.field.followers;
            damage victim 2;
        }
        evolve {
            choose target from own.field other;
            destroy target;
            random victim from oppo.field.followers;
            damage victim 2;
        }
    }

    meta {
        pack 10003;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "破坏的祈祷者";
        text """
【<color=Keyword>入场曲</color>】选择自己的战场上的1张其他卡牌，若成功选择，则破坏该卡牌。对对手的战场上的随机1个随从造成2点伤害。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Supplicant of Destruction";
        text """
<b><color=Keyword>Fanfare</color></b>: Select another allied card on the field. If you selected one, destroy it and deal 2 damage to a random enemy follower.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"はかい\">破壊</rub>の<rub=\"きとうしゃ\">祈祷者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の他のカード1枚を選ぶ。選んだなら、それを破壊。相手の場のフォロワーからランダム1枚に2ダメージ。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "파괴의 기도자";
        text """
[<color=Keyword>출격</color>] 내 전장에서 다른 카드 1장을 선택한다. 선택했다면, 그 카드를 파괴. 상대방 전장의 추종자 중 무작위로 1장에게 2 피해.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "破壞的祈禱者";
        text """
【<color=Keyword>入場曲</color>】指定1張自己戰場上的其他卡片。如果完成指定，則會將其破壞。隨機給予1張敵方戰場上的從者卡2點傷害。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
