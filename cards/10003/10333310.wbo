wbo 0.1.0;

card 10333310 {
    type spell;
    cost 2;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "虚假的术式";
        text """
选择自己的手牌中的1张随从，使其费用+1。破坏对手的战场上的随机1个随从。
""";
    }

    locale eng {
        name "Illusory Conjuration";
        text """
Select a follower in your hand and increase its cost by 1. Destroy a random enemy follower.
""";
    }

    locale jpn {
        name "<rub=\"きょぎ\">虚偽</rub>の<rub=\"じゅつしき\">術式</rub>";
        text """
自分の手札のフォロワー1枚を選ぶ。それのコストを+1する。相手の場のフォロワーからランダム1枚を破壊。
""";
    }

    locale kor {
        name "허구의 술식";
        text """
내 패에서 추종자 1장을 선택한다. 그 추종자의 비용을 +1. 상대방 전장의 추종자 중 무작위로 1장을 파괴.
""";
    }

    locale cht {
        name "虛偽的術式";
        text """
指定1張自己手牌中的從者卡。使其消費+1。隨機破壞1張敵方戰場上的從者卡。
""";
    }

}
