wbo 0.1.0;

card 10324120 {
    type follower;
    cost 3;
    stats 3/3;

    effect {
        fanfare {
            gain own crest 10324120;
        }
        evolve {
            add 1 card 90021310 to hand;
            add 1 card 90021340 to hand;
        }
    }

    crest {
        countdown 8;

        when own card played where trait loot {
            reduce countdown self 1;
        }
        when own card fused where trait loot {
            reduce countdown self 1;
        }

        lastwords {
            add 1 card 90024310 to hand;
        }

        locale chs {
            name "纹章：空绝的显现·奥克托丽丝";
            text """
【<color=Keyword>吟唱</color>_8】
自己使用财宝·卡牌时，或者自己【<color=Keyword>融合</color>】财宝·卡牌时，本纹章的倒计数-1。
【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>空绝的残光</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Octrice, Hollow Manifest";
            text """
<b><color=Keyword>Countdown</color> (8)</b>
Whenever you play or <b><color=Keyword>Fuse</color></b> a Loot card, advance this crest's count by 1.
<b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Remnant of Hollowness</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：空絶の顕現・オクトリス";
            text """
【<color=Keyword>カウントダウン</color>_8】
自分が財宝・カードをプレイしたとき、または、自分が財宝・カードを【<color=Keyword>融合</color>】したとき、これのカウントを-1する。
【<color=Keyword>ラストワード</color>】『<color=Keyword>空絶の残光</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 공허의 현현 오크트리스";
            text """
[<color=Keyword>카운트다운</color> 8]
내가 보물 카드를 사용했을 때 또는 내가 보물 카드를 [<color=Keyword>융합</color>]했을 때, 이 크레스트의 카운트를 -1.
[<color=Keyword>유언</color>] <color=Keyword>공허의 잔광</color> 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：空絕的顯現‧奧克托莉絲";
            text """
【<color=Keyword>倒數</color>_8】
當自己使用財寶‧卡片時，或當自己將財寶‧卡片進行【<color=Keyword>融合</color>】時，使這個紋章的倒數回合數-1。
【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>空絕的殘光</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10003;
        class swordcraft;
        rarity legendary;
    }

    locale chs {
        name "空绝的显现·奥克托丽丝";
        text """
【<color=Keyword>入场曲</color>】使自己获得『纹章：空绝的显现·奥克托丽丝』。
<hr><ev>【<color=Keyword>进化时</color>】将1张『<color=Keyword>黄金短剑</color>』和1张『<color=Keyword>黄金项链</color>』加入手牌。</ev>
""";
    }

    locale eng {
        name "Octrice, Hollowness Manifest";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain <b><i>Crest: Octrice, Hollowness Manifest</i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Add a <b><i><color=Keyword>Gilded Blade</color></i></b> and <b><i><color=Keyword>Gilded Necklace</color></i></b> to your hand.</ev>
""";
    }

    locale jpn {
        name "<rub=\"くうぜつ\">空絶</rub>の<rub=\"けんげん\">顕現</rub>・オクトリス";
        text """
【<color=Keyword>ファンファーレ</color>】自分は『クレスト：空絶の顕現・オクトリス』を持つ。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>黄金の小剣</color>』1枚と『<color=Keyword>黄金の首飾り</color>』1枚を自分の手札に加える。</ev>
""";
    }

    locale kor {
        name "공허의 현현 옥토리스";
        text """
[<color=Keyword>출격</color>] 나는 「크레스트: 공허의 현현 옥토리스」를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>황금 단검</color> 1장, <color=Keyword>황금 목걸이</color> 1장을 내 패에 넣는다.</ev>
""";
    }

    locale cht {
        name "空絕的顯現‧歐克托莉斯";
        text """
【<color=Keyword>入場曲</color>】使自己獲得『紋章：空絕的顯現‧歐克托莉斯』。
<hr><ev>【<color=Keyword>進化時</color>】增加1張『<color=Keyword>黃金短劍</color>』與1張『<color=Keyword>黃金首飾</color>』到自己的手牌中。</ev>
""";
    }

}
