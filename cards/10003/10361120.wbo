wbo 0.1.0;

card 10361120 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "圣骑士团员";
        text """
【<color=Keyword>守护</color>】
本随从在战场上获得攻击力或生命值增加时，回复自己的主战者1点生命值。
""";
    }

    locale eng {
        name "Knight of the Holy Order";
        text """
<b><color=Keyword>Ward</color></b>
Whenever this follower is given + attack or defense on the field, restore 1 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"せいきし\">聖騎士</rub>の<rub=\"だんいん\">団員</rub>";
        text """
【<color=Keyword>守護</color>】
これの攻撃力か体力が場で+されたとき、自分のリーダーを1回復。
""";
    }

    locale kor {
        name "성기사 단원";
        text """
[<color=Keyword>수호</color>]
이 추종자의 공격력이나 체력이 전장에서 증가했을 때, 내 리더를 1 회복.
""";
    }

    locale cht {
        name "聖騎士的團員";
        text """
【<color=Keyword>守護</color>】
當這張卡片的攻擊力或生命值在戰場上因「+」而增加時，回復自己的主戰者1點生命值。
""";
    }

}
