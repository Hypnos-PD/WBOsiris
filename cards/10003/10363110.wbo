wbo 0.1.0;

card 10363110 {
    type follower;
    cost 5;
    stats 2/4;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            destroy target;
        }
        evolve {
            gain own crest 10363110;
        }
    }

    crest {
        countdown 4;

        when own turn ends if not own.attacked_this_turn {
            draw 1 from deck where type follower and life == 4;
        }

        locale chs {
            name "纹章：安息的团结者";
            text """
【<color=Keyword>吟唱</color>_4】
自己的回合结束时，若本回合中自己的随从没有进行过攻击，则抽取1张生命值为4的随从。
""";
        }

        locale eng {
            name "Crest: Reposing Solidarity";
            text """
<b><color=Keyword>Countdown</color> (4)</b>
At the end of your turn, if allied followers didn't attack this turn, draw a follower with 4 defense.
""";
        }

        locale jpn {
            name "クレスト：不殺の連帯者";
            text """
【<color=Keyword>カウントダウン</color>_4】
自分のターン終了時、このターン中に自分のフォロワーが攻撃していないなら、自分のデッキから体力4のフォロワー1枚を引く。
""";
        }

        locale kor {
            name "크레스트: 불살의 연대자";
            text """
[<color=Keyword>카운트다운</color> 4]
내 턴 종료시 이번 턴에 내 추종자가 공격하지 않았다면, 내 덱에서 체력이 4인 추종자 1장을 뽑는다.
""";
        }

        locale cht {
            name "紋章：安息的團結者";
            text """
【<color=Keyword>倒數</color>_4】
自己的回合結束時，如果本回合中自己的從者卡未進行攻擊，則會由自己的牌堆中抽取1張生命值為4的從者卡。
""";
        }
    }

    meta {
        pack 10003;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "安息的团结者";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。
<hr><ev>【<color=Keyword>进化时</color>】使自己获得『纹章：安息的团结者』。</ev>
""";
    }

    locale eng {
        name "Congregant of Repose";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it.
<hr><ev><b><color=Keyword>Evolve</color></b>: Gain <b><i>Crest: Congregant of Repose</i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"あんそく\">安息</rub>の<rub=\"だんけつしゃ\">団結者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。
<hr><ev>【<color=Keyword>進化時</color>】自分は『クレスト：安息の団結者』を持つ。</ev>
""";
    }

    locale kor {
        name "안식의 단결자";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.
<hr><ev>[<color=Keyword>진화시</color>] 나는 「크레스트: 안식의 단결자」를 갖는다.</ev>
""";
    }

    locale cht {
        name "安息的團結者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。
<hr><ev>【<color=Keyword>進化時</color>】使自己獲得『紋章：安息的團結者』。</ev>
""";
    }

}
