wbo 0.1.0;

card 10312210 {
    type amulet;
    cost 3;

    effect {
        fanfare {
            choose target from own.hand;
            discard target;
            draw 2;
        }
        engage 0 {
            destroy self;
            choose victim from oppo.field.followers;
            buff victim +0/-2;
        }
    }

    meta {
        pack 10003;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "不弑之乡";
        text """
【<color=Keyword>入场曲</color>】选择自己的1张手牌，舍弃该手牌。抽取2张卡牌。
<hr>【<color=Keyword>启动</color>】破坏本卡牌。选择对手的战场上的1个随从，使其-0/-2。
""";
    }

    locale eng {
        name "Hamlet of Unkilling";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a card in your hand and discard it. Draw 2 cards.
<hr><b><color=Keyword>Engage</color></b>: Destroy this card. Select an enemy follower on the field and give it -0/-2.
""";
    }

    locale jpn {
        name "<rub=\"ふさつ\">不殺</rub>の<rub=\"さと\">里</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札1枚を選ぶ。それを捨てる。自分のデッキから2枚を引く。
<hr>【<color=Keyword>アクト</color>】これを破壊。相手の場のフォロワー1枚を選ぶ。それは-0/-2する。
""";
    }

    locale kor {
        name "불살의 마을";
        text """
[<color=Keyword>출격</color>] 내 패에서 1장을 선택한다. 그 카드를 버린다. 내 덱에서 2장을 뽑는다.
<hr>[<color=Keyword>활성화</color>] 이 마법진을 파괴. 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 -0/-2.
""";
    }

    locale cht {
        name "不弒之鄉";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中的卡片。將其捨棄。由自己的牌堆中抽取2張卡片。
<hr>【<color=Keyword>策動</color>】破壞這張卡片。指定1張敵方戰場上的從者卡。使其-0/-2。
""";
    }

}
