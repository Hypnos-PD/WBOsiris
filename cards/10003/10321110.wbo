wbo 0.1.0;

card 10321110 {
    type follower;
    cost 2;
    stats 2/1;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "篡夺的肯定者";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>黄金之靴</color>』加入手牌。
<hr>【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>黄金之杯</color>』加入手牌。
""";
    }

    locale eng {
        name "Devotee of Usurpation";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gilded Boots</color></i></b> to your hand.
<hr><b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Gilded Goblet</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"さんだつ\">簒奪</rub>の<rub=\"こうていしゃ\">肯定者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>黄金の靴</color>』1枚を自分の手札に加える。
<hr>【<color=Keyword>ラストワード</color>】『<color=Keyword>黄金の杯</color>』1枚を自分の手札に加える。
""";
    }

    locale kor {
        name "약탈의 긍정자";
        text """
[<color=Keyword>출격</color>] <color=Keyword>황금 신발</color> 1장을 내 패에 넣는다.
<hr>[<color=Keyword>유언</color>] <color=Keyword>황금 잔</color> 1장을 내 패에 넣는다.
""";
    }

    locale cht {
        name "篡奪的肯定者";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>黃金之靴</color>』到自己的手牌中。
<hr>【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>黃金之杯</color>』到自己的手牌中。
""";
    }

}
