wbo 0.1.0;

card 10302110 {
    type follower;
    cost 2;
    stats 1/3;

    effect {
        ward;
        when oppo follower super_evolved while self in hand {
            add bane to self;
        }
    }

    meta {
        pack 10003;
        class neutral;
        rarity silver;
    }

    locale chs {
        name "抗拒叹息之人";
        text """
在手牌中发动。对手的随从超进化时，本随从获得【<color=Keyword>毁灭</color>】。
<hr>【<color=Keyword>守护</color>】
""";
    }

    locale eng {
        name "Inspirational One";
        text """
Activates in hand. When an enemy follower super-evolves, give this follower <b><color=Keyword>Bane</color></b>.
<hr><b><color=Keyword>Ward</color></b>
""";
    }

    locale jpn {
        name "<rub=\"なげ\">嘆</rub>きに<rub=\"た\">立</rub>ちし<rub=\"もの\">者</rub>";
        text """
手札で働く。相手のフォロワーが超進化したとき、これは【<color=Keyword>必殺</color>】を持つ。
<hr>【<color=Keyword>守護</color>】
""";
    }

    locale kor {
        name "비탄에 맞서는 자";
        text """
패에서 발동. 상대방 추종자가 초진화했을 때, 이 추종자는 [<color=Keyword>필살</color>]을 갖는다.
<hr>[<color=Keyword>수호</color>]
""";
    }

    locale cht {
        name "力抗悲嘆的少年";
        text """
於手牌中發動。當敵方的從者卡超進化時，使這張卡片獲得【<color=Keyword>必殺</color>】。
<hr>【<color=Keyword>守護</color>】
""";
    }

}
