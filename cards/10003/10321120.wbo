wbo 0.1.0;

card 10321120 {
    type follower;
    cost 6;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "剑圣的同胞";
        text """
【<color=Keyword>谢幕曲</color>】召唤1个『<color=Keyword>剑圣的同胞</color>』，使其失去【<color=Keyword>谢幕曲</color>】。
""";
    }

    locale eng {
        name "Comrade of the Swordmaster";
        text """
<b><color=Keyword>Last Words</color></b>: Summon a <b><i><color=Keyword>Comrade of the Swordmaster</color></i></b> and remove <b><color=Keyword>Last Words</color></b> from it.
""";
    }

    locale jpn {
        name "<rub=\"けんせい\">剣聖</rub>の<rub=\"どうほう\">同胞</rub>";
        text """
【<color=Keyword>ラストワード</color>】『<color=Keyword>剣聖の同胞</color>』1枚を自分の場に出す。それは【<color=Keyword>ラストワード</color>】を失う。
""";
    }

    locale kor {
        name "검성의 동포";
        text """
[<color=Keyword>유언</color>] <color=Keyword>검성의 동포</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>유언</color>]을 잃는다.
""";
    }

    locale cht {
        name "劍聖的同胞";
        text """
【<color=Keyword>謝幕曲</color>】召喚1張『<color=Keyword>劍聖的同胞</color>』到自己的戰場上。使其失去【<color=Keyword>謝幕曲</color>】。
""";
    }

}
