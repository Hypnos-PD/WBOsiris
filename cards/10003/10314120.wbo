wbo 0.1.0;

card 10314120 {
    type follower;
    cost 8;
    stats 6/6;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            buff target +0/-6;
        }
        evolve {
            add 1 card 90014320 to hand;
        }
    }

    meta {
        pack 10003;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "绝命的显现·艾斯迪亚";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其-0/-6。
<hr><ev>【<color=Keyword>进化时</color>】将1张『<color=Keyword>绝命的痛击</color>』加入手牌。</ev>
""";
    }

    locale eng {
        name "Izudia, Annihilation Manifest";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and give it -0/-6.
<hr><ev><b><color=Keyword>Evolve</color></b>: Add an <b><i><color=Keyword>Annihilating Onslaught</color></i></b> to your hand.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ぜつめい\">絶命</rub>の<rub=\"けんげん\">顕現</rub>・エズディア";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それは-0/-6する。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>絶命の痛撃</color>』1枚を自分の手札に加える。</ev>
""";
    }

    locale kor {
        name "절명의 현현 에즈디아";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 -0/-6.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>절명의 통격</color> 1장을 내 패에 넣는다.</ev>
""";
    }

    locale cht {
        name "絕命的顯現‧艾茲迪亞";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其-0/-6。
<hr><ev>【<color=Keyword>進化時</color>】增加1張『<color=Keyword>絕命的痛擊</color>』到自己的手牌中。</ev>
""";
    }

}
