wbo 0.1.0;

card 10353310 {
    type spell;
    cost 3;

    effect {
        mode 2 {
            option 1 {
                label chs "回复自己1点能量点。";
                label eng "Restore 1 play point.";
                label jpn "自分のPPを1回復。";
                label kor "내 PP를 1 회복.";
                label cht "回復自己1點能量點。";
                gain own.pp 1;
            }
            option 2 {
                label chs "抽取1张随从。";
                label eng "Draw a follower.";
                label jpn "自分のデッキからフォロワー1枚を引く。";
                label kor "내 덱에서 추종자 1장을 뽑는다.";
                label cht "抽取1張從者卡。";
                draw 1 from deck where type follower;
            }
            option 3 {
                label chs "抽取1张费用为3的法术。";
                label eng "Draw a spell that costs 3.";
                label jpn "自分のデッキからコスト3のスペル1枚を引く。";
                label kor "내 덱에서 비용 3인 주문 1장을 뽑는다.";
                label cht "抽取1張消費為3的法術卡。";
                draw 1 from deck where type spell and cost == 3;
            }
            option 4 {
                label chs "对对手的战场上的随机1个随从造成4点伤害。";
                label eng "Deal 4 damage to a random enemy follower.";
                label jpn "相手の場のフォロワーからランダム1枚に4ダメージ。";
                label kor "상대방 전장의 추종자 하나를 무작위로 4 피해.";
                label cht "給予敵方戰場上的隨機1張從者卡4點傷害。";
                random victim from oppo.field.followers;
                damage victim 4;
            }
        }
    }

    meta {
        pack 10003;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "叫唤与憎恶";
        text """
【<color=Keyword>模式</color>】选择2个能力发动。
<ridx=0>（1）回复自己1点能量点。</ridx>
<ridx=1>（2）抽取1张随从。</ridx>
<ridx=2>（3）抽取1张费用为3的法术。</ridx>
<ridx=3>（4）对对手的战场上的随机1个随从造成4点伤害。</ridx>
""";
    }

    locale eng {
        name "Screaming and Loathing";
        text """
Select 2 <b><color=Keyword>Mode</color><color=Keyword>s</color></b> to activate.
<ridx=0>1. Recover 1 play point.</ridx>
<ridx=1>2. Draw a follower.</ridx>
<ridx=2>3. Draw a 3-cost spell.</ridx>
<ridx=3>4. Deal 4 damage to a random enemy follower.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"きょうかん\">叫喚</rub>と<rub=\"ぞうお\">憎悪</rub>";
        text """
【<color=Keyword>モード</color>】2つを選んでその能力が働く。
<ridx=0>（1）自分のPPを1回復。</ridx>
<ridx=1>（2）自分のデッキからフォロワー1枚を引く。</ridx>
<ridx=2>（3）自分のデッキからコスト3のスペル1枚を引く。</ridx>
<ridx=3>（4）相手の場のフォロワーからランダム1枚に4ダメージ。</ridx>
""";
    }

    locale kor {
        name "규환과 증오";
        text """
[<color=Keyword>모드</color>] 2개를 선택하여 그 능력을 발동.
<ridx=0>(1) 내 PP를 1 회복.</ridx>
<ridx=1>(2) 내 덱에서 추종자 1장을 뽑는다.</ridx>
<ridx=2>(3) 내 덱에서 비용이 3인 주문 1장을 뽑는다.</ridx>
<ridx=3>(4) 상대방 전장의 추종자 중 무작위로 1장에게 4 피해.</ridx>
""";
    }

    locale cht {
        name "叫喚與憎惡";
        text """
指定2個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）回復自己的PP 1點。</ridx>
<ridx=1>（2）由自己的牌堆中抽取1張從者卡。</ridx>
<ridx=2>（3）由自己的牌堆中抽取1張消費為3的法術卡。</ridx>
<ridx=3>（4）隨機給予1張敵方戰場上的從者卡4點傷害。</ridx>
""";
    }

}
