wbo 0.1.0;

card 10331310 {
    type spell;
    cost 4;

    effect {
        gain own crest 10331310;
    }

    crest {
        countdown 2;

        lastwords {
            draw 2;
            damage oppo.field.followers 4;
        }

        locale chs {
            name "纹章：水晶的指引";
            text """
【<color=Keyword>吟唱</color>_2】
【<color=Keyword>谢幕曲</color>】抽取2张卡牌。对对手的战场上的所有随从造成4点伤害。
""";
        }

        locale eng {
            name "Crest: Crystal's Guidance";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
<b><color=Keyword>Last Words</color></b>: Draw 2 cards. Deal 4 damage to all enemy followers.
""";
        }

        locale jpn {
            name "クレスト：クリスタルガイダンス";
            text """
【<color=Keyword>カウントダウン</color>_2】
【<color=Keyword>ラストワード</color>】自分のデッキから2枚を引く。相手の場のフォロワーすべてに4ダメージ。
""";
        }

        locale kor {
            name "크레스트: 크리스탈 가이던스";
            text """
[<color=Keyword>카운트다운</color> 2]
[<color=Keyword>유언</color>] 내 덱에서 2장을 뽑는다. 상대방 전장의 추종자 모두에게 4 피해.
""";
        }

        locale cht {
            name "紋章：水晶的指引";
            text """
【<color=Keyword>倒數</color>_2】
【<color=Keyword>謝幕曲</color>】由自己的牌堆中抽取2張卡片。給予敵方戰場上全部的從者卡4點傷害。
""";
        }
    }

    meta {
        pack 10003;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "水晶的指引";
        text """
使自己获得『纹章：水晶的指引』。
""";
    }

    locale eng {
        name "Crystal Gazing";
        text """
Gain <b><i>Crest: Crystal Gazing</i></b>.
""";
    }

    locale jpn {
        name "クリスタルゲイジング";
        text """
自分は『クレスト：クリスタルゲイジング』を持つ。
""";
    }

    locale kor {
        name "크리스탈 게이징";
        text """
나는 「크레스트: 크리스탈 게이징」을 갖는다.
""";
    }

    locale cht {
        name "水晶的預視";
        text """
使自己獲得『紋章：水晶的預視』。
""";
    }

}
