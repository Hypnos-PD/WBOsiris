wbo 0.1.0;

card 10373110 {
    type follower;
    cost 6;
    stats 3/3;

    effect {
        unplayable;
    }

    meta {
        pack 10003;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "破坏的团结者";
        text """
【<color=Keyword>入场曲</color>】破坏对手的战场上的随机X个随从。X为自己的战场上的其他卡牌张数。破坏自己的战场上的其他所有卡牌。
""";
    }

    locale eng {
        name "Congregant of Destruction";
        text """
<b><color=Keyword>Fanfare</color></b>: Destroy X random enemy followers. X is the number of other allied cards on the field. Destroy all other allied cards on the field.
""";
    }

    locale jpn {
        name "<rub=\"はかい\">破壊</rub>の<rub=\"だんけつしゃ\">団結者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーからランダムX枚を破壊。Xは自分の場の他のカードの枚数である。自分の場の他のカードすべてを破壊。
""";
    }

    locale kor {
        name "파괴의 단결자";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 중 무작위로 X장을 파괴. X는 내 전장의 다른 카드 수. 내 전장의 다른 카드 모두를 파괴.
""";
    }

    locale cht {
        name "破壞的團結者";
        text """
【<color=Keyword>入場曲</color>】隨機破壞X張敵方戰場上的從者卡。X為「自己戰場上其他卡片的張數」。破壞自己戰場上全部的其他卡片。
""";
    }

}
