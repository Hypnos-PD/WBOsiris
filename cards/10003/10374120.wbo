wbo 0.1.0;

card 10374120 {
    type follower;
    cost 4;
    stats 2/4;

    effect {
        fanfare {
            add 1 card 90074310 to hand;
        }
        ability_destruction_guard;
        evolve {
            summon 1 card 90074210;
        }
    }

    meta {
        pack 10003;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "奏绝的显现·莉洁纳";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>奏绝的独唱</color>』加入手牌。
<hr>不会被能力破坏。
<hr><ev>【<color=Keyword>进化时</color>】召唤1张『<color=Keyword>新约·白之章</color>』。</ev>
""";
    }

    locale eng {
        name "Lishenna, Melody Manifest";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Melodious Monody</color></i></b> to your hand.
<hr>Can't be destroyed by abilities.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>White Psalm, New Revelation</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"そうぜつ\">奏絶</rub>の<rub=\"けんげん\">顕現</rub>・リーシェナ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>奏絶の独唱</color>』1枚を自分の手札に加える。
<hr>能力によって破壊できない。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>新約・白の章</color>』1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "종연의 현현 리셰나";
        text """
[<color=Keyword>출격</color>] <color=Keyword>종연의 독창</color> 1장을 내 패에 넣는다.
<hr>능력에 의해 파괴되지 않는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>신약 백의 노래</color> 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "奏絕的顯現‧里榭娜";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>奏絕的獨唱</color>』到自己的手牌中。
<hr>無法被能力破壞。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>新約‧白之章</color>』到自己的戰場上。</ev>
""";
    }

}
