wbo 0.1.0;

card 10341120 {
    type follower;
    cost 6;
    stats 6/6;

    effect {
        fanfare {
            destroy oppo.field.followers where damaged;
        }
    }

    meta {
        pack 10003;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "风雪龙人";
        text """
【<color=Keyword>入场曲</color>】破坏对手的战场上的所有受伤的随从。
""";
    }

    locale eng {
        name "Snowstorm Dragonewt";
        text """
<b><color=Keyword>Fanfare</color></b>: Destroy all damaged enemy followers.
""";
    }

    locale jpn {
        name "<rub=\"ふぶき\">吹雪</rub>のドラゴニュート";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のダメージを受けているフォロワーすべてを破壊。
""";
    }

    locale kor {
        name "눈보라의 드래고뉴트";
        text """
[<color=Keyword>출격</color>] 피해를 받은 상태인 상대방 전장의 추종자 모두를 파괴.
""";
    }

    locale cht {
        name "舞冰的龍人";
        text """
【<color=Keyword>入場曲</color>】破壞敵方戰場上已受到傷害的全部從者卡。
""";
    }

}
