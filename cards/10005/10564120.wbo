wbo 0.1.0;

card 10564120 {
    type follower;
    cost 7;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10005;
        class havencraft;
        rarity legendary;
    }

    locale chs {
        name "雾卷花·茎白";
        text """
【<color=Keyword>入场曲</color>】使自己获得『纹章：雾卷花·茎白』。使自己的随机2张手牌返回牌组。抽取2张卡牌。
<hr>【<color=Keyword>突进</color>】
""";
    }

    locale eng {
        name "Kukishiro, Mistbloom";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain <b><i>Crest: Kukishiro, Mistbloom</i></b>. Return 2 random cards from your hand to deck. Draw 2 cards.
<hr><b><color=Keyword>Rush</color></b>
""";
    }

    locale jpn {
        name "<rub=\"きりまきばな\">霧巻花</rub>・クキシロ";
        text """
【<color=Keyword>ファンファーレ</color>】自分は『クレスト：霧巻花・クキシロ』を持つ。自分の手札からランダム2枚をデッキに戻す。自分のデッキから2枚を引く。
<hr>【<color=Keyword>突進</color>】
""";
    }

    locale kor {
        name "무권화 쿠키시로";
        text """
[<color=Keyword>출격</color>] 나는 「크레스트: 무권화 쿠키시로」를 갖는다. 내 패에서 무작위로 2장을 덱으로 되돌린다. 내 덱에서 2장을 뽑는다.
<hr>[<color=Keyword>돌진</color>]
""";
    }

    locale cht {
        name "霧卷花‧九喜代";
        text """
【<color=Keyword>入場曲</color>】使自己獲得『紋章：霧卷花‧九喜代』。隨機使2張自己手牌中的卡片返回牌堆中。由自己的牌堆中抽取2張卡片。
<hr>【<color=Keyword>突進</color>】
""";
    }

}
