wbo 0.1.0;

card 10563210 {
    type amulet;
    cost 3;

    effect {
        unplayable;
    }

    meta {
        pack 10005;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "坚固的雾卷花";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成5点伤害。
<hr>【<color=Keyword>启动</color>】破坏本卡牌。使自己的随机2张手牌返回牌组。抽取2张卡牌。
""";
    }

    locale eng {
        name "Resolve of the Mistbloom";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 5 damage.
<hr><b><color=Keyword>Engage</color></b>: Destroy this card. Return 2 random cards from your hand to deck. Draw 2 cards.
""";
    }

    locale jpn {
        name "<rub=\"けんご\">堅固</rub>なる<rub=\"きりまきばな\">霧巻花</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに5ダメージ。
<hr>【<color=Keyword>アクト</color>】これを破壊。自分の手札からランダム2枚をデッキに戻す。自分のデッキから2枚を引く。
""";
    }

    locale kor {
        name "견고한 무권화";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해.
<hr>[<color=Keyword>활성화</color>] 이 마법진을 파괴. 내 패에서 무작위로 2장을 덱으로 되돌린다. 내 덱에서 2장을 뽑는다.
""";
    }

    locale cht {
        name "堅牢的霧卷花";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其5點傷害。
<hr>【<color=Keyword>策動</color>】破壞這張卡片。隨機使2張自己手牌中的卡片返回牌堆中。由自己的牌堆中抽取2張卡片。
""";
    }

}
