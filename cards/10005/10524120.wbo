wbo 0.1.0;

card 10524120 {
    type follower;
    cost 5;
    stats 2/4;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            banish target;
            add 1 card 90021350 to hand;
        }
        superevolve {
            gain own crest 10524120;
        }
    }

    crest {
        countdown 4;

        when own turn ends {
            add 1 card 90021350 to hand;
        }

        locale chs {
            name "纹章：丽金花·云庆";
            text """
【<color=Keyword>吟唱</color>_4】
自己的回合结束时，将1张『<color=Keyword>闪耀的金币</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Goldflower, Cloud Celebrant";
            text """
<b><color=Keyword>Countdown</color> (4)</b>
At the end of your turn, add a <b><i><color=Keyword>Glittering Gold</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"れいきんか\">麗金花</rub>・うんけい";
            text """
【<color=Keyword>カウントダウン</color>_4】
自分のターン終了時、『<color=Keyword>きらめく金貨</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 여금화·운경";
            text """
[<color=Keyword>카운트다운</color> 4]
내 턴 종료시, 「<color=Keyword>빛나는 금화</color>」 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：麗金花‧雲慶";
            text """
【<color=Keyword>倒數</color>_4】
自己的回合結束時，增加1張『<color=Keyword>閃耀的金幣</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10005;
        class swordcraft;
        rarity legendary;
    }

    locale chs {
        name "丽金花·云庆";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其消失。将1张『<color=Keyword>闪耀的金币</color>』加入自己的手牌。
<hr><sev>【<color=Keyword>超进化时</color>】使自己获得『纹章：丽金花·云庆』。</sev>
""";
    }

    locale eng {
        name "Unkei, Goldbloom";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and banish it. Add a <b><i><color=Keyword>Glittering Gold</color></i></b> to your hand.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Gain <b><i>Crest: Unkei, Goldbloom</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"うらかねばな\">麗金花</rub>・ウンケイ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを消滅。『<color=Keyword>輝く金貨</color>』1枚を自分の手札に加える。
<hr><sev>【<color=Keyword>超進化時</color>】自分は『クレスト：麗金花・ウンケイ』を持つ。</sev>
""";
    }

    locale kor {
        name "여금화 운케이";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 소멸. <color=Keyword>찬란한 금화</color> 1장을 내 패에 넣는다.
<hr><sev>[<color=Keyword>초진화시</color>] 나는 「크레스트: 여금화 운케이」를 갖는다.</sev>
""";
    }

    locale cht {
        name "麗金花‧雲惠";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其消失。增加1張『<color=Keyword>閃耀的金幣</color>』到自己的手牌中。
<hr><sev>【<color=Keyword>超進化時</color>】使自己獲得『紋章：麗金花‧雲惠』。</sev>
""";
    }

}
