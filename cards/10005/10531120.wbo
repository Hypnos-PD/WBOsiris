wbo 0.1.0;

card 10531120 {
    type follower;
    cost 6;
    stats 3/3;

    effect {
        fanfare {
            repeat 3 {
                random victim from oppo.field.followers;
                damage victim 3;
            }
            spellboost own.hand 3;
        }
    }

    meta {
        pack 10005;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "流动控符师";
        text """
【<color=Keyword>入场曲</color>】对对手的战场上的随机3个随从造成3点伤害。使自己的所有手牌发动3次魔力增幅。
""";
    }

    locale eng {
        name "Waterbending Charmwielder";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 3 damage to 3 random enemy followers. Spellboost your hand 3 times.
""";
    }

    locale jpn {
        name "<rub=\"りゅうどう\">流動</rub>の<rub=\"ふそうし\">符操師</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーからランダム3枚に3ダメージ。自分の手札すべては3回スペルブーストする。
""";
    }

    locale kor {
        name "유동의 부적술사";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 중 무작위로 3장에게 3 피해. 내 패 모두를 3회 주문증폭.
""";
    }

    locale cht {
        name "流動的操符師";
        text """
【<color=Keyword>入場曲</color>】隨機給予3張敵方戰場上的從者卡3點傷害。使自己手牌中全部的卡片發動3次魔力增幅。
""";
    }

}
