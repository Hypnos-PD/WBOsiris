wbo 0.1.0;

card 10564110 {
    type follower;
    cost 4;
    stats 2/2;

    effect {
        ward;
        fanfare {
            mode {
                option 1 {
                    label chs "本随从进化。";
                    label eng "Evolve this follower.";
                    label jpn "これは進化する。";
                    label kor "이 추종자는 진화한다.";
                    label cht "使這張卡片進化。";
                    evolve self silent;
                }
                option 2 {
                    label chs "使自己的战场上的随机1个「拥有【守护】的进化前的其他随从」进化，使其+1/+1。";
                    label eng "Evolve a random other unevolved allied follower with Ward and give it +1/+1.";
                    label jpn "自分の場の「守護を持つ進化前の他のフォロワー」からランダム1枚は進化し、+1/+1する。";
                    label kor "내 전장의 「수호를 가진 진화 전의 다른 추종자」 중 무작위로 1장은 진화하고 +1/+1.";
                    label cht "隨機使1張自己戰場上「擁有【守護】且為進化前的其他從者卡」進化，並使其+1/+1。";
                    random ally from own.field.followers other where form unevolved and keyword ward;
                    evolve ally silent;
                    buff ally +1/+1;
                }
            }
        }
        when own turn ends if self form evolved {
            buff field.followers other -1/-1;
        }
    }

    meta {
        pack 10005;
        class havencraft;
        rarity legendary;
    }

    locale chs {
        name "思念的《力量》·索菲娜";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）本随从进化。</ridx>
<ridx=1>（2）使自己的战场上的随机1个「拥有【<color=Keyword>守护</color>】的进化前的其他随从」进化，使其+1/+1。</ridx>
<hr>【<color=Keyword>守护</color>】
自己的回合结束时，若本随从为进化后，则使战场上的其他所有随从-1/-1。
""";
    }

    locale eng {
        name "Sofina, Inspiring Strength";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Evolve this follower.</ridx>
<ridx=1>2. Evolve another random unevolved allied follower with <b><color=Keyword>Ward</color></b> and give it +1/+1.</ridx>
<hr><b><color=Keyword>Ward</color></b>
At the end of your turn, if this follower is evolved, give all other followers on the field -1/-1.
""";
    }

    locale jpn {
        name "<rub=\"おも\">想</rub>う《<rub=\"ちから\">力</rub>》・ソフィーナ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）これは進化する。</ridx>
<ridx=1>（2）自分の場の他の「【<color=Keyword>守護</color>】を持つ、進化前のフォロワー」からランダム1枚は進化する。それは+1/+1する。</ridx>
<hr>【<color=Keyword>守護</color>】
自分のターン終了時、これが進化後なら、場の他のフォロワーすべては-1/-1する。
""";
    }

    locale kor {
        name "생각하는 《힘》 소피나";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 이 추종자는 진화한다.</ridx>
<ridx=1>(2) [<color=Keyword>수호</color>]를 가진 내 전장의 진화전인 다른 추종자 중 무작위로 1장은 진화한다. 그 추종자는 +1/+1.</ridx>
<hr>[<color=Keyword>수호</color>]
내 턴 종료시 이 추종자가 진화후라면, 전장의 다른 추종자 모두는 -1/-1.
""";
    }

    locale cht {
        name "信念《力量》‧索菲娜";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）使這張卡片進化。</ridx>
<ridx=1>（2）隨機使1張自己戰場上其他「擁有【<color=Keyword>守護</color>】且為進化前的從者卡」進化。使其+1/+1。</ridx>
<hr>【<color=Keyword>守護</color>】
自己的回合結束時，如果這張卡片已進化，則會使戰場上全部的其他從者卡-1/-1。
""";
    }

}
