wbo 0.1.0;

card 10572110 {
    type follower;
    cost 4;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10005;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "新时代地理学者";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>毁灭创造物β</color>』加入手牌。
<hr><sev>【<color=Keyword>超进化时</color>】选择自己的手牌中的1张费用为5或以下的创造物·随从，召唤对应数量的复制随从。</sev>
""";
    }

    locale eng {
        name "New-Age Cartographer";
        text """
<b><color=Keyword>Fanfare</color></b>: Add an <b><i><color=Keyword>Ominous Artifact β</color></i></b> to your hand.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Select an Artifact follower in your hand that costs 5 or less and summon an exact copy of it.</sev>
""";
    }

    locale jpn {
        name "ネオジオグラファー";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>デストロイアーティファクトβ</color>』1枚を自分の手札に加える。
<hr><sev>【<color=Keyword>超進化時</color>】自分の手札のコスト5以下のアーティファクト・フォロワー1枚を選ぶ。それのコピー1枚を自分の場に出す。</sev>
""";
    }

    locale kor {
        name "네오 지오그래퍼";
        text """
[<color=Keyword>출격</color>] <color=Keyword>디스트로이 아티팩트 베타</color> 1장을 내 패에 넣는다.
<hr><sev>[<color=Keyword>초진화시</color>] 내 패에서 비용이 5 이하인 아티팩트 추종자 1장을 선택한다. 그 추종자의 복사본 1장을 내 전장에 소환.</sev>
""";
    }

    locale cht {
        name "次世代地理學家";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>破滅的創造物β</color>』到自己的手牌中。
<hr><sev>【<color=Keyword>超進化時</color>】指定1張自己手牌中消費為5以下的創造物‧從者卡。將其複製1張並召喚到自己的戰場上。</sev>
""";
    }

}
