wbo 0.1.0;

card 10501110 {
    type follower;
    cost 1;
    stats 1/1;

    effect {
        fanfare {
            if count(field other where base.cost == 1) >= 1 {
                buff self +1/+1;
            }
        }
    }

    meta {
        pack 10005;
        class neutral;
        rarity bronze;
    }

    locale chs {
        name "挥毫的怪物";
        text """
【<color=Keyword>入场曲</color>】若战场上有其他原始费用为1的卡牌，则本随从+1/+1。
""";
    }

    locale eng {
        name "Monster Litterateur";
        text """
<b><color=Keyword>Fanfare</color></b>: If there's another 1-base-cost card on the field, give this follower +1/+1.
""";
    }

    locale jpn {
        name "<rub=\"たっぴつ\">達筆</rub>の<rub=\"かいい\">怪異</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】場に他の元のコスト1のカードがあるなら、これは+1/+1する。
""";
    }

    locale kor {
        name "달필의 괴이";
        text """
[<color=Keyword>출격</color>] 전장에 원래 비용이 1인 다른 카드가 있다면, 이 추종자는 +1/+1.
""";
    }

    locale cht {
        name "妙筆精怪";
        text """
【<color=Keyword>入場曲</color>】如果戰場上有其他原始消費為1的卡片，則會使這張卡片+1/+1。
""";
    }

}
