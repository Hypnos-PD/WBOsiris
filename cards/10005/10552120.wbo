wbo 0.1.0;

card 10552120 {
    type follower;
    cost 5;
    stats 3/5;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            add cannot_attack to target until oppo turn ends;
            draw 1;
        }
        evolve {
            choose target from oppo.field.followers;
            add cannot_attack to target until oppo turn ends;
            draw 1;
        }
    }

    meta {
        pack 10005;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "牵线搭桥的青鬼";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对手的回合结束前，使其获得「无法攻击随从或主战者」。抽取1张卡牌。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Friendly Blue Ogre";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and give it \"Can't attack followers or leaders\" until the end of your opponent's turn. Draw a card.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"はしわた\">橋渡</rub>しの<rub=\"あおおに\">青鬼</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。相手のターン終了まで、それは「フォロワーやリーダーを攻撃できない。」を持つ。自分のデッキから1枚を引く。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "다리를 잇는 청귀";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 상대방 턴 종료까지 그 추종자는 「추종자나 리더 공격 불가」를 갖는다. 내 덱에서 1장을 뽑는다.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "引橋的青鬼";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。到敵方的回合結束為止，使其獲得「無法攻擊從者或主戰者」。由自己的牌堆中抽取1張卡片。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
