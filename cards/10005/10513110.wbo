wbo 0.1.0;

card 10513110 {
    type follower;
    cost 5;
    stats 4/3;

    effect {
        fanfare {
            summon 3 card 90011110;
        }
        evolve {
            summon 3 card 90011110;
        }
        superevolve {
            add bane to own.field.followers where trait pixie;
        }
    }

    meta {
        pack 10005;
        class forestcraft;
        rarity gold;
    }

    locale chs {
        name "引路船工";
        text """
【<color=Keyword>入场曲</color>】召唤3个『<color=Keyword>妖精</color>』。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
<sev>【<color=Keyword>超进化时</color>】使自己的战场上的所有妖精·随从获得【<color=Keyword>毁灭</color>】。</sev>
""";
    }

    locale eng {
        name "Spirited Skipper";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 3 copies of <b><i><color=Keyword>Fairy</color></i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
<sev><b><color=Keyword>Super-Evolve</color></b>: Give all allied Pixie followers on the field <b><color=Keyword>Bane</color></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"みちび\">導</rub>きの<rub=\"せんどう\">船頭</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フェアリー</color>』3枚を自分の場に出す。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
<sev>【<color=Keyword>超進化時</color>】自分の場の妖精・フォロワーすべては【<color=Keyword>必殺</color>】を持つ。</sev>
""";
    }

    locale kor {
        name "인도하는 선원";
        text """
[<color=Keyword>출격</color>] <color=Keyword>요정</color> 3장을 내 전장에 소환.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
<sev>[<color=Keyword>초진화시</color>] 내 전장의 요정 추종자 모두는 [<color=Keyword>필살</color>]을 갖는다.</sev>
""";
    }

    locale cht {
        name "引導的船孃";
        text """
【<color=Keyword>入場曲</color>】召喚3張『<color=Keyword>妖精</color>』到自己的戰場上。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
<sev>【<color=Keyword>超進化時</color>】使自己戰場上全部的妖精‧從者卡獲得【<color=Keyword>必殺</color>】。</sev>
""";
    }

}
