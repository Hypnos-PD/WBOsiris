wbo 0.1.0;

card 10541110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        evolve {
            choose target from oppo.field.followers;
            damage target 5;
        }
        superevolve replaces evolve {
            choose targets from oppo.field.followers count 2;
            damage targets 5;
        }
    }

    meta {
        pack 10005;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "涌泉打水人";
        text """
<ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成5点伤害。</ev>
<sev>【<color=Keyword>超进化时</color>】改为选择2个随从。</sev>
""";
    }

    locale eng {
        name "Springwell Steward";
        text """
<ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 5 damage.</ev>
<sev><b><color=Keyword>Super-Evolve</color></b>: Select 2 instead.</sev>
""";
    }

    locale jpn {
        name "<rub=\"ゆうすい\">湧水</rub>の<rub=\"く\">汲</rub>み<rub=\"て\">手</rub>";
        text """
<ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに5ダメージ。</ev>
<sev>【<color=Keyword>超進化時</color>】1枚ではなく2枚。</sev>
""";
    }

    locale kor {
        name "용천을 긷는 자";
        text """
<ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해.</ev>
<sev>[<color=Keyword>초진화시</color>] 1장 대신 2장.</sev>
""";
    }

    locale cht {
        name "湧水的汲取者";
        text """
<ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其5點傷害。</ev>
<sev>【<color=Keyword>超進化時</color>】由原本的1張轉變為2張。</sev>
""";
    }

}
