wbo 0.1.0;

card 10554110 {
    type follower;
    cost 7;
    stats 3/3;

    effect {
        fanfare {
            // 【亡者召还_4】与【亡者召还_2】各发动一次。
            reanimate 4;
            reanimate 2;
        }
        // 本随从进化时（含超进化与效果引起的进化）：破坏战场上的随机 6 个其他随从。
        when self evolved {
            random victims from field.followers other count 6;
            destroy victims;
        }
        superevolve {
            gain own crest 10554110;
        }
    }

    crest {
        passive suppress_fanfare;
        passive suppress_enhance;

        // "自己使用的随从入场时进化"（效果引起的进化，不发动进化时能力）。
        when own card played where type follower {
            evolve played silent;
        }

        locale chs {
            name "纹章：充实的《恋人与节制》·米路缇欧&卢泽";
            text """
自己的随从的【<color=Keyword>入场曲</color>】与【<color=Keyword>爆能强化</color>】不发动。
自己使用的随从进入战场时，使其进化。
""";
        }

        locale eng {
            name "Crest: Milteo & Luzen, Contentment";
            text """
Allied followers' <b><color=Keyword>Fanfare</color></b> and <b><color=Keyword>Enhance</color></b> effects do not activate.
When you play a follower, evolve it.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"み\">充</rub>つ《<rub=\"こいびと\">恋人</rub>と<rub=\"せっせい\">節制</rub>》・ミルティオ＆ルーゼン";
            text """
自分のフォロワーの【<color=Keyword>ファンファーレ</color>】と【<color=Keyword>エンハンス</color>】は働かない。
自分のフォロワーが場に出たとき、それは進化する。
""";
        }

        locale kor {
            name "크레스트: 충만한 《연인과 절제》 밀티오&루젠";
            text """
내 추종자의 [<color=Keyword>출격</color>]과 [<color=Keyword>강화</color>]는 발동하지 않는다.
내 추종자가 전장에 나올 때, 그 추종자는 진화한다.
""";
        }

        locale cht {
            name "紋章：充實的《戀人與節制》‧米路緹歐＆盧澤";
            text """
自己的從者的【<color=Keyword>入場曲</color>】與【<color=Keyword>爆能強化</color>】不會發動。
自己使用的從者進入戰場時，使其進化。
""";
        }
    }

    meta {
        pack 10005;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "充实的《恋人与节制》·米路缇欧&卢泽";
        text """
【<color=Keyword>入场曲</color>】发动【<color=Keyword>亡者召还</color>_4】和【<color=Keyword>亡者召还</color>_2】。
<hr><ev>本随从进化时，破坏战场上的随机6个其他随从。</ev>
<sev>本随从超进化时，使自己获得『纹章：充实的《恋人与节制》·米路缇欧&卢泽』。</sev>
""";
    }

    locale eng {
        name "Milteo & Luzen";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Reanimate</color> (4)</b> and <b><color=Keyword>Reanimate</color> (2)</b>.
<hr><ev>When this follower evolves, destroy 6 other random followers.</ev>
<sev>When this follower super-evolves, gain <b><i>Crest: Milteo & Luzen</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"み\">充</rub>つ《<rub=\"こいびと\">恋人</rub>と<rub=\"せっせい\">節制</rub>》・ミルティオ＆ルーゼン";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>リアニメイト</color>_4】と【<color=Keyword>リアニメイト</color>_2】を行う。
<hr><ev>これが進化したとき、場の他のフォロワーからランダム6枚を破壊。</ev>
<sev>これが超進化したとき、自分は『クレスト：充つ《恋人と節制》・ミルティオ＆ルーゼン』を持つ。</sev>
""";
    }

    locale kor {
        name "충족시키는 《연인과 절제》 밀티오&루젠";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>소생</color> 4], [<color=Keyword>소생</color> 2]를 발동.
<hr><ev>이 추종자가 진화했을 때, 전장의 다른 추종자 중 무작위로 6장을 파괴.</ev>
<sev>이 추종자가 초진화했을 때, 나는 「크레스트: 충족시키는 《연인과 절제》 밀티오&루젠」을 갖는다.</sev>
""";
    }

    locale cht {
        name "饜足《戀人與節制》‧米路緹歐＆盧澤";
        text """
【<color=Keyword>入場曲</color>】發動【<color=Keyword>亡者召還</color>_4】與【<color=Keyword>亡者召還</color>_2】。
<hr><ev>當這張卡片進化時，隨機破壞6張戰場上的其他從者卡。</ev>
<sev>當這張卡片超進化時，使自己獲得『紋章：饜足《戀人與節制》‧米路緹歐＆盧澤』。</sev>
""";
    }

}
