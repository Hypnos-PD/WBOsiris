wbo 0.1.0;

card 10574110 {
    type follower;
    cost 3;
    stats 0/2;

    effect {
        stealth;
        // 自己的回合开始时：从尚未发动过的能力中随机发动1个。
        when own turn starts {
            mode random 1 history wheel {
                option 1 {
                    label chs "回合结束前，使自己的所有手牌的费用-1。";
                    label eng "Reduce the cost of all cards in your hand by 1 until the end of the turn.";
                    label jpn "ターン終了まで、自分の手札すべてのコストを-1。";
                    label kor "턴 종료까지 내 패 모두의 코스트를 -1.";
                    label cht "回合結束前，使自己的手牌中全部的卡片消費-1。";
                    reduce cost own.hand 1 until own turn ends;
                }
                option 2 {
                    label chs "使自己的战场上的所有随从+2/+2。";
                    label eng "Give all allied followers on the field +2/+2.";
                    label jpn "自分の場のフォロワーすべては+2/+2する。";
                    label kor "내 전장의 추종자 모두는 +2/+2.";
                    label cht "使自己的戰場上全體從者+2/+2。";
                    buff own.field.followers +2/+2;
                }
                option 3 {
                    label chs "回复自己的主战者3点生命值。";
                    label eng "Restore 3 defense to your leader.";
                    label jpn "自分のリーダーを3回復。";
                    label kor "내 리더를 3 회복.";
                    label cht "回復自己的主戰者3點生命值。";
                    heal own.leader 3;
                }
            }
        }
        // 自己的回合结束时：若本随从已进化，则使对手获得纹章并消失。
        when own turn ends {
            if self form evolved {
                gain oppo crest 10574110;
                banish self;
            }
        }
    }

    crest {
        countdown 3;

        // 纹章持有者的回合开始时：从尚未发动过的能力中随机发动1个（全是负面效果）。
        when own turn starts {
            mode random 1 history wheel {
                option 1 {
                    raise cost own.hand 1 until own turn ends;
                }
                option 2 {
                    buff own.field.followers -2/-2;
                }
                option 3 {
                    damage own.leader 3;
                }
            }
        }

        locale chs {
            name "纹章：转动的《命运之轮》·斯洛士";
            text """
【<color=Keyword>吟唱</color>_3】
自己的回合开始时，从以下尚未发动的能力中随机发动1个。
（1）回合结束前，使自己的所有手牌的费用+1。
（2）使自己的战场上的所有随从-2/-2。
（3）对自己的主战者造成3点伤害。
""";
        }

        locale eng {
            name "Crest: Slaus, Revolving Wheel of Fortune";
            text """
<b><color=Keyword>Countdown</color> (3)</b>
At the start of your turn, activate 1 of the following abilities, chosen at random, that hasn't been activated yet.
1. Increase the cost of all cards in your hand by 1 until the end of the turn.
2. Give all allied followers on the field -2/-2.
3. Deal 3 damage to your leader.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"まわ\">廻</rub>る《<rub=\"うんめい\">運命</rub>の<rub=\"わ\">輪</rub>》・スロース";
            text """
【<color=Keyword>カウントダウン</color>_3】
自分のターン開始時、次の未発動の能力からランダムに1つ働く。
（1）ターン終了まで、自分の手札すべてのコストを+1。
（2）自分の場のフォロワーすべては-2/-2する。
（3）自分のリーダーに3ダメージ。
""";
        }

        locale kor {
            name "크레스트: 회전하는 《운명의 수레바퀴》 슬라우스";
            text """
[<color=Keyword>카운트다운</color> 3]
내 턴 시작 시, 다음의 미발동 능력 중 무작위로 1개가 발동.
(1) 턴 종료까지 내 패 모두의 코스트를 +1.
(2) 내 전장의 추종자 모두는 -2/-2.
(3) 내 리더에게 3 피해.
""";
        }

        locale cht {
            name "紋章：轉動的《命運之輪》‧斯洛士";
            text """
【<color=Keyword>吟唱</color>_3】
自己的回合開始時，從以下尚未發動的能力中隨機發動1個。
（1）回合結束前，使自己的手牌中全部的卡片消費+1。
（2）使自己的戰場上全體從者-2/-2。
（3）對自己的主戰者造成3點傷害。
""";
        }
    }

    meta {
        pack 10005;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "转动的《命运之轮》·斯洛士";
        text """
【<color=Keyword>潜行</color>】
自己的回合结束时，若本随从为进化后，则使对手获得『纹章：转动的《命运之轮》·斯洛士』。使本随从消失。
自己的回合开始时，从以下未发动的能力中随机发动1个能力。
<ridx=0>（1）回合结束前，使自己的所有手牌的费用-1。</ridx>
<ridx=1>（2）使自己的战场上的所有随从+2/+2。</ridx>
<ridx=2>（3）回复自己的主战者3点生命值。</ridx>
""";
    }

    locale eng {
        name "Slaus, Revolving Wheel of Fortune";
        text """
<b><color=Keyword>Ambush</color></b>
At the end of your turn, if this follower is evolved, give your opponent <b><i>Crest: Slaus, Revolving Wheel of Fortune</i></b> and banish this card.
At the start of your turn, activate a random ability that hasn't been activated yet from the following.
<ridx=0>1. Reduce the cost of all cards in your hand by 1 until the end of the turn.</ridx>
<ridx=1>2. Give all allied followers on the field +2/+2.</ridx>
<ridx=2>3. Restore 3 defense to your leader.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"まわ\">廻</rub>る《<rub=\"うんめい\">運命</rub>の<rub=\"わ\">輪</rub>》・スロース";
        text """
【<color=Keyword>潜伏</color>】
自分のターン終了時、これが進化後なら、相手は『クレスト：廻る《運命の輪》・スロース』を持つ。これを消滅。
自分のターン開始時、下記の能力から働いていないランダム1つの能力が働く。
<ridx=0>（1）ターン終了まで、自分の手札すべてのコストを-1する。</ridx>
<ridx=1>（2）自分の場のフォロワーすべては+2/+2する。</ridx>
<ridx=2>（3）自分のリーダーを3回復。</ridx>
""";
    }

    locale kor {
        name "돌아가는 《운명의 수레바퀴》 슬로스";
        text """
[<color=Keyword>잠복</color>]
내 턴 종료시 이 추종자가 진화후라면, 상대방은 「크레스트: 돌아가는 《운명의 수레바퀴》 슬로스」를 갖는다. 이 추종자를 소멸.
내 턴 시작시, 아래에서 발동하지 않은 능력 중 무작위로 1개를 발동.
<ridx=0>(1) 턴 종료까지 내 패 모두의 비용을 -1.</ridx>
<ridx=1>(2) 내 전장의 추종자 모두는 +2/+2.</ridx>
<ridx=2>(3) 내 리더를 3 회복.</ridx>
""";
    }

    locale cht {
        name "迴環《命運之輪》‧斯洛士";
        text """
【<color=Keyword>潛行</color>】
自己的回合結束時，如果這張卡片已進化，則會使敵方獲得『紋章：迴環《命運之輪》‧斯洛士』。使這張卡片消失。
自己的回合開始時，由下列能力中隨機發動1個尚未發動的能力。
<ridx=0>（1）到回合結束為止，使自己手牌中全部的卡片消費-1。</ridx>
<ridx=1>（2）使自己戰場上全部的從者卡+2/+2。</ridx>
<ridx=2>（3）回復自己的主戰者3點生命值。</ridx>
""";
    }

}
