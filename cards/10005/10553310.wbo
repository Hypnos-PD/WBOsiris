wbo 0.1.0;

card 10553310 {
    type spell;
    cost 2;

    effect {
        gain own crest 10553310;
    }

    crest {
        countdown 2;

        when own turn ends {
            draw 1;
            if own.hand has 4 same cost {
                summon 1 card 90051110;
                add ward to summoned;
            }
        }

        locale chs {
            name "纹章：严酷的奥夜花";
            text """
【<color=Keyword>吟唱</color>_2】
自己的回合结束时，抽取1张卡牌。之后，若自己的手牌中有4张或以上费用相同的卡牌，则召唤1个『<color=Keyword>骸骨士兵</color>』，使其获得【<color=Keyword>守护</color>】。
""";
        }

        locale eng {
            name "Crest: Rigor of the Nightblossom";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
At the end of your turn, draw a card. Then, if you have at least 4 cards with the same cost in your hand, summon a <b><i><color=Keyword>Skeleton</color></i></b> and give it <b><color=Keyword>Ward</color></b>.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"げんこく\">厳酷</rub>なる<rub=\"おくよばな\">奥夜花</rub>";
            text """
【<color=Keyword>カウントダウン</color>_2】
自分のターン終了時、自分のデッキから1枚を引く。その後、自分の手札に4枚以上同じコストがあるなら、『<color=Keyword>スケルトン</color>』1枚を自分の場に出す。それは【<color=Keyword>守護</color>】を持つ。
""";
        }

        locale kor {
            name "크레스트: 혹독한 오야화";
            text """
[<color=Keyword>카운트다운</color> 2]
내 턴 종료시, 내 덱에서 1장을 뽑는다. 그다음 내 패에 비용이 같은 카드가 4장 이상이라면, <color=Keyword>스켈레톤</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
""";
        }

        locale cht {
            name "紋章：嚴酷的奧夜花";
            text """
【<color=Keyword>倒數</color>_2】
自己的回合結束時，由自己的牌堆中抽取1張卡片。隨後，如果自己手牌中有4張以上相同消費的卡片，則會召喚1張『<color=Keyword>骷髏士兵</color>』到自己的戰場上。使其獲得【<color=Keyword>守護</color>】。
""";
        }
    }

    meta {
        pack 10005;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "严酷的奥夜花";
        text """
使自己获得『纹章：严酷的奥夜花』。
""";
    }

    locale eng {
        name "Rigor of the Nightblossom";
        text """
Gain <b><i>Crest: Rigor of the Nightblossom</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"げんこく\">厳酷</rub>なる<rub=\"おくよばな\">奥夜花</rub>";
        text """
自分は『クレスト：厳酷なる奥夜花』を持つ。
""";
    }

    locale kor {
        name "혹독한 오야화";
        text """
나는 「크레스트: 혹독한 오야화」를 갖는다.
""";
    }

    locale cht {
        name "嚴酷的奧夜花";
        text """
使自己獲得『紋章：嚴酷的奧夜花』。
""";
    }

}
