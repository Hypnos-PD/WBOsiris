wbo 0.1.0;

card 10541120 {
    type follower;
    cost 6;
    stats 5/5;

    effect {
        fanfare {
            summon 1 card 90041130;
        }
        when own follower summoned where trait marine {
            heal own.leader 2;
        }
    }

    meta {
        pack 10005;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "水滴打拍者";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>大海虎鲸</color>』。
<hr>自己的海洋·随从进入战场时，回复自己的主战者2点生命值。
""";
    }

    locale eng {
        name "Stormy Shamisen Shredder";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Majestic Megalorca</color></i></b>.
<hr>Whenever an allied Marine follower enters the field, restore 2 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"しずく\">雫</rub>の<rub=\"はやしがた\">囃子方</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>大海のオルカ</color>』1枚を自分の場に出す。
<hr>自分の海洋・フォロワーが場に出たとき、自分のリーダーを2回復。
""";
    }

    locale kor {
        name "비의 연주자";
        text """
[<color=Keyword>출격</color>] <color=Keyword>대해의 오르카</color> 1장을 내 전장에 소환.
<hr>내 바다 추종자가 전장에 소환되었을 때, 내 리더를 2 회복.
""";
    }

    locale cht {
        name "水露的奏者";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>滄海虎鯨</color>』到自己的戰場上。
<hr>當自己的海洋‧從者卡進入戰場時，回復自己的主戰者2點生命值。
""";
    }

}
