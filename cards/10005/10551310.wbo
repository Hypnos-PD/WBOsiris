wbo 0.1.0;

card 10551310 {
    type spell;
    cost 2;

    effect {
        require target from oppo.field.followers;
        damage target 5;
        add 1 card 10551310 to deck;
    }

    meta {
        pack 10005;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "奥夜花的开战";
        text """
选择对手的战场上的1个随从，对其造成5点伤害。将1张『<color=Keyword>奥夜花的开战</color>』加入牌组。
""";
    }

    locale eng {
        name "Valor of the Nightblossom";
        text """
Select an enemy follower on the field and deal it 5 damage. Add a <b><i><color=Keyword>Valor of the Nightblossom</color></i></b> to your deck.
""";
    }

    locale jpn {
        name "<rub=\"おくよばな\">奥夜花</rub>の<rub=\"かいせん\">開戦</rub>";
        text """
相手の場のフォロワー1枚を選ぶ。それに5ダメージ。『<color=Keyword>奥夜花の開戦</color>』1枚を自分のデッキに加える。
""";
    }

    locale kor {
        name "오야화의 개전";
        text """
상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해. <color=Keyword>오야화의 개전</color> 1장을 내 덱에 넣는다.
""";
    }

    locale cht {
        name "奧夜花的開戰";
        text """
指定1張敵方戰場上的從者卡。給予其5點傷害。增加1張『<color=Keyword>奧夜花的開戰</color>』到自己的牌堆中。
""";
    }

}
