wbo 0.1.0;

card 10571110 {
    type follower;
    cost 4;
    stats 3/3;

    effect {
        fanfare {
            summon 1 card 90071120;
            summon 1 card 90071110;
        }
        enhance 7 {
            add storm to summoned_all;
        }
    }

    meta {
        pack 10005;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "舞台缔造者";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>改良型·悬丝傀儡</color>』和1个『<color=Keyword>悬丝傀儡</color>』。
【<color=Keyword>爆能强化</color>_7】使其获得【<color=Keyword>疾驰</color>】。
""";
    }

    locale eng {
        name "Marionette Master";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon an <b><i><color=Keyword>Enhanced Puppet</color></i></b> and <b><i><color=Keyword>Puppet</color></i></b>.
<b><color=Keyword>Enhance</color> (7)</b>: Give them <b><color=Keyword>Storm</color></b>.
""";
    }

    locale jpn {
        name "ステージメーカー";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>改良型・操り人形</color>』1枚と『<color=Keyword>操り人形</color>』1枚を自分の場に出す。
【<color=Keyword>エンハンス</color>_7】それは【<color=Keyword>疾走</color>】を持つ。
""";
    }

    locale kor {
        name "스테이지 메이커";
        text """
[<color=Keyword>출격</color>] <color=Keyword>개량형 꼭두각시 인형</color> 1장, <color=Keyword>꼭두각시 인형</color> 1장을 내 전장에 소환.
[<color=Keyword>증강</color> 7] 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.
""";
    }

    locale cht {
        name "創戲者";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>改良型‧懸絲人偶</color>』與1張『<color=Keyword>懸絲人偶</color>』到自己的戰場上。
【<color=Keyword>爆能強化</color>_7】使其獲得【<color=Keyword>疾馳</color>】。
""";
    }

}
