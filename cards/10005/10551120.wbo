wbo 0.1.0;

card 10551120 {
    type follower;
    cost 4;
    stats 3/2;

    effect {
        fanfare {
            reanimate 2;
        }
        evolve {
            reanimate 2;
        }
    }

    meta {
        pack 10005;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "红符的魂魄道士";
