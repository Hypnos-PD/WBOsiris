wbo 0.1.0;

card 10532310 {
    type spell;
    cost 1;

    effect {
        earthrite 2 {
            mode random 2 {
                option 1 {
                    label chs "召唤1个『泥尘巨像』。";
                    label eng "Summon a Clay Golem.";
                    label jpn "『クレイゴーレム』1枚を自分の場に出す。";
                    label kor "「진흙 골렘」 1장을 내 전장에 소환.";
                    label cht "召喚1張『泥塵巨像』到自己的戰場上。";
                    summon 1 card 90031110;
                }
                option 2 {
                    label chs "回复自己的主战者2点生命值。";
                    label eng "Restore 2 defense to your leader.";
                    label jpn "自分のリーダーを2回復。";
                    label kor "내 리더를 2 회복.";
                    label cht "回復自己的主戰者2點生命值。";
                    heal own.leader 2;
                }
                option 3 {
                    label chs "使自己的战场上的土之印+3。";
                    label eng "Gain 3 earth sigils.";
                    label jpn "自分の場の土の印を+3する。";
                    label kor "내 전장의 대지의 인장을 +3.";
                    label cht "使自己戰場上的土之印+3。";
                    add 3 earthsigil;
                }
            }
        }
    }

    meta {
        pack 10005;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "魔猫戏法";
        text """
【<color=Keyword>土之秘术</color>_2】从以下能力中随机发动2个能力。
<ridx=0>（1）召唤1个『<color=Keyword>泥尘巨像</color>』。</ridx>
<ridx=1>（2）回复自己的主战者2点生命值。</ridx>
<ridx=2>（3）使自己的战场上的土之印+3。</ridx>
""";
    }

    locale eng {
        name "Kitty Cunning";
        text """
<b><color=Keyword>Earth Rite</color> (2)</b> - Activate 2 random abilities from the following.
<ridx=0>1. Summon a <b><i><color=Keyword>Clay Golem</color></i></b>.</ridx>
<ridx=1>2. Restore 2 defense to your leader.</ridx>
<ridx=2>3. Gain 3 earth sigils.</ridx>
""";
    }

    locale jpn {
        name "キティトリック";
        text """
【<color=Keyword>土の秘術</color>_2】下記の能力からランダム2つの能力が働く。
<ridx=0>（1）『<color=Keyword>クレイゴーレム</color>』1枚を自分の場に出す。</ridx>
<ridx=1>（2）自分のリーダーを2回復。</ridx>
<ridx=2>（3）自分の場の土の印を+3する。</ridx>
""";
    }

    locale kor {
        name "키티 트릭";
        text """
[<color=Keyword>대지의 비술</color> 2] 아래 능력 중 무작위로 2개를 발동.
<ridx=0>(1) <color=Keyword>진흙 골렘</color> 1장을 내 전장에 소환.</ridx>
<ridx=1>(2) 내 리더를 2 회복.</ridx>
<ridx=2>(3) 내 전장의 대지의 인장을 +3.</ridx>
""";
    }

    locale cht {
        name "魔貓戲法";
        text """
【<color=Keyword>土之秘術</color>_2】由下列能力中隨機發動2個能力。
<ridx=0>（1）召喚1張『<color=Keyword>泥塵巨像</color>』到自己的戰場上。</ridx>
<ridx=1>（2）回復自己的主戰者2點生命值。</ridx>
<ridx=2>（3）使自己戰場上的土之印+3。</ridx>
""";
    }

}
