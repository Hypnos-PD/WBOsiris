wbo 0.1.0;

card 10512110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            if combo >= 5 {
                summon 1 card 10512110;
                evolve summoned silent;
                evolve self silent;
            }
        }
    }

    meta {
        pack 10005;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "新晋搭档";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>连击</color>_5】召唤1个『<color=Keyword>新晋搭档</color>』。该随从和本随从进化。
""";
    }

    locale eng {
        name "Flowering Friendship";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Combo</color> (5)</b> - Summon a <b><i><color=Keyword>Flowering Friendship</color></i></b> and evolve it and this follower.
""";
    }

    locale jpn {
        name "バディングバディーズ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>コンボ</color>_5】『<color=Keyword>バディングバディーズ</color>』1枚を自分の場に出す。それとこれは進化する。
""";
    }

    locale kor {
        name "버딩 버디즈";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>콤보</color> 5] <color=Keyword>버딩 버디즈</color> 1장을 내 전장에 소환. 그 추종자와 이 추종자는 진화한다.
""";
    }

    locale cht {
        name "新銳搭檔";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>連擊</color>_5】召喚1張『<color=Keyword>新銳搭檔</color>』到自己的戰場上。使其與這張卡片進化。
""";
    }

}
