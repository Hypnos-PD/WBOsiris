wbo 0.1.0;

card 10763110 {
    type follower;
    cost 6;
    stats 4/6;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "审理的守卫";
        text """
【<color=Keyword>入场曲</color>】若自己的战场上的护符的张数为3张或以上，则本随从进化。本随从获得【<color=Keyword>屏障</color>】。
<hr>【<color=Keyword>守护</color>】
【<color=Keyword>谢幕曲</color>】回复自己的主战者3点生命值。
""";
    }

    locale eng {
        name "Deacon of Security";
        text """
<b><color=Keyword>Fanfare</color></b>: If there are at least 3 allied amulets on the field, evolve this follower and give it <b><color=Keyword>Barrier</color></b>.
<hr><b><color=Keyword>Ward</color></b>
<b><color=Keyword>Last Words</color></b>: Restore 3 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"しんり\">審理</rub>の<rub=\"しゅえい\">守衛</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場のアミュレットの枚数が3以上なら、これは進化する。これは【<color=Keyword>バリア</color>】を持つ。
<hr>【<color=Keyword>守護</color>】
【<color=Keyword>ラストワード</color>】自分のリーダーを3回復。
""";
    }

    locale kor {
        name "재판 경호원";
        text """
[<color=Keyword>출격</color>] 내 전장의 마법진 수가 3 이상이라면, 이 추종자는 진화한다. 이 추종자는 [<color=Keyword>배리어</color>]를 갖는다.
<hr>[<color=Keyword>수호</color>]
[<color=Keyword>유언</color>] 내 리더를 3 회복.
""";
    }

    locale cht {
        name "審理的護衛";
        text """
【<color=Keyword>入場曲</color>】如果自己戰場上的護符卡張數為3以上，則會使這張卡片進化。使這張卡片獲得【<color=Keyword>障壁</color>】。
<hr>【<color=Keyword>守護</color>】
【<color=Keyword>謝幕曲</color>】回復自己的主戰者3點生命值。
""";
    }

}
