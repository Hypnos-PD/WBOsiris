wbo 0.1.0;

card 10743110 {
    type follower;
    cost 5;
    stats 2/3;

    effect {
        fanfare {
            random victim from oppo.field.followers highest attack;
            destroy victim;
            mode {
                option 1 {
                    evolve self silent;
                }
                option 2 {
                    add stealth to self;
                }
            }
        }
    }

    meta {
        pack 10007;
        class dragoncraft;
        rarity gold;
    }

    locale chs {
        name "龙人先驱者";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。破坏对手的战场上的随机1个攻击力最大的随从。
<ridx=0>（1）本随从进化。</ridx>
<ridx=1>（2）本随从获得【<color=Keyword>潜行</color>】。</ridx>
""";
    }

    locale eng {
        name "Dragonewt Pathfinder";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate. Destroy a random enemy follower with the highest attack.
<ridx=0>1. Evolve this follower.</ridx>
<ridx=1>2. Give this follower <b><color=Keyword>Ambush</color></b>.</ridx>
""";
    }

    locale jpn {
        name "ドラゴニュートの<rub=\"せんどうしゃ\">先導者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。相手の場の攻撃力最大のフォロワーからランダム1枚を破壊。
<ridx=0>（1）これは進化する。</ridx>
<ridx=1>（2）これは【<color=Keyword>潜伏</color>】を持つ。</ridx>
""";
    }

    locale kor {
        name "드래고뉴트 선도자";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동. 공격력이 가장 높은 상대방 전장의 추종자 중 무작위로 1장을 파괴.
<ridx=0>(1) 이 추종자는 진화한다.</ridx>
<ridx=1>(2) 이 추종자는 [<color=Keyword>잠복</color>]을 갖는다.</ridx>
""";
    }

    locale cht {
        name "龍人引導者";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。隨機破壞1張敵方戰場上攻擊力最高的從者卡。
<ridx=0>（1）使這張卡片進化。</ridx>
<ridx=1>（2）使這張卡片獲得【<color=Keyword>潛行</color>】。</ridx>
""";
    }

}
