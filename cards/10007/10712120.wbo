wbo 0.1.0;

card 10712120 {
    type follower;
    cost 5;
    stats 4/4;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target 4;
            add combo 1;
        }
        evolve {
            choose target from oppo.field.followers;
            damage target 4;
            add combo 1;
        }
    }

    meta {
        pack 10007;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "弓兵指挥者";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。使自己的【<color=Keyword>连击</color>】+1。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Hawkeyed Tactician";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage. Increase your <b><color=Keyword>Combo</color></b> by 1.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"きゅうへい\">弓兵</rub>の<rub=\"さいはいしゃ\">采配者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。自分の【<color=Keyword>コンボ</color>】を+1する。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "궁병 전술가";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해. 내 [<color=Keyword>콤보</color>]를 +1.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "弓兵指揮者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。使自己的【<color=Keyword>連擊</color>】+1。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
