wbo 0.1.0;

card 10773110 {
    type follower;
    cost 3;
    stats 1/1;

    effect {
        fanfare {
            summon 1 card 90071130;
        }
        enhance 5 {
            summon 1 card 90071150;
        }
        when own follower summoned where trait artifact {
            add rush to summoned;
        }
    }

    meta {
        pack 10007;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "狂野播报员";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>解析的创造物</color>』。
【<color=Keyword>爆能强化</color>_5】召唤1个『<color=Keyword>神秘的创造物</color>』。
<hr>自己的创造物·随从进入战场时，使其获得【<color=Keyword>突进</color>】。
""";
    }

    locale eng {
        name "Brazen Broadcaster";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon an <b><i><color=Keyword>Analyzing Artifact</color></i></b>.
<b><color=Keyword>Enhance</color> (5)</b>: Summon a <b><i><color=Keyword>Mystic Artifact</color></i></b>.
<hr>Whenever an allied Artifact follower enters the field, give it <b><color=Keyword>Rush</color></b>.
""";
    }

    locale jpn {
        name "ワイルドキャスター";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>アナライズアーティファクト</color>』1枚を自分の場に出す。
【<color=Keyword>エンハンス</color>_5】『<color=Keyword>ミスティックアーティファクト</color>』1枚を自分の場に出す。
<hr>自分のアーティファクト・フォロワーが場に出たとき、それは【<color=Keyword>突進</color>】を持つ。
""";
    }

    locale kor {
        name "거침없는 캐스터";
        text """
[<color=Keyword>출격</color>] <color=Keyword>분석의 아티팩트</color> 1장을 내 전장에 소환.
[<color=Keyword>증강</color> 5] <color=Keyword>신비의 아티팩트</color> 1장을 내 전장에 소환.
<hr>내 아티팩트 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다.
""";
    }

    locale cht {
        name "野性的播報員";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>解析的創造物</color>』到自己的戰場上。
【<color=Keyword>爆能強化</color>_5】召喚1張『<color=Keyword>神祕的創造物</color>』到自己的戰場上。
<hr>當自己的創造物‧從者卡進入戰場時，使其獲得【<color=Keyword>突進</color>】。
""";
    }

}
