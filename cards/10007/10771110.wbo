    stats 3/3;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "个性店主";
        text """
自己的创造物·随从进入战场时，回复自己的主战者1点生命值。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>神秘的创造物</color>』。</ev>
""";
    }

    locale eng {
        name "Brusque Barkeep";
        text """
Whenever an allied Artifact follower enters the field, restore 1 defense to your leader.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>Mystic Artifact</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "エッジーマスター";
        text """
自分のアーティファクト・フォロワーが場に出たとき、自分のリーダーを1回復。
