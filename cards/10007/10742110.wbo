""";
    }

    locale eng {
        name "Gallant Gatekeeper";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it.
<hr><b><color=Keyword>Ward</color></b>
""";
    }

    locale jpn {
        name "<rub=\"ごうりゅう\">豪龍</rub>の<rub=\"もんばん\">門番</rub>";
