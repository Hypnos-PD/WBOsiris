wbo 0.1.0;

card 10771310 {
    type spell;
    cost 1;
    trait anathema;

    effect {
        // 【模式】通常在打出时选择；种类达到 3 时"改为发动所有能力"，因此两个效果都结算。
        if own.entered_artifacts >= 3 {
            add 1 card 90071130 to hand;
            add 1 card 90071140 to hand;
        } else {
            mode {
                option 1 {
                    add 1 card 90071130 to hand;
                }
                option 2 {
                    add 1 card 90071140 to hand;
                }
            }
        }
    }

    meta {
        pack 10007;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "跑酷";
        text """
【<color=Keyword>模式</color>】选择1个能力发动。若本次对战中进入战场的自己的创造物·随从的种类为3种或以上，则改为发动所有能力。
<ridx=0>（1）将1张『<color=Keyword>解析的创造物</color>』加入手牌。</ridx>
<ridx=1>（2）将1张『<color=Keyword>古老的创造物</color>』加入手牌。</ridx>
""";
    }

    locale eng {
        name "Freerunning";
        text """
Select a <b><color=Keyword>Mode</color></b> to activate. If at least 3 differently named allied Artifact followers have entered the field this match, activate all of them instead.
<ridx=0>1. Add an <b><i><color=Keyword>Analyzing Artifact</color></i></b> to your hand.</ridx>
<ridx=1>2. Add an <b><i><color=Keyword>Ancient Artifact</color></i></b> to your hand.</ridx>
""";
    }

    locale jpn {
        name "ストリートラン";
        text """
【<color=Keyword>モード</color>】1つを選んでその能力が働く。このバトル中に場に出た自分のアーティファクト・フォロワーの種類が3以上なら、1つを選ぶのではなくすべて。
<ridx=0>（1）『<color=Keyword>アナライズアーティファクト</color>』1枚を自分の手札に加える。</ridx>
<ridx=1>（2）『<color=Keyword>エンシェントアーティファクト</color>』1枚を自分の手札に加える。</ridx>
""";
    }

    locale kor {
        name "스트리트 런";
        text """
[<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동. 이번 대전에서 전장에 소환된 내 아티팩트 추종자의 종류 수가 3 이상이라면, 1개를 선택하는 대신 모두.
<ridx=0>(1) <color=Keyword>분석의 아티팩트</color> 1장을 내 패에 넣는다.</ridx>
<ridx=1>(2) <color=Keyword>고대의 아티팩트</color> 1장을 내 패에 넣는다.</ridx>
""";
    }

    locale cht {
        name "街頭疾走";
        text """
指定1個【<color=Keyword>模式</color>】並發動該能力。如果本次對戰中自己已進入戰場的創造物‧從者卡種類為3以上，則會由原本的指定1個轉變為全部。
<ridx=0>（1）增加1張『<color=Keyword>解析的創造物</color>』到自己的手牌中。</ridx>
<ridx=1>（2）增加1張『<color=Keyword>古老的創造物</color>』到自己的手牌中。</ridx>
""";
    }

}
