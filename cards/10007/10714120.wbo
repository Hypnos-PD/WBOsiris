wbo 0.1.0;

card 10714120 {
    type follower;
    cost 6;
    stats 5/5;

    effect {
        fanfare {
            add 2 card 90011310 to hand;
        }
        // X 为本随从的攻击力：分配 X 点伤害给对手战场上的所有随从。
        when own turn ends {
            damage oppo.field.followers self.attack distributed;
        }
        superevolve {
            gain own crest 10714120;
        }
    }

    crest {
        countdown 3;

        when own turn ends {
            if combo >= 3 {
                add 1 card 90011310 to hand;
            }
        }

        locale chs {
            name "纹章：冰界鹿王";
            text """
【<color=Keyword>吟唱</color>_3】
自己的回合结束时，【<color:Keyword>连击</color>_3】将1张『<color=Keyword>森林的奥秘</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Winterglade Stag King";
            text """
<b><color=Keyword>Countdown</color> (3)</b>
At the end of your turn, if you have at least 3 cards in your combo, add a <b><i><color=Keyword>Deepwood Bounty</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"ひょうかい\">氷界</rub>の<rub=\"しかおう\">鹿王</rub>";
            text """
【<color=Keyword>カウントダウン</color>_3】
自分のターン終了時、【<color=Keyword>コンボ</color>_3】『<color=Keyword>森の神秘</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 빙계의 녹왕";
            text """
[<color=Keyword>카운트다운</color> 3]
내 턴 종료 시, [<color=Keyword>콤보</color> 3] <color=Keyword>숲의 신비</color> 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：冰界鹿王";
            text """
【<color=Keyword>倒數</color>_3】
自己的回合結束時，【<color=Keyword>連擊</color>_3】增加1張『<color=Keyword>森林的奧祕</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10007;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "冰界鹿王";
        text """
【<color=Keyword>入场曲</color>】将2张『<color=Keyword>森林的奥秘</color>』加入手牌。
<hr>自己的回合结束时，对对手的战场上的所有随从分配X点伤害。X为本随从的攻击力。
<hr><sev>【<color=Keyword>超进化时</color>】使自己获得『纹章：冰界鹿王』。</sev>
""";
    }

    locale eng {
        name "Great Hart of the Glacial Realm";
        text """
<b><color=Keyword>Fanfare</color></b>: Add 2 copies of <b><i><color=Keyword>Deepwood Bounty</color></i></b> to your hand.
<hr>At the end of your turn, deal X damage split between all enemy followers. X is this follower's attack.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Gain <b><i>Crest: Great Hart of the Glacial Realm</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"ひょうかい\">氷界</rub>の<rub=\"ろくおう\">鹿王</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>森の神秘</color>』2枚を自分の手札に加える。
<hr>自分のターン終了時、相手の場のフォロワーすべてにXダメージを割りふる。Xはこれの攻撃力である。
<hr><sev>【<color=Keyword>超進化時</color>】自分は『クレスト：氷界の鹿王』を持つ。</sev>
""";
    }

    locale kor {
        name "빙계의 사슴왕";
        text """
[<color=Keyword>출격</color>] <color=Keyword>숲의 신비</color> 2장을 내 패에 넣는다.
<hr>내 턴 종료시, 상대방 전장의 추종자 모두에게 X 피해를 분배한다. X는 이 추종자의 공격력.
<hr><sev>[<color=Keyword>초진화시</color>] 나는 「크레스트: 빙계의 사슴왕」을 갖는다.</sev>
""";
    }

    locale cht {
        name "冰界鹿王";
        text """
【<color=Keyword>入場曲</color>】增加2張『<color=Keyword>森林的奧祕</color>』到自己的手牌中。
<hr>自己的回合結束時，對敵方戰場上全部的從者卡分配X點傷害。X為「這張卡片的攻擊力」。
<hr><sev>【<color=Keyword>超進化時</color>】使自己獲得『紋章：冰界鹿王』。</sev>
""";
    }

}
