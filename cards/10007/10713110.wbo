wbo 0.1.0;

card 10713110 {
    type follower;
    cost 3;
    stats 3/1;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target self.attack;
        }
        when own turn ends if combo >= 3 {
            draw 1;
        }
    }

    meta {
        pack 10007;
        class forestcraft;
        rarity gold;
    }

    locale chs {
        name "冰箭射手";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成X点伤害。X为本随从的攻击力。
<hr>自己的回合结束时，【<color=Keyword>连击</color>_3】抽取1张卡牌。
""";
    }

    locale eng {
        name "Frostbow Sniper";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it X damage. X is this follower's attack.
<hr>At the end of your turn, <b><color=Keyword>Combo</color> (3)</b> - Draw a card.
""";
    }

    locale jpn {
        name "<rub=\"とうや\">凍矢</rub>の<rub=\"しゃしゅ\">射手</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それにXダメージ。Xはこれの攻撃力である。
<hr>自分のターン終了時、【<color=Keyword>コンボ</color>_3】自分のデッキから1枚を引く。
""";
    }

    locale kor {
        name "얼음화살 사수";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 X 피해. X는 이 추종자의 공격력.
<hr>내 턴 종료시, [<color=Keyword>콤보</color> 3] 내 덱에서 1장을 뽑는다.
""";
    }

    locale cht {
        name "凍箭射手";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其X點傷害。X為「這張卡片的攻擊力」。
<hr>自己的回合結束時，【<color=Keyword>連擊</color>_3】由自己的牌堆中抽取1張卡片。
""";
    }

}
