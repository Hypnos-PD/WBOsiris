wbo 0.1.0;

card 10721310 {
    type spell;
    cost 1;
    trait anathema;

    effect {
        choose target from oppo.field.followers;
        damage target 3;
        if rally >= 10 {
            add cannot_attack to target until oppo turn ends;
        }
    }

    meta {
        pack 10007;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "敌我的调律";
        text """
选择对手的战场上的1个随从，对其造成3点伤害。【<color=Keyword>协作</color>_10】对手的回合结束前，使其获得「无法攻击随从或主战者」。
""";
    }

    locale eng {
        name "Measured Attunement";
        text """
Select an enemy follower on the field and deal it 3 damage. <b><color=Keyword>Rally</color> (10)</b> - Give it \"Can't attack followers or leaders\" until the end of your opponent's turn.
""";
    }

    locale jpn {
        name "<rub=\"ひが\">彼我</rub>の<rub=\"ちょうりつ\">調律</rub>";
        text """
相手の場のフォロワー1枚を選ぶ。それに3ダメージ。【<color=Keyword>連携</color>_10】相手のターン終了まで、それは「フォロワーやリーダーを攻撃できない。」を持つ。
""";
    }

    locale kor {
        name "피아의 조율";
        text """
상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 3 피해. [<color=Keyword>연계</color> 10] 상대방 턴 종료까지 그 추종자는 「추종자나 리더 공격 불가」를 갖는다.
""";
    }

    locale cht {
        name "雙向的調律";
        text """
指定1張敵方戰場上的從者卡。給予其3點傷害。【<color=Keyword>協作</color>_<nobr>10</nobr>】到敵方的回合結束為止，使其獲得「無法攻擊從者或主戰者」。
""";
    }

}
