        rarity silver;
    }

    locale chs {
        name "讴歌青春";
        text """
召唤1个『<color=Keyword>怨灵</color>』和1个『<color=Keyword>蝙蝠</color>』和1个『<color=Keyword>骸骨士兵</color>』，使其进化。
""";
    }

    locale eng {
        name "Harmony of Youth";
        text """
Summon a <b><i><color=Keyword>Ghost</color></i></b>, <b><i><color=Keyword>Bat</color></i></b>, and <b><i><color=Keyword>Skeleton</color></i></b> and evolve them.
""";
