wbo 0.1.0;

card 10763210 {
    type amulet;
    cost 3;
    trait anathema;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target 4;
        }
        engage 0 {
            destroy self;
            choose target from oppo.field.followers;
            damage target 2;
        }
    }

    meta {
        pack 10007;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "海蚀三叉戟";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。
<hr>【<color=Keyword>启动</color>】破坏本卡牌。选择对手的战场上的1个随从，对其造成2点伤害。
""";
    }

    locale eng {
        name "Trident of Eroding Tides";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage.
<hr><b><color=Keyword>Engage</color></b>: Destroy this card. Select an enemy follower on the field and deal it 2 damage.
""";
    }

    locale jpn {
        name "<rub=\"かいしょく\">海蝕</rub>の<rub=\"さんさそう\">三叉槍</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。
<hr>【<color=Keyword>アクト</color>】これを破壊。相手の場のフォロワー1枚を選ぶ。それに2ダメージ。
""";
    }

    locale kor {
        name "해식의 삼지창";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해.
<hr>[<color=Keyword>활성화</color>] 이 마법진을 파괴. 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 2 피해.
""";
    }

    locale cht {
        name "海蝕三叉戟";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。
<hr>【<color=Keyword>策動</color>】破壞這張卡片。指定1張敵方戰場上的從者卡。給予其2點傷害。
""";
    }

}
