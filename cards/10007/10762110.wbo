wbo 0.1.0;

card 10762110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class havencraft;
        rarity silver;
    }

    locale chs {
        name "神圣策划人";
        text """
【<color=Keyword>入场曲</color>】若自己的战场上的护符的张数为3张或以上，则选择对手的战场上的1个随从，对其造成5点伤害。
""";
    }

    locale eng {
        name "Sister of Strategic Development";
        text """
<b><color=Keyword>Fanfare</color></b>: If there are at least 3 allied amulets on the field, select an enemy follower on the field and deal it 5 damage.
""";
    }

    locale jpn {
        name "ホーリープランナー";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場のアミュレットの枚数が3以上なら、相手の場のフォロワー1枚を選ぶ。それに5ダメージ。
""";
    }

    locale kor {
        name "신성 기획자";
        text """
[<color=Keyword>출격</color>] 내 전장의 마법진 수가 3 이상이라면, 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해.
""";
    }

    locale cht {
        name "聖職策劃師";
        text """
【<color=Keyword>入場曲</color>】如果自己戰場上的護符卡張數為3以上，則會指定1張敵方戰場上的從者卡。給予其5點傷害。
""";
    }

}
