wbo 0.1.0;

card 10731120 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "小型怪兽";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成1点伤害。使自己的战场上的土之印+1。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Little Beastie";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 1 damage. Gain an earth sigil.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "リトルビースト";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに1ダメージ。自分の場の土の印を+1する。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "리틀 비스트";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 1 피해. 내 전장의 대지의 인장을 +1.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "小小野獸";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其1點傷害。使自己戰場上的土之印+1。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
