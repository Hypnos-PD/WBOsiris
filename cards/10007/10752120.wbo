wbo 0.1.0;

card 10752120 {
    type follower;
    cost 6;
    stats 6/5;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            destroy target;
            reanimate 2;
        }
    }

    meta {
        pack 10007;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "乌鸦杂耍师";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。发动【<color=Keyword>亡者召还</color>_2】。
""";
    }

    locale eng {
        name "Juggler Corvid";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it. <b><color=Keyword>Reanimate</color> (2)</b>.
""";
    }

    locale jpn {
        name "ジャグラークロウ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。【<color=Keyword>リアニメイト</color>_2】を行う。
""";
    }

    locale kor {
        name "저글링 까마귀";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴. [<color=Keyword>소생</color> 2]를 발동.
""";
    }

    locale cht {
        name "鴉頭雜耍者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。發動【<color=Keyword>亡者召還</color>_2】。
""";
    }

}
