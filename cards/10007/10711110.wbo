wbo 0.1.0;

card 10711110 {
    type follower;
    cost 8;
    stats 6/6;

    effect {
        rush;
        ward;
        damage_cap 3;
        fanfare {
            summon copies of self;
        }
    }

    meta {
        pack 10007;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "巨型熊";
        text """
【<color=Keyword>入场曲</color>】召唤1个本随从的复制随从。
<hr>【<color=Keyword>突进</color>】
【<color=Keyword>守护</color>】
受到的4点或以上的伤害变为3点。
""";
    }

    locale eng {
        name "Macrobear";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon an exact copy of this card.
<hr><b><color=Keyword>Rush</color></b>
<b><color=Keyword>Ward</color></b>
Can't take more than 3 damage at a time.
""";
    }

    locale jpn {
        name "グロースベア";
        text """
【<color=Keyword>ファンファーレ</color>】これのコピー1枚を自分の場に出す。
<hr>【<color=Keyword>突進</color>】
【<color=Keyword>守護</color>】
受ける4以上のダメージを3にする。
""";
    }

    locale kor {
        name "그로스 베어";
        text """
[<color=Keyword>출격</color>] 이 추종자의 복사본 1장을 내 전장에 소환.
<hr>[<color=Keyword>돌진</color>]
[<color=Keyword>수호</color>]
4 이상의 받는 피해를 3으로 만든다.
""";
    }

    locale cht {
        name "巨化熊";
        text """
【<color=Keyword>入場曲</color>】將這張卡片複製1張並召喚到自己的戰場上。
<hr>【<color=Keyword>突進</color>】
【<color=Keyword>守護</color>】
受到的傷害為4以上時轉變為3。
""";
    }

}
