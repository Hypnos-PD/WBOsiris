wbo 0.1.0;

card 10712310 {
    type spell;
    cost 1;
    trait anathema;

    effect {
        heal own.leader 1;
        if combo >= 3 {
            gain own crest 10712310;
        }
    }

    crest {
        countdown 1;

        lastwords {
            add 1 card 10713310 to hand;
        }

        locale chs {
            name "纹章：忧虑缩小";
            text """
【<color=Keyword>吟唱</color>_1】
【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>恶意扩大</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Minimized Anxiety";
            text """
<b><color=Keyword>Countdown</color> (1)</b>
<b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Magnified Malice</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"ゆうりょ\">憂慮</rub>の<rub=\"しゅくしょう\">縮小</rub>";
            text """
【<color=Keyword>カウントダウン</color>_1】
【<color=Keyword>ラストワード</color>】『<color=Keyword>害意の拡大</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 우려의 축소";
            text """
[<color=Keyword>카운트다운</color> 1]
[<color=Keyword>유언</color>] <color=Keyword>해의의 확대</color> 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：縮小憂慮";
            text """
【<color=Keyword>倒數</color>_1】
【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>擴大惡意</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10007;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "忧虑缩小";
        text """
回复自己的主战者1点生命值。【<color=Keyword>连击</color>_3】使自己获得『纹章：忧虑缩小』。
""";
    }

    locale eng {
        name "Minimized Anxiety";
        text """
Restore 1 defense to your leader. <b><color=Keyword>Combo</color> (3)</b> - Gain <b><i>Crest: Minimized Anxiety</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"ゆうりょ\">憂慮</rub>の<rub=\"しゅくしょう\">縮小</rub>";
        text """
自分のリーダーを1回復。【<color=Keyword>コンボ</color>_3】自分は『クレスト：憂慮の縮小』を持つ。
""";
    }

    locale kor {
        name "우려의 축소";
        text """
내 리더를 1 회복. [<color=Keyword>콤보</color> 3] 나는 「크레스트: 우려의 축소」를 갖는다.
""";
    }

    locale cht {
        name "縮小憂慮";
        text """
回復自己的主戰者1點生命值。【<color=Keyword>連擊</color>_3】使自己獲得『紋章：縮小憂慮』。
""";
    }

}
