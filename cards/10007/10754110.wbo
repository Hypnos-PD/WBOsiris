wbo 0.1.0;

card 10754110 {
    type follower;
    cost 6;
    stats 5/4;
    trait anathema;

    effect {
        fanfare {
            // 「梦魇·随从」是职业（本工程里写作 abysscraft），随机 2 种各 1 张。
            summon random 2 from own.deck.followers where class abysscraft and cost <= 2 distinct names;
        }
        when own follower summoned other where class abysscraft {
            add rush to summoned;
        }
        superevolve {
            buff own.field.followers other +2/+2 where class abysscraft;
        }
    }

    meta {
        pack 10007;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "傍死的安纳提玛·徒姬";
        text """
【<color=Keyword>入场曲</color>】召唤随机2种自己的牌组中费用为2或以下的梦魇·随从。
<hr>自己的其他梦魇·随从进入战场时，使其获得【<color=Keyword>突进</color>】。
<hr><sev>【<color=Keyword>超进化时</color>】使自己的战场上的其他所有梦魇·随从+2/+2。</sev>
""";
    }

    locale eng {
        name "Adahime, Anathema of Death";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 2 random differently named Abysscraft followers that cost 2 or less from your deck.
<hr>Whenever another allied Abysscraft follower enters the field, give it <b><color=Keyword>Rush</color></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give all other allied Abysscraft followers on the field +2/+2.</sev>
""";
    }

    locale jpn {
        name "<rub=\"ぼうし\">傍死</rub>のアナテマ・<rub=\"あだひめ\">徒姫</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分のデッキのコスト2以下のナイトメア・フォロワーからランダム2種類を自分の場に出す。
<hr>自分の他のナイトメア・フォロワーが場に出たとき、それは【<color=Keyword>突進</color>】を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】自分の場の他のナイトメア・フォロワーすべては+2/+2する。</sev>
""";
    }

    locale kor {
        name "사경의 아나테마 도희";
        text """
[<color=Keyword>출격</color>] 비용이 2 이하인 내 덱의 나이트메어 추종자 중 무작위로 2종류를 내 전장에 소환.
<hr>내 다른 나이트메어 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 내 전장의 다른 나이트메어 추종자 모두는 +2/+2.</sev>
""";
    }

    locale cht {
        name "死境的弒滅者‧徒姬";
        text """
【<color=Keyword>入場曲</color>】隨機將2種「自己牌堆中消費為2以下的夜魔‧從者卡」召喚到自己的戰場上。
<hr>當自己的其他夜魔‧從者卡進入戰場時，使其獲得【<color=Keyword>突進</color>】。
<hr><sev>【<color=Keyword>超進化時</color>】使自己戰場上全部的其他夜魔‧從者卡+2/+2。</sev>
""";
    }

}
