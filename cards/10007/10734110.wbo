wbo 0.1.0;

card 10734110 {
    type follower;
    cost 7;
    stats 4/4;
    trait anathema;

    effect {
        aura;
        fanfare {
            earthrite 1 {
                gain own crest 10734110;
            }
        }
        evolve {
            earthrite 1 {
                choose target from oppo.field.followers;
                destroy target;
            }
        }
    }

    crest {
        countdown 1;

        when oppo turn ends {
            summon 1 card 10734110;
            evolve summoned silent;
        }

        locale chs {
            name "纹章：万食的安纳提玛·拉拉安瑟姆";
            text """
【<color=Keyword>吟唱</color>_1】
对手的回合结束时，召唤1个『<color=Keyword>万食的安纳提玛·拉拉安瑟姆</color>』，使其进化。
""";
        }

        locale eng {
            name "Crest: Larasel, Anathema of Insatiety";
            text """
<b><color=Keyword>Countdown</color> (1)</b>
At the end of your opponent's turn, summon a <b><i><color=Keyword>Larasel, Anathema of Insatiety</color></i></b> and evolve it.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"ばんしょく\">万食</rub>のアナテマ・ララアンセム";
            text """
【<color=Keyword>カウントダウン</color>_1】
相手のターン終了時、『<color=Keyword>万食のアナテマ・ララアンセム</color>』1枚を自分の場に出す。それは進化する。
""";
        }

        locale kor {
            name "크레스트: 만식의 아나테마 라라안셈";
            text """
[<color=Keyword>카운트다운</color> 1]
상대방 턴 종료 시, <color=Keyword>만식의 아나테마 라라안셈</color> 1장을 내 전장에 소환. 그 추종자는 진화한다.
""";
        }

        locale cht {
            name "紋章：萬食的安納提瑪‧拉拉安瑟姆";
            text """
【<color=Keyword>倒數</color>_1】
敵方的回合結束時，召喚1張『<color=Keyword>萬食的安納提瑪‧拉拉安瑟姆</color>』，使其進化。
""";
        }
    }

    meta {
        pack 10007;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "万食的安纳提玛·拉拉安瑟姆";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>土之秘术</color>_1】使自己获得『纹章：万食的安纳提玛·拉拉安瑟姆』。
<hr>【<color=Keyword>灵气</color>】
<hr><ev>【<color=Keyword>进化时</color>】【<color=Keyword>土之秘术</color>_1】选择对手的战场上的1个随从，破坏该随从。</ev>
""";
    }

    locale eng {
        name "Lilanthim, Anathema of Predation";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Earth Rite</color> (1)</b> - Gain <b><i>Crest: Lilanthim, Anathema of Predation</i></b>.
<hr><b><color=Keyword>Aura</color></b>
<hr><ev><b><color=Keyword>Evolve</color></b>: <b><color=Keyword>Earth Rite</color> (1)</b> - Select an enemy follower on the field and destroy it.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ばんしょく\">万食</rub>のアナテマ・ララアンセム";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>土の秘術</color>_1】自分は『クレスト：万食のアナテマ・ララアンセム』を持つ。
<hr>【<color=Keyword>オーラ</color>】
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>土の秘術</color>_1】相手の場のフォロワー1枚を選ぶ。それを破壊。</ev>
""";
    }

    locale kor {
        name "만식의 아나테마 라라안셈";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>대지의 비술</color> 1] 나는 「크레스트: 만식의 아나테마 라라안셈」을 갖는다.
<hr>[<color=Keyword>오라</color>]
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>대지의 비술</color> 1] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.</ev>
""";
    }

    locale cht {
        name "萬食的弒滅者‧菈菈安瑟姆";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>土之秘術</color>_1】使自己獲得『紋章：萬食的弒滅者‧菈菈安瑟姆』。
<hr>【<color=Keyword>光紋</color>】
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>土之秘術</color>_1】指定1張敵方戰場上的從者卡。將其破壞。</ev>
""";
    }

}
