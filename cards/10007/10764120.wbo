wbo 0.1.0;

card 10764120 {
    type follower;
    cost 7;
    stats 4/7;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class havencraft;
        rarity legendary;
    }

    locale chs {
        name "崇拜经理人·伊尼西雅";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其消失。若自己的战场上的护符的张数为3张或以上，则回复自己的主战者3点生命值。
<hr>【<color=Keyword>守护</color>】
【<color=Keyword>灵气</color>】
<hr><sev>【<color=Keyword>超进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</sev>
""";
    }

    locale eng {
        name "Initia, Chief Ordination Officer";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and banish it. If there are at least 3 allied amulets on the field, restore 3 defense to your leader.
<hr><b><color=Keyword>Ward</color></b>
<b><color=Keyword>Aura</color></b>
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</sev>
""";
    }

    locale jpn {
        name "アドアマネージャー・イニシア";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを消滅。自分の場のアミュレットの枚数が3以上なら、自分のリーダーを3回復。
<hr>【<color=Keyword>守護</color>】
【<color=Keyword>オーラ</color>】
<hr><sev>【<color=Keyword>超進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</sev>
""";
    }

    locale kor {
        name "추앙의 매니저 이니시아";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 소멸. 내 전장의 마법진 수가 3 이상이라면, 내 리더를 3 회복.
<hr>[<color=Keyword>수호</color>]
[<color=Keyword>오라</color>]
<hr><sev>[<color=Keyword>초진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</sev>
""";
    }

    locale cht {
        name "崇拜的經理人‧伊妮西雅";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其消失。如果自己戰場上的護符卡張數為3以上，則會回復自己的主戰者3點生命值。
<hr>【<color=Keyword>守護</color>】
【<color=Keyword>光紋</color>】
<hr><sev>【<color=Keyword>超進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</sev>
""";
    }

}
