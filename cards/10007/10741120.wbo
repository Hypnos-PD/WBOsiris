wbo 0.1.0;

card 10741120 {
    type follower;
    cost 4;
    stats 3/2;

    effect {
        fanfare {
            choose target from own.field.followers other;
            buff target +2/+2;
        }
        evolve {
            choose target from own.hand.followers;
            buff target +2/+2;
        }
    }

    meta {
        pack 10007;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "载运飞龙";
        text """
【<color=Keyword>入场曲</color>】选择自己的战场上的1个其他随从，使其+2/+2。
<hr><ev>【<color=Keyword>进化时</color>】选择自己的手牌中的1张随从，使其+2/+2。</ev>
""";
    }

    locale eng {
        name "Carrier Wyvern";
        text """
<b><color=Keyword>Fanfare</color></b>: Select another allied follower on the field and give it +2/+2.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select a follower in your hand and give it +2/+2.</ev>
""";
    }

    locale jpn {
        name "キャリーワイバーン";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の他のフォロワー1枚を選ぶ。それは+2/+2する。
<hr><ev>【<color=Keyword>進化時</color>】自分の手札のフォロワー1枚を選ぶ。それは+2/+2する。</ev>
""";
    }

    locale kor {
        name "짐 나르는 와이번";
        text """
[<color=Keyword>출격</color>] 내 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 +2/+2.
<hr><ev>[<color=Keyword>진화시</color>] 내 패에서 추종자 1장을 선택한다. 그 추종자는 +2/+2.</ev>
""";
    }

    locale cht {
        name "運載翼龍";
        text """
【<color=Keyword>入場曲</color>】指定1張自己戰場上的其他從者卡。使其+2/+2。
<hr><ev>【<color=Keyword>進化時</color>】指定1張自己手牌中的從者卡。使其+2/+2。</ev>
""";
    }

}
