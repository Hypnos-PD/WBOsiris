wbo 0.1.0;

card 10722120 {
    type follower;
    cost 5;
    stats 2/3;

    effect {
        unplayable;
    }

    meta {
        pack 10007;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "斩奏医护兵";
        text """
【<color=Keyword>入场曲</color>】抽取2张卡牌。召唤2个『<color=Keyword>骑士</color>』。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成3点伤害。</ev>
""";
    }

    locale eng {
        name "Metronomic Medic";
        text """
<b><color=Keyword>Fanfare</color></b>: Draw 2 cards. Summon 2 copies of <b><i><color=Keyword>Knight</color></i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 3 damage.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ざんそう\">斬奏</rub>の<rub=\"えいせいへい\">衛生兵</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分のデッキから2枚を引く。『<color=Keyword>ナイト</color>』2枚を自分の場に出す。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに3ダメージ。</ev>
""";
    }

    locale kor {
        name "참주의 의무병";
        text """
[<color=Keyword>출격</color>] 내 덱에서 2장을 뽑는다. <color=Keyword>기사</color> 2장을 내 전장에 소환.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 3 피해.</ev>
""";
    }

    locale cht {
        name "斬奏醫護兵";
        text """
【<color=Keyword>入場曲</color>】由自己的牌堆中抽取2張卡片。召喚2張『<color=Keyword>騎士</color>』到自己的戰場上。
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其3點傷害。</ev>
""";
    }

}
