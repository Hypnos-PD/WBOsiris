wbo 0.1.0;

card 90044310 {
    type spell;
    cost 3;

    effect {
        mode {
            option 1 {
                label chs "破坏对手的战场上的所有受伤的随从。";
                label eng "Destroy all damaged enemy followers.";
                label jpn "相手の場のダメージを受けているフォロワーすべてを破壊。";
                label kor "상대방 전장의 피해를 받은 추종자 모두를 파괴.";
                label cht "破壞敵方戰場上所有受傷的從者卡。";
                destroy oppo.field.followers where damaged;
            }
            option 2 {
                label chs "对手的回合结束前，使对手的所有手牌的费用+1。";
                label eng "Until the end of your opponent's turn, increase the cost of all cards in your opponent's hand by 1.";
                label jpn "相手のターン終了まで、相手の手札すべてのコスト+1。";
                label kor "상대방 턴 종료까지 상대방 패의 모든 코스트 +1.";
                label cht "到敵方回合結束為止，使敵方手牌中全部的卡片消費+1。";
                raise cost oppo.hand 1 until oppo turn ends;
            }
        }
    }

    meta {
        pack 90000;
        class dragoncraft;
        rarity legendary;
    }

    locale chs {
        name "银冰吐息";
        text """
【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）破坏对手的战场上的所有受伤的随从。</ridx>
<ridx=1>（2）对手的回合结束前，使对手的所有手牌的费用+1。</ridx>
""";
    }

    locale eng {
        name "Whitefrost Whisper";
        text """
Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Destroy all damaged enemy followers.</ridx>
<ridx=1>2. Increase the cost of all cards in your opponent's hand by 1 until the end of their turn.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"ぎんひょう\">銀氷</rub>の<rub=\"といき\">吐息</rub>";
        text """
【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）相手の場のダメージを受けているフォロワーすべてを破壊。</ridx>
<ridx=1>（2）相手のターン終了まで、相手の手札すべてのコストを+1する。</ridx>
""";
    }

    locale kor {
        name "은빛얼음의 숨결";
        text """
[<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 피해를 받은 상태인 상대방 전장의 추종자 모두를 파괴.</ridx>
<ridx=1>(2) 상대방 턴 종료까지 상대방 패 모두의 비용을 +1.</ridx>
""";
    }

    locale cht {
        name "銀冰吐息";
        text """
指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）破壞敵方戰場上已受到傷害的全部從者卡。</ridx>
<ridx=1>（2）到敵方的回合結束為止，使敵方手牌中全部的卡片消費+1。</ridx>
""";
    }

}
