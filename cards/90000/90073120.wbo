wbo 0.1.0;

card 90073120 {
    type follower;
    cost 5;
    stats 4/4;
    trait artifact;

    effect {
        when own turn ends {
            damage oppo.leader 3;
        }
    }

    meta {
        pack 90000;
        class portalcraft;
        rarity silver;
    }

    locale chs {
