wbo 0.1.0;

card 90021210 {
    type amulet;
    cost 1;

    effect {
        unplayable;
    }

    meta {
        pack 90000;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "令人战栗的海盗旗";
        text """
【<color=Keyword>吟唱</color>_7】
自己使用法术时，本护符的倒计数-1。
【<color=Keyword>谢幕曲</color>】对对手的主战者造成2点伤害。
""";
    }

    locale eng {
        name "Dread Pirate's Flag";
        text """
<b><color=Keyword>Countdown</color> (7)</b>
Whenever you play a spell, advance this amulet's count by 1.
<b><color=Keyword>Last Words</color></b>: Deal 2 damage to the enemy leader.
""";
    }

    locale jpn {
        name "<rub=\"せんりつ\">戦慄</rub>の<rub=\"かいぞくき\">海賊旗</rub>";
        text """
【<color=Keyword>カウントダウン</color>_7】
自分がスペルをプレイしたとき、これのカウントを-1する。
【<color=Keyword>ラストワード</color>】相手のリーダーに2ダメージ。
""";
    }

    locale kor {
        name "전율의 해적기";
        text """
[<color=Keyword>카운트다운</color> 7]
내가 주문을 사용했을 때, 이 마법진의 카운트를 -1.
[<color=Keyword>유언</color>] 상대방 리더에게 2 피해.
""";
    }

    locale cht {
        name "戰慄的海賊旗";
        text """
【<color=Keyword>倒數</color>_7】
當自己使用法術卡時，使這張卡片的倒數回合數-1。
【<color=Keyword>謝幕曲</color>】給予敵方的主戰者2點傷害。
""";
    }

}
