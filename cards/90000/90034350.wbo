wbo 0.1.0;

card 90034350 {
    type spell;
    cost 1;

    effect {
        require target from own.field.followers;
        set_attack_limit target 2;
    }

    meta {
        pack 90000;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "宏大的回归";
        text """
选择自己的战场上的1个随从，使其获得「1回合可以攻击2次」。
""";
    }

    locale eng {
        name "Send 'Em Packing";
        text """
Select an allied follower on the field and give it \"Can attack 2 times per turn.\"
""";
    }

    locale jpn {
        name "<rub=\"おお\">大</rub>いなる<rub=\"かいき\">回帰</rub>";
        text """
自分の場のフォロワー1枚を選ぶ。それは「1ターンに2回攻撃できる。」を持つ。
""";
    }

    locale kor {
        name "위대한 회귀";
        text """
내 전장에서 추종자 1장을 선택한다. 그 추종자는 「1턴에 2회 공격 가능」을 갖는다.
""";
    }

    locale cht {
        name "宏大的回歸";
        text """
指定1張自己戰場上的從者卡。使其獲得「1回合中可進行2次攻擊」。
""";
    }

}
