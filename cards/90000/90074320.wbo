wbo 0.1.0;

card 90074320 {
    type spell;
    cost 0;
    trait encroacher;

    effect {
        unplayable;
    }

    meta {
        pack 90000;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "天斧深渊";
        text """
选择自己的战场上的1个原始费用为5或以上的随从，将1张与其同名的卡牌以非公开形式加入手牌，使其费用-3。
""";
    }

    locale eng {
        name "Depths of the Eld Axe";
        text """
Select an allied follower on the field with a base cost of 5 or more, add a copy of it to your hand without revealing it, and reduce the cost of the copy by 3.
""";
    }

    locale jpn {
        name "<rub=\"てんぷ\">天斧</rub>の<rub=\"しんえん\">深淵</rub>";
        text """
自分の場の元のコスト5以上のフォロワー1枚を選ぶ。それと同名のカード1枚を非公開で自分の手札に加える。それのコストを-3する。
""";
    }

    locale kor {
        name "천부의 심연";
        text """
내 전장에서 원래 비용이 5 이상인 추종자 1장을 선택한다. 그 추종자와 동명의 추종자 1장을 비공개로 내 패에 넣는다. 그 추종자의 비용을 -3.
""";
    }

    locale cht {
        name "天斧的深淵";
        text """
指定1張自己戰場上原始消費為5以上的從者卡。將1張與其同名的卡片以非公開形式增加到自己的手牌中。使其消費-3。
""";
    }

}
