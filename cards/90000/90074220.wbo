wbo 0.1.0;

card 90074220 {
    type amulet;
    cost 3;

    effect {
        countdown 1;
        lastwords {
            damage oppo.leader 1;
            summon 1 card 90074210;
        }
    }

    meta {
        pack 90000;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "新约·黑之章";
        text """
【<color=Keyword>吟唱</color>_1】
【<color=Keyword>谢幕曲</color>】对对手的主战者造成1点伤害。召唤1张『<color=Keyword>新约·白之章</color>』。
""";
    }

    locale eng {
        name "Black Psalm, New Revelation";
        text """
<b><color=Keyword>Countdown</color> (1)</b>
<b><color=Keyword>Last Words</color></b>: Deal 1 damage to the enemy leader. Summon a <b><i><color=Keyword>White Psalm, New Revelation</color></i></b>.
""";
    }

    locale jpn {
        name "<rub=\"しんやく\">新約</rub>・<rub=\"くろ\">黒</rub>の<rub=\"しょう\">章</rub>";
        text """
【<color=Keyword>カウントダウン</color>_1】
【<color=Keyword>ラストワード</color>】相手のリーダーに1ダメージ。『<color=Keyword>新約・白の章</color>』1枚を自分の場に出す。
""";
    }

    locale kor {
        name "신약 흑의 노래";
        text """
[<color=Keyword>카운트다운</color> 1]
[<color=Keyword>유언</color>] 상대방 리더에게 1 피해. <color=Keyword>신약 백의 노래</color> 1장을 내 전장에 소환.
""";
    }

    locale cht {
        name "新約‧黑之章";
        text """
【<color=Keyword>倒數</color>_1】
【<color=Keyword>謝幕曲</color>】給予敵方的主戰者1點傷害。召喚1張『<color=Keyword>新約‧白之章</color>』到自己的戰場上。
""";
    }

}
