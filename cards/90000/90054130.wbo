wbo 0.1.0;

card 90054130 {
    type follower;
    cost 2;
    stats 2/3;

    effect {
        rush;
        ward;
        lastwords {
            random ally from own.field.followers where card 10254110;
            buff ally +1/+0;
        }
    }

    meta {
        pack 90000;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "一尾狐";
        text """
【<color=Keyword>突进</color>】
【<color=Keyword>守护</color>】
【<color=Keyword>谢幕曲</color>】使自己的战场上的随机1个『<color=Keyword>双轮夜行·吟雪&夕月</color>』+1/+0。
""";
    }

    locale eng {
        name "One-Tailed Fox";
        text """
<b><color=Keyword>Rush</color></b>
<b><color=Keyword>Ward</color></b>
<b><color=Keyword>Last Words</color></b>: Give a random allied <b><i><color=Keyword>Ginsetsu & Yuzuki, Twin Calamities</color></i></b> on the field +1/+0.
""";
    }

    locale jpn {
        name "<rub=\"ひと\">一</rub>ツ<rub=\"おぎつね\">尾狐</rub>";
        text """
【<color=Keyword>突進</color>】
【<color=Keyword>守護</color>】
【<color=Keyword>ラストワード</color>】自分の場の『<color=Keyword>双輪夜行・ギンセツ＆ユヅキ</color>』からランダム1枚は+1/+0する。
""";
    }

    locale kor {
        name "일미호";
        text """
[<color=Keyword>돌진</color>]
[<color=Keyword>수호</color>]
