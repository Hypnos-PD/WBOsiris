""";
    }

    locale cht {
        name "一尾狐";
        text """
【<color=Keyword>突進</color>】
【<color=Keyword>守護</color>】
【<color=Keyword>謝幕曲</color>】隨機使1張自己戰場上的『<color=Keyword>雙禍夜行‧吟雪＆夕月</color>』+1/+0。
