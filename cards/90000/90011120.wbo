wbo 0.1.0;

card 90011120 {
    type follower;
    cost 2;
    stats 1/1;
    trait pixie;

    effect {
        ward;
        when own turn ends {
            evolve self silent;
        }
    }

    meta {
        pack 90000;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "新绿的妖精";
        text """
【<color=Keyword>守护</color>】
自己的回合结束时，本随从进化。
""";
    }

    locale eng {
        name "Springbloom Fairy";
        text """
<b><color=Keyword>Ward</color></b>
At the end of your turn, evolve this follower.
""";
    }

    locale jpn {
        name "<rub=\"しんりょく\">新緑</rub>のフェアリー";
        text """
【<color=Keyword>守護</color>】
自分のターン終了時、これは進化する。
""";
    }

    locale kor {
        name "신록의 요정";
        text """
[<color=Keyword>수호</color>]
내 턴 종료시, 이 추종자는 진화한다.
""";
    }

    locale cht {
        name "新綠的妖精";
        text """
【<color=Keyword>守護</color>】
自己的回合結束時，使這張卡片進化。
""";
    }

}
