    }

    meta {
        pack 90000;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "腐臭的僵尸";
        text """
【<color=Keyword>谢幕曲</color>】召唤1个『<color=Keyword>腐臭的僵尸</color>』，使其失去【<color=Keyword>谢幕曲</color>】。
""";
    }

    locale eng {
        name "Rotting Zombie";
        text """
<b><color=Keyword>Last Words</color></b>: Summon a <b><i><color=Keyword>Rotting Zombie</color></i></b> and remove <b><color=Keyword>Last Words</color></b> from it.
""";
    }

    locale jpn {
        name "<rub=\"ふしゅう\">腐臭</rub>のゾンビ";
        text """
【<color=Keyword>ラストワード</color>】『<color=Keyword>腐臭のゾンビ</color>』1枚を自分の場に出す。それは【<color=Keyword>ラストワード</color>】を失う。
""";
    }

    locale kor {
        name "부취 좀비";
        text """
[<color=Keyword>유언</color>] <color=Keyword>부취 좀비</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>유언</color>]을 잃는다.
""";
    }

    locale cht {
        name "腐臭的殭屍";
        text """
【<color=Keyword>謝幕曲</color>】召喚1張『<color=Keyword>腐臭的殭屍</color>』到自己的戰場上。使其失去【<color=Keyword>謝幕曲</color>】。
""";
