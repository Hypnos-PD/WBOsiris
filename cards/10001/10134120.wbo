wbo 0.1.0;

card 10134120 {
    type follower;
    cost 5;
    stats 4/4;
    trait mysteria;

    effect {
        fanfare {
            summon 1 card 90034130;
            spellboost own.hand 3;
        }
        evolve {
            choose target from oppo.field.followers;
            damage target 3;
        }
    }

    meta {
        pack 10001;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "玛纳利亚密友·安&古蕾雅";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>安的巨大英灵</color>』。使自己的所有手牌发动3次魔力增幅。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成3点伤害。</ev>
""";
    }

    locale eng {
        name "Anne & Grea, Mysterian Duo";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon an <b><i><color=Keyword>Anne's Summoning</color></i></b>. Spellboost your hand 3 times.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 3 damage.</ev>
""";
    }

    locale jpn {
        name "マナリアフレンズ・アン＆グレア";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>アンの大英霊</color>』1枚を自分の場に出す。自分の手札すべては3回スペルブーストする。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに3ダメージ。</ev>
""";
    }

    locale kor {
        name "마나리아 프렌즈 앤&글레어";
        text """
[<color=Keyword>출격</color>] <color=Keyword>앤의 대영령</color> 1장을 내 전장에 소환. 내 패 모두를 3회 주문증폭.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 3 피해.</ev>
""";
    }

    locale cht {
        name "馬納歷亞的親愛摯友‧安＆古蕾婭";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>安的巨大英靈</color>』到自己的戰場上。使自己手牌中全部的卡片發動3次魔力增幅。
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其3點傷害。</ev>
""";
    }

}
