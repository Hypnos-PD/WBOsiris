wbo 0.1.0;

card 10131130 {
    type follower;
    cost 3;
    stats 3/3;

    effect {
        fanfare {
            add 1 earthsigil;
        }
        evolve {
            choose target from oppo.field.followers;
            damage target 5;
        }
    }

    meta {
        pack 10001;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "唤枭士";
        text """
【<color=Keyword>入场曲</color>】使自己的战场上的土之印+1。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成5点伤害。</ev>
""";
    }

    locale eng {
        name "Owl Summoner";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain an earth sigil.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 5 damage.</ev>
""";
    }

    locale jpn {
        name "オウルサモナー";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の土の印を+1する。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに5ダメージ。</ev>
""";
    }

    locale kor {
        name "부엉이 소환사";
        text """
[<color=Keyword>출격</color>] 내 전장의 대지의 인장을 +1.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해.</ev>
""";
    }

    locale cht {
        name "智梟召喚師";
        text """
【<color=Keyword>入場曲</color>】使自己戰場上的土之印+1。
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其5點傷害。</ev>
""";
    }

}
