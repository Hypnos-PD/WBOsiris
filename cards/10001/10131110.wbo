wbo 0.1.0;

card 10131110 {
    type follower;
    cost 5;
    stats 1/1;

    effect {
        spellboost {
            buff self +1/+1;
        }
        fanfare {
            choose target from oppo.field.followers;
            damage target self.attack;
        }
    }

    meta {
        pack 10001;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "符文剑操控师";
        text """
【<color=Keyword>魔力增幅时</color>】本随从+1/+1。
<hr>【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成X点伤害。X为本随从的攻击力。
""";
    }

    locale eng {
        name "Runeblade Conductor";
        text """
<b><color=Keyword>On Spellboost</color></b>: Give this follower +1/+1.
<hr><b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it X damage. X is this follower's attack.
""";
    }

    locale jpn {
        name "ルーンブレイドコンダクター";
        text """
【<color=Keyword>スペルブースト時</color>】これは+1/+1する。
<hr>【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それにXダメージ。Xはこれの攻撃力である。
""";
    }

    locale kor {
        name "룬검 지휘관";
        text """
[<color=Keyword>주문증폭시</color>] 이 추종자는 +1/+1.
<hr>[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 X 피해. X는 이 추종자의 공격력.
""";
    }

    locale cht {
        name "符文劍驅使者";
        text """
【<color=Keyword>魔力增幅時</color>】使這張卡片+1/+1。
<hr>【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其X點傷害。X為「這張卡片的攻擊力」。
""";
    }

}
