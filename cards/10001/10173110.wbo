wbo 0.1.0;

card 10173110 {
    type follower;
    cost 3;
    stats 2/3;

    effect {
        fanfare {
            add 1 card 90071210 to hand;
            add 1 card 90071220 to hand;
        }
        evolve {
            add 1 card 90071210 to hand;
            add 1 card 90071220 to hand;
        }
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "决心之誓·米莉亚姆";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>未来核心</color>』和1张『<color=Keyword>过往核心</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Miriam, the Resolute";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gear of Ambition</color></i></b> and <b><i><color=Keyword>Gear of Remembrance</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "レゾリューション・ミリアム";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フューチャー・コア</color>』1枚と『<color=Keyword>パスト・コア</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "결의의 소녀 미리암";
        text """
[<color=Keyword>출격</color>] <color=Keyword>퓨처 코어</color> 1장, <color=Keyword>패스트 코어</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "決意之志‧米莉亞姆";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>未來之核</color>』與1張『<color=Keyword>過往之核</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
