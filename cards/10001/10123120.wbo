wbo 0.1.0;

card 10123120 {
    type follower;
    cost 3;
    stats 2/1;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target 5;
        }
        enhance 6 {
            buff self +2/+2;
            add stealth to self;
        }
    }

    meta {
        pack 10001;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "沉默的狙击手·瓦路兹";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成5点伤害。
【<color=Keyword>爆能强化</color>_6】本随从+2/+2且获得【<color=Keyword>潜行</color>】。
""";
    }

    locale eng {
        name "Valse, Silent Sniper";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 5 damage.
<b><color=Keyword>Enhance</color> (6)</b>: Give this follower +2/+2 and <b><color=Keyword>Ambush</color></b>.
""";
    }

    locale jpn {
        name "サイレントスナイパー・ワルツ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに5ダメージ。
【<color=Keyword>エンハンス</color>_6】これは+2/+2して【<color=Keyword>潜伏</color>】を持つ。
""";
    }

    locale kor {
        name "침묵의 저격수 왈츠";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해.
[<color=Keyword>증강</color> 6] 이 추종자는 +2/+2 및 [<color=Keyword>잠복</color>]을 갖는다.
""";
    }

    locale cht {
        name "寂靜狙擊手‧瓦路茲";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其5點傷害。
【<color=Keyword>爆能強化</color>_6】使這張卡片+2/+2並獲得【<color=Keyword>潛行</color>】。
""";
    }

}
