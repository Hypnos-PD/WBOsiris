wbo 0.1.0;

card 10122130 {
    type follower;
    cost 2;
    stats 1/2;
    trait luminous;

    effect {
        fanfare {
            summon 1 card 90021110;
        }
        when own follower summoned where trait officer {
            add rush to summoned;
        }
    }

    meta {
        pack 10001;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "勇猛的鲁米那斯枪士";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>骑士</color>』。
<hr>自己的士兵·随从进入战场时，使其获得【<color=Keyword>突进</color>】。
""";
    }

    locale eng {
        name "Luminous Lancetrooper";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Knight</color></i></b>.
<hr>Whenever an allied Officer follower enters the field, give it <b><color=Keyword>Rush</color></b>.
""";
    }

    locale jpn {
        name "<rub=\"ゆうもう\">勇猛</rub>のルミナスランサー";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>ナイト</color>』1枚を自分の場に出す。
<hr>自分の兵士・フォロワーが場に出たとき、それは【<color=Keyword>突進</color>】を持つ。
""";
    }

    locale kor {
        name "용맹의 루미나스 랜서";
        text """
[<color=Keyword>출격</color>] <color=Keyword>기사</color> 1장을 내 전장에 소환.
<hr>내 병사 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다.
""";
    }

    locale cht {
        name "勇猛的魯米那斯槍士";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>騎士</color>』到自己的戰場上。
<hr>當自己的士兵‧從者卡進入戰場時，使其獲得【<color=Keyword>突進</color>】。
""";
    }

}
