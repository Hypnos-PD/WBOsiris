wbo 0.1.0;

card 10141140 {
    type follower;
    cost 2;
    stats 1/1;

    effect {
        fanfare {
            summon 1 card 90041110;
        }
        evolve {
            summon 1 card 90041110;
        }
    }

    meta {
        pack 10001;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "育龙少女";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>炽炎幼龙</color>』。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Little Dragon Nanny";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Fire Drake Whelp</color></i></b>.
