wbo 0.1.0;

card 10163220 {
    type amulet;
    cost 6;

    effect {
        engage 0 {
            destroy self;
            destroy field.followers;
        }
    }

    meta {
        pack 10001;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "邪教法器";
        text """
【<color=Keyword>启动</color>】破坏本卡牌。破坏战场上的所有随从。
""";
    }

    locale eng {
        name "Unholy Vessel";
        text """
<b><color=Keyword>Engage</color></b>: Destroy this card and all followers.
""";
