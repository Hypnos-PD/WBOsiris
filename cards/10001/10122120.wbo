wbo 0.1.0;

card 10122120 {
    type follower;
    cost 5;
    stats 1/3;
    trait luminous;

    effect {
        fanfare {
            summon 3 card 90021120;
        }
        when own follower summoned where trait officer {
            add ward to summoned;
        }
    }

    meta {
        pack 10001;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "卓越的鲁米那斯法师";
        text """
【<color=Keyword>入场曲</color>】召唤3个『<color=Keyword>铁甲骑士</color>』。
<hr>自己的士兵·随从进入战场时，使其获得【<color=Keyword>守护</color>】。
""";
    }

    locale eng {
        name "Luminous Magus";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 3 copies of <b><i><color=Keyword>Steelclad Knight</color></i></b>.
<hr>Whenever an allied Officer follower enters the field, give it <b><color=Keyword>Ward</color></b>.
""";
    }

    locale jpn {
        name "<rub=\"たくえつ\">卓越</rub>のルミナスメイジ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>スティールナイト</color>』3枚を自分の場に出す。
<hr>自分の兵士・フォロワーが場に出たとき、それは【<color=Keyword>守護</color>】を持つ。
""";
    }

    locale kor {
        name "탁월의 루미나스 메이지";
        text """
[<color=Keyword>출격</color>] <color=Keyword>철갑 기사</color> 3장을 내 전장에 소환.
<hr>내 병사 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
""";
    }

    locale cht {
        name "卓越的魯米那斯法師";
        text """
【<color=Keyword>入場曲</color>】召喚3張『<color=Keyword>鐵甲騎士</color>』到自己的戰場上。
<hr>當自己的士兵‧從者卡進入戰場時，使其獲得【<color=Keyword>守護</color>】。
""";
    }

}
