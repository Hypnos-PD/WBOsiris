wbo 0.1.0;

card 10123110 {
    type follower;
    cost 7;
    stats 7/6;
    trait levin;

    effect {
        rush;
        fanfare {
            set_attack_limit self 2;
        }
        attack {
            add barrier to self;
            summon 1 card 90021110;
        }
    }

    meta {
        pack 10001;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "雷维翁之斧·杰诺";
        text """
【<color=Keyword>突进</color>】
1回合可以攻击2次。
