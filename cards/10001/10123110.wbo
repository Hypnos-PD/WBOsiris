""";
    }

    locale eng {
        name "Jeno, Levin Axeraider";
        text """
<b><color=Keyword>Rush</color></b>
Can attack 2 times per turn.
<b><color=Keyword>Strike</color></b>: Give this follower <b><color=Keyword>Barrier</color></b>. Summon a <b><i><color=Keyword>Knight</color></i></b>.
""";
    }

    locale jpn {
        name "レヴィオンアックス・ジェノ";
        text """
