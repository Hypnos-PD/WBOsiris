wbo 0.1.0;

card 10152120 {
    type follower;
    cost 2;
    stats 3/3;

    effect {
        fanfare {
            damage own.leader 3;
        }
        evolve {
            heal own.leader 5;
        }
    }

    meta {
        pack 10001;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "梦魇·维莉";
        text """
【<color=Keyword>入场曲</color>】对自己的主战者造成3点伤害。
<hr><ev>【<color=Keyword>进化时</color>】回复自己的主战者5点生命值。</ev>
""";
    }

    locale eng {
        name "Beryl, Nightmare Incarnate";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 3 damage to your leader.
<hr><ev><b><color=Keyword>Evolve</color></b>: Restore 5 defense to your leader.</ev>
""";
    }

    locale jpn {
        name "ナイトメア・ヴェリィ";
        text """
【<color=Keyword>ファンファーレ</color>】自分のリーダーに3ダメージ。
<hr><ev>【<color=Keyword>進化時</color>】自分のリーダーを5回復。</ev>
""";
    }

    locale kor {
        name "나이트메어 베리";
        text """
[<color=Keyword>출격</color>] 내 리더에게 3 피해.
<hr><ev>[<color=Keyword>진화시</color>] 내 리더를 5 회복.</ev>
""";
    }

    locale cht {
        name "夢魔‧維莉";
        text """
【<color=Keyword>入場曲</color>】給予自己的主戰者3點傷害。
<hr><ev>【<color=Keyword>進化時</color>】回復自己的主戰者5點生命值。</ev>
""";
    }

}
