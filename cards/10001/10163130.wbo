wbo 0.1.0;

card 10163130 {
    type follower;
    cost 8;
    stats 7/6;

    effect {
        lastwords {
            gain own crest 10163130;
        }
    }

    crest {
        countdown 2;
        lastwords {
            summon 1 card 10163130;
            add storm to summoned;
        }

        locale chs {
            name "纹章：伟大的炽天使·勒碧丝";
            text """
【<color=Keyword>吟唱</color>_2】
【<color=Keyword>谢幕曲</color>】召唤1个『<color=Keyword>伟大的炽天使·勒碧丝</color>』，使其获得【<color=Keyword>疾驰</color>】。
""";
        }

        locale eng {
            name "Crest: Lapis, Shining Seraph";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
<b><color=Keyword>Last Words</color></b>: Summon a <b><i><color=Keyword>Lapis, Shining Seraph</color></i></b> and give it <b><color=Keyword>Storm</color></b>.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"おお\">大</rub>いなる<rub=\"してんし\">熾天使</rub>・ラピス";
            text """
【<color=Keyword>カウントダウン</color>_2】
【<color=Keyword>ラストワード</color>】『<color=Keyword>大いなる熾天使・ラピス</color>』1枚を自分の場に出す。それは【<color=Keyword>疾走</color>】を持つ。
""";
        }

        locale kor {
            name "크레스트: 위대한 치천사 라피스";
            text """
[<color=Keyword>카운트다운</color> 2]
[<color=Keyword>유언</color>] <color=Keyword>위대한 치천사 라피스</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.
""";
        }

        locale cht {
            name "紋章：崇高的熾天使‧勒碧絲";
            text """
【<color=Keyword>倒數</color>_2】
【<color=Keyword>謝幕曲</color>】召喚1張『<color=Keyword>崇高的熾天使‧勒碧絲</color>』到自己的戰場上。使其獲得【<color=Keyword>疾馳</color>】。
""";
        }
    }

    meta {
        pack 10001;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "伟大的炽天使·勒碧丝";
        text """
【<color=Keyword>谢幕曲</color>】使自己获得『纹章：伟大的炽天使·勒碧丝』。
""";
    }

    locale eng {
        name "Lapis, Shining Seraph";
        text """
<b><color=Keyword>Last Words</color></b>: Gain <b><i>Crest: Lapis, Shining Seraph</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"おお\">大</rub>いなる<rub=\"してんし\">熾天使</rub>・ラピス";
        text """
【<color=Keyword>ラストワード</color>】自分は『クレスト：大いなる熾天使・ラピス』を持つ。
""";
    }

    locale kor {
        name "위대한 치천사 라피스";
        text """
[<color=Keyword>유언</color>] 나는 「크레스트: 위대한 치천사 라피스」를 갖는다.
""";
    }

    locale cht {
        name "崇高的熾天使‧勒碧絲";
        text """
【<color=Keyword>謝幕曲</color>】使自己獲得『紋章：崇高的熾天使‧勒碧絲』。
""";
    }

}
