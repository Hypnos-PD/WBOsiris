wbo 0.1.0;

card 10174120 {
    type follower;
    cost 8;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "迈进之心·奥契丝";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>洛伊德</color>』。
<hr>自己的人偶·随从进入战场时，使其获得【<color=Keyword>疾驰</color>】和【<color=Keyword>毁灭</color>】。
<hr><sev>【<color=Keyword>超进化时</color>】召唤2个『<color=Keyword>改良型·悬丝傀儡</color>』。</sev>
""";
    }

    locale eng {
        name "Orchis, Newfound Heart";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Lloyd</color></i></b>.
<hr>Whenever an allied Puppetry follower enters the field, give it <b><color=Keyword>Storm</color></b> and <b><color=Keyword>Bane</color></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Summon 2 copies of <b><i><color=Keyword>Enhanced Puppet</color></i></b>.</sev>
""";
    }

    locale jpn {
        name "プロシードハート・オーキス";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>ロイド</color>』1枚を自分の場に出す。
<hr>自分の人形・フォロワーが場に出たとき、それは【<color=Keyword>疾走</color>】と【<color=Keyword>必殺</color>】を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】『<color=Keyword>改良型・操り人形</color>』2枚を自分の場に出す。</sev>
""";
    }

    locale kor {
        name "나아가는 마음 오르키스";
        text """
[<color=Keyword>출격</color>] <color=Keyword>로이드</color> 1장을 내 전장에 소환.
<hr>내 인형 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>질주</color>], [<color=Keyword>필살</color>]을 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] <color=Keyword>개량형 꼭두각시 인형</color> 2장을 내 전장에 소환.</sev>
""";
    }

    locale cht {
        name "邁步之心‧奧契絲";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>洛伊德</color>』到自己的戰場上。
<hr>當自己的人偶‧從者卡進入戰場時，使其獲得【<color=Keyword>疾馳</color>】與【<color=Keyword>必殺</color>】。
<hr><sev>【<color=Keyword>超進化時</color>】召喚2張『<color=Keyword>改良型‧懸絲人偶</color>』到自己的戰場上。</sev>
""";
    }

}
