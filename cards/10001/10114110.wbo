wbo 0.1.0;

card 10114110 {
    type follower;
    cost 6;
    stats 4/4;

    effect {
        fanfare {
            gain own crest 10114110;
        }
        evolve {
            summon 3 card 90011110;
        }
    }

    crest {
        when own follower summoned where trait pixie {
            add storm to summoned;
        }

        locale chs {
            name "纹章：自然妖精公主·阿丽雅";
            text """
自己的妖精·随从进入战场时，使其获得【<color=Keyword>疾驰</color>】。
""";
        }

        locale eng {
            name "Crest: Aria, Lady of the Woods";
            text """
Whenever an allied Pixie follower enters the field, give it <b><color=Keyword>Storm</color></b>.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"しぜん\">自然</rub>の<rub=\"ようせいひめ\">妖精姫</rub>・アリア";
            text """
自分の妖精・フォロワーが場に出たとき、それは【<color=Keyword>疾走</color>】を持つ。
""";
        }

        locale kor {
            name "크레스트: 자연의 요정 공주 아리아";
            text """
내 요정 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.
""";
        }

        locale cht {
            name "紋章：自然界的妖精公主‧阿麗雅";
            text """
當自己的妖精‧從者卡進入戰場時，使其獲得【<color=Keyword>疾馳</color>】。
""";
        }
    }

    meta {
        pack 10001;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "自然妖精公主·阿丽雅";
        text """
【<color=Keyword>入场曲</color>】使自己获得『纹章：自然妖精公主·阿丽雅』。
<hr><ev>【<color=Keyword>进化时</color>】召唤3个『<color=Keyword>妖精</color>』。</ev>
""";
    }

    locale eng {
        name "Aria, Lady of the Woods";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain <b><i>Crest: Aria, Lady of the Woods</i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon 3 copies of <b><i><color=Keyword>Fairy</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"しぜん\">自然</rub>の<rub=\"ようせいひめ\">妖精姫</rub>・アリア";
        text """
【<color=Keyword>ファンファーレ</color>】自分は『クレスト：自然の妖精姫・アリア』を持つ。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>フェアリー</color>』3枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "자연의 요정 공주 아리아";
        text """
[<color=Keyword>출격</color>] 나는 「크레스트: 자연의 요정 공주 아리아」를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>요정</color> 3장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "自然界的妖精公主‧阿麗雅";
        text """
【<color=Keyword>入場曲</color>】使自己獲得『紋章：自然界的妖精公主‧阿麗雅』。
<hr><ev>【<color=Keyword>進化時</color>】召喚3張『<color=Keyword>妖精</color>』到自己的戰場上。</ev>
""";
    }

}
