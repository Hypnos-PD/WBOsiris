wbo 0.1.0;

card 10113110 {
    type follower;
    cost 2;
    stats 1/3;

    effect {
        fanfare {
            if own.combo >= 3 {
                choose target from oppo.field.followers;
                set life target 1;
            }
        }
        evolve {
            draw 1;
            choose target from oppo.field.followers;
            damage target 1;
        }
    }

    meta {
        pack 10001;
        class forestcraft;
        rarity gold;
    }

    locale chs {
        name "纯洁冰晶·莉莉";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>连击</color>_3】选择对手的战场上的1个随从，使其生命值变为1。
<hr><ev>【<color=Keyword>进化时</color>】抽取1张卡牌。选择对手的战场上的1张随从，对其造成1点伤害。</ev>
""";
    }

    locale eng {
        name "Lily, Crystalian Innocence";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Combo</color> (3)</b> - Select an enemy follower on the field and set its defense to 1.
<hr><ev><b><color=Keyword>Evolve</color></b>: Draw a card. Select an enemy follower on the field and deal it 1 damage.</ev>
""";
    }

    locale jpn {
        name "ピュアクリスタリア・リリィ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>コンボ</color>_3】相手の場のフォロワー1枚を選ぶ。それは体力1になる。
<hr><ev>【<color=Keyword>進化時</color>】自分のデッキから1枚を引く。相手の場のフォロワー1枚を選ぶ。それに1ダメージ。</ev>
""";
    }

    locale kor {
        name "새하얀 얼음수정족 릴리";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>콤보</color> 3] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 체력이 1이 된다.
<hr><ev>[<color=Keyword>진화시</color>] 내 덱에서 1장을 뽑는다. 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 1 피해.</ev>
""";
    }

    locale cht {
        name "純潔冰晶‧莉莉";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>連擊</color>_3】指定1張敵方戰場上的從者卡。使其生命值轉變為1。
<hr><ev>【<color=Keyword>進化時</color>】由自己的牌堆中抽取1張卡片。指定1張敵方戰場上的從者卡。給予其1點傷害。</ev>
""";
    }

}
