wbo 0.1.0;

card 10172110 {
    type follower;
    cost 4;
    stats 3/3;

    effect {
        fanfare {
            add 1 card 90071210 to hand;
            add 1 card 90071220 to hand;
        }
        evolve {
            summon 1 card 90072110;
        }
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "抗争领袖·露琪娜";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>未来核心</color>』和1张『<color=Keyword>过往核心</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>攻击创造物</color>』。</ev>
""";
    }

    locale eng {
        name "Rukina, Resistance Leader";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gear of Ambition</color></i></b> and <b><i><color=Keyword>Gear of Remembrance</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>Striker Artifact</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "ストラグルリーダー・ルキナ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フューチャー・コア</color>』1枚と『<color=Keyword>パスト・コア</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>アタックアーティファクト</color>』1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "투쟁의 리더 루키나";
        text """
[<color=Keyword>출격</color>] <color=Keyword>퓨처 코어</color> 1장, <color=Keyword>패스트 코어</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>어택 아티팩트</color> 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "奮戰領袖‧露琪娜";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>未來之核</color>』與1張『<color=Keyword>過往之核</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>進攻的創造物</color>』到自己的戰場上。</ev>
""";
    }

}
