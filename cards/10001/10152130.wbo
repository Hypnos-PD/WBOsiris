    locale cht {
        name "奇異探索者‧尤娜";
        text """
【<color=Keyword>守護</color>】
【<color=Keyword>謝幕曲</color>】增加1張『<color=Keyword>怨靈</color>』與1張『<color=Keyword>蝙蝠</color>』到自己的手牌中。
