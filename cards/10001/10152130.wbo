wbo 0.1.0;

card 10152130 {
    type follower;
    cost 4;
    stats 3/5;

    effect {
        ward;
        lastwords {
            add 1 card 90051130 to hand;
            add 1 card 90051120 to hand;
        }
    }

    meta {
        pack 10001;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "怪奇探索者·尤娜";
        text """
【<color=Keyword>守护</color>】
【<color=Keyword>谢幕曲</color>】将1张『<color=Keyword>怨灵</color>』和1张『<color=Keyword>蝙蝠</color>』加入手牌。
""";
    }

    locale eng {
        name "Yuna, Occult Hunter";
        text """
<b><color=Keyword>Ward</color></b>
<b><color=Keyword>Last Words</color></b>: Add a <b><i><color=Keyword>Ghost</color></i></b> and <b><i><color=Keyword>Bat</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"かいき\">怪奇</rub>の<rub=\"たんさくしゃ\">探索者</rub>・ユナ";
        text """
【<color=Keyword>守護</color>】
【<color=Keyword>ラストワード</color>】『<color=Keyword>ゴースト</color>』1枚と『<color=Keyword>バット</color>』1枚を自分の手札に加える。
""";
    }

    locale kor {
        name "괴기 탐색꾼 유나";
        text """
[<color=Keyword>수호</color>]
[<color=Keyword>유언</color>] <color=Keyword>유령</color> 1장, <color=Keyword>박쥐</color> 1장을 내 패에 넣는다.
