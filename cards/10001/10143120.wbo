wbo 0.1.0;

card 10143120 {
    type follower;
    cost 3;
    stats 3/3;

    effect {
        fanfare {
            if overflow {
                evolve self silent;
            }
        }
        when self evolved {
            gain own.maxpp 1;
        }
    }

    meta {
        pack 10001;
        class dragoncraft;
        rarity gold;
    }

    locale chs {
        name "荣弦的天宫·龙芙";
        text """
【<color=Keyword>入场曲</color>】若为【<color=Keyword>觉醒</color>】，则本随从进化。
<hr><ev>本随从进化时，使自己的能量点最大值+1。</ev>
""";
    }

    locale eng {
        name "Liu Feng, Goldennote Ward";
        text """
<b><color=Keyword>Fanfare</color></b>: If you're in <b><color=Keyword>Overflow</color></b>, evolve this follower.
<hr><ev>When this follower evolves, gain 1 max play point.</ev>
""";
    }

    locale jpn {
        name "<rub=\"えいげん\">栄弦</rub>の<rub=\"てんきゅう\">天宮</rub>・リュウフウ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>覚醒</color>】なら、これは進化する。
<hr><ev>これが進化したとき、自分のPP最大値を+1する。</ev>
""";
    }

    locale kor {
        name "영현의 천궁 류후";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>각성</color>]이라면, 이 추종자는 진화한다.
<hr><ev>이 추종자가 진화했을 때, 내 PP 최대치를 +1.</ev>
""";
    }

    locale cht {
        name "榮弦天宮‧琉芙";
        text """
【<color=Keyword>入場曲</color>】如果【<color=Keyword>覺醒</color>】已發動，則會使這張卡片進化。
<hr><ev>當這張卡片進化時，使自己的PP最大值+1。</ev>
""";
    }

}
