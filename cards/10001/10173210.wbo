wbo 0.1.0;

card 10173210 {
    type amulet;
    cost 5;

    effect {
        fanfare {
            add 1 card 90071210 to hand;
        }
        when own card fused {
            random target from oppo.field.followers;
            damage target 2;
        }
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "遗产的炮击";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>未来核心</color>』加入手牌。
<hr>自己进行【<color=Keyword>融合</color>】时，对对手的战场上的随机1个随从造成2点伤害。
""";
    }

    locale eng {
        name "Ancient Cannon";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gear of Ambition</color></i></b> to your hand.
<hr>Whenever you <b><color=Keyword>Fuse</color></b>, deal 2 damage to a random enemy follower.
""";
    }

    locale jpn {
        name "<rub=\"いさん\">遺産</rub>の<rub=\"ほうげき\">砲撃</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フューチャー・コア</color>』1枚を自分の手札に加える。
<hr>自分が【<color=Keyword>融合</color>】したとき、相手の場のフォロワーからランダム1枚に2ダメージ。
""";
    }

    locale kor {
        name "유산의 포격";
        text """
[<color=Keyword>출격</color>] <color=Keyword>퓨처 코어</color> 1장을 내 패에 넣는다.
<hr>내가 [<color=Keyword>융합</color>]했을 때, 상대방 전장의 추종자 중 무작위로 1장에게 2 피해.
""";
    }

    locale cht {
        name "遺產的砲擊";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>未來之核</color>』到自己的手牌中。
<hr>當自己進行【<color=Keyword>融合</color>】時，隨機給予1張敵方戰場上的從者卡2點傷害。
""";
    }

}
