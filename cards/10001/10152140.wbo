wbo 0.1.0;

card 10152140 {
    type follower;
    cost 8;
    stats 5/8;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target 5;
            heal own.leader 5;
        }
    }

    meta {
        pack 10001;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "穿刺公·弗拉德";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成5点伤害。回复自己的主战者5点生命值。
""";
    }

    locale eng {
        name "Vlad, Impaler";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 5 damage. Restore 5 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"くしざ\">串刺</rub>し<rub=\"こう\">公</rub>・ヴラド";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに5ダメージ。自分のリーダーを5回復。
""";
    }

    locale kor {
        name "꿰뚫는 자 블라드";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 5 피해. 내 리더를 5 회복.
""";
    }

    locale cht {
        name "穿刺公‧弗拉德";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其5點傷害。回復自己的主戰者5點生命值。
""";
    }

}
