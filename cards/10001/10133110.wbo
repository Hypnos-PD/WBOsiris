wbo 0.1.0;

card 10133110 {
    type follower;
    cost 5;
    stats 3/3;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            damage target own.earthsigils;
        }
        evolve {
            gain own crest 10133110;
        }
    }

    crest {
        countdown 3;
        when own turn ends {
            earthrite 1 {
                summon 1 card 90031120;
            }
        }

        locale chs {
            name "纹章：黎明炼金术师·诺诺";
            text """
【<color=Keyword>吟唱</color>_3】
自己的回合结束时，【<color=Keyword>土之秘术</color>_1】召唤1个『<color=Keyword>守护者巨像</color>』。
""";
        }

        locale eng {
            name "Crest: Juno, Visionary Alchemist";
            text """
<b><color=Keyword>Countdown</color> (3)</b>
At the end of your turn, <b><color=Keyword>Earth Rite</color> (1)</b> - Summon a <b><i><color=Keyword>Guardian Golem</color></i></b>.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"れいめい\">黎明</rub>の<rub=\"れんきんじゅつし\">錬金術師</rub>・ノノ";
            text """
【<color=Keyword>カウントダウン</color>_3】
自分のターン終了時、【<color=Keyword>土の秘術</color>_1】『<color=Keyword>ガーディアンゴーレム</color>』1枚を自分の場に出す。
""";
        }

        locale kor {
            name "크레스트: 여명의 연금술사 노노";
            text """
[<color=Keyword>카운트다운</color> 3]
내 턴 종료시, [<color=Keyword>대지의 비술</color> 1] <color=Keyword>수호 골렘</color> 1장을 내 전장에 소환.
""";
        }

        locale cht {
            name "紋章：拂曉鍊金術師‧諾諾";
            text """
【<color=Keyword>倒數</color>_3】
自己的回合結束時，【<color=Keyword>土之秘術</color>_1】召喚1張『<color=Keyword>守護者巨像</color>』到自己的戰場上。
""";
        }
    }

    meta {
        pack 10001;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "黎明炼金术师·诺诺";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成X点伤害。X为自己的战场上的土之印数。
<hr><ev>【<color=Keyword>进化时</color>】使自己获得『纹章：黎明炼金术师·诺诺』。</ev>
""";
    }

    locale eng {
        name "Juno, Visionary Alchemist";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it X damage. X is the number of earth sigils you have.
<hr><ev><b><color=Keyword>Evolve</color></b>: Gain <b><i>Crest: Juno, Visionary Alchemist</i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"れいめい\">黎明</rub>の<rub=\"れんきんじゅつし\">錬金術師</rub>・ノノ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それにXダメージ。Xは自分の場の土の印の数である。
<hr><ev>【<color=Keyword>進化時</color>】自分は『クレスト：黎明の錬金術師・ノノ』を持つ。</ev>
""";
    }

    locale kor {
        name "여명의 연금술사 노노";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 X 피해. X는 내 전장의 대지의 인장 수.
<hr><ev>[<color=Keyword>진화시</color>] 나는 「크레스트: 여명의 연금술사 노노」를 갖는다.</ev>
""";
    }

    locale cht {
        name "拂曉鍊金術師‧諾諾";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其X點傷害。X為「自己戰場上的土之印數」。
<hr><ev>【<color=Keyword>進化時</color>】使自己獲得『紋章：拂曉鍊金術師‧諾諾』。</ev>
""";
    }

}
