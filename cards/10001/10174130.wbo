wbo 0.1.0;

card 10174130 {
    type follower;
    cost 8;
    stats 2/2;

    effect {
        fanfare {
            choose targets from own.hand where type follower and trait artifact and cost <= 5 count 3;
            summon copies of targets;
        }
        superevolve {
            buff own.field.followers +1/+1 where trait artifact;
        }
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "增幅加速·洛拉米亚";
        text """
【<color=Keyword>入场曲</color>】选择自己的手牌中的3张费用为5或以下的创造物·随从，召唤对应数量的复制随从。
<hr><sev>【<color=Keyword>超进化时</color>】使自己的战场上的所有创造物·随从+1/+1。</sev>
""";
    }

    locale eng {
        name "Ralmia, Sonic Boom";
        text """
<b><color=Keyword>Fanfare</color></b>: Select 3 Artifact followers in your hand that cost 5 or less and summon an exact copy of each.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give all allied Artifact followers on the field +1/+1.</sev>
""";
    }

    locale jpn {
        name "ブーストエクステンド・ララミア";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札のコスト5以下のアーティファクト・フォロワー3枚を選ぶ。それのコピー1枚を自分の場に出す。
<hr><sev>【<color=Keyword>超進化時</color>】自分の場のアーティファクト・フォロワーすべては+1/+1する。</sev>
""";
    }

    locale kor {
        name "부스트 익스텐드 라라미아";
        text """
[<color=Keyword>출격</color>] 내 패에서 비용이 5 이하인 아티팩트 추종자 3장을 선택한다. 그 추종자의 복사본 1장을 내 전장에 소환.
<hr><sev>[<color=Keyword>초진화시</color>] 내 전장의 아티팩트 추종자 모두는 +1/+1.</sev>
""";
    }

    locale cht {
        name "凌光星馳‧洛菈米亞";
        text """
【<color=Keyword>入場曲</color>】指定3張自己手牌中消費為5以下的創造物‧從者卡。將其複製1張並召喚到自己的戰場上。
<hr><sev>【<color=Keyword>超進化時</color>】使自己戰場上全部的創造物‧從者卡+1/+1。</sev>
""";
    }

}
