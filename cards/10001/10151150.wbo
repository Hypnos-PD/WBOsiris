wbo 0.1.0;

card 10151150 {
    type follower;
    cost 5;
    stats 4/4;

    effect {
        fanfare {
            draw 2;
            damage own.leader 2;
        }
        evolve {
            choose target from oppo.field.followers;
            damage target 6;
        }
    }

    meta {
        pack 10001;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "禁约恶魔";
        text """
【<color=Keyword>入场曲</color>】抽取2张卡牌。对自己的主战者造成2点伤害。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成6点伤害。</ev>
""";
    }

    locale eng {
        name "Darkseal Demon";
        text """
<b><color=Keyword>Fanfare</color></b>: Draw 2 cards. Deal 2 damage to your leader.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 6 damage.</ev>
""";
    }

    locale jpn {
        name "<rub=\"きんやく\">禁約</rub>の<rub=\"あくま\">悪魔</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分のデッキから2枚を引く。自分のリーダーに2ダメージ。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに6ダメージ。</ev>
""";
    }

    locale kor {
        name "금약의 악마";
        text """
[<color=Keyword>출격</color>] 내 덱에서 2장을 뽑는다. 내 리더에게 2 피해.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 6 피해.</ev>
""";
    }

    locale cht {
        name "禁約惡魔";
        text """
【<color=Keyword>入場曲</color>】由自己的牌堆中抽取2張卡片。給予自己的主戰者2點傷害。
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其6點傷害。</ev>
""";
    }

}
