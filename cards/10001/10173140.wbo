wbo 0.1.0;

card 10173140 {
    type follower;
    cost 5;
    stats 2/4;

    effect {
        fanfare {
            add 1 card 90071210 to hand;
            add 1 card 90071220 to hand;
        }
        evolve {
            choose target from own.hand where type follower and trait artifact and cost <= 5;
            summon copies of target;
        }
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "改境的天宫·阿洛艾特";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>未来核心</color>』和1张『<color=Keyword>过往核心</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】选择自己的手牌中的1张费用为5或以下的创造物·随从，召唤对应数量的复制随从。</ev>
""";
    }

    locale eng {
        name "Alouette, Doomwright Ward";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Gear of Ambition</color></i></b> and <b><i><color=Keyword>Gear of Remembrance</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an Artifact follower in your hand that costs 5 or less and summon an exact copy of it.</ev>
""";
    }

    locale jpn {
        name "<rub=\"かいきょう\">改境</rub>の<rub=\"てんきゅう\">天宮</rub>・アルエット";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>フューチャー・コア</color>』1枚と『<color=Keyword>パスト・コア</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】自分の手札のコスト5以下のアーティファクト・フォロワー1枚を選ぶ。それのコピー1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "개경의 천궁 알루에트";
        text """
[<color=Keyword>출격</color>] <color=Keyword>퓨처 코어</color> 1장, <color=Keyword>패스트 코어</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] 내 패에서 비용이 5 이하인 아티팩트 추종자 1장을 선택한다. 그 추종자의 복사본 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "改境天宮‧亞露愛得";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>未來之核</color>』與1張『<color=Keyword>過往之核</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】指定1張自己手牌中消費為5以下的創造物‧從者卡。將其複製1張並召喚到自己的戰場上。</ev>
""";
    }

}
