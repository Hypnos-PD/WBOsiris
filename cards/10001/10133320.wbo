wbo 0.1.0;

card 10133320 {
    type spell;
    cost 7;

    effect {
        spellboost {
            reduce cost self 1 minimum 0;
        }
        summon 1 card 90031140;
    }

    meta {
        pack 10001;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "唤鬼术";
        text """
【<color=Keyword>魔力增幅时</color>】使本卡牌的费用-1。
<hr>召唤1个『<color=Keyword>式神·暴鬼</color>』。
""";
    }

    locale eng {
        name "Demonic Call";
        text """
<b><color=Keyword>On Spellboost</color></b>: Reduce the cost of this card by 1.
<hr>Summon a <b><i><color=Keyword>Demonic Shikigami</color></i></b>.
""";
    }

    locale jpn {
        name "<rub=\"おによ\">鬼呼</rub>びの<rub=\"じゅつ\">術</rub>";
        text """
【<color=Keyword>スペルブースト時</color>】これのコストを-1する。
