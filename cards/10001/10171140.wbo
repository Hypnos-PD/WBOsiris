wbo 0.1.0;

card 10171140 {
    type follower;
    cost 3;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10001;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "自动机械刺客";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>改良型·悬丝傀儡</color>』加入手牌。
<hr>自己的人偶·随从进入战场时，自己的每回合中可触发1次，使其获得【<color=Keyword>毁灭</color>】。
""";
    }

    locale eng {
        name "Medical-Grade Assassin";
        text """
<b><color=Keyword>Fanfare</color></b>: Add an <b><i><color=Keyword>Enhanced Puppet</color></i></b> to your hand.
<hr>Once on each of your turns, when an allied Puppetry follower enters the field, give it <b><color=Keyword>Bane</color></b>.
""";
    }

    locale jpn {
        name "オートマタアサシン";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>改良型・操り人形</color>』1枚を自分の手札に加える。
<hr>自分の人形・フォロワーが場に出たとき、自分のターンごとに1回、それは【<color=Keyword>必殺</color>】を持つ。
""";
    }

    locale kor {
        name "오토마타 어쌔신";
        text """
[<color=Keyword>출격</color>] <color=Keyword>개량형 꼭두각시 인형</color> 1장을 내 패에 넣는다.
<hr>내 인형 추종자가 전장에 소환되었을 때, 내 턴마다 1회에 한해 그 추종자는 [<color=Keyword>필살</color>]을 갖는다.
""";
    }

    locale cht {
        name "機偶暗殺者";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>改良型‧懸絲人偶</color>』到自己的手牌中。
<hr>當自己的人偶‧從者卡進入戰場時，每個自己的回合僅限發動1次，使其獲得【<color=Keyword>必殺</color>】。
""";
    }

}
