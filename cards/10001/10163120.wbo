wbo 0.1.0;

card 10163120 {
    type follower;
    cost 4;
    stats 1/3;

    effect {
        stealth;
        evolve {
            choose target from oppo.field.followers;
            destroy target;
        }
    }

    meta {
        pack 10001;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "禁密的天宫·罗纳维罗";
        text """
【<color=Keyword>潜行</color>】
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，破坏该随从。</ev>
""";
    }

    locale eng {
        name "Ronavero, Darkhaven Ward";
        text """
<b><color=Keyword>Ambush</color></b>
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and destroy it.</ev>
""";
    }

    locale jpn {
        name "<rub=\"きんみつ\">禁密</rub>の<rub=\"てんきゅう\">天宮</rub>・ロナヴェロ";
        text """
【<color=Keyword>潜伏</color>】
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。</ev>
""";
    }

    locale kor {
        name "금밀의 천궁 로나베로";
        text """
[<color=Keyword>잠복</color>]
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.</ev>
""";
    }

    locale cht {
        name "禁密天宮‧羅納威洛";
        text """
【<color=Keyword>潛行</color>】
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。將其破壞。</ev>
""";
    }

}
