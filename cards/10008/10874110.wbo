wbo 0.1.0;

card 10874110 {
    type follower;
    cost 5;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "决断的交错·亚修雷&莉缇雅";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其获得【<color=Keyword>守护</color>】。
【<color=Keyword>爆能强化</color>_9】本随从进化。本随从获得【<color=Keyword>疾驰</color>】。
<hr><ev>本随从进化时，破坏对手的战场上的随机2个拥有【<color=Keyword>守护</color>】的随从。</ev>
""";
    }

    locale eng {
        name "Asher & Lydia, Paths Beyond";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and give it <b><color=Keyword>Ward</color></b>.
<b><color=Keyword>Enhance</color> (9)</b>: Evolve this follower and give it <b><color=Keyword>Storm</color></b>.
<hr><ev>When this follower evolves, destroy 2 random enemy followers with <b><color=Keyword>Ward</color></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"けつだん\">決断</rub>の<rub=\"こうさ\">交差</rub>・アシュレイ＆リディア";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それは【<color=Keyword>守護</color>】を持つ。
【<color=Keyword>エンハンス</color>_9】これは進化する。これは【<color=Keyword>疾走</color>】を持つ。
<hr><ev>これが進化したとき、相手の場の【<color=Keyword>守護</color>】を持つフォロワーからランダム2枚を破壊。</ev>
""";
    }

    locale kor {
        name "맞닿은 결단 애쉬레이&리디아";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
[<color=Keyword>증강</color> 9] 이 추종자는 진화한다. 이 추종자는 [<color=Keyword>질주</color>]를 갖는다.
<hr><ev>이 추종자가 진화했을 때, [<color=Keyword>수호</color>]를 가진 상대방 전장의 추종자 중 무작위로 2장을 파괴.</ev>
""";
    }

    locale cht {
        name "決斷的交會‧亞修雷＆莉媞雅";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其獲得【<color=Keyword>守護</color>】。
【<color=Keyword>爆能強化</color>_9】使這張卡片進化。使這張卡片獲得【<color=Keyword>疾馳</color>】。
<hr><ev>當這張卡片進化時，隨機破壞2張敵方戰場上擁有【<color=Keyword>守護</color>】的從者卡。</ev>
""";
    }

}
