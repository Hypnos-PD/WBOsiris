wbo 0.1.0;

card 10862310 {
    type spell;
    cost 2;

    effect {
        choose target from oppo.field.followers where life <= 3;
        banish target;
        enhance 5 replaces {
            banish oppo.field.followers where life <= 3;
        }
    }

    meta {
        pack 10008;
        class havencraft;
        rarity silver;
    }

    locale chs {
        name "威胁的残渣";
        text """
选择对手的战场上的1个生命值为3或以下的随从，使其消失。
【<color=Keyword>爆能强化</color>_5】改为使对手的战场上的所有生命值为3或以下的随从消失。
""";
    }

    locale eng {
        name "Lingering Threat";
        text """
Select an enemy follower on the field with 3 defense or less and banish it.
<b><color=Keyword>Enhance</color> (5)</b>: Banish all enemy followers with 3 defense or less instead.
""";
    }

    locale jpn {
        name "<rub=\"きょうい\">脅威</rub>の<rub=\"ざんし\">残滓</rub>";
        text """
相手の場の体力3以下のフォロワー1枚を選ぶ。それを消滅。
【<color=Keyword>エンハンス</color>_5】1枚を選ぶのではなくすべて。
""";
    }

    locale kor {
        name "위협의 잔재";
        text """
상대방 전장에서 체력이 3 이하인 추종자 1장을 선택한다. 그 추종자를 소멸.
[<color=Keyword>증강</color> 5] 1장을 선택하는 대신 모두.
""";
    }

    locale cht {
        name "威脅的餘燼";
        text """
指定1張敵方戰場上生命值為3以下的從者卡。使其消失。
【<color=Keyword>爆能強化</color>_5】由原本的指定1張轉變為全部。
""";
    }

}
