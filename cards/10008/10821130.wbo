wbo 0.1.0;

card 10821130 {
    type follower;
    cost 4;
    stats 3/3;

    effect {
        fanfare {
            summon 1 card 90021120;
            add rush to summoned;
        }
        evolve {
            summon 1 card 90021120;
            add ward to summoned;
        }
    }

    meta {
        pack 10008;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "悠久的骑士·莎夏";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>铁甲骑士</color>』，使其获得【<color=Keyword>突进</color>】。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>铁甲骑士</color>』，使其获得【<color=Keyword>守护</color>】。</ev>
""";
    }

    locale eng {
        name "Sasha, Knight Everlasting";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Steelclad Knight</color></i></b> and give it <b><color=Keyword>Rush</color></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>Steelclad Knight</color></i></b> and give it <b><color=Keyword>Ward</color></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ゆうきゅう\">悠久</rub>の<rub=\"きし\">騎士</rub>・サーシャ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>スティールナイト</color>』1枚を自分の場に出す。それは【<color=Keyword>突進</color>】を持つ。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>スティールナイト</color>』1枚を自分の場に出す。それは【<color=Keyword>守護</color>】を持つ。</ev>
""";
    }

    locale kor {
        name "유구의 기사 사샤";
        text """
[<color=Keyword>출격</color>] <color=Keyword>철갑 기사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>철갑 기사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.</ev>
""";
    }

    locale cht {
        name "悠久騎士‧薩莎";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>鐵甲騎士</color>』到自己的戰場上。使其獲得【<color=Keyword>突進</color>】。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>鐵甲騎士</color>』到自己的戰場上。使其獲得【<color=Keyword>守護</color>】。</ev>
""";
    }

}
