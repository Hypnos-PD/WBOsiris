wbo 0.1.0;

card 10834120 {
    type follower;
    cost 7;
    stats 5/5;

    effect {
        fanfare {
            summon 2 card 90031120;
        }
        // 英文把"增幅手牌"并进入场监听里：每有一张其他随从入场就给它突进并增幅手牌 1 次。
        when own follower summoned other {
            add rush to summoned;
            spellboost own.hand 1;
        }
        evolve {
            summon 1 card 90031120;
        }
    }

    meta {
        pack 10008;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "灾难言灵·洋荷";
        text """
【<color=Keyword>入场曲</color>】召唤2个『<color=Keyword>守护者巨像</color>』。
<hr>自己的其他随从进入战场时，使其获得【<color=Keyword>突进</color>】。使自己的所有手牌发动1次魔力增幅。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>守护者巨像</color>』。</ev>
""";
    }

    locale eng {
        name "Ginger, Disastrous Word";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 2 copies of <b><i><color=Keyword>Guardian Golem</color></i></b>.
<hr>Whenever another allied follower enters the field, give it <b><color=Keyword>Rush</color></b> and spellboost your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>Guardian Golem</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"わざわ\">災</rub>いの<rub=\"ことだま\">言霊</rub>・ジンジャー";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>ガーディアンゴーレム</color>』2枚を自分の場に出す。
<hr>自分の他のフォロワーが場に出たとき、それは【<color=Keyword>突進</color>】を持つ。自分の手札すべては1回スペルブーストする。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>ガーディアンゴーレム</color>』1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "재앙의 언령 진저";
        text """
[<color=Keyword>출격</color>] <color=Keyword>수호 골렘</color> 2장을 내 전장에 소환.
<hr>내 다른 추종자가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다. 내 패 모두를 1회 주문증폭.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>수호 골렘</color> 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "災厄言靈‧洋荷";
        text """
【<color=Keyword>入場曲</color>】召喚2張『<color=Keyword>守護者巨像</color>』到自己的戰場上。
<hr>當自己的其他從者卡進入戰場時，使其獲得【<color=Keyword>突進</color>】。使自己手牌中全部的卡片發動1次魔力增幅。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>守護者巨像</color>』到自己的戰場上。</ev>
""";
    }

}
