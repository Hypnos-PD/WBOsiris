    locale eng {
        name "Lilium, Witch of the Tomes";
        text """
<b><color=Keyword>Last Words</color></b>: Draw a card.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field, remove all abilities from it, and deal it 2 damage.</ev>
""";
    }

    locale jpn {
        name "<rub=\"としょしつ\">図書室</rub>の<rub=\"まじょ\">魔女</rub>・リリウム";
        text """
【<color=Keyword>ラストワード</color>】自分のデッキから1枚を引く。
