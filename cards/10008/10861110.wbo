    meta {
        pack 10008;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "图书室的魔女·莉莉尤姆";
        text """
【<color=Keyword>谢幕曲</color>】抽取1张卡牌。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，使其失去所有能力，对其造成2点伤害。</ev>
""";
