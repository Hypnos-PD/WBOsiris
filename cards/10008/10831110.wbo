wbo 0.1.0;

card 10831110 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class runecraft;
        rarity bronze;
    }

    locale chs {
        name "森绿的恩惠·喵鲁&圆滚滚2号&吉娜";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成1点伤害。使自己的所有手牌发动1次魔力增幅。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Meowskers, Roly-Poly Mk II & Djeana";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 1 damage. Spellboost your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"みどり\">緑</rub>の<rub=\"さち\">幸</rub>・ムニャール＆マンマル2<rub=\"ごう\">号</rub>＆ジーナ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに1ダメージ。自分の手札すべては1回スペルブーストする。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "푸르른 행복 므냐르&동글이 2호&지나";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 1 피해. 내 패 모두를 1회 주문증폭.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "自然的恩惠‧喵魯＆圓滾滾2號＆吉娜";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其1點傷害。使自己手牌中全部的卡片發動1次魔力增幅。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
