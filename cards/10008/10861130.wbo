wbo 0.1.0;

card 10861130 {
    type follower;
    cost 5;
    stats 3/2;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            destroy target;
        }
        evolve {
            choose target from oppo.field.followers;
            destroy target;
        }
    }

    meta {
        pack 10008;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "亡灵猎人·格兰特";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Grant, Hunter of Undeath";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "イモータルハンター・グラント";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "이모탈 헌터 그랜트";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "不滅的獵人‧古蘭特";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
