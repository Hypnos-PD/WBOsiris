wbo 0.1.0;

card 10811130 {
    type follower;
    cost 1;
    stats 1/1;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "忧郁少女·莫埃尔";
        text """
【<color=Keyword>入场曲</color>】选择自己的1张手牌，使其返回牌组。抽取1张卡牌。
<hr>【<color=Keyword>守护</color>】
""";
    }

    locale eng {
        name "Moelle, Gloomy Maiden";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a card in your hand and return it to deck. Draw a card.
<hr><b><color=Keyword>Ward</color></b>
""";
    }

    locale jpn {
        name "グルーミーガール・モエル";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札1枚を選ぶ。それをデッキに戻す。自分のデッキから1枚を引く。
<hr>【<color=Keyword>守護</color>】
""";
    }

    locale kor {
        name "글루미 걸 모엘";
        text """
[<color=Keyword>출격</color>] 내 패에서 1장을 선택한다. 그 카드를 덱으로 되돌린다. 내 덱에서 1장을 뽑는다.
<hr>[<color=Keyword>수호</color>]
""";
    }

    locale cht {
        name "灰暗少女‧莫耶兒";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中的卡片。使其返回牌堆中。由自己的牌堆中抽取1張卡片。
<hr>【<color=Keyword>守護</color>】
""";
    }

}
