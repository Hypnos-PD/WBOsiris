wbo 0.1.0;

card 10863110 {
    type follower;
    cost 3;
    stats 2/4;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "圣洁驱魔人·珂蕾特";
        text """
【<color=Keyword>入场曲</color>】若自己的战场上有进化后的随从，则本随从进化。
<hr>【<color=Keyword>守护</color>】
<hr><ev>本随从进化时，发动2次「对对手的战场上的随机1个随从造成1点伤害」。</ev>
""";
    }

    locale eng {
        name "Colette, Holy Exorcist";
        text """
<b><color=Keyword>Fanfare</color></b>: If there's an evolved allied follower on the field, evolve this follower.
<hr><b><color=Keyword>Ward</color></b>
<hr><ev>When this follower evolves, do this 2 times: \"Deal 1 damage to a random enemy follower.\"</ev>
""";
    }

    locale jpn {
        name "セイントエクソシスト・コレット";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場に進化後のフォロワーがあるなら、これは進化する。
<hr>【<color=Keyword>守護</color>】
<hr><ev>これが進化したとき、「相手の場のフォロワーからランダム1枚に1ダメージ。」を2回行う。</ev>
""";
    }

    locale kor {
        name "세인트 엑소시스트 코렛";
        text """
[<color=Keyword>출격</color>] 내 전장에 진화후인 추종자가 있다면, 이 추종자는 진화한다.
<hr>[<color=Keyword>수호</color>]
<hr><ev>이 추종자가 진화했을 때, 「상대방 전장의 추종자 중 무작위로 1장에게 1 피해」를 2회 발동.</ev>
""";
    }

    locale cht {
        name "聖潔驅魔師‧珂蕾特";
        text """
【<color=Keyword>入場曲</color>】如果自己戰場上有已進化的從者卡，則會使這張卡片進化。
<hr>【<color=Keyword>守護</color>】
<hr><ev>當這張卡片進化時，發動2次「隨機給予1張敵方戰場上的從者卡1點傷害」。</ev>
""";
    }

}
