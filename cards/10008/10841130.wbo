wbo 0.1.0;

card 10841130 {
    type follower;
    cost 2;
    stats 1/2;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "沧海之精";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>大海虎鲸</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】使自己获得『纹章：沧海之精』。</ev>
""";
    }

    locale eng {
        name "Spirit of Wadatsumi";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Majestic Megalorca</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Gain <b><i>Crest: Spirit of Wadatsumi</i></b>.</ev>
""";
    }

    locale jpn {
        name "わだつみの<rub=\"せい\">精</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>大海のオルカ</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】自分は『クレスト：わだつみの精』を持つ。</ev>
""";
    }

    locale kor {
        name "바다신의 정령";
        text """
[<color=Keyword>출격</color>] <color=Keyword>대해의 오르카</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] 나는 「크레스트: 바다신의 정령」을 갖는다.</ev>
""";
    }

    locale cht {
        name "掌海精靈";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>滄海虎鯨</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】使自己獲得『紋章：掌海精靈』。</ev>
""";
    }

}
