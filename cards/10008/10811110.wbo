wbo 0.1.0;

card 10811110 {
    type follower;
    cost 7;
    stats 6/6;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "昔日的天秤·马龙";
        text """
【<color=Keyword>入场曲</color>】破坏对手的战场上的随机X个随从。X为「对手的战场上的随从数减去自己的战场上的随从数」。
""";
    }

    locale eng {
        name "Marlone, Scales of the Past";
        text """
<b><color=Keyword>Fanfare</color></b>: Destroy X random enemy followers. X is the number of enemy followers on the field minus the number of allied followers on the field.
""";
    }

    locale jpn {
        name "<rub=\"せきじつ\">昔日</rub>の<rub=\"てんびん\">天秤</rub>・マーロン";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーからランダムX枚を破壊。Xは「相手の場のフォロワーの枚数から、自分の場のフォロワーの枚数を引いた数」である。
""";
    }

    locale kor {
        name "지난날의 천칭 머론";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 중 무작위로 X장을 파괴. X는 상대방 전장의 추종자 수에서 내 전장의 추종자 수를 뺀 수.
""";
    }

    locale cht {
        name "昔日的天秤‧馬龍";
        text """
【<color=Keyword>入場曲</color>】隨機破壞X張敵方戰場上的從者卡。X為「敵方戰場上的從者卡張數減去自己戰場上的從者卡張數」。
""";
    }

}
