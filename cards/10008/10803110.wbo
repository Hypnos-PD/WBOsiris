wbo 0.1.0;

card 10803110 {
    type follower;
    cost 2;
    stats 2/1;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class neutral;
        rarity gold;
    }

    locale chs {
        name "遗忘的纯真·爱卡";
        text """
【<color=Keyword>入场曲</color>】将随机1张与本次对战中被破坏的自己的随从同名的卡牌以非公开形式加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Aika, Elegy of Loss";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a copy of a random allied follower destroyed this match to your hand without revealing it.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ぼうしつ\">忘失</rub>の<rub=\"むく\">無垢</rub>・アイカ";
        text """
【<color=Keyword>ファンファーレ</color>】このバトル中に破壊された自分のフォロワーからランダム1枚と同名のカード1枚を非公開で自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "기억 잃은 순수 아이카";
        text """
[<color=Keyword>출격</color>] 이번 대전에서 파괴된 내 추종자 중 무작위로 1장과 동명의 추종자 1장을 비공개로 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "遺忘的純潔‧雅卡";
        text """
【<color=Keyword>入場曲</color>】隨機將1張與「本次對戰中自己已被破壞的從者卡」同名的卡片以非公開形式增加到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
