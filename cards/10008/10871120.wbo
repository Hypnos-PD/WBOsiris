    locale eng {
        name "Leona, Overbearing Guardian";
        text """
<b><color=Keyword>Ward</color></b>
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Select another allied follower on the field and give it <b><color=Keyword>Ambush</color></b>.</sev>
""";
