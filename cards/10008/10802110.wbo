wbo 0.1.0;

card 10802110 {
    type follower;
    cost 4;
    stats 1/3;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class neutral;
        rarity silver;
    }

    locale chs {
        name "激动的欢喜·阿尔菲德";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。
<hr><ev>【<color=Keyword>进化时</color>】本随从获得【<color=Keyword>疾驰</color>】。</ev>
""";
    }

    locale eng {
        name "Alfied, Squire of Joy";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage.
<hr><ev><b><color=Keyword>Evolve</color></b>: Give this follower <b><color=Keyword>Storm</color></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"はやがね\">早鐘</rub>の<rub=\"かんき\">歓喜</rub>・アルフィード";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。
<hr><ev>【<color=Keyword>進化時</color>】これは【<color=Keyword>疾走</color>】を持つ。</ev>
""";
    }

    locale kor {
        name "가슴 벅찬 환희 알피드";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해.
<hr><ev>[<color=Keyword>진화시</color>] 이 추종자는 [<color=Keyword>질주</color>]를 갖는다.</ev>
""";
    }

    locale cht {
        name "雀躍的欣喜‧艾爾斐德";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。
<hr><ev>【<color=Keyword>進化時</color>】使這張卡片獲得【<color=Keyword>疾馳</color>】。</ev>
""";
    }

}
