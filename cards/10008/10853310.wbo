wbo 0.1.0;

card 10853310 {
    type spell;
    cost 2;

    effect {
        choose target from own.hand;
        return target to deck;
        draw 2;
        if own.superevolve_unlocked {
            reduce cost target 1 minimum 0;
        }
    }

    meta {
        pack 10008;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "改变的流向";
        text """
选择自己的1张手牌，使其返回牌组。抽取2张卡牌。若为超进化已解禁的回合，则使其费用-1。
""";
    }

    locale eng {
        name "Ebb and Flow";
        text """
Select a card in your hand and return it to deck. Draw 2 cards. If you've unlocked super-evolution, reduce their costs by 1.
""";
    }

    locale jpn {
        name "<rub=\"か\">変</rub>わりし<rub=\"なが\">流</rub>れ";
        text """
自分の手札1枚を選ぶ。それをデッキに戻す。自分のデッキから2枚を引く。超進化可能ターンなら、それのコストを-1する。
""";
    }

    locale kor {
        name "변화한 흐름";
        text """
내 패에서 1장을 선택한다. 그 카드를 덱으로 되돌린다. 내 덱에서 2장을 뽑는다. 초진화 가능 턴이라면, 그 카드의 비용을 -1.
""";
    }

    locale cht {
        name "蛻變的波流";
        text """
指定1張自己手牌中的卡片。使其返回牌堆中。由自己的牌堆中抽取2張卡片。如果為已超進化解禁的回合，則會使其消費-1。
""";
    }

}
