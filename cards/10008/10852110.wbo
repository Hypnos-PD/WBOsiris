wbo 0.1.0;

card 10852110 {
    type follower;
    cost 6;
    stats 3/5;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "母爱恶魔·菲欧蕾";
        text """
【<color=Keyword>入场曲</color>】召唤3个『<color=Keyword>蝙蝠</color>』。
<hr>自己的『<color=Keyword>蝙蝠</color>』进入战场时，使其获得【<color=Keyword>突进</color>】。
""";
    }

    locale eng {
        name "Fiole, Devilish Matriarch";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 3 copies of <b><i><color=Keyword>Bat</color></i></b>.
<hr>Whenever an allied <b><i><color=Keyword>Bat</color></i></b> enters the field, give it <b><color=Keyword>Rush</color></b>.
""";
    }

    locale jpn {
        name "マザーな<rub=\"あくま\">悪魔</rub>・フィオレ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>バット</color>』3枚を自分の場に出す。
<hr>自分の『<color=Keyword>バット</color>』が場に出たとき、それは【<color=Keyword>突進</color>】を持つ。
""";
    }

    locale kor {
        name "마더 악마 피오레";
        text """
[<color=Keyword>출격</color>] <color=Keyword>박쥐</color> 3장을 내 전장에 소환.
<hr>내 <color=Keyword>박쥐</color>가 전장에 소환되었을 때, 그 추종자는 [<color=Keyword>돌진</color>]을 갖는다.
""";
    }

    locale cht {
        name "母愛惡魔‧費歐菈";
        text """
【<color=Keyword>入場曲</color>】召喚3張『<color=Keyword>蝙蝠</color>』到自己的戰場上。
<hr>當自己的『<color=Keyword>蝙蝠</color>』進入戰場時，使其獲得【<color=Keyword>突進</color>】。
""";
    }

}
