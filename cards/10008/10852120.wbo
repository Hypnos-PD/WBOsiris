wbo 0.1.0;

card 10852120 {
    type follower;
    cost 5;
    stats 5/4;

    effect {
        fanfare {
            damage oppo.field.followers 1;
            damage all.leaders 1;
        }
        evolve {
            damage oppo.field.followers 1;
            damage all.leaders 1;
        }
    }

    meta {
        pack 10008;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "黑暗骑士·玛莎";
        text """
【<color=Keyword>入场曲</color>】对对手的战场上的所有随从和所有主战者造成1点伤害。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Marsha, Dark Knight";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 1 damage to all enemy followers and both leaders.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "ダークナイト・マーシャ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーすべてとリーダーすべてに1ダメージ。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "다크나이트 마샤";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 모두와 리더 모두에게 1 피해.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "黑暗騎士‧瑪瑟";
        text """
【<color=Keyword>入場曲</color>】給予敵方戰場上全部的從者卡與全部的主戰者1點傷害。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
