wbo 0.1.0;

card 10874120 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            add 1 card 90071130 to hand;
        }
        evolve {
            choose target from own.field.followers other where form unevolved;
            evolve target silent;
        }
    }

    meta {
        pack 10008;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "你的前辈·欧丝";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>解析的创造物</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】选择自己的战场上的1个进化前的其他随从，使其进化。</ev>
""";
    }

    locale eng {
        name "Eudie, Your Dependable Mentor";
        text """
<b><color=Keyword>Fanfare</color></b>: Add an <b><i><color=Keyword>Analyzing Artifact</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select another unevolved allied follower on the field and evolve it.</ev>
""";
    }

    locale jpn {
        name "アナタの<rub=\"せんぱい\">先輩</rub>・エース";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>アナライズアーティファクト</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】自分の場の他の進化前のフォロワー1枚を選ぶ。それは進化する。</ev>
""";
    }

    locale kor {
        name "당신의 선배 에이스";
        text """
[<color=Keyword>출격</color>] <color=Keyword>분석의 아티팩트</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] 내 전장에서 진화전인 다른 추종자 1장을 선택한다. 그 추종자는 진화한다.</ev>
""";
    }

    locale cht {
        name "你的前輩‧歐絲";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>解析的創造物</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】指定1張自己戰場上其他進化前的從者卡。使其進化。</ev>
""";
    }

}
