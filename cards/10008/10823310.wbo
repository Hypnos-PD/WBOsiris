wbo 0.1.0;

card 10823310 {
    type spell;
    cost 2;

    effect {
        unplayable;
    }

    meta {
        pack 10008;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "相伴相随的日常";
        text """
【<color=Keyword>模式</color>】选择1个能力发动。若自己的战场上的卡牌的张数为2张或以上，则改为发动所有能力。
<ridx=0>（1）对对手的战场上的随机1个随从造成4点伤害。</ridx>
<ridx=1>（2）回复自己的主战者2点生命值。</ridx>
""";
    }

    locale eng {
        name "Slice of Domesticity";
        text """
Select a <b><color=Keyword>Mode</color></b> to activate. If there are at least 2 allied cards on the field, activate all of them instead.
<ridx=0>1. Deal 4 damage to a random enemy follower.</ridx>
<ridx=1>2. Restore 2 defense to your leader.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"にとうぶん\">二等分</rub>の<rub=\"にちじょう\">日常</rub>";
        text """
【<color=Keyword>モード</color>】1つを選んでその能力が働く。自分の場のカードの枚数が2以上なら、1つを選ぶのではなくすべて。
<ridx=0>（1）相手の場のフォロワーからランダム1枚に4ダメージ。</ridx>
<ridx=1>（2）自分のリーダーを2回復。</ridx>
""";
    }

    locale kor {
        name "함께 나누는 일상";
        text """
[<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동. 내 전장의 카드 수가 2 이상이라면, 1개를 선택하는 대신 모두.
<ridx=0>(1) 상대방 전장의 추종자 중 무작위로 1장에게 4 피해.</ridx>
<ridx=1>(2) 내 리더를 2 회복.</ridx>
""";
    }

    locale cht {
        name "相伴的日常";
        text """
指定1個【<color=Keyword>模式</color>】並發動該能力。如果自己戰場上的卡片張數為2以上，則會由原本的指定1個轉變為全部。
<ridx=0>（1）隨機給予1張敵方戰場上的從者卡4點傷害。</ridx>
<ridx=1>（2）回復自己的主戰者2點生命值。</ridx>
""";
    }

}
