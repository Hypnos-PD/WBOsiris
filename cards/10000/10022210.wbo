wbo 0.1.0;

card 10022210 {
    type amulet;
    cost 4;

    effect {
        countdown 4;
        when own follower summoned {
            buff summoned +1/+1;
        }
    }

    meta {
        pack 10000;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "昭示正统的王冠";
        text """
        【吟唱_4】
        自己的随从进入战场时，使其+1/+1。
        """;
    }

    locale eng {
        name "Ancestral Crown";
        text """
        Countdown (4)
        Whenever an allied follower enters the field, give it +1/+1.
        """;
    }

    locale jpn {
        name "正統なる王冠";
        text """
        【カウントダウン_4】
        自分のフォロワーが場に出たとき、それは+1/+1する。
        """;
    }

    locale kor {
        name "정통성의 왕관";
        text """
        [카운트다운 4]
        내 추종자가 전장에 소환되었을 때, 그 추종자는 +1/+1.
        """;
    }

    locale cht {
        name "傳家皇冠";
        text """
        【倒數_4】
        當自己的從者卡進入戰場時，使其+1/+1。
        """;
    }
