wbo 0.1.0;

card 10061130 {
    type follower;
    cost 4;
    stats 4/4;

    effect {
        fanfare {
            choose target from own.field.followers other;
            buff target +1/+1;
        }
        evolve {
            choose target from own.field.followers other;
            buff target +1/+1;
        }
    }

    meta {
        pack 10000;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "圣翼战士";
        text """
        【入场曲】选择自己的战场上的1个其他随从，使其+1/+1。
        【进化时】发动与【入场曲】相同的能力。
        """;
    }

    locale eng {
        name "Winged Warrior";
        text """
        Fanfare: Select another allied follower on the field and give it +1/+1.
        Evolve: Replicate the effects of this card's Fanfare ability.
        """;
    }

    locale jpn {
        name "ウィングウォーリアー";
        text """
        【ファンファーレ】自分の場の他のフォロワー1枚を選ぶ。それは+1/+1する。
        【進化時】【ファンファーレ】と同じ能力が働く。
        """;
    }

    locale kor {
        name "윙 워리어";
        text """
        [출격] 내 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 +1/+1.
        [진화시] [출격]과 같은 능력을 발동.
        """;
    }

    locale cht {
        name "飛翼戰士";
        text """
        【入場曲】指定1張自己戰場上的其他從者卡。使其+1/+1。
        【進化時】發動與【入場曲】相同的能力。
        """;
    }
}
