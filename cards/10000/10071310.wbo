wbo 0.1.0;

card 10071310 {
    type spell;
    cost 4;

    effect {
        require target from oppo.field.followers;
        destroy target;
        add 1 card 90071210 to hand;
        add 1 card 90071220 to hand;
    }

    meta {
        pack 10000;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "来自异次元的枪击";
        text "选择对手的战场上的1个随从，破坏该随从。将1张『未来核心』和1张『过往核心』加入手牌。";
    }

    locale eng {
        name "Bullet from Beyond";
        text "Select an enemy follower on the field and destroy it. Add a Gear of Ambition and Gear of Remembrance to your hand.";
    }

    locale jpn {
        name "異次元からの銃撃";
        text "相手の場のフォロワー1枚を選ぶ。それを破壊。『フューチャー・コア』1枚と『パスト・コア』1枚を自分の手札に加える。";
    }

    locale kor {
        name "다른 차원의 총격";
        text "상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴. 퓨처 코어 1장, 패스트 코어 1장을 내 패에 넣는다.";
    }

    locale cht {
        name "異次元的槍擊";
        text "指定1張敵方戰場上的從者卡。將其破壞。增加1張『未來之核』與1張『過往之核』到自己的手牌中。";
    }
}
