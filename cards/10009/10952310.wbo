wbo 0.1.0;

card 10952310 {
    type spell;
    cost 2;

    effect {
        repeat 1 {
            random victim from oppo.field.followers;
            damage victim 3;
            damage all.leaders 1;
        }
        enhance 4 replaces {
            repeat 2 {
                random victim from oppo.field.followers;
                damage victim 3;
                damage all.leaders 1;
            }
        }
    }

    meta {
        pack 10009;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "锁链相连";
        text """
发动1次「对对手的战场上的随机1个随从造成3点伤害。对所有主战者造成1点伤害」。
【<color=Keyword>爆能强化</color>_4】改为发动2次。
""";
    }

    locale eng {
        name "Chains of the Past";
        text """
Do this 1 time: \"Deal 3 damage to a random enemy follower. Deal 1 damage to both leaders.\"
<b><color=Keyword>Enhance</color> (4)</b>: Do it 2 times instead.
""";
    }

    locale jpn {
        name "<rub=\"てっさ\">鉄鎖</rub>の<rub=\"つな\">繋</rub>がり";
        text """
「相手の場のフォロワーからランダム1枚に3ダメージ。リーダーすべてに1ダメージ。」を1回行う。
【<color=Keyword>エンハンス</color>_4】1回ではなく2回。
""";
    }

    locale kor {
        name "쇠사슬의 관계";
        text """
「상대방 전장의 추종자 중 무작위로 1장에게 3 피해. 리더 모두에게 1 피해」를 1회 발동.
[<color=Keyword>증강</color> 4] 1회 대신 2회.
""";
    }

    locale cht {
        name "鐵鎖聯結";
        text """
發動1次「隨機給予1張敵方戰場上的從者卡3點傷害。給予全部的主戰者1點傷害」。
【<color=Keyword>爆能強化</color>_4】由原本的1次轉變為2次。
""";
    }

}
