wbo 0.1.0;

card 10953110 {
    type follower;
    cost 6;
    stats 3/3;

    effect {
        unplayable;
    }

    meta {
        pack 10009;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "激烈的副总长";
        text """
【<color=Keyword>入场曲</color>】对对手的战场上的所有随从造成3点伤害。对所有主战者造成3点伤害。
<hr><sev>【<color=Keyword>超进化时</color>】抽取2张卡牌。对所有主战者造成1点伤害。</sev>
""";
    }

    locale eng {
        name "Rampaging Commander";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 3 damage to all enemy followers. Deal 3 damage to both leaders.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Draw 2 cards. Deal 1 damage to both leaders.</sev>
""";
    }

    locale jpn {
        name "<rub=\"げきれつ\">激烈</rub>の<rub=\"ふくそうちょう\">副総長</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワーすべてに3ダメージ。リーダーすべてに3ダメージ。
<hr><sev>【<color=Keyword>超進化時</color>】自分のデッキから2枚を引く。リーダーすべてに1ダメージ。</sev>
""";
    }

    locale kor {
        name "격렬의 부총장";
        text """
[<color=Keyword>출격</color>] 상대방 전장의 추종자 모두에게 3 피해. 리더 모두에게 3 피해.
<hr><sev>[<color=Keyword>초진화시</color>] 내 덱에서 2장을 뽑는다. 리더 모두에게 1 피해.</sev>
""";
    }

    locale cht {
        name "暴烈的副總長";
        text """
【<color=Keyword>入場曲</color>】給予敵方戰場上全部的從者卡3點傷害。給予全部的主戰者3點傷害。
<hr><sev>【<color=Keyword>超進化時</color>】由自己的牌堆中抽取2張卡片。給予全部的主戰者1點傷害。</sev>
""";
    }

}
