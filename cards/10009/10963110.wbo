wbo 0.1.0;

card 10963110 {
    type follower;
    cost 7;
    stats 6/6;

    effect {
        unplayable;
    }

    meta {
        pack 10009;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "誓言干部";
        text """
【<color=Keyword>入场曲</color>】回复自己的主战者2点生命值。
<hr>【<color=Keyword>守护</color>】
自己的主战者回复时，若为自己的回合，则破坏对手的战场上的随机1个随从。
<hr><sev>【<color=Keyword>超进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</sev>
""";
    }

    locale eng {
        name "Executor of the Vow";
        text """
<b><color=Keyword>Fanfare</color></b>: Restore 2 defense to your leader.
<hr><b><color=Keyword>Ward</color></b>
During your turn, whenever your leader's defense is restored, destroy a random enemy follower.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</sev>
""";
    }

    locale jpn {
        name "<rub=\"せいげん\">誓言</rub>の<rub=\"かんぶ\">幹部</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分のリーダーを2回復。
<hr>【<color=Keyword>守護</color>】
自分のリーダーが回復したとき、自分のターンなら、相手の場のフォロワーからランダム1枚を破壊。
<hr><sev>【<color=Keyword>超進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</sev>
""";
    }

    locale kor {
        name "서언의 간부";
        text """
[<color=Keyword>출격</color>] 내 리더를 2 회복.
<hr>[<color=Keyword>수호</color>]
내 리더가 회복했을 때 내 턴이라면, 상대방 전장의 추종자 중 무작위로 1장을 파괴.
<hr><sev>[<color=Keyword>초진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</sev>
""";
    }

    locale cht {
        name "立誓幹部";
        text """
【<color=Keyword>入場曲</color>】回復自己的主戰者2點生命值。
<hr>【<color=Keyword>守護</color>】
當自己的主戰者回復生命值時，如果是自己的回合，則會隨機破壞1張敵方戰場上的從者卡。
<hr><sev>【<color=Keyword>超進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</sev>
""";
    }

}
