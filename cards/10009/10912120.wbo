wbo 0.1.0;

card 10912120 {
    type follower;
    cost 3;
    stats 3/3;

    effect {
        fanfare {
            add random 1 copies from oppo.hand to hand;
        }
        evolve {
            add random 1 copies from oppo.hand to hand;
        }
    }

    meta {
        pack 10009;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "温泉度假猴";
        text """
【<color=Keyword>入场曲</color>】将对手的手牌中的随机1张卡牌的复制卡牌以非公开形式加入自己的手牌。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
""";
    }

    locale eng {
        name "Primate Plotters";
        text """
<b><color=Keyword>Fanfare</color></b>: Add an exact copy of a random card in your opponent's hand to your hand without revealing it.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
""";
    }

    locale jpn {
        name "スパリゾートモンキー";
        text """
【<color=Keyword>ファンファーレ</color>】相手の手札からランダム1枚のコピー1枚を非公開で自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
""";
    }

    locale kor {
        name "온천숭이";
        text """
[<color=Keyword>출격</color>] 상대방 패에서 무작위로 1장의 복사본 1장을 비공개로 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
""";
    }

    locale cht {
        name "溫泉度假村的獼猴";
        text """
【<color=Keyword>入場曲</color>】隨機複製1張敵方手牌中的卡片並以非公開形式增加到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
""";
    }

}
