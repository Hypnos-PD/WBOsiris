wbo 0.1.0;

card 10901110 {
    type follower;
    cost 6;
    stats 6/6;

    effect {
        ward;
        fanfare {
            choose target from oppo.field.followers;
            damage target 6;
            // 「选中的以外的随机 1 个」：用 `other <绑定>` 排除刚选中的那张。
            random victim from oppo.field.followers other target;
            damage victim 2;
        }
        // 【激奏_1】：以 1 费打出时改为对随机 1 个敌方随从造成 2 点伤害。
        accelerate 1 {
            random victim from oppo.field.followers;
            damage victim 2;
        }
    }

    meta {
        pack 10009;
        class neutral;
        rarity bronze;
    }

    locale chs {
        name "最古老的狱卒";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成6点伤害。对对手的战场上的随机1个未被选择的随从造成2点伤害。
<hr>【<color=Keyword>守护</color>】
""";
    }

    locale eng {
        name "Jailor of Antiquity";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 6 damage. Deal 2 damage to a random unselected enemy follower.
<hr><b><color=Keyword>Ward</color></b>
""";
    }

    locale jpn {
        name "<rub=\"さいこ\">最古</rub>の<rub=\"ごくそつ\">獄卒</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに6ダメージ。相手の場の選んでいないフォロワーからランダム1枚に2ダメージ。
<hr>【<color=Keyword>守護</color>】
""";
    }

    locale kor {
        name "최구의 옥졸";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 6 피해. 선택하지 않은 상대방 전장의 추종자 중 무작위로 1장에게 2 피해.
<hr>[<color=Keyword>수호</color>]
""";
    }

    locale cht {
        name "邃古的獄卒";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其6點傷害。隨機給予1張敵方戰場上未指定的從者卡2點傷害。
<hr>【<color=Keyword>守護</color>】
""";
    }

}
