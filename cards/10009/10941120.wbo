wbo 0.1.0;

card 10941120 {
    type follower;
    cost 5;
    stats 5/3;

    effect {
        stealth;
        fanfare {
            if overflow {
                evolve self silent;
            }
        }
    }

    meta {
        pack 10009;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "洞窟龙";
        text """
【<color=Keyword>入场曲</color>】若为【<color=Keyword>觉醒</color>】，则本随从进化。
<hr>【<color=Keyword>潜行</color>】
""";
    }

    locale eng {
        name "Cave Dragon";
        text """
<b><color=Keyword>Fanfare</color></b>: If you're in <b><color=Keyword>Overflow</color></b>, evolve this follower.
<hr><b><color=Keyword>Ambush</color></b>
""";
    }

    locale jpn {
        name "ケイブドラゴン";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>覚醒</color>】なら、これは進化する。
<hr>【<color=Keyword>潜伏</color>】
""";
    }

    locale kor {
        name "케이브 드래곤";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>각성</color>]이라면, 이 추종자는 진화한다.
<hr>[<color=Keyword>잠복</color>]
""";
    }

    locale cht {
        name "岩穴之龍";
        text """
【<color=Keyword>入場曲</color>】如果【<color=Keyword>覺醒</color>】已發動，則會使這張卡片進化。
<hr>【<color=Keyword>潛行</color>】
""";
    }

}
