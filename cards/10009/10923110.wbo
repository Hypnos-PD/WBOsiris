wbo 0.1.0;

card 10923110 {
    type follower;
    cost 5;
    stats 3/3;

    effect {
        unplayable;
    }

    meta {
        pack 10009;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "波涛副船长";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成3点伤害。召唤1张『<color=Keyword>令人战栗的海盗旗</color>』。
<hr><ev>【<color=Keyword>进化时</color>】发动与【<color=Keyword>入场曲</color>】相同的能力。</ev>
<sev>【<color=Keyword>超进化时</color>】将1张『<color=Keyword>黄金短剑</color>』和1张『<color=Keyword>黄金项链</color>』加入手牌，使其费用变为0。</sev>
""";
    }

    locale eng {
        name "Roughwater First Mate";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 3 damage. Summon a <b><i><color=Keyword>Dread Pirate's Flag</color></i></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Replicate the effects of this card's <b><color=Keyword>Fanfare</color></b> ability.</ev>
<sev><b><color=Keyword>Super-Evolve</color></b>: Add a <b><i><color=Keyword>Gilded Blade</color></i></b> and <b><i><color=Keyword>Gilded Necklace</color></i></b> to your hand and set their costs to 0.</sev>
""";
    }

    locale jpn {
        name "<rub=\"はとう\">波濤</rub>の<rub=\"ふくせんちょう\">副船長</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに3ダメージ。『<color=Keyword>戦慄の海賊旗</color>』1枚を自分の場に出す。
<hr><ev>【<color=Keyword>進化時</color>】【<color=Keyword>ファンファーレ</color>】と同じ能力が働く。</ev>
<sev>【<color=Keyword>超進化時</color>】『<color=Keyword>黄金の小剣</color>』1枚と『<color=Keyword>黄金の首飾り</color>』1枚を自分の手札に加える。それのコストを0にする。</sev>
""";
    }

    locale kor {
        name "파도의 부선장";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 3 피해. <color=Keyword>전율의 해적기</color> 1장을 내 전장에 소환.
<hr><ev>[<color=Keyword>진화시</color>] [<color=Keyword>출격</color>]과 같은 능력을 발동.</ev>
<sev>[<color=Keyword>초진화시</color>] <color=Keyword>황금 단검</color> 1장, <color=Keyword>황금 목걸이</color> 1장을 내 패에 넣는다. 그 주문의 비용을 0으로 만든다.</sev>
""";
    }

    locale cht {
        name "波濤副船長";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其3點傷害。召喚1張『<color=Keyword>戰慄的海賊旗</color>』到自己的戰場上。
<hr><ev>【<color=Keyword>進化時</color>】發動與【<color=Keyword>入場曲</color>】相同的能力。</ev>
<sev>【<color=Keyword>超進化時</color>】增加1張『<color=Keyword>黃金短劍</color>』與1張『<color=Keyword>黃金首飾</color>』到自己的手牌中。使其消費轉變為0。</sev>
""";
    }

}
