wbo 0.1.0;

card 10902110 {
    type follower;
    cost 7;
    stats 6/6;

    effect {
        fanfare {
            choose targets from own.field.followers other count 2;
            buff targets +3/+3;
        }
    }

    meta {
        pack 10009;
        class neutral;
        rarity silver;
    }

    locale chs {
        name "圣剑天使";
        text """
【<color=Keyword>入场曲</color>】选择自己的战场上的2个其他随从，使其+3/+3。
""";
    }

    locale eng {
        name "Blade Angel";
        text """
<b><color=Keyword>Fanfare</color></b>: Select 2 other allied followers on the field and give them +3/+3.
""";
    }

    locale jpn {
        name "ブレードエンジェル";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の他のフォロワー2枚を選ぶ。それは+3/+3する。
""";
    }

    locale kor {
        name "블레이드 엔젤";
        text """
[<color=Keyword>출격</color>] 내 전장에서 다른 추종자 2장을 선택한다. 그 추종자는 +3/+3.
""";
    }

    locale cht {
        name "劍刃天使";
        text """
【<color=Keyword>入場曲</color>】指定2張自己戰場上的其他從者卡。使其+3/+3。
""";
    }

}
