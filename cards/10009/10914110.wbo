wbo 0.1.0;

card 10914110 {
    type follower;
    cost 3;
    stats 2/2;

    effect {
        unplayable;
    }

    meta {
        pack 10009;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "烟管的罪人·曲千代";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。【<color=Keyword>连击</color>_3】改为对对手的战场上的所有随从造成4点伤害。
<hr><sev>【<color=Keyword>超进化时</color>】本随从获得【<color=Keyword>疾驰</color>】。</sev>
""";
    }

    locale eng {
        name "Magachiyo, Aromatic Convict";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage. <b><color=Keyword>Combo</color> (3)</b> - Deal damage to all enemy followers instead.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give this follower <b><color=Keyword>Storm</color></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"きせる\">煙管</rub>の<rub=\"とがびと\">咎人</rub>・マガチヨ";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。【<color=Keyword>コンボ</color>_3】1枚を選ぶのではなくすべて。
<hr><sev>【<color=Keyword>超進化時</color>】これは【<color=Keyword>疾走</color>】を持つ。</sev>
""";
    }

    locale kor {
        name "연관의 죄인 마가치요";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해. [<color=Keyword>콤보</color> 3] 1장을 선택하는 대신 모두.
<hr><sev>[<color=Keyword>초진화시</color>] 이 추종자는 [<color=Keyword>질주</color>]를 갖는다.</sev>
""";
    }

    locale cht {
        name "煙管的罪人‧瑪伽綺耶";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。【<color=Keyword>連擊</color>_3】由原本的指定1張轉變為全部。
<hr><sev>【<color=Keyword>超進化時</color>】使這張卡片獲得【<color=Keyword>疾馳</color>】。</sev>
""";
    }

}
