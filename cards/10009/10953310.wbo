wbo 0.1.0;

card 10953310 {
    type spell;
    cost 2;

    effect {
        choose target from own.field.followers;
        grant target {
            label chs "【谢幕曲】召唤1个与本随从同名的随从。";
            label eng "Last Words: Summon a copy of this follower.";
            label jpn "【ラストワード】これと同名のフォロワー1枚を自分の場に出す。";
            label kor "[유언] 이 추종자와 동명인 추종자 1장을 내 전장에 소환.";
            label cht "【謝幕曲】召喚1張與這張從者卡同名的從者卡。";
            lastwords {
                summon copies of self;
            }
        }
    }

    meta {
        pack 10009;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "驱逐死神";
        text """
选择自己的战场上的1个随从，使其获得「【<color=Keyword>谢幕曲</color>】召唤1个与本随从同名的随从」。
""";
    }

    locale eng {
        name "Reaper's Due";
        text """
Select an allied follower on the field and give it \"<b><color=Keyword>Last Words</color></b>: Summon a copy of this card.\"
""";
    }

    locale jpn {
        name "<rub=\"しにがみばら\">死神払</rub>い";
        text """
自分の場のフォロワー1枚を選ぶ。それは「【<color=Keyword>ラストワード</color>】これと同名のカード1枚を自分の場に出す。」を持つ。
""";
    }

    locale kor {
        name "사신불제";
        text """
내 전장에서 추종자 1장을 선택한다. 그 추종자는 「[<color=Keyword>유언</color>] 이 추종자와 동명의 추종자 1장을 내 전장에 소환」을 갖는다.
""";
    }

    locale cht {
        name "驅趕死神";
        text """
指定1張自己戰場上的從者卡。使其獲得「【<color=Keyword>謝幕曲</color>】召喚1張與這張卡片同名的卡片到自己的戰場上」。
""";
    }

}
