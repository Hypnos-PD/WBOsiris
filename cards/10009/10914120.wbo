wbo 0.1.0;

card 10914120 {
    type follower;
    cost 9;
    stats 4/4;

    effect {
        // 手牌中发动：自己使用卡牌时，回合结束前费用 -1。
        when own card played while self in hand {
            reduce cost self 1 until turn ends;
        }
        fanfare {
            choose target from oppo.field.followers;
            damage target 4;
        }
        lastwords {
            summon 1 card 10914120;
        }
    }

    meta {
        pack 10009;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "香风的变貌·飞燕";
        text """
在手牌中发动。自己使用卡牌时，回合结束前，使本卡牌的费用-1。
<hr>【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，对其造成4点伤害。
<hr>【<color=Keyword>谢幕曲</color>】召唤1个『<color=Keyword>香风的变貌·飞燕</color>』。
""";
    }

    locale eng {
        name "Hien, Redolent Revenant";
        text """
Activates in hand. Whenever you play a card, reduce the cost of this card by 1 until the end of the turn.
<hr><b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and deal it 4 damage.
<hr><b><color=Keyword>Last Words</color></b>: Summon a <b><i><color=Keyword>Hien, Redolent Revenant</color></i></b>.
""";
    }

    locale jpn {
        name "<rub=\"こうふう\">香風</rub>の<rub=\"へんぼう\">変貌</rub>・ヒエン";
        text """
手札で働く。自分がカードをプレイしたとき、ターン終了まで、これのコストを-1する。
<hr>【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。
<hr>【<color=Keyword>ラストワード</color>】『<color=Keyword>香風の変貌・ヒエン</color>』1枚を自分の場に出す。
""";
    }

    locale kor {
        name "향풍의 변모 히엔";
        text """
패에서 발동. 내가 카드를 사용했을 때, 턴 종료까지 이 추종자의 비용을 -1.
<hr>[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해.
<hr>[<color=Keyword>유언</color>] <color=Keyword>향풍의 변모 히엔</color> 1장을 내 전장에 소환.
""";
    }

    locale cht {
        name "香風的轉變‧希硯";
        text """
於手牌中發動。當自己使用卡片時，到回合結束為止，使這張卡片的消費-1。
<hr>【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。
<hr>【<color=Keyword>謝幕曲</color>】召喚1張『<color=Keyword>香風的轉變‧希硯</color>』到自己的戰場上。
""";
    }

}
