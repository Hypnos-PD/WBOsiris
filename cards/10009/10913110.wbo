wbo 0.1.0;

card 10913110 {
    type follower;
    cost 2;
    stats 1/3;

    effect {
        fanfare {
            if combo >= 3 {
                draw 2;
            }
        }
        evolve {
            choose target from own.field.followers other;
            buff target +1/+1;
            add rush to target;
        }
    }

    meta {
        pack 10009;
        class forestcraft;
        rarity gold;
    }

    locale chs {
        name "枝叶大姐大";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>连击</color>_3】抽取2张卡牌。
<hr><ev>【<color=Keyword>进化时</color>】选择自己的战场上的1个其他随从，使其+1/+1且获得【<color=Keyword>突进</color>】。</ev>
""";
    }

    locale eng {
        name "Virid Lieutenant";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Combo</color> (3)</b> - Draw 2 cards.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select another allied follower on the field and give it +1/+1 and <b><color=Keyword>Rush</color></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"えだは\">枝葉</rub>の<rub=\"しゃていがしら\">舎弟頭</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>コンボ</color>_3】自分のデッキから2枚を引く。
<hr><ev>【<color=Keyword>進化時</color>】自分の場の他のフォロワー1枚を選ぶ。それは+1/+1して【<color=Keyword>突進</color>】を持つ。</ev>
""";
    }

    locale kor {
        name "지엽의 고문";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>콤보</color> 3] 내 덱에서 2장을 뽑는다.
<hr><ev>[<color=Keyword>진화시</color>] 내 전장에서 다른 추종자 1장을 선택한다. 그 추종자는 +1/+1 및 [<color=Keyword>돌진</color>]을 갖는다.</ev>
""";
    }

    locale cht {
        name "枝葉舍弟頭";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>連擊</color>_3】由自己的牌堆中抽取2張卡片。
<hr><ev>【<color=Keyword>進化時</color>】指定1張自己戰場上的其他從者卡。使其+1/+1並獲得【<color=Keyword>突進</color>】。</ev>
""";
    }

}
