wbo 0.1.0;

card 10921310 {
    type spell;
    cost 2;

    effect {
        summon 1 card 90021120;
        add ward to summoned;
        enhance 6 replaces {
            summon 5 card 90021120;
            add ward to summoned_all;
        }
    }

    meta {
        pack 10009;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "方阵";
        text """
召唤1个『<color=Keyword>铁甲骑士</color>』，使其获得【<color=Keyword>守护</color>】。
【<color=Keyword>爆能强化</color>_6】改为召唤5个。
""";
    }

    locale eng {
        name "Phalanx";
        text """
Summon a <b><i><color=Keyword>Steelclad Knight</color></i></b> and give it <b><color=Keyword>Ward</color></b>.
<b><color=Keyword>Enhance</color> (6)</b>: Summon 5 instead.
""";
    }

    locale jpn {
        name "ファランクス";
        text """
『<color=Keyword>スティールナイト</color>』1枚を自分の場に出す。それは【<color=Keyword>守護</color>】を持つ。
【<color=Keyword>エンハンス</color>_6】1枚ではなく5枚。
""";
    }

    locale kor {
        name "팔랑크스";
        text """
<color=Keyword>철갑 기사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
[<color=Keyword>증강</color> 6] 1장 대신 5장.
""";
    }

    locale cht {
        name "堅槍方陣";
        text """
召喚1張『<color=Keyword>鐵甲騎士</color>』到自己的戰場上。使其獲得【<color=Keyword>守護</color>】。
【<color=Keyword>爆能強化</color>_6】由原本的1張轉變為5張。
""";
    }

}
