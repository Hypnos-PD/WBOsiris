    locale chs {
        name "颚口之别";
        text """
选择自己的2张手牌，舍弃这些手牌。对对手的战场上的随机1个随从和对手的主战者造成3点伤害。
""";
    }

    locale eng {
        name "Parting Jaws";
        text """
Select 2 cards in your hand and discard them. Deal 3 damage to a random enemy follower and the enemy leader.
""";
    }

    locale jpn {
        name "<rub=\"あぎと\">顎門</rub>の<rub=\"わか\">別</rub>れ";
        text """
