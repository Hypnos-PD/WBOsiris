wbo 0.1.0;

card 10932110 {
    type follower;
    cost 4;
    stats 1/1;

    effect {
        fanfare {
            summon 2 card 10931110;
        }
        enhance 8 replaces {
            summon 3 card 10931110;
            add ward to summoned_all;
        }
        evolve {
            choose target from own.field.followers where card 10931110;
            add bane to target;
        }
    }

    meta {
        pack 10009;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "心醉的研究者";
        text """
【<color=Keyword>入场曲</color>】召唤2个『<color=Keyword>沉溺的实验体</color>』。
【<color=Keyword>爆能强化</color>_8】改为召唤3个，使其获得【<color=Keyword>守护</color>】。
<hr><ev>【<color=Keyword>进化时</color>】选择自己的战场上的1个『<color=Keyword>沉溺的实验体</color>』，使其获得【<color=Keyword>毁灭</color>】。</ev>
""";
    }

    locale eng {
        name "Enamored Researcher";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 2 copies of <b><i><color=Keyword>Obsessed Test Subject</color></i></b>.
<b><color=Keyword>Enhance</color> (8)</b>: Summon 3 copies instead and give them <b><color=Keyword>Ward</color></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an allied <b><i><color=Keyword>Obsessed Test Subject</color></i></b> on the field and give it <b><color=Keyword>Bane</color></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"しんすい\">心酔</rub>の<rub=\"けんきゅうしゃ\">研究者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>没入の実験体</color>』2枚を自分の場に出す。
【<color=Keyword>エンハンス</color>_8】2枚ではなく3枚。それは【<color=Keyword>守護</color>】を持つ。
<hr><ev>【<color=Keyword>進化時</color>】自分の場の『<color=Keyword>没入の実験体</color>』1枚を選ぶ。それは【<color=Keyword>必殺</color>】を持つ。</ev>
""";
    }

    locale kor {
        name "심취의 연구자";
        text """
[<color=Keyword>출격</color>] <color=Keyword>몰입의 실험체</color> 2장을 내 전장에 소환.
[<color=Keyword>증강</color> 8] 2장 대신 3장. 그 추종자는 [<color=Keyword>수호</color>]를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] 내 전장에서 <color=Keyword>몰입의 실험체</color> 1장을 선택한다. 그 추종자는 [<color=Keyword>필살</color>]을 갖는다.</ev>
""";
    }

    locale cht {
        name "陶醉的研究者";
        text """
【<color=Keyword>入場曲</color>】召喚2張『<color=Keyword>入神的實驗體</color>』到自己的戰場上。
【<color=Keyword>爆能強化</color>_8】由原本的2張轉變為3張。使其獲得【<color=Keyword>守護</color>】。
<hr><ev>【<color=Keyword>進化時</color>】指定1張自己戰場上的『<color=Keyword>入神的實驗體</color>』。使其獲得【<color=Keyword>必殺</color>】。</ev>
""";
    }

}
