wbo 0.1.0;

card 10952120 {
    type follower;
    cost 7;
    stats 7/7;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            destroy target;
            damage oppo.leader 2;
        }
    }

    meta {
        pack 10009;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "闪烁恶魔";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。对对手的主战者造成2点伤害。
""";
    }

    locale eng {
        name "Sparkly Demoness";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it. Deal 2 damage to the enemy leader.
""";
    }

    locale jpn {
        name "トゥインクルデビル";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。相手のリーダーに2ダメージ。
""";
    }

    locale kor {
        name "트윙클 데빌";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴. 상대방 리더에게 2 피해.
""";
    }

    locale cht {
        name "閃耀惡魔";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。給予敵方的主戰者2點傷害。
""";
    }

}
