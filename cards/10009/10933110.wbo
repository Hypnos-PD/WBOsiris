wbo 0.1.0;

card 10933110 {
    type follower;
    cost 5;
    stats 2/3;

    effect {
        fusion material from own.hand {
        }
        fanfare {
            draw 2;
            summon 1 card 10931110;
        }
        superevolve {
            // 「若已与本卡牌融合」。
            if fused.distinct >= 1 {
                choose target from own.field.followers where card 10931110;
                add drain to target;
            }
        }
    }

    meta {
        pack 10009;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "陶醉的才女";
        text """
【<color=Keyword>融合</color>】卡牌
<hr>【<color=Keyword>入场曲</color>】抽取2张卡牌。召唤1个『<color=Keyword>沉溺的实验体</color>』。
<hr><sev>【<color=Keyword>超进化时</color>】若已与本卡牌【<color=Keyword>融合</color>】，则选择自己的战场上的1个『<color=Keyword>沉溺的实验体</color>』，使其获得【<color=Keyword>虹吸</color>】。</sev>
""";
    }

    locale eng {
        name "Ecstatic Scholar";
        text """
<b><color=Keyword>Fuse</color></b>: Cards
<hr><b><color=Keyword>Fanfare</color></b>: Draw 2 cards. Summon an <b><i><color=Keyword>Obsessed Test Subject</color></i></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: If you've <b><color=Keyword>Fuse</color><color=Keyword>d</color></b> to this card, select an allied <b><i><color=Keyword>Obsessed Test Subject</color></i></b> on the field and give it <b><color=Keyword>Drain</color></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"こうこつ\">恍惚</rub>の<rub=\"さいえん\">才媛</rub>";
        text """
【<color=Keyword>融合</color>】カード
<hr>【<color=Keyword>ファンファーレ</color>】自分のデッキから2枚を引く。『<color=Keyword>没入の実験体</color>』1枚を自分の場に出す。
<hr><sev>【<color=Keyword>超進化時</color>】これに【<color=Keyword>融合</color>】していたなら、自分の場の『<color=Keyword>没入の実験体</color>』1枚を選ぶ。それは【<color=Keyword>ドレイン</color>】を持つ。</sev>
""";
    }

    locale kor {
        name "황홀의 과학자";
        text """
[<color=Keyword>융합</color>] 카드
<hr>[<color=Keyword>출격</color>] 내 덱에서 2장을 뽑는다. <color=Keyword>몰입의 실험체</color> 1장을 내 전장에 소환.
<hr><sev>[<color=Keyword>초진화시</color>] 이 추종자에 [<color=Keyword>융합</color>]된 카드가 있다면, 내 전장에서 <color=Keyword>몰입의 실험체</color> 1장을 선택한다. 그 추종자는 [<color=Keyword>흡혈</color>]을 갖는다.</sev>
""";
    }

    locale cht {
        name "痴迷的才女";
        text """
【<color=Keyword>融合</color>】卡片
<hr>【<color=Keyword>入場曲</color>】由自己的牌堆中抽取2張卡片。召喚1張『<color=Keyword>入神的實驗體</color>』到自己的戰場上。
<hr><sev>【<color=Keyword>超進化時</color>】如果已有卡片與這張卡片進行【<color=Keyword>融合</color>】，則會指定1張自己戰場上的『<color=Keyword>入神的實驗體</color>』。使其獲得【<color=Keyword>吸血</color>】。</sev>
""";
    }

}
