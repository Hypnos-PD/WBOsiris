wbo 0.1.0;

card 10653110 {
    type follower;
    cost 5;
    stats 3/3;

    effect {
        fanfare {
            choose ally from own.field.followers other;
            destroy ally;
            evolve self silent;
        }
        when self evolved {
            summon 1 card 90051120;
            evolve summoned silent;
        }
    }

    meta {
        pack 10006;
        class abysscraft;
        rarity gold;
    }

    locale chs {
        name "渴命的破坏者";
        text """
【<color=Keyword>入场曲</color>】选择自己的战场上的1个其他随从，若成功选择，则破坏该随从。本随从进化。
<hr><ev>本随从进化时，召唤1个『<color=Keyword>蝙蝠</color>』，使其进化。</ev>
""";
    }

    locale eng {
        name "Deprived Destroyer";
        text """
<b><color=Keyword>Fanfare</color></b>: Select another allied follower on the field. If you selected one, destroy it and evolve this follower.
<hr><ev>When this follower evolves, summon a <b><i><color=Keyword>Bat</color></i></b> and evolve it.</ev>
""";
    }

    locale jpn {
        name "<rub=\"かつめい\">渇命</rub>の<rub=\"はかいしゃ\">破壊者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の他のフォロワー1枚を選ぶ。選んだなら、それを破壊。これは進化する。
<hr><ev>これが進化したとき、『<color=Keyword>バット</color>』1枚を自分の場に出す。それは進化する。</ev>
""";
    }

    locale kor {
        name "갈명의 파괴자";
        text """
[<color=Keyword>출격</color>] 내 전장에서 다른 추종자 1장을 선택한다. 선택했다면, 그 추종자를 파괴. 이 추종자는 진화한다.
<hr><ev>이 추종자가 진화했을 때, <color=Keyword>박쥐</color> 1장을 내 전장에 소환. 그 추종자는 진화한다.</ev>
""";
    }

    locale cht {
        name "渴命的破壞者";
        text """
【<color=Keyword>入場曲</color>】指定1張自己戰場上的其他從者卡。如果完成指定，則會將其破壞。使這張卡片進化。
<hr><ev>當這張卡片進化時，召喚1張『<color=Keyword>蝙蝠</color>』到自己的戰場上。使其進化。</ev>
""";
    }

}
