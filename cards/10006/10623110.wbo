wbo 0.1.0;

card 10623110 {
    type follower;
    cost 4;
    stats 2/1;

    effect {
        fanfare {
            choose target from oppo.field.followers;
            destroy target;
        }
        enhance 6 {
            gain own.pp 3;
            add 1 card 10621110 to hand;
        }
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "暴烈的参谋";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。
【<color=Keyword>爆能强化</color>_6】回复自己3点能量点。将1张『<color=Keyword>勇烈的士兵</color>』加入手牌。
""";
    }

    locale eng {
        name "Heartless Strategist";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it.
<b><color=Keyword>Enhance</color> (6)</b>: Recover 3 play points. Add a <b><i><color=Keyword>Fearless Soldier</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"かれつ\">苛烈</rub>の<rub=\"さんぼう\">参謀</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。
【<color=Keyword>エンハンス</color>_6】自分のPPを3回復。『<color=Keyword>勇烈の兵士</color>』1枚を自分の手札に加える。
""";
    }

    locale kor {
        name "가열의 참모";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.
[<color=Keyword>증강</color> 6] 내 PP를 3 회복. <color=Keyword>용렬의 병사</color> 1장을 내 패에 넣는다.
""";
    }

    locale cht {
        name "苛烈的參謀";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。
【<color=Keyword>爆能強化</color>_6】回復自己的PP 3點。增加1張『<color=Keyword>勇烈的士兵</color>』到自己的手牌中。
""";
    }

}
