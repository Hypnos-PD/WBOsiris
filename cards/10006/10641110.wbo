wbo 0.1.0;

card 10641110 {
    type follower;
    cost 3;
    stats 2/3;

    effect {
        fanfare {
            choose target from own.hand;
            discard target;
        }
        lastwords {
            draw 2;
        }
    }

    meta {
        pack 10006;
        class dragoncraft;
        rarity bronze;
    }

    locale chs {
        name "决断的龙人";
        text """
【<color=Keyword>入场曲</color>】选择自己的1张手牌，舍弃该手牌。
<hr>【<color=Keyword>谢幕曲</color>】抽取2张卡牌。
""";
    }

    locale eng {
        name "Resolute Dragonewt";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a card in your hand and discard it.
<hr><b><color=Keyword>Last Words</color></b>: Draw 2 cards.
""";
    }

    locale jpn {
        name "<rub=\"かだん\">果断</rub>のドラゴニュート";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札1枚を選ぶ。それを捨てる。
<hr>【<color=Keyword>ラストワード</color>】自分のデッキから2枚を引く。
""";
    }

    locale kor {
        name "과단의 용인";
        text """
[<color=Keyword>출격</color>] 내 패에서 1장을 선택한다. 그 카드를 버린다.
<hr>[<color=Keyword>유언</color>] 내 덱에서 2장을 뽑는다.
""";
    }

    locale cht {
        name "果斷的龍人";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中的卡片。將其捨棄。
<hr>【<color=Keyword>謝幕曲</color>】由自己的牌堆中抽取2張卡片。
""";
    }

}
