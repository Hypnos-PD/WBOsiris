wbo 0.1.0;

card 10621120 {
    type follower;
    cost 4;
    stats 3/5;

    effect {
        fanfare {
            require target from own.hand;
            return target to deck;
            draw 2 from deck where class swordcraft and type follower;
        }
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity bronze;
    }

    locale chs {
        name "懒惰女仆";
        text """
【<color=Keyword>入场曲</color>】选择自己的1张手牌，使其返回牌组。抽取2张皇家护卫·随从。
""";
    }

    locale eng {
        name "Idle Maid";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a card in your hand and return it to deck. Draw 2 Swordcraft followers.
""";
    }

    locale jpn {
        name "レイジーメイド";
        text """
【<color=Keyword>ファンファーレ</color>】自分の手札1枚を選ぶ。それをデッキに戻す。自分のデッキからロイヤル・フォロワー2枚を引く。
""";
    }

    locale kor {
        name "느긋한 메이드";
        text """
[<color=Keyword>출격</color>] 내 패에서 1장을 선택한다. 그 카드를 덱으로 되돌린다. 내 덱에서 로얄 추종자 2장을 뽑는다.
""";
    }

    locale cht {
        name "懶散的女僕";
        text """
【<color=Keyword>入場曲</color>】指定1張自己手牌中的卡片。使其返回牌堆中。由自己的牌堆中抽取2張皇家護衛‧從者卡。
""";
    }

}
