wbo 0.1.0;

card 10663110 {
    type follower;
    cost 6;
    stats 2/4;

    effect {
        bane;
        aura;
        fanfare {
            summon 1 card 10663110;
        }
        evolve {
            choose target from oppo.field.followers;
            destroy target;
        }
    }

    meta {
        pack 10006;
        class havencraft;
        rarity gold;
    }

    locale chs {
        name "崇拜的圣骑士";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>崇拜的圣骑士</color>』。
<hr>【<color=Keyword>毁灭</color>】
【<color=Keyword>灵气</color>】
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，破坏该随从。</ev>
""";
    }

    locale eng {
        name "Worshipful Crusader";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Worshipful Crusader</color></i></b>.
<hr><b><color=Keyword>Bane</color></b>
<b><color=Keyword>Aura</color></b>
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and destroy it.</ev>
""";
    }

    locale jpn {
        name "<rub=\"すうはい\">崇拝</rub>の<rub=\"せいきし\">聖騎士</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>崇拝の聖騎士</color>』1枚を自分の場に出す。
<hr>【<color=Keyword>必殺</color>】
【<color=Keyword>オーラ</color>】
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。</ev>
""";
    }

    locale kor {
        name "숭배의 성기사";
        text """
[<color=Keyword>출격</color>] <color=Keyword>숭배의 성기사</color> 1장을 내 전장에 소환.
<hr>[<color=Keyword>필살</color>]
[<color=Keyword>오라</color>]
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.</ev>
""";
    }

    locale cht {
        name "崇拜的聖騎士";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>崇拜的聖騎士</color>』到自己的戰場上。
<hr>【<color=Keyword>必殺</color>】
【<color=Keyword>光紋</color>】
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。將其破壞。</ev>
""";
    }

}
