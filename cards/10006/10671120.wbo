wbo 0.1.0;

card 10671120 {
    type follower;
    cost 6;
    stats 1/1;

    effect {
        fanfare {
            summon 1 card 90073110;
            add bane to summoned;
            add ward to summoned;
        }
    }

    meta {
        pack 10006;
        class portalcraft;
        rarity bronze;
    }

    locale chs {
        name "聪明的创造者";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>毁灭创造物α</color>』，使其获得【<color=Keyword>毁灭</color>】和【<color=Keyword>守护</color>】。
""";
    }

    locale eng {
        name "Brilliant Inventor";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon an <b><i><color=Keyword>Ominous Artifact α</color></i></b> and give it <b><color=Keyword>Bane</color></b> and <b><color=Keyword>Ward</color></b>.
""";
    }

    locale jpn {
        name "ブライトクリエイター";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>デストロイアーティファクトα</color>』1枚を自分の場に出す。それは【<color=Keyword>必殺</color>】と【<color=Keyword>守護</color>】を持つ。
""";
    }

    locale kor {
        name "브라이트 크리에이터";
        text """
[<color=Keyword>출격</color>] <color=Keyword>디스트로이 아티팩트 알파</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>필살</color>], [<color=Keyword>수호</color>]를 갖는다.
""";
    }

    locale cht {
        name "聰敏的創造者";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>破滅的創造物α</color>』到自己的戰場上。使其獲得【<color=Keyword>必殺</color>】與【<color=Keyword>守護</color>】。
""";
    }

}
