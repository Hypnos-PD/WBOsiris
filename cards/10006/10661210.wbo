wbo 0.1.0;

card 10661210 {
    type amulet;
    cost 2;

    effect {
        countdown 3;
        lastwords {
            draw 1;
            random victim from oppo.field.followers;
            destroy victim;
        }
        engage 1 {
            reduce countdown self 1;
        }
    }

    meta {
        pack 10006;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "污浊的圣水";
        text """
【<color=Keyword>吟唱</color>_3】
【<color=Keyword>谢幕曲</color>】抽取1张卡牌。破坏对手的战场上的随机1个随从。
<hr>费用1【<color=Keyword>启动</color>】本护符的倒计数-1。
""";
    }

    locale eng {
        name "Unholy Water";
        text """
<b><color=Keyword>Countdown</color> (3)</b>
<b><color=Keyword>Last Words</color></b>: Draw a card. Destroy a random enemy follower.
<hr><b><color=Keyword>Engage</color> (1)</b>: Advance this amulet's count by 1.
""";
    }

    locale jpn {
        name "<rub=\"おだく\">汚濁</rub>の<rub=\"せいすい\">聖水</rub>";
        text """
【<color=Keyword>カウントダウン</color>_3】
【<color=Keyword>ラストワード</color>】自分のデッキから1枚を引く。相手の場のフォロワーからランダム1枚を破壊。
<hr>コスト1【<color=Keyword>アクト</color>】これのカウントを-1する。
""";
    }

    locale kor {
        name "오염된 성수";
        text """
[<color=Keyword>카운트다운</color> 3]
[<color=Keyword>유언</color>] 내 덱에서 1장을 뽑는다. 상대방 전장의 추종자 중 무작위로 1장을 파괴.
<hr>비용 1 [<color=Keyword>활성화</color>] 이 마법진의 카운트를 -1.
""";
    }

    locale cht {
        name "汙濁的聖水";
        text """
【<color=Keyword>倒數</color>_3】
【<color=Keyword>謝幕曲</color>】由自己的牌堆中抽取1張卡片。隨機破壞1張敵方戰場上的從者卡。
<hr>消費1【<color=Keyword>策動</color>】使這張卡片的倒數回合數-1。
""";
    }

}
