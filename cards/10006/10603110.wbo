wbo 0.1.0;

card 10603110 {
    type follower;
    cost 6;
    stats 3/3;

    effect {
        fanfare {
            // 【疾驰】【毁灭】【威慑】【虹吸】【灵气】【屏障】中随机 3 个。
            mode random 3 {
                option 1 { add storm to self; }
                option 2 { add bane to self; }
                option 3 { add intimidate to self; }
                option 4 { add drain to self; }
                option 5 { add aura to self; }
                option 6 { add barrier to self; }
            }
        }
    }

    meta {
        pack 10006;
        class neutral;
        rarity gold;
    }

    locale chs {
        name "彷徨于黑暗之兽";
        text """
【<color=Keyword>入场曲</color>】本随从获得【<color=Keyword>疾驰</color>】【<color=Keyword>毁灭</color>】【<color=Keyword>威慑</color>】【<color=Keyword>虹吸</color>】【<color=Keyword>灵气</color>】【<color=Keyword>屏障</color>】中随机3个能力。
""";
    }

    locale eng {
        name "Beast Lost to the Dark";
        text """
<b><color=Keyword>Fanfare</color></b>: Give this follower 3 random abilities from the following.
1. <b><color=Keyword>Storm</color></b>.
2. <b><color=Keyword>Bane</color></b>.
3. <b><color=Keyword>Intimidate</color></b>.
4. <b><color=Keyword>Drain</color></b>.
5. <b><color=Keyword>Aura</color></b>.
6. <b><color=Keyword>Barrier</color></b>.
""";
    }

    locale jpn {
        name "<rub=\"やみ\">闇</rub>を<rub=\"さまよ\">彷徨</rub>う<rub=\"けもの\">獣</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】これは【<color=Keyword>疾走</color>】【<color=Keyword>必殺</color>】【<color=Keyword>威圧</color>】【<color=Keyword>ドレイン</color>】【<color=Keyword>オーラ</color>】【<color=Keyword>バリア</color>】からランダム3つの能力を持つ。
""";
    }

    locale kor {
        name "어둠을 헤매는 짐승";
        text """
[<color=Keyword>출격</color>] 이 추종자는 [<color=Keyword>질주</color>], [<color=Keyword>필살</color>], [<color=Keyword>위압</color>], [<color=Keyword>흡혈</color>], [<color=Keyword>오라</color>], [<color=Keyword>배리어</color>] 중 무작위로 3개의 능력을 갖는다.
""";
    }

    locale cht {
        name "徘徊黑暗的野獸";
        text """
【<color=Keyword>入場曲</color>】使這張卡片由【<color=Keyword>疾馳</color>】、【<color=Keyword>必殺</color>】、【<color=Keyword>威懾</color>】、【<color=Keyword>吸血</color>】、【<color=Keyword>光紋</color>】、【<color=Keyword>障壁</color>】中隨機獲得3個能力。
""";
    }

}
