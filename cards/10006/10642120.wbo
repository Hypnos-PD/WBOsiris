wbo 0.1.0;

card 10642120 {
    type follower;
    cost 8;
    stats 5/5;

    effect {
        when own turn ends {
            evolve self silent;
        }
        when self evolved {
            damage oppo.field.followers 3;
            damage oppo.leader 3;
        }
    }

    meta {
        pack 10006;
        class dragoncraft;
        rarity silver;
    }

    locale chs {
        name "尖刺龙";
        text """
自己的回合结束时，本随从进化。
<hr><ev>本随从进化时，对对手的战场上的所有随从和对手的主战者造成3点伤害。</ev>
""";
    }

    locale eng {
        name "Spiked Dragon";
        text """
At the end of your turn, evolve this follower.
<hr><ev>When this follower evolves, deal 3 damage to all enemies.</ev>
""";
    }

    locale jpn {
        name "スパイクドラゴン";
        text """
自分のターン終了時、これは進化する。
<hr><ev>これが進化したとき、相手の場のフォロワーすべてと相手のリーダーに3ダメージ。</ev>
""";
    }

    locale kor {
        name "스파이크 드래곤";
        text """
내 턴 종료시, 이 추종자는 진화한다.
<hr><ev>이 추종자가 진화했을 때, 상대방 전장의 추종자 모두와 상대방 리더에게 3 피해.</ev>
""";
    }

    locale cht {
        name "銳刺之龍";
        text """
自己的回合結束時，使這張卡片進化。
<hr><ev>當這張卡片進化時，給予敵方戰場上全部的從者卡與敵方的主戰者3點傷害。</ev>
""";
    }

}
