wbo 0.1.0;

card 10672110 {
    type follower;
    cost 5;
    stats 2/1;

    effect {
        fanfare {
            summon 1 card 10672110;
            evolve summoned silent;
            evolve self silent;
        }
    }

    meta {
        pack 10006;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "拙劣的人偶";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>拙劣的人偶</color>』，该随从和本随从进化。
""";
    }

    locale eng {
        name "Substandard Puppet";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Substandard Puppet</color></i></b> and evolve it and this follower.
""";
    }

    locale jpn {
        name "<rub=\"せつれつ\">拙劣</rub>の<rub=\"にんぎょう\">人形</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>拙劣の人形</color>』1枚を自分の場に出す。それとこれは進化する。
""";
    }

    locale kor {
        name "졸렬의 인형";
        text """
[<color=Keyword>출격</color>] <color=Keyword>졸렬의 인형</color> 1장을 내 전장에 소환. 그 추종자와 이 추종자는 진화한다.
""";
    }

    locale cht {
        name "拙劣的人偶";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>拙劣的人偶</color>』到自己的戰場上。使其與這張卡片進化。
""";
