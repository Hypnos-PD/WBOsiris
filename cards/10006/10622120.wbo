wbo 0.1.0;

card 10622120 {
    type follower;
    cost 8;
    stats 6/6;

    effect {
        storm;
        fanfare {
            destroy oppo.field.followers where life == 1;
        }
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "猫人水手";
        text """
【<color=Keyword>入场曲</color>】破坏对手的战场上的所有生命值为1的随从。
<hr>【<color=Keyword>疾驰</color>】
""";
    }

    locale eng {
        name "Navy Cat";
        text """
<b><color=Keyword>Fanfare</color></b>: Destroy all enemy followers with 1 defense.
<hr><b><color=Keyword>Storm</color></b>
""";
    }

    locale jpn {
        name "キャットネイビー";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場の体力1のフォロワーすべてを破壊。
<hr>【<color=Keyword>疾走</color>】
""";
    }

    locale kor {
        name "캣 네이비";
        text """
[<color=Keyword>출격</color>] 체력이 1인 상대방 전장의 추종자 모두를 파괴.
<hr>[<color=Keyword>질주</color>]
""";
    }

    locale cht {
        name "巧貓海員";
        text """
【<color=Keyword>入場曲</color>】破壞敵方戰場上生命值為1的全部從者卡。
