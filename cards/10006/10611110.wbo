wbo 0.1.0;

card 10611110 {
    type follower;
    cost 4;
    stats 4/4;

    effect {
        fanfare {
            add 1 card 90011120 to hand;
        }
        evolve {
            summon 1 card 90011120;
        }
    }

    meta {
        pack 10006;
        class forestcraft;
        rarity bronze;
    }

    locale chs {
        name "慈育的森民";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>新绿的妖精</color>』加入手牌。
<hr><ev>【<color=Keyword>进化时</color>】召唤1个『<color=Keyword>新绿的妖精</color>』。</ev>
""";
    }

    locale eng {
        name "Motherly Forestdweller";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Springbloom Fairy</color></i></b> to your hand.
<hr><ev><b><color=Keyword>Evolve</color></b>: Summon a <b><i><color=Keyword>Springbloom Fairy</color></i></b>.</ev>
""";
    }

    locale jpn {
        name "<rub=\"じいく\">慈育</rub>の<rub=\"もりびと\">森人</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>新緑のフェアリー</color>』1枚を自分の手札に加える。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>新緑のフェアリー</color>』1枚を自分の場に出す。</ev>
""";
    }

    locale kor {
        name "자육의 숲주민";
        text """
[<color=Keyword>출격</color>] <color=Keyword>신록의 요정</color> 1장을 내 패에 넣는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>신록의 요정</color> 1장을 내 전장에 소환.</ev>
""";
    }

    locale cht {
        name "慈育的森林住民";
        text """
【<color=Keyword>入場曲</color>】增加1張『<color=Keyword>新綠的妖精</color>』到自己的手牌中。
<hr><ev>【<color=Keyword>進化時</color>】召喚1張『<color=Keyword>新綠的妖精</color>』到自己的戰場上。</ev>
""";
    }

}
