wbo 0.1.0;

card 10634120 {
    type follower;
    cost 10;
    stats 5/5;
    trait encroacher;

    effect {
        when own follower summoned while self in hand where card 10631110 {
            reduce cost self 1 minimum 0;
        }
        fanfare {
            summon 1 card 10631110;
            add storm to summoned;
            summon 1 card 10631110;
            add storm to summoned;
        }
        evolve {
            add 1 card 90034330 to hand;
        }
    }

    faith {
        counter value 0;

        when own follower summoned where card 10631110 {
            add 1 counter value;
        }

        locale chs {
            name "信仰：古旧天晶·卡卢基典瑟拉";
            text """
信仰值起始为0。
<hr>自己的『<color=Keyword>天晶魔手</color>』进入战场时，信仰值+1。
""";
        }

        locale eng {
            name "Faith: Crystals of the Eld, Kalukidensera";
            text """
This faith's value starts at 0.
<hr>Whenever an allied <b><i><color=Keyword>Crystalspawn</color></i></b> enters the field, increase this faith's value by 1.
""";
        }

        locale jpn {
            name "信仰：<rub=\"こきゅうてんしょう\">古旧天晶</rub>・カルキデンセラ";
            text """
信仰値は0から始まる。
<hr>自分の『<color=Keyword>天晶の魔手</color>』が場に出たとき、信仰値を+1する。
""";
        }

        locale kor {
            name "신앙: 고구천정 칼키덴세라";
            text """
신앙 수치는 0부터 시작.
<hr>내 <color=Keyword>천정의 마수</color>가 전장에 소환되었을 때, 신앙 수치를 +1.
""";
        }

        locale cht {
            name "信仰：古舊天晶‧卡盧基典瑟拉";
            text """
信仰值由0開始。
<hr>當自己的『<color=Keyword>天晶的魔手</color>』進入戰場時，使信仰值+1。
""";
        }
    }

    meta {
        pack 10006;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "古旧天晶·卡卢基典瑟拉";
        text """
在手牌中发动。自己的『<color=Keyword>天晶魔手</color>』进入战场时，使本卡牌的费用-1。
<hr>【<color=Keyword>入场曲</color>】召唤2个『<color=Keyword>天晶魔手</color>』，使其获得【<color=Keyword>疾驰</color>】。
<hr><ev>【<color=Keyword>进化时</color>】将1张『<color=Keyword>天晶深渊</color>』加入手牌。</ev>
""";
    }

    locale eng {
        name "Calge-Danthla, Eld Crystals";
        text """
Activates in hand. Whenever an allied <b><i><color=Keyword>Crystalspawn</color></i></b> enters the field, reduce the cost of this card by 1.
<hr><b><color=Keyword>Fanfare</color></b>: Summon 2 copies of <b><i><color=Keyword>Crystalspawn</color></i></b> and give them <b><color=Keyword>Storm</color></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Add a <b><i><color=Keyword>Depths of the Eld Crystals</color></i></b> to your hand.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ふる\">旧</rub>き<rub=\"てんしょう\">天晶</rub>・カルギデンスラ";
        text """
手札で働く。自分の『<color=Keyword>天晶の魔手</color>』が場に出たとき、これのコストを-1する。
<hr>【<color=Keyword>ファンファーレ</color>】『<color=Keyword>天晶の魔手</color>』2枚を自分の場に出す。それは【<color=Keyword>疾走</color>】を持つ。
<hr><ev>【<color=Keyword>進化時</color>】『<color=Keyword>天晶の深淵</color>』1枚を自分の手札に加える。</ev>
""";
    }

    locale kor {
        name "옛 천정 카르기덴틀라";
        text """
패에서 발동. 내 <color=Keyword>천정의 마수</color>가 전장에 소환되었을 때, 이 추종자의 비용을 -1.
<hr>[<color=Keyword>출격</color>] <color=Keyword>천정의 마수</color> 2장을 내 전장에 소환. 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] <color=Keyword>천정의 심연</color> 1장을 내 패에 넣는다.</ev>
""";
    }

    locale cht {
        name "古老天晶‧卡邇基登斯拉";
        text """
於手牌中發動。當自己的『<color=Keyword>天晶的魔手</color>』進入戰場時，使這張卡片的消費-1。
<hr>【<color=Keyword>入場曲</color>】召喚2張『<color=Keyword>天晶的魔手</color>』到自己的戰場上。使其獲得【<color=Keyword>疾馳</color>】。
<hr><ev>【<color=Keyword>進化時</color>】增加1張『<color=Keyword>天晶的深淵</color>』到自己的手牌中。</ev>
""";
    }

}
