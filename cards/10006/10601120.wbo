wbo 0.1.0;

card 10601120 {
    type follower;
    cost 5;
    stats 4/4;

    effect {
        bane;
        fanfare {
            require target from oppo.field.followers;
            destroy target;
        }
    }

    meta {
        pack 10006;
        class neutral;
        rarity bronze;
    }

    locale chs {
        name "匍匐的异类";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，破坏该随从。
<hr>【<color=Keyword>毁灭</color>】
""";
    }

    locale eng {
        name "Disrupted Commoner";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field and destroy it.
<hr><b><color=Keyword>Bane</color></b>
""";
    }

    locale jpn {
        name "<rub=\"は\">這</rub>い<rub=\"よ\">寄</rub>られし<rub=\"もの\">者</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それを破壊。
<hr>【<color=Keyword>必殺</color>】
""";
    }

    locale kor {
        name "기어오는 자";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자를 파괴.
<hr>[<color=Keyword>필살</color>]
""";
    }

    locale cht {
        name "潛步的迫近者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。將其破壞。
<hr>【<color=Keyword>必殺</color>】
""";
    }

}
