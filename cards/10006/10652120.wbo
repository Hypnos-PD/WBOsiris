wbo 0.1.0;

card 10652120 {
    type follower;
    cost 4;
    stats 4/5;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class abysscraft;
        rarity silver;
    }

    locale chs {
        name "失恋恶魔";
        text """
【<color=Keyword>爆能强化</color>_7】本随从获得【<color=Keyword>疾驰</color>】。
<hr><ev>【<color=Keyword>进化时</color>】选择对手的战场上的1个随从，对其造成4点伤害。</ev>
""";
    }

    locale eng {
        name "Devilish Heartbreaker";
        text """
<b><color=Keyword>Enhance</color> (7)</b>: Give this follower <b><color=Keyword>Storm</color></b>.
<hr><ev><b><color=Keyword>Evolve</color></b>: Select an enemy follower on the field and deal it 4 damage.</ev>
""";
    }

    locale jpn {
        name "ロストラブデビル";
        text """
【<color=Keyword>エンハンス</color>_7】これは【<color=Keyword>疾走</color>】を持つ。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワー1枚を選ぶ。それに4ダメージ。</ev>
""";
    }

    locale kor {
        name "로스트 러브 데빌";
        text """
[<color=Keyword>증강</color> 7] 이 추종자는 [<color=Keyword>질주</color>]를 갖는다.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 4 피해.</ev>
""";
    }

    locale cht {
        name "斷情惡魔";
        text """
【<color=Keyword>爆能強化</color>_7】使這張卡片獲得【<color=Keyword>疾馳</color>】。
<hr><ev>【<color=Keyword>進化時</color>】指定1張敵方戰場上的從者卡。給予其4點傷害。</ev>
""";
