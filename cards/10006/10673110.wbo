wbo 0.1.0;

card 10673110 {
    type follower;
    cost 8;
    stats 3/4;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "愚劣的兵器";
        text """
【<color=Keyword>入场曲</color>】召唤2个『<color=Keyword>愚劣的兵器</color>』。
<hr>自己的回合结束时，对对手的战场上的所有随从分配3点伤害。
<hr><ev>【<color=Keyword>进化时</color>】对对手的战场上的所有随从分配3点伤害。</ev>
""";
    }

    locale eng {
        name "Ludicrous Ordnance";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 2 copies of <b><i><color=Keyword>Ludicrous Ordnance</color></i></b>.
<hr>At the end of your turn, deal 3 damage split between all enemy followers.
<hr><ev><b><color=Keyword>Evolve</color></b>: Deal 3 damage split between all enemy followers.</ev>
""";
    }

    locale jpn {
        name "<rub=\"ぐれつ\">愚劣</rub>の<rub=\"へいき\">兵器</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>愚劣の兵器</color>』2枚を自分の場に出す。
<hr>自分のターン終了時、相手の場のフォロワーすべてに3ダメージを割りふる。
<hr><ev>【<color=Keyword>進化時</color>】相手の場のフォロワーすべてに3ダメージを割りふる。</ev>
""";
    }

    locale kor {
        name "우열의 병기";
        text """
[<color=Keyword>출격</color>] <color=Keyword>우열의 병기</color> 2장을 내 전장에 소환.
<hr>내 턴 종료시, 상대방 전장의 추종자 모두에게 3 피해를 분배한다.
<hr><ev>[<color=Keyword>진화시</color>] 상대방 전장의 추종자 모두에게 3 피해를 분배한다.</ev>
""";
    }

    locale cht {
        name "愚劣的兵器";
        text """
【<color=Keyword>入場曲</color>】召喚2張『<color=Keyword>愚劣的兵器</color>』到自己的戰場上。
<hr>自己的回合結束時，對敵方戰場上全部的從者卡分配3點傷害。
<hr><ev>【<color=Keyword>進化時</color>】對敵方戰場上全部的從者卡分配3點傷害。</ev>
""";
    }

}
