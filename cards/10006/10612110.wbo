wbo 0.1.0;

card 10612110 {
    type follower;
    cost 2;
    stats 1/2;

    effect {
        fanfare {
            add 1 card 90011120 to hand;
        }
    }

    meta {
        pack 10006;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "慈颜的拥趸";
        text """
【<color=Keyword>入场曲</color>】将1张『<color=Keyword>新绿的妖精</color>』加入手牌。
""";
    }

    locale eng {
        name "Kindly Executor";
        text """
<b><color=Keyword>Fanfare</color></b>: Add a <b><i><color=Keyword>Springbloom Fairy</color></i></b> to your hand.
""";
    }

    locale jpn {
        name "<rub=\"じがん\">慈顔</rub>の<rub=\"にな\">担</rub>い<rub=\"て\">手</rub>";
