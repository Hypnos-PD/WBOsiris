wbo 0.1.0;

card 10654110 {
    type follower;
    cost 9;
    stats 10/10;

    effect {
        aura;
        ability_destruction_guard;
        clash {
            destroy opponent;
        }
        superevolve {
            set_attack_limit self 3;
        }
    }

    meta {
        pack 10006;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "枯渴的魔神·阿尔弭斯";
        text """
【<color=Keyword>灵气</color>】
不会被能力破坏。
【<color=Keyword>交战时</color>】破坏交战对手。
<hr><sev>【<color=Keyword>超进化时</color>】本随从获得「1回合可以攻击3次」。</sev>
""";
    }

    locale eng {
        name "Armes, Depletive Demon";
        text """
<b><color=Keyword>Aura</color></b>
Can't be destroyed by abilities.
<hr><b><color=Keyword>Clash</color></b>: Destroy the opposing follower.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give this follower \"Can attack 3 times per turn.\"</sev>
""";
    }

    locale jpn {
        name "<rub=\"こかつ\">枯渇</rub>の<rub=\"しんま\">神魔</rub>・アルメス";
        text """
【<color=Keyword>オーラ</color>】
能力によって破壊できない。
【<color=Keyword>交戦時</color>】交戦相手を破壊。
<hr><sev>【<color=Keyword>超進化時</color>】これは「1ターンに3回攻撃できる。」を持つ。</sev>
""";
    }

    locale kor {
        name "고갈의 신마 아르메스";
        text """
[<color=Keyword>오라</color>]
능력에 의해 파괴되지 않는다.
[<color=Keyword>교전시</color>] 교전 상대를 파괴.
<hr><sev>[<color=Keyword>초진화시</color>] 이 추종자는 「1턴에 3회 공격 가능」을 갖는다.</sev>
""";
    }

    locale cht {
        name "枯渴的神魔‧阿爾梅斯";
        text """
【<color=Keyword>光紋</color>】
無法被能力破壞。
【<color=Keyword>交戰時</color>】破壞交戰對象。
<hr><sev>【<color=Keyword>超進化時</color>】使這張卡片獲得「1回合中可進行3次攻擊」。</sev>
""";
    }

}
