wbo 0.1.0;

card 10623310 {
    type spell;
    cost 1;
    trait encroacher;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity gold;
    }

    locale chs {
        name "惨烈的天剑";
        text """
【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）抽取1张卡牌。</ridx>
<ridx=1>（2）对对手的战场上的随机1个随从造成3点伤害。</ridx>
【<color=Keyword>爆能强化</color>_3】改为发动所有能力。
""";
    }

    locale eng {
        name "Ruthless Eld Sword";
        text """
Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Draw a card.</ridx>
<ridx=1>2. Deal 3 damage to a random enemy follower.</ridx>
<b><color=Keyword>Enhance</color> (3)</b>: Activate all of them instead.
""";
    }

    locale jpn {
        name "<rub=\"せいれつ\">凄烈</rub>の<rub=\"てんけん\">天剣</rub>";
        text """
【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）自分のデッキから1枚を引く。</ridx>
<ridx=1>（2）相手の場のフォロワーからランダム1枚に3ダメージ。</ridx>
【<color=Keyword>エンハンス</color>_3】1つを選ぶのではなくすべて。
""";
    }

    locale kor {
        name "격렬의 천검";
        text """
[<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 내 덱에서 1장을 뽑는다.</ridx>
<ridx=1>(2) 상대방 전장의 추종자 중 무작위로 1장에게 3 피해.</ridx>
[<color=Keyword>증강</color> 3] 1개를 선택하는 대신 모두.
""";
    }

    locale cht {
        name "淒烈的天劍";
        text """
指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）由自己的牌堆中抽取1張卡片。</ridx>
<ridx=1>（2）隨機給予1張敵方戰場上的從者卡3點傷害。</ridx>
【<color=Keyword>爆能強化</color>_3】由原本的指定1個轉變為全部。
""";
    }

}
