wbo 0.1.0;

card 10674110 {
    type follower;
    cost 7;
    stats 6/6;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "恶劣的纯心·卡密希拉";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>低劣的玩具</color>』和1个『<color=Keyword>拙劣的人偶</color>』。
<hr>自己的原始费用为5或以上的其他随从进入战场时，使其进化。
<hr><sev>【<color=Keyword>超进化时</color>】对对手的主战者造成X点伤害。X为自己的战场上的原始费用为5或以上的随从的张数。</sev>
""";
    }

    locale eng {
        name "Camiscilla, Unfeeling Heart";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Shoddy Plaything</color></i></b> and <b><i><color=Keyword>Substandard Puppet</color></i></b>.
<hr>Whenever another allied follower with a base cost of 5 or more enters the field, evolve it.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Deal X damage to the enemy leader. X is the number of allied followers on the field with a base cost of 5 or more.</sev>
""";
    }

    locale jpn {
        name "<rub=\"れつあく\">劣悪</rub>の<rub=\"じゅんしん\">純心</rub>・カミシラ";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>低劣の玩具</color>』1枚と『<color=Keyword>拙劣の人形</color>』1枚を自分の場に出す。
<hr>自分の他の元のコスト5以上のフォロワーが場に出たとき、それは進化する。
<hr><sev>【<color=Keyword>超進化時</color>】相手のリーダーにXダメージ。Xは自分の場の元のコスト5以上のフォロワーの枚数である。</sev>
""";
    }

    locale kor {
        name "열악의 순수 카미시라";
        text """
[<color=Keyword>출격</color>] <color=Keyword>저열의 완구</color> 1장, <color=Keyword>졸렬의 인형</color> 1장을 내 전장에 소환.
<hr>원래 비용이 5 이상인 내 다른 추종자가 전장에 소환되었을 때, 그 추종자는 진화한다.
<hr><sev>[<color=Keyword>초진화시</color>] 상대방 리더에게 X 피해. X는 원래 비용이 5 이상인 내 전장의 추종자 수.</sev>
""";
    }

    locale cht {
        name "惡劣的純心‧卡宓辛菈";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>粗劣的玩具</color>』與1張『<color=Keyword>拙劣的人偶</color>』到自己的戰場上。
<hr>當自己的其他原始消費為5以上的從者卡進入戰場時，使其進化。
<hr><sev>【<color=Keyword>超進化時</color>】給予敵方的主戰者X點傷害。X為「自己戰場上原始消費為5以上的從者卡張數」。</sev>
""";
    }

}
