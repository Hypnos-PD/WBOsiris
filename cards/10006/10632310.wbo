wbo 0.1.0;

card 10632310 {
    type spell;
    cost 1;

    effect {
        require target from own.field.followers where card 10631110;
        destroy target;
        draw 2;
    }

    meta {
        pack 10006;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "正常的侵蚀";
        text """
选择自己的战场上的1个『<color=Keyword>天晶魔手</color>』，破坏该随从。抽取2张卡牌。
""";
    }

    locale eng {
        name "Reaved Order";
        text """
Select an allied <b><i><color=Keyword>Crystalspawn</color></i></b> on the field and destroy it. Draw 2 cards.
""";
    }

    locale jpn {
        name "<rub=\"せいじょう\">正常</rub>の<rub=\"しんしょく\">侵食</rub>";
        text """
自分の場の『<color=Keyword>天晶の魔手</color>』1枚を選ぶ。それを破壊。自分のデッキから2枚を引く。
""";
    }

    locale kor {
        name "정상의 침식";
        text """
내 전장에서 <color=Keyword>천정의 마수</color> 1장을 선택한다. 그 추종자를 파괴. 내 덱에서 2장을 뽑는다.
""";
    }

    locale cht {
        name "侵蝕日常";
        text """
指定1張自己戰場上的『<color=Keyword>天晶的魔手</color>』。將其破壞。由自己的牌堆中抽取2張卡片。
