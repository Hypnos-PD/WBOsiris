wbo 0.1.0;

card 10624110 {
    type follower;
    cost 6;
    stats 4/5;

    effect {
        fanfare {
            summon 1 card 10621110;
            add bane to summoned;
        }
        enhance 7 {
            summon 1 card 10621110;
            add drain to summoned;
        }
        enhance 8 {
            summon 1 card 10621110;
            add storm to summoned;
        }
        superevolve {
            buff own.field.followers other +1/+1;
        }
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity legendary;
    }

    locale chs {
        name "惨烈的剑王·罗德诺艾尔四世";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>勇烈的士兵</color>』，使其获得【<color=Keyword>毁灭</color>】。
【<color=Keyword>爆能强化</color>_7】召唤1个『<color=Keyword>勇烈的士兵</color>』，使其获得【<color=Keyword>虹吸</color>】。
【<color=Keyword>爆能强化</color>_8】召唤1个『<color=Keyword>勇烈的士兵</color>』，使其获得【<color=Keyword>疾驰</color>】。
<hr><sev>【<color=Keyword>超进化时</color>】使自己的战场上的其他所有随从+1/+1。</sev>
""";
    }

    locale eng {
        name "Noel IV, Ruthless Warlord";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Fearless Soldier</color></i></b> and give it <b><color=Keyword>Bane</color></b>.
<b><color=Keyword>Enhance</color> (7)</b>: Summon a <b><i><color=Keyword>Fearless Soldier</color></i></b> and give it <b><color=Keyword>Drain</color></b>.
<b><color=Keyword>Enhance</color> (8)</b>: Summon a <b><i><color=Keyword>Fearless Soldier</color></i></b> and give it <b><color=Keyword>Storm</color></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Give all other allied followers on the field +1/+1.</sev>
""";
    }

    locale jpn {
        name "<rub=\"せいれつ\">凄烈</rub>の<rub=\"けんおう\">剣王</rub>・ロードノエル<rub=\"よんせい\">四世</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>勇烈の兵士</color>』1枚を自分の場に出す。それは【<color=Keyword>必殺</color>】を持つ。
【<color=Keyword>エンハンス</color>_7】『<color=Keyword>勇烈の兵士</color>』1枚を自分の場に出す。それは【<color=Keyword>ドレイン</color>】を持つ。
【<color=Keyword>エンハンス</color>_8】『<color=Keyword>勇烈の兵士</color>』1枚を自分の場に出す。それは【<color=Keyword>疾走</color>】を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】自分の場の他のフォロワーすべては+1/+1する。</sev>
""";
    }

    locale kor {
        name "격렬의 검왕 로드 노엘 4세";
        text """
[<color=Keyword>출격</color>] <color=Keyword>용렬의 병사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>필살</color>]을 갖는다.
[<color=Keyword>증강</color> 7] <color=Keyword>용렬의 병사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>흡혈</color>]을 갖는다.
[<color=Keyword>증강</color> 8] <color=Keyword>용렬의 병사</color> 1장을 내 전장에 소환. 그 추종자는 [<color=Keyword>질주</color>]를 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 내 전장의 다른 추종자 모두는 +1/+1.</sev>
