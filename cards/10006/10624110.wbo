    }

    locale cht {
        name "淒烈的劍王‧領主諾艾爾四世";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>勇烈的士兵</color>』到自己的戰場上。使其獲得【<color=Keyword>必殺</color>】。
