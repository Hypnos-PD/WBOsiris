wbo 0.1.0;

card 10632110 {
    type follower;
    cost 5;
    stats 3/4;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "魔境的学生";
        text """
【<color=Keyword>入场曲</color>】召唤2个『<color=Keyword>天晶魔手</color>』。
<hr>自己的『<color=Keyword>天晶魔手</color>』进入战场时，回复自己的主战者1点生命值。
""";
    }

    locale eng {
        name "Enraptured Student";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon 2 copies of <b><i><color=Keyword>Crystalspawn</color></i></b>.
<hr>Whenever an allied <b><i><color=Keyword>Crystalspawn</color></i></b> enters the field, restore 1 defense to your leader.
""";
    }

    locale jpn {
        name "<rub=\"まきょう\">魔境</rub>の<rub=\"せいと\">生徒</rub>";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>天晶の魔手</color>』2枚を自分の場に出す。
<hr>自分の『<color=Keyword>天晶の魔手</color>』が場に出たとき、自分のリーダーを1回復。
""";
    }

    locale kor {
        name "마경의 학생";
        text """
[<color=Keyword>출격</color>] <color=Keyword>천정의 마수</color> 2장을 내 전장에 소환.
<hr>내 <color=Keyword>천정의 마수</color>가 전장에 소환되었을 때, 내 리더를 1 회복.
""";
    }

    locale cht {
        name "魔境的學生";
        text """
【<color=Keyword>入場曲</color>】召喚2張『<color=Keyword>天晶的魔手</color>』到自己的戰場上。
<hr>當自己的『<color=Keyword>天晶的魔手</color>』進入戰場時，回復自己的主戰者1點生命值。
""";
    }

}
