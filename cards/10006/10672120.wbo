wbo 0.1.0;

card 10672120 {
    type follower;
    cost 4;
    stats 1/1;

    effect {
        unplayable;
    }

    meta {
        pack 10006;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "胆小鬼先锋";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个生命值为3或以下的随从，使其消失。
<hr>【<color=Keyword>潜行</color>】
""";
    }

    locale eng {
        name "Timid Pioneer";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field with 3 defense or less and banish it.
<hr><b><color=Keyword>Ambush</color></b>
""";
    }

    locale jpn {
        name "<rub=\"しょうたん\">小胆</rub>のパイオニア";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場の体力3以下のフォロワー1枚を選ぶ。それを消滅。
<hr>【<color=Keyword>潜伏</color>】
""";
    }

    locale kor {
        name "겁 많은 개척자";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 체력이 3 이하인 추종자 1장을 선택한다. 그 추종자를 소멸.
<hr>[<color=Keyword>잠복</color>]
""";
    }

    locale cht {
        name "膽小的開拓者";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上生命值為3以下的從者卡。使其消失。
<hr>【<color=Keyword>潛行</color>】
""";
    }

}
