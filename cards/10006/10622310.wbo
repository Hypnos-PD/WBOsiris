wbo 0.1.0;

card 10622310 {
    type spell;
    cost 1;

    effect {
        gain own crest 10622310;
        enhance 3 {
            raise countdown own.crests 2;
        }
    }

    crest {
        countdown 2;

        when own card played where enhanced {
            summon 1 card 10621110;
        }

        locale chs {
            name "纹章：威风的行军";
            text """
【<color=Keyword>吟唱</color>_2】
自己通过【<color=Keyword>爆能强化</color>】使用卡牌时，召唤1个『<color=Keyword>勇烈的士兵</color>』。
""";
        }

        locale eng {
            name "Crest: March of Valor";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
Whenever you play an <b><color=Keyword>Enhance</color>d</b> card, summon a <b><i><color=Keyword>Fearless Soldier</color></i></b>.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"いふう\">威風</rub>の<rub=\"こうしん\">行進</rub>";
            text """
【<color=Keyword>カウントダウン</color>_2】
自分が【<color=Keyword>エンハンス</color>】でカードを使用したとき、『<color=Keyword>勇烈の兵士</color>』1枚を自分の場に出す。
""";
        }

        locale kor {
            name "크레스트: 위풍의 행진";
            text """
[<color=Keyword>카운트다운</color> 2]
내가 [<color=Keyword>증강</color>]으로 카드를 사용했을 때, 「<color=Keyword>용렬한 병사</color>」 1장을 내 전장에 소환.
""";
        }

        locale cht {
            name "紋章：威風的行軍";
            text """
【<color=Keyword>倒數</color>_2】
自己透過【<color=Keyword>爆能強化</color>】使用卡片時，召喚1張『<color=Keyword>勇烈的士兵</color>』。
""";
        }
    }

    meta {
        pack 10006;
        class swordcraft;
        rarity silver;
    }

    locale chs {
        name "威风的行军";
        text """
使自己获得『纹章：威风的行军』。
【<color=Keyword>爆能强化</color>_3】使自己的『纹章：威风的行军』的倒计数+2。
""";
    }

    locale eng {
        name "Majestic Conquest";
        text """
Gain <b><i>Crest: Majestic Conquest</i></b>.
<b><color=Keyword>Enhance</color> (3)</b>: Delay the count of your <b><i>Crest: Majestic Conquest</i></b> by 2.
""";
    }

    locale jpn {
        name "<rub=\"いふう\">威風</rub>の<rub=\"こうぐん\">行軍</rub>";
        text """
自分は『クレスト：威風の行軍』を持つ。
【<color=Keyword>エンハンス</color>_3】自分の『クレスト：威風の行軍』のカウントを+2する。
""";
    }

    locale kor {
        name "위풍당당한 행군";
        text """
나는 「크레스트: 위풍당당한 행군」을 갖는다.
[<color=Keyword>증강</color> 3] 내 「크레스트: 위풍당당한 행군」의 카운트를 +2.
""";
    }

    locale cht {
        name "威武行軍";
        text """
使自己獲得『紋章：威武行軍』。
【<color=Keyword>爆能強化</color>_3】使自己的『紋章：威武行軍』倒數回合數+2。
""";
    }

}
