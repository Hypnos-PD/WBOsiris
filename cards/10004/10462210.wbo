wbo 0.1.0;

card 10462210 {
    type amulet;
    cost 4;

    effect {
        when own amulet engaged while self in hand {
            reduce cost self 1 minimum 0;
        }
        engage 0 {
            require ally from own.field.followers where form unevolved;
            destroy self;
            evolve ally silent;
        }
    }

    meta {
        pack 10004;
        class havencraft;
        rarity silver;
    }

    locale chs {
        name "骑驰天空之艇";
        text """
在手牌中发动。自己【<color=Keyword>启动</color>】护符时，使本卡牌的费用-1。
<hr>【<color=Keyword>启动</color>】破坏本卡牌。选择自己的战场上的1个进化前的随从，使其进化。
""";
    }

    locale eng {
        name "Skyfaring Vessel";
        text """
Activates in hand. Whenever you <b><color=Keyword>Engage</color></b> an amulet, reduce the cost of this card by 1.
<hr><b><color=Keyword>Engage</color></b>: Destroy this card. Select an unevolved allied follower on the field and evolve it.
""";
    }

    locale jpn {
        name "<rub=\"そら\">空</rub>を<rub=\"ゆ\">征</rub>く<rub=\"ふね\">艇</rub>";
        text """
手札で働く。自分がアミュレットを【<color=Keyword>アクト</color>】したとき、これのコストを-1する。
<hr>【<color=Keyword>アクト</color>】これを破壊。自分の場の進化前のフォロワー1枚を選ぶ。それは進化する。
""";
    }

    locale kor {
        name "하늘을 나아가는 배";
        text """
패에서 발동. 내가 마법진을 [<color=Keyword>활성화</color>]했을 때, 이 마법진의 비용을 -1.
<hr>[<color=Keyword>활성화</color>] 이 마법진을 파괴. 내 전장에서 진화전인 추종자 1장을 선택한다. 그 추종자는 진화한다.
""";
    }

    locale cht {
        name "邁向蒼空之艇";
        text """
於手牌中發動。當自己進行護符卡的【<color=Keyword>策動</color>】時，使這張卡片的消費-1。
<hr>【<color=Keyword>策動</color>】破壞這張卡片。指定1張自己戰場上進化前的從者卡。使其進化。
""";
    }

}
