wbo 0.1.0;

card 10472110 {
    type follower;
    cost 5;
    stats 5/4;

    effect {
        fanfare {
            if skybound_art {
                choose ally from own.field.followers other where form unevolved;
                evolve ally silent;
                evolve self silent;
            }
        }
        clash {
            damage opponent 3;
        }
    }

    meta {
        pack 10004;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "轰雷闪狼·尤斯提斯";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>奥义</color>】选择自己的战场上的1个进化前的其他随从，该随从和本随从进化。
<hr>【<color=Keyword>交战时</color>】对交战对手造成3点伤害。
""";
    }

    locale eng {
        name "Eustace, Howl of Thunder";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Skybound Art</color></b> - Select another unevolved allied follower on the field and evolve it and this follower.
<hr><b><color=Keyword>Clash</color></b>: Deal 3 damage to the opposing follower.
""";
    }

    locale jpn {
        name "<rub=\"ごうらい\">轟雷</rub>の<rub=\"せんろう\">閃狼</rub>・ユーステス";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>奥義</color>】自分の場の他の進化前のフォロワー1枚を選ぶ。それとこれは進化する。
<hr>【<color=Keyword>交戦時</color>】交戦相手に3ダメージ。
""";
    }

    locale kor {
        name "굉뢰의 섬랑 유스테스";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>오의</color>] 내 전장에서 진화전인 다른 추종자 1장을 선택한다. 그 추종자와 이 추종자는 진화한다.
<hr>[<color=Keyword>교전시</color>] 교전 상대에게 3 피해.
""";
    }

    locale cht {
        name "轟雷的閃狼‧尤斯堤斯";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>奧義</color>】指定1張自己戰場上其他進化前的從者卡。使其與這張卡片進化。
<hr>【<color=Keyword>交戰時</color>】給予交戰對象3點傷害。
""";
    }

}
