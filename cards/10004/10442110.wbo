wbo 0.1.0;

card 10442110 {
    type follower;
    cost 5;
    stats 5/4;

    effect {
        fanfare {
            if own.maxpp == 10 {
                evolve self silent;
            }
        }
        when self evolved {
            damage oppo.field.followers 3;
        }
    }

    meta {
        pack 10004;
        class dragoncraft;
        rarity silver;
    }

    locale chs {
        name "冰封的命运·伊什米尔";
        text """
【<color=Keyword>入场曲</color>】若自己的能量点最大值为10，则本随从进化。
<hr><ev>本随从进化时，对对手的战场上的所有随从造成3点伤害。</ev>
""";
    }

    locale eng {
        name "Izmir, Frigid Fate";
        text """
<b><color=Keyword>Fanfare</color></b>: If you have 10 max play points, evolve this follower.
<hr><ev>When this follower evolves, deal 3 damage to all enemy followers.</ev>
""";
    }

    locale jpn {
        name "<rub=\"い\">凍</rub>てつく<rub=\"さだ\">定</rub>め・イシュミール";
        text """
【<color=Keyword>ファンファーレ</color>】自分のPP最大値が10なら、これは進化する。
<hr><ev>これが進化したとき、相手の場のフォロワーすべてに3ダメージ。</ev>
""";
    }

    locale kor {
        name "얼어붙는 숙명 이슈미르";
        text """
[<color=Keyword>출격</color>] 내 PP 최대치가 10이라면, 이 추종자는 진화한다.
<hr><ev>이 추종자가 진화했을 때, 상대방 전장의 추종자 모두에게 3 피해.</ev>
""";
    }

    locale cht {
        name "凍結的宿命‧依舒宓爾";
        text """
【<color=Keyword>入場曲</color>】如果自己的PP最大值為10，則會使這張卡片進化。
<hr><ev>當這張卡片進化時，給予敵方戰場上全部的從者卡3點傷害。</ev>
""";
    }

}
