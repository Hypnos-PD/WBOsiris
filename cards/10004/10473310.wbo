wbo 0.1.0;

card 10473310 {
    type spell;
    cost 6;

    effect {
        if super_skybound_art {
            damage oppo.field.followers 6;
            damage oppo.leader 6;
        } else {
            damage oppo.field.followers 3;
            damage oppo.leader 3;
        }
    }

    meta {
        pack 10004;
        class portalcraft;
        rarity gold;
    }

    locale chs {
        name "混沌军势";
        text """
对对手的战场上的所有随从和对手的主战者造成3点伤害。【<color=Keyword>解放奥义</color>】改为6点伤害。
""";
    }

    locale eng {
        name "Chaos Legion";
        text """
Deal 3 damage to all enemies. <b><color=Keyword>Super Skybound Art</color></b> - Deal 6 damage instead.
""";
    }

    locale jpn {
        name "ケイオス・レギオン";
        text """
相手の場のフォロワーすべてと相手のリーダーに3ダメージ。【<color=Keyword>解放奥義</color>】3ダメージではなく6ダメージ。
""";
    }

    locale kor {
        name "카오스 레기온";
        text """
상대방 전장의 추종자 모두와 상대방 리더에게 3 피해. [<color=Keyword>해방 오의</color>] 3 피해 대신 6 피해.
""";
    }

    locale cht {
        name "混沌軍勢";
        text """
給予敵方戰場上全部的從者卡與敵方的主戰者3點傷害。【<color=Keyword>解放奧義</color>】由原本的3點傷害轉變為6點傷害。
""";
    }

}
