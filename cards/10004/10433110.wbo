wbo 0.1.0;

card 10433110 {
    type follower;
    cost 3;
    stats 2/1;

    effect {
        fanfare {
            require target from oppo.field.followers;
            remove all abilities from target;
            damage target 3;
        }
        superevolve {
            gain own crest 10433110;
        }
    }

    crest {
        when own turn starts {
            damage oppo.leader 1;
        }

        locale chs {
            name "纹章：缅怀之火·埃尔默特";
            text """
自己的回合开始时，对对手的主战者造成1点伤害。
""";
        }

        locale eng {
            name "Crest: Elmott, Remembrance Aflame";
            text """
At the start of your turn, deal 1 damage to the enemy leader.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"かいきゅう\">懐旧</rub>の<rub=\"おく\">送</rub>り<rub=\"び\">火</rub>・エルモート";
            text """
自分のターン開始時、相手のリーダーに1ダメージ。
""";
        }

        locale kor {
            name "크레스트: 회고의 등불 엘모트";
            text """
내 턴 시작시, 상대방 리더에게 1 피해.
""";
        }

        locale cht {
            name "紋章：懷舊的送火‧艾爾蒙特";
            text """
自己的回合開始時，給予敵方的主戰者1點傷害。
""";
        }
    }

    meta {
        pack 10004;
        class runecraft;
        rarity gold;
    }

    locale chs {
        name "缅怀之火·埃尔默特";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的1个随从，使其失去所有能力，对其造成3点伤害。
<hr><sev>【<color=Keyword>超进化时</color>】使自己获得『纹章：缅怀之火·埃尔默特』。</sev>
""";
    }

    locale eng {
        name "Elmott, Remembrance Aflame";
        text """
<b><color=Keyword>Fanfare</color></b>: Select an enemy follower on the field, remove all abilities from it, and deal it 3 damage.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Gain <b><i>Crest: Elmott, Remembrance Aflame</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"かいきゅう\">懐旧</rub>の<rub=\"おく\">送</rub>り<rub=\"び\">火</rub>・エルモート";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー1枚を選ぶ。それは能力すべてを失う。それに3ダメージ。
<hr><sev>【<color=Keyword>超進化時</color>】自分は『クレスト：懐旧の送り火・エルモート』を持つ。</sev>
""";
    }

    locale kor {
        name "회고의 등불 엘모트";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 1장을 선택한다. 그 추종자는 능력을 전부 잃는다. 그 추종자에게 3 피해.
<hr><sev>[<color=Keyword>초진화시</color>] 나는 「크레스트: 회고의 등불 엘모트」를 갖는다.</sev>
""";
    }

    locale cht {
        name "懷舊的送火‧艾爾蒙特";
        text """
【<color=Keyword>入場曲</color>】指定1張敵方戰場上的從者卡。使其失去全部能力。給予其3點傷害。
<hr><sev>【<color=Keyword>超進化時</color>】使自己獲得『紋章：懷舊的送火‧艾爾蒙特』。</sev>
""";
    }

}
