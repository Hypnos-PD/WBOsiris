wbo 0.1.0;

card 10451310 {
    type spell;
    cost 2;

    effect {
        damage own.leader 2;
        gain own crest 10451310;
    }

    crest {
        countdown 2;

        when own turn ends {
            random victim from oppo.field.followers;
            damage victim 2;
            heal own.leader 1;
        }

        locale chs {
            name "纹章：妖异利刃";
            text """
【<color=Keyword>吟唱</color>_2】
自己的回合结束时，对对手的战场上的随机1个随从造成2点伤害。回复自己的主战者1点生命值。
""";
        }

        locale eng {
            name "Crest: Baleful Blade";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
At the end of your turn, deal 2 damage to a random enemy follower and restore 1 defense to your leader.
""";
        }

        locale jpn {
            name "クレスト：妖異の刃";
            text """
【<color=Keyword>カウントダウン</color>_2】
自分のターン終了時、相手の場のフォロワーからランダム1枚に2ダメージ。自分のリーダーを1回復。
""";
        }

        locale kor {
            name "크레스트: 요이한 칼날";
            text """
[<color=Keyword>카운트다운</color> 2]
내 턴 종료시, 상대방 전장의 추종자 중 무작위로 1장에게 2 피해. 내 리더를 1 회복.
""";
        }

        locale cht {
            name "紋章：妖異利刃";
            text """
【<color=Keyword>倒數</color>_2】
自己的回合結束時，隨機給予1張敵方戰場上的從者卡2點傷害。回復自己的主戰者1點生命值。
""";
        }
    }

    meta {
        pack 10004;
        class abysscraft;
        rarity bronze;
    }

    locale chs {
        name "妖异利刃";
        text """
对自己的主战者造成2点伤害。使自己获得『纹章：妖异利刃』。
""";
    }

    locale eng {
        name "Valiant Edge";
        text """
Deal 2 damage to your leader. Gain <b><i>Crest: Valiant Edge</i></b>.
""";
    }

    locale jpn {
        name "ヴァリアントエッジ";
        text """
自分のリーダーに2ダメージ。自分は『クレスト：ヴァリアントエッジ』を持つ。
""";
    }

    locale kor {
        name "밸리언트 에지";
        text """
내 리더에게 2 피해. 나는 「크레스트: 밸리언트 에지」를 갖는다.
""";
    }

    locale cht {
        name "異變銳擊";
        text """
給予自己的主戰者2點傷害。使自己獲得『紋章：異變銳擊』。
""";
    }

}
