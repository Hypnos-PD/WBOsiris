wbo 0.1.0;

card 10414120 {
    type follower;
    cost 5;
    stats 4/3;

    effect {
        fanfare {
            repeat 2 {
                random victim from oppo.field.followers;
                damage victim 4;
            }
        }
        superevolve {
            gain own crest 10414120;
        }
    }

    crest {
        countdown 4;

        when own card played once per own turn where type follower {
            evolve played silent;
        }

        locale chs {
            name "纹章：调和的舞者·尤艾尔&苏丝雅";
            text """
【<color=Keyword>吟唱</color>_4】
自己使用随从时，自己的每回合中可触发1次，使其进化。
""";
        }

        locale eng {
            name "Crest: Yuel & Socie, Dancers in Harmony";
            text """
<b><color=Keyword>Countdown</color> (4)</b>
Once on each of your turns, when you play a follower, evolve it.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"ちょうわ\">調和</rub>の<rub=\"ぶとうしゃ\">舞踏者</rub>・ユエル＆ソシエ";
            text """
【<color=Keyword>カウントダウン</color>_4】
自分がフォロワーをプレイしたとき、自分のターンごとに1回、それは進化する。
""";
        }

        locale kor {
            name "크레스트: 조화의 무용수 유엘&소시에";
            text """
[<color=Keyword>카운트다운</color> 4]
내가 추종자를 사용했을 때, 내 턴마다 1회에 한해 그 추종자는 진화한다.
""";
        }

        locale cht {
            name "紋章：調和的舞者‧尤艾爾＆蘇絲雅";
            text """
【<color=Keyword>倒數</color>_4】
當自己使用從者卡時，每個自己的回合僅限發動1次，使其進化。
""";
        }
    }

    meta {
        pack 10004;
        class forestcraft;
        rarity legendary;
    }

    locale chs {
        name "调和的舞者·尤艾尔&苏丝雅";
        text """
【<color=Keyword>入场曲</color>】发动2次「对对手的战场上的随机1个随从造成4点伤害」。
<hr><sev>【<color=Keyword>超进化时</color>】使自己获得『纹章：调和的舞者·尤艾尔&苏丝雅』。</sev>
""";
    }

    locale eng {
        name "Yuel & Societte, Dancing Duo";
        text """
<b><color=Keyword>Fanfare</color></b>: Do this 2 times: \"Deal 4 damage to a random enemy follower.\"
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Gain <b><i>Crest: Yuel & Societte, Dancing Duo</i></b>.</sev>
""";
    }

    locale jpn {
        name "<rub=\"ちょうわ\">調和</rub>の<rub=\"まいて\">舞手</rub>・ユエル＆ソシエ";
        text """
【<color=Keyword>ファンファーレ</color>】「相手の場のフォロワーからランダム1枚に4ダメージ。」を2回行う。
<hr><sev>【<color=Keyword>超進化時</color>】自分は『クレスト：調和の舞手・ユエル＆ソシエ』を持つ。</sev>
""";
    }

    locale kor {
        name "조화의 무용수 유엘&소시에";
        text """
[<color=Keyword>출격</color>] 「상대방 전장의 추종자 중 무작위로 1장에게 4 피해」를 2회 발동.
<hr><sev>[<color=Keyword>초진화시</color>] 나는 「크레스트: 조화의 무용수 유엘&소시에」를 갖는다.</sev>
""";
    }

    locale cht {
        name "調和的舞者‧尤埃爾＆蘇希耶";
        text """
【<color=Keyword>入場曲</color>】發動2次「隨機給予1張敵方戰場上的從者卡4點傷害」。
<hr><sev>【<color=Keyword>超進化時</color>】使自己獲得『紋章：調和的舞者‧尤埃爾＆蘇希耶』。</sev>
""";
    }

}
