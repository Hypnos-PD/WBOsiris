wbo 0.1.0;

card 10442310 {
    type spell;
    cost 2;

    effect {
        require target from oppo.field.followers;
        damage target 3;
        add cannot_attack to target until oppo turn ends;
    }

    meta {
        pack 10004;
        class dragoncraft;
        rarity silver;
    }

    locale chs {
        name "至爱狂轰";
        text """
选择对手的战场上的1个随从，对其造成3点伤害，对手的回合结束前，使其获得「无法攻击随从或主战者」。
""";
    }

    locale eng {
        name "Maximum Love Bomb";
        text """
Select an enemy follower on the field, deal it 3 damage, and give it \"Can't attack followers or leaders\" until the end of your opponent's turn.
""";
    }

    locale jpn {
        name "ラヴマックス・ボンバー";
        text """
相手の場のフォロワー1枚を選ぶ。それに3ダメージ。相手のターン終了まで、それは「フォロワーやリーダーを攻撃できない。」を持つ。
""";
    }

    locale kor {
        name "러브 맥스 봄버";
        text """
상대방 전장에서 추종자 1장을 선택한다. 그 추종자에게 3 피해. 상대방 턴 종료까지 그 추종자는 「추종자나 리더 공격 불가」를 갖는다.
""";
    }

    locale cht {
        name "愛情無限‧天女爆彈擊";
        text """
指定1張敵方戰場上的從者卡。給予其3點傷害。到敵方的回合結束為止，使其獲得「無法攻擊從者或主戰者」。
""";
    }

}
