wbo 0.1.0;

card 10434120 {
    type follower;
    cost 4;
    stats 5/3;

    effect {
        fanfare {
            add 2 earthsigil;
            add 1 card 90034320 to hand;
            if skybound_art {
                evolve self silent;
            }
            if super_skybound_art {
                gain own crest 10434120;
            }
        }
    }

    crest {
        when own turn starts {
            earthrite 1 {
                add 1 card 90034320 to hand;
            }
        }

        locale chs {
            name "纹章：天才美少女炼金术士·卡莉奥丝特罗";
            text """
自己的回合开始时，【<color=Keyword>土之秘术</color>_1】将1张『<color=Keyword>伟大之术</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Cagliostro, Genius Alchemist";
            text """
At the start of your turn, <b><color=Keyword>Earth Rite</color> (1)</b> - Add an <b><i><color=Keyword>Ars Magna</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：天才美少女錬金術師・カリオストロ";
            text """
自分のターン開始時、【<color=Keyword>土の秘術</color>_1】『<color=Keyword>アルス・マグナ</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 천재 미소녀 연금술사 칼리오스트로";
            text """
내 턴 시작시, [<color=Keyword>대지의 비술</color> 1] <color=Keyword>아르스 마그나</color> 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：天才美少女鍊金術師‧卡莉歐斯托蘿";
            text """
自己的回合開始時，【<color=Keyword>土之秘術</color>_1】增加1張『<color=Keyword>魔創鍊金</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10004;
        class runecraft;
        rarity legendary;
    }

    locale chs {
        name "天才美少女炼金术士·卡莉奥丝特罗";
        text """
【<color=Keyword>入场曲</color>】使自己的战场上的土之印+2。将1张『<color=Keyword>伟大之术</color>』加入手牌。【<color=Keyword>奥义</color>】本随从进化。【<color=Keyword>解放奥义</color>】使自己获得『纹章：天才美少女炼金术士·卡莉奥丝特罗』。
""";
    }

    locale eng {
        name "Cagliostro, Genius Alchemist";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain 2 earth sigils. Add an <b><i><color=Keyword>Ars Magna</color></i></b> to your hand. <b><color=Keyword>Skybound Art</color></b> - Evolve this follower. <b><color=Keyword>Super Skybound Art</color></b> - Gain <b><i>Crest: Cagliostro, Genius Alchemist</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"てんさいびしょうじょれんきんじゅつし\">天才美少女錬金術師</rub>・カリオストロ";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場の土の印を+2する。『<color=Keyword>アルス・マグナ</color>』1枚を自分の手札に加える。【<color=Keyword>奥義</color>】これは進化する。【<color=Keyword>解放奥義</color>】自分は『クレスト：天才美少女錬金術師・カリオストロ』を持つ。
""";
    }

    locale kor {
        name "천재 미소녀 연금술사 칼리오스트로";
        text """
[<color=Keyword>출격</color>] 내 전장의 대지의 인장을 +2. <color=Keyword>아르스 마그나</color> 1장을 내 패에 넣는다. [<color=Keyword>오의</color>] 이 추종자는 진화한다. [<color=Keyword>해방 오의</color>] 나는 「크레스트: 천재 미소녀 연금술사 칼리오스트로」를 갖는다.
""";
    }

    locale cht {
        name "天才美少女鍊金術師‧卡莉歐斯托蘿";
        text """
【<color=Keyword>入場曲</color>】使自己戰場上的土之印+2。增加1張『<color=Keyword>魔創鍊金</color>』到自己的手牌中。【<color=Keyword>奧義</color>】使這張卡片進化。【<color=Keyword>解放奧義</color>】使自己獲得『紋章：天才美少女鍊金術師‧卡莉歐斯托蘿』。
""";
    }

}
