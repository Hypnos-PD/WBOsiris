wbo 0.1.0;

card 10412310 {
    type spell;
    cost 1;

    effect {
        random victim from oppo.field.followers;
        damage victim 2;
        if combo >= 5 {
            gain own crest 10412310;
        }
    }

    crest {
        countdown 1;

        lastwords {
            damage oppo.leader 1;
            add 1 card 10412310 to hand;
        }

        locale chs {
            name "纹章：绮罗星";
            text """
【<color=Keyword>吟唱</color>_1】
【<color=Keyword>谢幕曲</color>】对对手的主战者造成1点伤害。将1张『<color=Keyword>绮罗星</color>』加入手牌。
""";
        }

        locale eng {
            name "Crest: Starry Sky";
            text """
<b><color=Keyword>Countdown</color> (1)</b>
<b><color=Keyword>Last Words</color></b>: Deal 1 damage to the enemy leader. Add a <b><i><color=Keyword>Starry Sky</color></i></b> to your hand.
""";
        }

        locale jpn {
            name "クレスト：綺羅星";
            text """
【<color=Keyword>カウントダウン</color>_1】
【<color=Keyword>ラストワード</color>】相手のリーダーに1ダメージ。『<color=Keyword>綺羅星</color>』1枚を自分の手札に加える。
""";
        }

        locale kor {
            name "크레스트: 기라성";
            text """
[<color=Keyword>카운트다운</color> 1]
[<color=Keyword>유언</color>] 상대방 리더에게 1 피해. <color=Keyword>기라성</color> 1장을 내 패에 넣는다.
""";
        }

        locale cht {
            name "紋章：綺羅星";
            text """
【<color=Keyword>倒數</color>_1】
【<color=Keyword>謝幕曲</color>】給予敵方的主戰者1點傷害。增加1張『<color=Keyword>綺羅星</color>』到自己的手牌中。
""";
        }
    }

    meta {
        pack 10004;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "绮罗星";
        text """
对对手的战场上的随机1个随从造成2点伤害。【<color=Keyword>连击</color>_5】使自己获得『纹章：绮罗星』。
""";
    }

    locale eng {
        name "Starry Sky";
        text """
Deal 2 damage to a random enemy follower. <b><color=Keyword>Combo</color> (5)</b> - Gain <b><i>Crest: Starry Sky</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"きらぼし\">綺羅星</rub>";
        text """
相手の場のフォロワーからランダム1枚に2ダメージ。【<color=Keyword>コンボ</color>_5】自分は『クレスト：綺羅星』を持つ。
""";
    }

    locale kor {
        name "기라성";
        text """
상대방 전장의 추종자 중 무작위로 1장에게 2 피해. [<color=Keyword>콤보</color> 5] 나는 「크레스트: 기라성」을 갖는다.
""";
    }

    locale cht {
        name "綺羅星";
        text """
隨機給予1張敵方戰場上的從者卡2點傷害。【<color=Keyword>連擊</color>_5】使自己獲得『紋章：綺羅星』。
""";
    }

}
