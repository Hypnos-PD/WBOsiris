wbo 0.1.0;

card 10424110 {
    type follower;
    cost 4;
    stats 3/2;

    effect {
        rush;
        fanfare {
            summon 1 card 10424110;
        }
        enhance 6 {
            add bane to summoned;
            add storm to self;
        }
    }

    meta {
        pack 10004;
        class swordcraft;
        rarity legendary;
    }

    locale chs {
        name "真红与群青·塞达&贝阿朵丽丝";
        text """
【<color=Keyword>入场曲</color>】召唤1个『<color=Keyword>真红与群青·塞达&贝阿朵丽丝</color>』。
【<color=Keyword>爆能强化</color>_6】使其获得【<color=Keyword>毁灭</color>】。本随从获得【<color=Keyword>疾驰</color>】。
<hr>【<color=Keyword>突进</color>】
""";
    }

    locale eng {
        name "Zeta & Bea, Crimson and Blue";
        text """
<b><color=Keyword>Fanfare</color></b>: Summon a <b><i><color=Keyword>Zeta & Bea, Crimson and Blue</color></i></b>.
<b><color=Keyword>Enhance</color> (6)</b>: Give it <b><color=Keyword>Bane</color></b> and this follower <b><color=Keyword>Storm</color></b>.
<hr><b><color=Keyword>Rush</color></b>
""";
    }

    locale jpn {
        name "<rub=\"しんく\">真紅</rub>と<rub=\"ぐんじょう\">群青</rub>・ゼタ＆ベアトリクス";
        text """
【<color=Keyword>ファンファーレ</color>】『<color=Keyword>真紅と群青・ゼタ＆ベアトリクス</color>』1枚を自分の場に出す。
【<color=Keyword>エンハンス</color>_6】それは【<color=Keyword>必殺</color>】を持つ。これは【<color=Keyword>疾走</color>】を持つ。
<hr>【<color=Keyword>突進</color>】
""";
    }

    locale kor {
        name "진홍과 군청 제타&베아트릭스";
        text """
[<color=Keyword>출격</color>] <color=Keyword>진홍과 군청 제타&베아트릭스</color> 1장을 내 전장에 소환.
[<color=Keyword>증강</color> 6] 그 추종자는 [<color=Keyword>필살</color>]을 갖는다. 이 추종자는 [<color=Keyword>질주</color>]를 갖는다.
<hr>[<color=Keyword>돌진</color>]
""";
    }

    locale cht {
        name "鮮紅與群青‧瑟塔＆貝雅特麗絲";
        text """
【<color=Keyword>入場曲</color>】召喚1張『<color=Keyword>鮮紅與群青‧瑟塔＆貝雅特麗絲</color>』到自己的戰場上。
【<color=Keyword>爆能強化</color>_6】使其獲得【<color=Keyword>必殺</color>】。使這張卡片獲得【<color=Keyword>疾馳</color>】
<hr>【<color=Keyword>突進</color>】
""";
    }

}
