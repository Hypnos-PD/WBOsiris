wbo 0.1.0;

card 10412120 {
    type follower;
    cost 5;
    stats 5/4;

    effect {
        fanfare {
            add barrier to own.field.followers;
        }
    }

    meta {
        pack 10004;
        class forestcraft;
        rarity silver;
    }

    locale chs {
        name "绯焰舞姬·安苏莉娅";
        text """
【<color=Keyword>入场曲</color>】使自己的战场上的所有随从获得【<color=Keyword>屏障</color>】。
""";
    }

    locale eng {
        name "Anthuria, Toe-Tapping Torch";
        text """
<b><color=Keyword>Fanfare</color></b>: Give all allied followers on the field <b><color=Keyword>Barrier</color></b>.
""";
    }

    locale jpn {
        name "<rub=\"ひえん\">緋焔</rub>の<rub=\"おど\">踊</rub>り<rub=\"こ\">子</rub>・アンスリア";
        text """
【<color=Keyword>ファンファーレ</color>】自分の場のフォロワーすべては【<color=Keyword>バリア</color>】を持つ。
""";
    }

    locale kor {
        name "적염의 무희 안스리아";
        text """
[<color=Keyword>출격</color>] 내 전장의 추종자 모두는 [<color=Keyword>배리어</color>]를 갖는다.
""";
    }

    locale cht {
        name "緋焰舞孃‧安絲璃雅";
        text """
【<color=Keyword>入場曲</color>】使自己戰場上全部的從者卡獲得【<color=Keyword>障壁</color>】。
""";
    }

}
