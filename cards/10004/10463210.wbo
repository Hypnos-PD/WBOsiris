        text """
<b><color=Keyword>Engage</color></b>: Destroy this card. Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Destroy a random enemy follower.</ridx>
<ridx=1>2. Draw 2 cards.</ridx>
""";
    }

    locale jpn {
        name "レ・フィーエの<rub=\"ほうせき\">宝石</rub>";
