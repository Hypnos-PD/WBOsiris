    stats 6/6;

    effect {
        unplayable;
    }

    meta {
        pack 10004;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "光之法则·龙敖";
        text """
【<color=Keyword>入场曲</color>】发动6次「对对手的战场上的随机1个随从造成1点伤害」。使对手的手牌中的所有随从+1/+0。【<color=Keyword>奥义</color>】使自己获得『纹章：光之法则·龙敖』。
""";
    }

    locale eng {
        name "Lu Woh, Light Personified";
        text """
<b><color=Keyword>Fanfare</color></b>: Do this 6 times: \"Deal 1 damage to a random enemy follower.\" Give all followers in your opponent's hand +1/+0. <b><color=Keyword>Skybound Art</color></b> - Gain <b><i>Crest: Lu Woh, Light Personified</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"ひかり\">光</rub>の<rub=\"ことわり\">理</rub>・ル・オー";
        text """
