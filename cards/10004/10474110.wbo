wbo 0.1.0;

card 10474110 {
    type follower;
    cost 5;
    stats 6/6;

    effect {
        fanfare {
            repeat 6 {
                random victim from oppo.field.followers;
                damage victim 1;
            }
            buff oppo.hand.followers +1/+0;
            if skybound_art {
                gain own crest 10474110;
            }
        }
    }

    crest {
        countdown 2;

        when oppo follower attacks leader where keyword storm {
            buff attacker -3/-0 until turn ends;
        }

        locale chs {
            name "纹章：光之法则·龙敖";
            text """
【<color=Keyword>吟唱</color>_2】
对手的拥有【<color=Keyword>疾驰</color>】的随从攻击主战者时，回合结束前，使其-3/-0。
""";
        }

        locale eng {
            name "Crest: Lu Woh, Light Personified";
            text """
<b><color=Keyword>Countdown</color> (2)</b>
Whenever an enemy follower with <b><color=Keyword>Storm</color></b> attacks a leader, give it -3/-0 until the end of the turn.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"ひかり\">光</rub>の<rub=\"ことわり\">理</rub>・ル・オー";
            text """
【<color=Keyword>カウントダウン</color>_2】
相手の【<color=Keyword>疾走</color>】を持つフォロワーがリーダーを攻撃したとき、ターン終了まで、それは-3/-0する。
""";
        }

        locale kor {
            name "크레스트: 빛의 섭리 루 오";
            text """
[<color=Keyword>카운트다운</color> 2]
상대방의 [<color=Keyword>질주</color>]를 가진 추종자가 리더를 공격했을 때, 턴 종료까지 그 추종자는 -3/-0.
""";
        }

        locale cht {
            name "紋章：光之攝理‧盧歐";
            text """
【<color=Keyword>倒數</color>_2】
敵方擁有【<color=Keyword>疾馳</color>】的從者卡攻擊主戰者時，到回合結束為止使其-3/-0。
""";
        }
    }

    meta {
        pack 10004;
        class portalcraft;
        rarity legendary;
    }

    locale chs {
        name "光之法则·龙敖";
        text """
【<color=Keyword>入场曲</color>】发动6次「对对手的战场上的随机1个随从造成1点伤害」。使对手的手牌中的所有随从+1/+0。【<color=Keyword>奥义</color>】使自己获得『纹章：光之法则·龙敖』。
""";
    }

    locale eng {
        name "Lu Woh, Light Personified";
        text """
<b><color=Keyword>Fanfare</color></b>: Do this 6 times: \"Deal 1 damage to a random enemy follower.\" Give all followers in your opponent's hand +1/+0. <b><color=Keyword>Skybound Art</color></b> - Gain <b><i>Crest: Lu Woh, Light Personified</i></b>.
""";
    }

    locale jpn {
        name "<rub=\"ひかり\">光</rub>の<rub=\"ことわり\">理</rub>・ル・オー";
        text """
【<color=Keyword>ファンファーレ</color>】「相手の場のフォロワーからランダム1枚に1ダメージ。」を6回行う。相手の手札のフォロワーすべては+1/+0する。【<color=Keyword>奥義</color>】自分は『クレスト：光の理・ル・オー』を持つ。
""";
    }

    locale kor {
        name "빛의 섭리 루 오";
        text """
[<color=Keyword>출격</color>] 「상대방 전장의 추종자 중 무작위로 1장에게 1 피해」를 6회 발동. 상대방 패의 추종자 모두는 +1/+0. [<color=Keyword>오의</color>] 나는 「크레스트: 빛의 섭리 루 오」를 갖는다.
""";
    }

    locale cht {
        name "光之攝理‧盧歐";
        text """
【<color=Keyword>入場曲</color>】發動6次「隨機給予1張敵方戰場上的從者卡1點傷害」。使敵方手牌中全部的從者卡+1/+0。【<color=Keyword>奧義</color>】使自己獲得『紋章：光之攝理‧盧歐』。
""";
    }

}
