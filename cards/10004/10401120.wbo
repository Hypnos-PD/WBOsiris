wbo 0.1.0;

card 10401120 {
    type follower;
    cost 2;
    stats 2/2;

    effect {
        fanfare {
            if own.superevolve_unlocked {
                superevolve self silent;
            }
        }
    }

    meta {
        pack 10004;
        class neutral;
        rarity bronze;
    }

    locale chs {
        name "亲爱的搭档·碧";
        text """
【<color=Keyword>入场曲</color>】若为超进化已解禁的回合，则本随从进化。
""";
    }

    locale eng {
        name "Vyrn, Bestest Pal";
        text """
<b><color=Keyword>Fanfare</color></b>: If you've unlocked super-evolution, evolve this follower.
""";
    }

    locale jpn {
        name "<rub=\"あい\">愛</rub>すべき<rub=\"あいぼう\">相棒</rub>・ビィ";
        text """
【<color=Keyword>ファンファーレ</color>】超進化可能ターンなら、これは進化する。
""";
    }

    locale kor {
        name "소중한 단짝 비";
        text """
[<color=Keyword>출격</color>] 초진화 가능 턴이라면, 이 추종자는 진화한다.
""";
    }

    locale cht {
        name "惹人憐愛的搭檔‧碧";
        text """
【<color=Keyword>入場曲</color>】如果為已超進化解禁的回合，則會使這張卡片進化。
""";
    }

}
