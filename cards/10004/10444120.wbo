wbo 0.1.0;

card 10444120 {
    type follower;
    cost 5;
    stats 5/5;

    effect {
        fanfare {
            gain own.maxpp 1;
        }
        enhance 10 {
            add storm to self;
            set maxlife own.leader 1;
            // 「对手的回合结束前」：主战者级关键词的到期时点。
            add damage_to_zero to own.leader until oppo turn ends;
        }
    }

    meta {
        pack 10004;
        class dragoncraft;
        rarity legendary;
    }

    locale chs {
        name "世界的伙伴·佐伊";
        text """
【<color=Keyword>入场曲</color>】使自己的能量点最大值+1。
【<color=Keyword>爆能强化</color>_10】本随从获得【<color=Keyword>疾驰</color>】。使自己的主战者的生命值的最大值变为1。对手的回合结束前，使自己的主战者获得「受到的1点或以上的伤害变为0点」。
""";
    }

    locale eng {
        name "Zooey, Ally of the World";
        text """
<b><color=Keyword>Fanfare</color></b>: Gain 1 max play point.
<b><color=Keyword>Enhance</color> (10)</b>: Give this follower <b><color=Keyword>Storm</color></b>. Set your leader's max defense to 1. Give your leader \"Can't take more than 0 damage at a time\" until the end of your opponent's turn.
""";
    }

    locale jpn {
        name "<rub=\"せかい\">世界</rub>の<rub=\"みかた\">味方</rub>・ゾーイ";
        text """
【<color=Keyword>ファンファーレ</color>】自分のPP最大値を+1する。
【<color=Keyword>エンハンス</color>_10】これは【<color=Keyword>疾走</color>】を持つ。自分のリーダーの体力の最大値を1にする。相手のターン終了まで、自分のリーダーは「受ける1以上のダメージを0にする。」を持つ。
""";
    }

    locale kor {
        name "세계의 편에 선 자 조이";
        text """
[<color=Keyword>출격</color>] 내 PP 최대치를 +1.
[<color=Keyword>증강</color> 10] 이 추종자는 [<color=Keyword>질주</color>]를 갖는다. 내 리더의 체력 최대치를 1로 만든다. 상대방 턴 종료까지 내 리더는 「1 이상의 받는 피해를 0으로 만든다」를 갖는다.
""";
    }

    locale cht {
        name "世界的同伴‧佐伊";
        text """
【<color=Keyword>入場曲</color>】使自己的PP最大值+1。
【<color=Keyword>爆能強化</color>_10】使這張卡片獲得【<color=Keyword>疾馳</color>】。使自己主戰者生命值的最大值轉變為1。到敵方的回合結束為止，使自己的主戰者獲得「受到的傷害為1以上時轉變為0」。
""";
    }

}
