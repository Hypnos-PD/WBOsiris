wbo 0.1.0;

card 10454110 {
    type follower;
    cost 7;
    stats 5/5;

    effect {
        unplayable;
    }

    meta {
        pack 10004;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "暗之法则·菲迪埃尔";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>唤灵</color>_6】发动【<color=Keyword>亡者召还</color>_2】和【<color=Keyword>亡者召还</color>_1】，使其进化。
<hr>自己的回合结束时，使对手的战场上的所有随从-2/-2。
""";
    }

    locale eng {
        name "Fediel, Darkness Personified";
        text """
<b><color=Keyword>Fanfare</color></b>: <b><color=Keyword>Necromancy</color> (6)</b> - <b><color=Keyword>Reanimate</color> (2)</b>, <b><color=Keyword>Reanimate</color> (1)</b>, and evolve them.
<hr>At the end of your turn, give all enemy followers on the field -2/-2.
""";
    }

    locale jpn {
        name "<rub=\"やみ\">闇</rub>の<rub=\"ことわり\">理</rub>・フェディエル";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>ネクロマンス</color>_6】【<color=Keyword>リアニメイト</color>_2】と【<color=Keyword>リアニメイト</color>_1】を行う。それは進化する。
<hr>自分のターン終了時、相手の場のフォロワーすべては-2/-2する。
""";
    }

    locale kor {
        name "어둠의 섭리 페디엘";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>사령술</color> 6] [<color=Keyword>소생</color> 2], [<color=Keyword>소생</color> 1]을 발동. 그 추종자는 진화한다.
<hr>내 턴 종료시, 상대방 전장의 추종자 모두는 -2/-2.
""";
    }

    locale cht {
        name "闇之攝理‧菲迪耶爾";
        text """
【<color=Keyword>入場曲</color>】【<color=Keyword>死靈術</color>_6】發動【<color=Keyword>亡者召還</color>_2】與【<color=Keyword>亡者召還</color>_1】。使其進化。
<hr>自己的回合結束時，使敵方戰場上全部的從者卡-2/-2。
""";
