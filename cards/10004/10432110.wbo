wbo 0.1.0;

card 10432110 {
    type follower;
    cost 6;
    stats 6/5;

    effect {
        unplayable;
    }

    meta {
        pack 10004;
        class runecraft;
        rarity silver;
    }

    locale chs {
        name "报仇的占卜师·艾塞克莱因";
        text """
【<color=Keyword>入场曲</color>】选择对手的战场上的2个随从，对其造成4点伤害。使自己的战场上的土之印+2。
""";
    }

    locale eng {
        name "Ezecrain, Portent of Vengeance";
        text """
<b><color=Keyword>Fanfare</color></b>: Select 2 enemy followers on the field and deal them 4 damage. Gain 2 earth sigils.
""";
    }

    locale jpn {
        name "<rub=\"ふくしゅう\">復讐</rub>の<rub=\"うらないし\">占師</rub>・エゼクレイン";
        text """
【<color=Keyword>ファンファーレ</color>】相手の場のフォロワー2枚を選ぶ。それに4ダメージ。自分の場の土の印を+2する。
""";
    }

    locale kor {
        name "복수의 점술사 에제크레인";
        text """
[<color=Keyword>출격</color>] 상대방 전장에서 추종자 2장을 선택한다. 그 추종자에게 4 피해. 내 전장의 대지의 인장을 +2.
""";
    }

    locale cht {
        name "復仇的占卜師‧艾賽克萊因";
        text """
【<color=Keyword>入場曲</color>】指定2張敵方戰場上的從者卡。給予其4點傷害。使自己戰場上的土之印+2。
""";
    }

}
