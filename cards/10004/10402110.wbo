wbo 0.1.0;

card 10402110 {
    type follower;
    cost 3;
    stats 3/3;

    effect {
        aura;
        when own turn ends {
            heal own.field.followers 1;
            heal own.leader 1;
        }
    }

    meta {
        pack 10004;
        class neutral;
        rarity silver;
    }

    locale chs {
        name "宙域使者·尤妮";
        text """
【<color=Keyword>灵气</color>】
自己的回合结束时，回复自己的战场上的所有随从和自己的主战者1点生命值。
""";
    }

    locale eng {
        name "Yuni, Cosmic Legacy";
        text """
<b><color=Keyword>Aura</color></b>
At the end of your turn, restore 1 defense to all allies.
""";
    }

    locale jpn {
        name "コスモスの<rub=\"みつか\">御使</rub>い・ユニ";
        text """
【<color=Keyword>オーラ</color>】
自分のターン終了時、自分の場のフォロワーすべてと自分のリーダーを1回復。
""";
    }

    locale kor {
        name "코스모스의 사도 유니";
        text """
[<color=Keyword>오라</color>]
내 턴 종료시, 내 전장의 추종자 모두와 내 리더를 1 회복.
""";
    }

    locale cht {
        name "柯絲摩斯的使者‧尤妮";
        text """
【<color=Keyword>光紋</color>】
自己的回合結束時，回復自己戰場上全部的從者卡與自己的主戰者1點生命值。
""";
    }

}
