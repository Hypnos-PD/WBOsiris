wbo 0.1.0;

card 10472120 {
    type follower;
    cost 7;
    stats 7/6;

    effect {
        fanfare {
            mode {
                option 1 {
                    label chs "发动3次「对对手的战场上的随机1个随从造成4点伤害」。";
                    label eng "Do this 3 times: \"Deal 4 damage to a random enemy follower.\"";
                    label jpn "「相手の場のフォロワーからランダム1枚に4ダメージ。」を3回行う。";
                    label kor "「상대방 전장의 추종자 중 무작위로 1장에게 4 피해」를 3회 발동.";
                    label cht "發動3次「隨機給予1張敵方戰場上的從者卡4點傷害」。";
                    repeat 3 {
                        random victim from oppo.field.followers;
                        damage victim 4;
                    }
                }
                option 2 {
                    label chs "对对手的主战者造成4点伤害。";
                    label eng "Deal 4 damage to the enemy leader.";
                    label jpn "相手のリーダーに4ダメージ。";
                    label kor "상대방 리더에게 4 피해.";
                    label cht "給予敵方的主戰者4點傷害。";
                    damage oppo.leader 4;
                }
            }
        }
    }

    meta {
        pack 10004;
        class portalcraft;
        rarity silver;
    }

    locale chs {
        name "严厉的教官·伊尔莎";
        text """
【<color=Keyword>入场曲</color>】【<color=Keyword>模式</color>】选择1个能力发动。
<ridx=0>（1）发动3次「对对手的战场上的随机1个随从造成4点伤害」。</ridx>
<ridx=1>（2）对对手的主战者造成4点伤害。</ridx>
""";
    }

    locale eng {
        name "Ilsa, Brutal Drill Sergeant";
        text """
<b><color=Keyword>Fanfare</color></b>: Select a <b><color=Keyword>Mode</color></b> to activate.
<ridx=0>1. Do this 3 times: \"Deal 4 damage to a random enemy follower.\"</ridx>
<ridx=1>2. Deal 4 damage to the enemy leader.</ridx>
""";
    }

    locale jpn {
        name "<rub=\"げんれつ\">厳烈</rub>なる<rub=\"きょうかん\">教官</rub>・イルザ";
        text """
【<color=Keyword>ファンファーレ</color>】【<color=Keyword>モード</color>】1つを選んでその能力が働く。
<ridx=0>（1）「相手の場のフォロワーからランダム1枚に4ダメージ。」を3回行う。</ridx>
<ridx=1>（2）相手のリーダーに4ダメージ。</ridx>
""";
    }

    locale kor {
        name "엄격한 교관 일루자";
        text """
[<color=Keyword>출격</color>] [<color=Keyword>모드</color>] 1개를 선택하여 그 능력을 발동.
<ridx=0>(1) 「상대방 전장의 추종자 중 무작위로 1장에게 4 피해」를 3회 발동.</ridx>
<ridx=1>(2) 상대방 리더에게 4 피해.</ridx>
""";
    }

    locale cht {
        name "嚴厲的教官‧伊露莎";
        text """
【<color=Keyword>入場曲</color>】指定1個【<color=Keyword>模式</color>】並發動該能力。
<ridx=0>（1）發動3次「隨機給予1張敵方戰場上的從者卡4點傷害」。</ridx>
<ridx=1>（2）給予敵方的主戰者4點傷害。</ridx>
""";
    }

}
