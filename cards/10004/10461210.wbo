wbo 0.1.0;

card 10461210 {
    type amulet;
    cost 0;

    effect {
        engage 2 {
            destroy self;
            choose target from own.field.followers;
            transform target into card 10461210;
            draw 1;
        }
    }

    meta {
        pack 10004;
        class havencraft;
        rarity bronze;
    }

    locale chs {
        name "莉莉艾的鼓舞";
        text """
费用2【<color=Keyword>启动</color>】破坏本卡牌。选择自己的战场上的1个随从，使其变身为『<color=Keyword>莉莉艾的鼓舞</color>』。抽取1张卡牌。
""";
    }

    locale eng {
        name "Awed and Inspired";
        text """
<b><color=Keyword>Engage</color> (2)</b>: Destroy this card. Select an allied follower on the field and transform it into an <b><i><color=Keyword>Awed and Inspired</color></i></b>. Draw a card.
""";
    }

    locale jpn {
        name "リーリエ・ライツ";
        text """
コスト2【<color=Keyword>アクト</color>】これを破壊。自分の場のフォロワー1枚を選ぶ。それは『<color=Keyword>リーリエ・ライツ</color>』に変身する。自分のデッキから1枚を引く。
""";
    }

    locale kor {
        name "릴리에 라이츠";
        text """
비용 2 [<color=Keyword>활성화</color>] 이 마법진을 파괴. 내 전장에서 추종자 1장을 선택한다. 그 추종자는 <color=Keyword>릴리에 라이츠</color>로 변신한다. 내 덱에서 1장을 뽑는다.
""";
    }

    locale cht {
        name "利利耶的撩動";
        text """
消費2【<color=Keyword>策動</color>】破壞這張卡片。指定1張自己戰場上的從者卡。使其變身為『<color=Keyword>利利耶的撩動</color>』。由自己的牌堆中抽取1張卡片。
""";
    }

}
