wbo 0.1.0;

card 10454120 {
    type follower;
    cost 7;
    stats 7/6;

    effect {
        fanfare {
            damage field.followers other 10;
            if super_skybound_art {
                gain own crest 10454120;
            }
        }
        superevolve {
            reduce countdown own.crests 1;
        }
    }

    crest {
        countdown 4;

        lastwords {
            damage oppo.leader 20;
        }

        locale chs {
            name "纹章：狡诈的堕天司·彼列";
            text """
【<color=Keyword>吟唱</color>_4】
【<color=Keyword>谢幕曲</color>】对对手的主战者造成20点伤害。
""";
        }

        locale eng {
            name "Crest: Belial, Archangel of Cunning";
            text """
<b><color=Keyword>Countdown</color> (4)</b>
<b><color=Keyword>Last Words</color></b>: Deal 20 damage to the enemy leader.
""";
        }

        locale jpn {
            name "クレスト：<rub=\"こうかつ\">狡詐</rub>の<rub=\"だてんし\">堕天使</rub>・ベリアル";
            text """
【<color=Keyword>カウントダウン</color>_4】
【<color=Keyword>ラストワード</color>】相手のリーダーに20ダメージ。
""";
        }

        locale kor {
            name "크레스트: 교활한 타천사 벨리알";
            text """
[<color=Keyword>카운트다운</color> 4]
[<color=Keyword>유언</color>] 상대방 리더에게 20 피해.
""";
        }

        locale cht {
            name "紋章：狡詐的墮天司‧彼列";
            text """
【<color=Keyword>倒數</color>_4】
【<color=Keyword>謝幕曲</color>】給予敵方的主戰者20點傷害。
""";
        }
    }

    meta {
        pack 10004;
        class abysscraft;
        rarity legendary;
    }

    locale chs {
        name "狡诈的堕天司·彼列";
        text """
【<color=Keyword>入场曲</color>】对战场上的其他所有随从造成10点伤害。【<color=Keyword>解放奥义</color>】使自己获得『纹章：狡诈的堕天司·彼列』。
<hr><sev>【<color=Keyword>超进化时</color>】使自己的『纹章：狡诈的堕天司·彼列』的倒计数-1。</sev>
""";
    }

    locale eng {
        name "Belial, Archangel of Cunning";
        text """
<b><color=Keyword>Fanfare</color></b>: Deal 10 damage to all other followers. <b><color=Keyword>Super Skybound Art</color></b> - Gain <b><i>Crest: Belial, Archangel of Cunning</i></b>.
<hr><sev><b><color=Keyword>Super-Evolve</color></b>: Advance the count of your <b><i>Crest: Belial, Archangel of Cunning</i></b> by 1.</sev>
""";
    }

    locale jpn {
        name "<rub=\"こうち\">狡知</rub>の<rub=\"だてんし\">堕天司</rub>・ベリアル";
        text """
【<color=Keyword>ファンファーレ</color>】場の他のフォロワーすべてに10ダメージ。【<color=Keyword>解放奥義</color>】自分は『クレスト：狡知の堕天司・ベリアル』を持つ。
<hr><sev>【<color=Keyword>超進化時</color>】自分の『クレスト：狡知の堕天司・ベリアル』のカウントを-1する。</sev>
""";
    }

    locale kor {
        name "교지의 타천사 벨리알";
        text """
[<color=Keyword>출격</color>] 전장의 다른 추종자 모두에게 10 피해. [<color=Keyword>해방 오의</color>] 나는 「크레스트: 교지의 타천사 벨리알」을 갖는다.
<hr><sev>[<color=Keyword>초진화시</color>] 내 「크레스트: 교지의 타천사 벨리알」의 카운트를 -1.</sev>
""";
    }

    locale cht {
        name "狡智的墮天司‧彼列";
        text """
【<color=Keyword>入場曲</color>】給予戰場上全部的其他從者卡10點傷害。【<color=Keyword>解放奧義</color>】使自己獲得『紋章：狡智的墮天司‧彼列』。
<hr><sev>【<color=Keyword>超進化時</color>】使自己的『紋章：狡智的墮天司‧彼列』倒數回合數-1。</sev>
""";
    }

}
