scenario "营利支援者在三张护符时召唤一个自己" {
    seed 78015;
    state {
        player own {
            pp 4/4;
            field {
                amulet one = 10001210;
                amulet two = 10061210;
                amulet three = 90021210;
            }
            hand { follower source = 10761110; }
        }
    }
    action { play source; }
    expect { legal; own.field count card 10761110 == 2; }
}

scenario "营利支援者在护符不足二张时不召唤自己" {
    seed 78016;
    state {
        player own {
            pp 4/4;
            field {
                amulet one = 10001210;
                amulet two = 10061210;
            }
            hand { follower source = 10761110; }
        }
    }
    action { play source; }
    expect { legal; own.field count card 10761110 == 1; }
}

scenario "闪光一瞬强化自己战场上的随从" {
    seed 78017;
    state {
        turn own 3;
        player own {
            pp 2/2;
            field { follower ally = 10001110; }
            hand {
                spell source = 10772310;
                follower inhand = 10011110;
            }
        }
    }
    action { play source; }
    expect { legal; ally.stats == 3/2; inhand.stats == 1/1; }
}

scenario "闪光一瞬在超进化解禁回合也强化手牌随从" {
    seed 78018;
    state {
        turn own 7;
        player own {
            pp 2/2;
            field { follower ally = 10001110; }
            hand {
                spell source = 10772310;
                follower inhand = 10011110;
            }
        }
    }
    action { play source; }
    expect { legal; ally.stats == 3/2; inhand.stats == 2/1; }
}
