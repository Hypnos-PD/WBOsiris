wbotest 0.1.0;
use cards "../../cards";

scenario "恶意扩大在连击三点时获得纹章" {
    seed 78001;
    state {
        player own {
            pp 1/1;
            combo 2;
            hand { spell source = 10713310; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; }
    expect { legal; victim.stats == 0/7; own.crests count card 10713310 == 1; }
}

scenario "恶意扩大在连击不足时不获得纹章" {
    seed 78002;
    state {
        player own {
            pp 1/1;
            combo 1;
            hand { spell source = 10713310; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; }
    expect { legal; victim.stats == 0/7; own.crests count card 10713310 == 0; }
}

scenario "载运飞龙的入场曲强化自己的其他随从" {
    seed 78003;
    state {
        player own {
            pp 4/4;
            field { follower ally = 10001110; }
            hand { follower source = 10741120; }
        }
    }
    action { play source; select ally; }
    expect { legal; ally.stats == 4/4; }
}

scenario "载运飞龙的进化时强化手牌中的随从" {
    seed 78004;
    state {
        turn own 7;
        player own {
            ep 1;
            field { follower source = 10741120; }
            hand { follower inhand = 10001110; }
        }
    }
    action { evolve source; select inhand; }
    expect { legal; inhand.stats == 4/4; }
}

scenario "完美的时钟爆能强化时打击敌方全体" {
    seed 78005;
    state {
        player own {
            pp 4/4;
            hand { amulet source = 10762210; }
        }
        player oppo {
            field {
                follower first = 10001110;
                follower second = 10001120 { stats 0/3; }
            }
        }
    }
    action { play source; }
    expect { legal; first.stats == 2/1; second.stats == 0/2; }
}

scenario "完美的时钟启动破坏自身并打击敌方全体" {
    seed 78006;
    state {
        player own {
            pp 2/2;
            field { amulet source = 10762210; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/3; } }
        }
    }
    action { engage source; }
    expect { legal; source.zone == graveyard; victim.stats == 0/2; }
}

scenario "弓兵指挥者入场打击四点并增加连击" {
    seed 78007;
    state {
        player own {
            pp 5/5;
            hand { follower source = 10712120; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; select victim; }
    expect { legal; victim.stats == 0/5; own.combo == 2; }
}

scenario "冰箭射手入场按自身攻击力造成伤害" {
    seed 78008;
    state {
        player own {
            pp 3/3;
            hand { follower source = 10713110; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; select victim; }
    expect { legal; victim.stats == 0/6; }
}

scenario "冰箭射手在回合结束时因连击三点抽一张牌" {
    seed 78009;
    state {
        player own {
            combo 3;
            field { follower source = 10713110; }
            deck top { follower next = 10011110; }
        }
    }
    action { end_turn; }
    expect { legal; own.hand count card 10011110 == 1; }
}

scenario "暴食的零嘴模式一增加四点土之印" {
    seed 78010;
    state {
        player own {
            pp 2/2;
            hand { spell source = 10732310; }
        }
    }
    action { play source; mode 1; }
    expect { legal; own.earthsigils == 4; }
}

scenario "暴食的零嘴模式二消耗土之印打击敌方全体" {
    seed 78011;
    state {
        player own {
            pp 2/2;
            field { amulet sigil = 90031210 { earthsigil 2; } }
            hand { spell source = 10732310; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; mode 2; }
    expect { legal; victim.stats == 0/7; sigil.earthsigil == 0; }
}

scenario "小型怪兽的入场曲打击随从并增加土之印" {
    seed 78012;
    state {
        player own {
            pp 2/2;
            hand { follower source = 10731120; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; select victim; }
    expect { legal; victim.stats == 0/8; own.earthsigils == 1; }
}

scenario "海蚀三叉戟的入场曲打击四点" {
    seed 78013;
    state {
        player own {
            pp 3/3;
            hand { amulet source = 10763210; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { play source; select victim; }
    expect { legal; victim.stats == 0/5; }
}

scenario "海蚀三叉戟的启动破坏自身并打击两点" {
    seed 78014;
    state {
        player own {
            pp 3/3;
            field { amulet source = 10763210; }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/9; } }
        }
    }
    action { engage source; select victim; }
    expect { legal; source.zone == graveyard; victim.stats == 0/7; }
