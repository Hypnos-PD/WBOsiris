wbotest 0.1.0;
use cards "../../cards";

scenario "Bayle discounts when an allied follower returns to hand" {
    seed 3401;
    state { player own {
        pp 1/1;
        hand { spell source = 10012310; follower bayle = 10113130; }
        field { follower ally = 10001110; }
    } }
    action { play source; select ally; }
    expect { legal; ally.zone == hand; bayle.cost == 7; }
}

scenario "Bayle does not discount for an allied amulet departure" {
    seed 3402;
    state { player own {
        pp 1/1;
        hand { spell source = 10012310; follower bayle = 10113130; }
        field { amulet ally = 10173210; }
    } }
    action { play source; select ally; }
    expect { legal; ally.zone == hand; bayle.cost == 8; }
}

scenario "Bayle does not discount for an enemy follower departure" {
    seed 3403;
    state {
        player own { hand { follower bayle = 10113130; } field { follower source = 10154120; } }
        player oppo { field { follower target = 10001110; } }
    }
    action { attack source into target; }
    expect { legal; target.zone == graveyard; bayle.cost == 8; }
}

scenario "Bayle discounts once for an allied combat death" {
    seed 3404;
    state {
        player own { hand { follower bayle = 10113130; } field { follower source = 10001110; } }
        player oppo { field { follower target = 10001110; } }
    }
    action { attack source into target; }
    expect { legal; source.zone == graveyard; target.zone == graveyard; bayle.cost == 7; }
}

scenario "Bayle can be played without an enemy fanfare target" {
    seed 3405;
    state { player own { pp 8/8; hand { follower source = 10113130; } } }
    action { play source; }
    expect { legal; source.zone == field; source.stats == 4/4; own.pp == 0/8; }
}

scenario "Ancient Cannon adds a Gear of Ambition on play" {
    seed 3406;
    state { player own { pp 5/5; hand { amulet source = 10173210; } } }
    action { play source; }
    expect { legal; source.zone == field; own.hand count card 90071210 == 1; }
}

scenario "Ancient Cannon fires once when two materials fuse" {
    seed 3407;
    state {
        player own {
            field { amulet cannon = 10173210; }
            hand { amulet source = 90071210; amulet a = 90071220; amulet b = 90071220; }
        }
        player oppo { field { follower target = 10113130; } }
    }
    action { fuse source; select a, b; }
    expect { legal; own.hand count card 90072110 == 1; target.stats == 4/2; }
}

scenario "Ancient Cannon allows fusion without an enemy follower" {
    seed 3408;
    state { player own {
        field { amulet cannon = 10173210; }
        hand { amulet source = 90071210; amulet material = 90071220; }
    } }
    action { fuse source; select material; }
    expect { legal; own.hand count card 90072110 == 1; oppo.leader.life == 20; }
}

scenario "An opposing Ancient Cannon does not respond to your fusion" {
    seed 3409;
    state {
        player own {
            field { follower ally = 10001110; }
            hand { amulet source = 90071210; amulet material = 90071220; }
        }
        player oppo { field { amulet cannon = 10173210; } }
    }
    action { fuse source; select material; }
    expect { legal; ally.stats == 2/2; own.hand count card 90072110 == 1; }
}
