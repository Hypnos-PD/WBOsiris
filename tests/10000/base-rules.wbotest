wbotest 0.1.0;
use cards "../../cards";

<< 先覆盖动作提交前后的关键边界，再逐步扩展完整对局流程。
scenario "无敌方目标时零费启动仍先破坏自身" {
    seed 1001;

    state {
        turn own 5;
        phase main;

        player own {
            pp 0/5;
            field {
                amulet lens = 10001210 {
                    engaged false;
                }
            }
        }
        player oppo {
        }
    }

    action {
        engage lens;
    }

    expect {
        legal;
        own.pp == 0/5;
        lens.zone == graveyard;
        events contains ordered {
            destroy lens;
        }
        rng.consumed == 0;
    }
}

scenario "无己方场目标时法术不可使用" {
    seed 1002;

    state {
        turn own 2;
        phase main;

        player own {
            pp 1/2;
            hand {
                spell source = 10012310;
            }
        }
        player oppo {
        }
    }

    action {
        play source;
    }

    expect {
        illegal target_required;
        unchanged;
    }
}

scenario "超进化替换普通进化治疗" {
    seed 1003;

    state {
        turn own 6;
        phase main;

        player own {
            leader 10/20;
            sep 1;
            field {
                follower healer = 10002110;
            }
        }
        player oppo {
        }
    }

    action {
        superevolve healer;
    }

    expect {
        legal;
        own.leader.life == 14;
        own.sep == 0;
        healer.super_evolved == true;
        events contains ordered {
            heal own.leader 4;
        }
        events excludes {
            heal own.leader 2;
        }
    }
}

scenario "超进化仅召唤可容纳怨灵并赋予虹吸" {
    seed 1004;

    state {
        turn own 6;
        phase main;

        player own {
            sep 1;
            field {
                follower summoner = 10052120;
                amulet blocker_one = 10001210;
                amulet blocker_two = 10001210;
                amulet blocker_three = 10001210;
            }
        }
        player oppo {
        }
    }

    action {
        superevolve summoner;
    }

    expect {
        legal;
        own.sep == 0;
        summoner.super_evolved == true;
        own.field count card 90051130 == 1;
        all own.field where card 90051130 have drain;
    }
}

scenario "打出后自身计入连击并静默进化" {
    seed 1005;

    state {
        turn own 5;
        phase main;

        player own {
            pp 4/5;
            ep 1;
            combo 2;
            hand {
                follower treant = 10011130;
            }
        }
        player oppo {
        }
    }

    action {
        play treant;
    }

    expect {
        legal;
        own.pp == 0/5;
        own.combo == 3;
        own.ep == 1;
        treant.evolved == true;
    }
}

scenario "无土之印仍可选择土之秘术模式" {
    seed 1006;

    state {
        turn own 4;
        phase main;

        player own {
            pp 3/4;
            hand {
                follower knight = 10031110;
            }
        }
        player oppo {
        }
    }

    action {
        play knight;
        mode 2;
    }

    expect {
        legal;
        knight.stats == 2/2;
        knight lacks ward;
    }
}

scenario "新土之印并入已有土之印层数" {
    seed 1007;

    state {
        turn own 3;
        phase main;

        player own {
            pp 1/3;
            deck top {
                follower drawn_card = 10001110;
            }
            hand {
                amulet new_sigil = 10031210;
            }
            field {
                amulet old_sigil = 10031210 {
                    earthsigil 2;
                }
            }
        }
        player oppo {
        }
    }

    action {
        play new_sigil;
    }

    expect {
        legal;
        own.field count card 10031210 == 1;
        new_sigil.zone == field;
        new_sigil.earthsigil == 3;
        old_sigil.zone == banished;
        drawn_card.zone == hand;
        events excludes {
            destroy old_sigil;
        }
    }
}

scenario "墓场不足时唤灵不支付且不获疾驰" {
    seed 1008;

    state {
        turn own 3;
        phase main;

        player own {
            pp 2/3;
            shadows 3;
            hand {
                follower mummy = 10051130;
            }
        }
        player oppo {
        }
    }

    action {
        play mummy;
    }

    expect {
        legal;
        own.pp == 0/3;
        own.shadows == 3;
        mummy.zone == field;
        mummy lacks storm;
    }
}

scenario "亡者召还确定召唤唯一最高费用随从" {
    seed 1009;

    state {
        turn own 4;
        phase main;

        player own {
            pp 2/4;
            hand {
                spell source = 10051310;
            }
            destroyed {
                follower lower_cost = 10012110;
                follower highest_cost = 10051130;
                follower over_limit = 10002110;
            }
        }
        player oppo {
        }
    }

    action {
        play source;
        mode 2;
    }

    expect {
        legal;
        own.field count card 10051130 == 1;
        own.field count card 10012110 == 0;
        own.field count card 10002110 == 0;
        rng.consumed == 0;
    }
}

scenario "启动倒计时护符立即破坏并触发谢幕曲" {
    seed 1010;

    state {
        turn own 5;
        phase main;

        player own {
            pp 2/5;
            field {
                amulet statue = 10061210 {
                    countdown 2;
                    engaged false;
                }
            }
        }
        player oppo {
        }
    }

    action {
        engage statue;
    }

    expect {
        legal;
        own.pp == 0/5;
        statue.zone == graveyard;
        own.field count card 90061130 == 1;
        events contains ordered {
            destroy statue;
            summon card 90061130 count 1;
        }
    }
}

scenario "己方随从入场时王冠强化新随从" {
    seed 1011;

    state {
        turn own 4;
        phase main;

        player own {
            pp 2/4;
            hand {
                follower newcomer = 10001110;
            }
            field {
                amulet crown = 10022210 {
                    countdown 4;
                }
            }
        }
        player oppo {
        }
    }

    action {
        play newcomer;
    }

    expect {
        legal;
        newcomer.zone == field;
        newcomer.stats == 3/3;
    }
}

scenario "最大能量已满时保持上限并抽牌" {
    seed 1012;

    state {
        turn own 10;
        phase main;

        player own {
            pp 3/10;
            deck top {
                follower drawn_card = 10001110;
            }
            hand {
                spell source = 10042310;
            }
        }
        player oppo {
        }
    }

    action {
        play source;
    }

    expect {
        legal;
        own.pp == 0/10;
        own.maxpp == 10;
        drawn_card.zone == hand;
        events contains ordered {
            draw own 1;
        }
    }
}

scenario "超进化抽取全部同名卡并赋予疾驰" {
    seed 1013;

    state {
        turn own 6;
        phase main;

        player own {
            sep 1;
            deck top {
                follower first_copy = 10022120;
                follower other_card = 10001110;
                follower second_copy = 10022120;
            }
            field {
                follower trickster = 10022120;
            }
        }
        player oppo {
        }
    }

    action {
        superevolve trickster;
    }

    expect {
        legal;
        own.sep == 0;
        trickster.super_evolved == true;
        own.hand count card 10022120 == 2;
        own.hand contains [first_copy, second_copy] ordered;
        all own.hand where card 10022120 have storm;
        own.deck top == [other_card];
    }
}

scenario "必选手牌返回牌组后自顶向下抽皇家随从" {
    seed 1014;

    state {
        turn own 4;
        phase main;

        player own {
            pp 2/4;
            deck top {
                amulet skipped_top = 10001210;
                follower first_sword = 10021110;
                follower skipped_middle = 10001110;
                follower second_sword = 10021120;
            }
            hand {
                spell source = 10021310;
                spell required_target = 10031310;
            }
        }
        player oppo {
        }
    }

    action {
        play source;
        select required_target;
    }

    expect {
        legal;
        own.pp == 0/4;
        source.zone == graveyard;
        required_target.zone == deck;
        own.hand contains [first_sword, second_sword] ordered;
        skipped_top.zone == deck;
        skipped_middle.zone == deck;
        rng.consumed == 1;
    }
}

scenario "妖精入场但无敌方随从时跳过随机伤害" {
    seed 1015;

    state {
        turn own 3;
        phase main;

        player own {
            pp 1/3;
            hand {
                follower pixie = 90011110;
            }
            field {
                amulet garden = 10011210 {
                    countdown 2;
                }
            }
        }
        player oppo {
        }
    }

    action {
        play pixie;
    }

    expect {
        legal;
        own.pp == 0/3;
        pixie.zone == field;
        rng.consumed == 0;
    }
}
