wbotest 0.1.0;
use cards "../../cards";

scenario "奥夜花入场曲发动两次，手牌四张同费用时每次都对全体敌人造成四点伤害" {
    seed 101101;
    state {
        player own {
            pp 10/10;
            hand {
                follower source = 10554120;
                follower first = 10001110;
                follower second = 10001110;
                follower third = 10001110;
                follower fourth = 10001110;
            }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/12; } }
        }
    }
    action { play source; }
    expect {
        legal;
        own.hand count card 10001110 == 4;
        own.deck count card 10001110 == 0;
        victim.stats == 0/4;
        oppo.leader.life == 12;
    }
}

scenario "奥夜花入场曲在四张手牌费用不全部相同时只洗回并抽牌" {
    seed 101102;
    state {
        player own {
            pp 10/10;
            hand {
                follower source = 10554120;
                follower one = 10021110;
                follower two = 10001110;
                follower three = 10022120;
                follower four = 10021120;
            }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/12; } }
        }
    }
    action { play source; }
    expect {
        legal;
        own.hand count card 10021110 == 1;
        own.hand count card 10001110 == 1;
        own.hand count card 10022120 == 1;
        own.hand count card 10021120 == 1;
        victim.stats == 0/12;
        oppo.leader.life == 20;
    }
}

scenario "奥夜花超进化时发动与入场曲相同的能力" {
    seed 101103;
    state {
        turn own 7;
        player own {
            sep 1;
            field { follower source = 10554120; }
            hand {
                follower first = 10001110;
                follower second = 10001110;
                follower third = 10001110;
                follower fourth = 10001110;
            }
        }
        player oppo {
            field { follower victim = 10001120 { stats 0/12; } }
        }
    }
    action { superevolve source; }
    expect {
        legal;
        own.hand count card 10001110 == 4;
        victim.stats == 0/4;
        oppo.leader.life == 12;
    }
}
