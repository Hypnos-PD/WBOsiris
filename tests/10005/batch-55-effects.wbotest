}

scenario "八界花舍弃手牌后按模式抽取八张" {
    seed 55023;
    state {
        player own {
            pp 8/8;
            deck top {
                follower first = 10001110;
                follower second = 10001110;
                follower third = 10001110;
                follower fourth = 10001110;
                follower fifth = 10001110;
                follower sixth = 10001110;
                follower seventh = 10001110;
                follower eighth = 10001110;
            }
            hand {
                follower source = 10504110;
                follower discarded = 10001110;
            }
        }
    }
    action { play source; mode 1; }
    expect { legal; discarded.zone == graveyard; own.hand count card 10001110 == 8; }
}

scenario "八界花模式二抽取两张并把费用降到最低" {
