}

scenario "海洋随从进入战场时水母舞姬获得突进与毁灭" {
    seed 55007;
    state {
        player own {
            pp 6/6;
            field { follower jelly = 10542120; }
            hand { follower drummer = 10541120; }
        }
    }
    action { play drummer; }
    expect { legal; jelly has rush; jelly has bane; }
}

scenario "神经遮蔽者按其他随从数量回复能量点" {
    seed 55008;
    state {
        player own {
            pp 5/5;
            field {
                follower first = 10001110;
                follower second = 10001110;
            }
            hand { follower source = 10573110; }
        }
    }
    action { play source; }
    expect { legal; own.pp == 2/5; source has rush; }
}

scenario "神经遮蔽者的谢幕曲抽两张" {
    seed 55009;
    state {
        player own {
            field { follower source = 10573110; }
            deck top { follower first = 10001110; follower second = 10001110; }
        }
        player oppo { field { follower big = 10001110 { stats 5/5; } } }
    }
    action { attack source into big; }
    expect { legal; source.zone == graveyard; own.hand count card 10001110 == 2; }
}

