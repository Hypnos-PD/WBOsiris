            hand { spell source = 10503310; }
        }
        player oppo {
            field {
                follower strong = 10001110 { stats 5/5; }
                follower enemy = 10001110 { stats 2/8; }
            }
        }
    }
    action { play source; }
    expect { legal; strong.zone == graveyard; enemy.stats == 2/4; oppo.leader.life == 16; }
}

scenario "不动如山的将校无法攻击并在回合结束召唤铁甲骑士" {
    seed 55021;
    state {
        player own { field { follower source = 10523110; } }
    }
    action { end_turn; }
