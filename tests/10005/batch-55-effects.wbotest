wbotest 0.1.0;
use cards "../../cards";

scenario "奥夜花的开战造成五点伤害并把自身加入牌组" {
    seed 55001;
    state {
        player own {
            pp 2/2;
            hand { spell source = 10551310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/9; } } }
    }
    action { play source; select enemy; }
    expect { legal; enemy.stats == 2/4; own.deck count card 10551310 == 1; }
}

scenario "波摇花的裁决按抽到的随从费用造成伤害" {
    seed 55002;
    state {
        player own {
            pp 3/3;
            deck top { follower drew = 10001110; }
            hand { spell source = 10541310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/9; } } }
    }
    action { play source; }
    // 抽到的 10001110 费用为 2。
    expect { legal; own.hand count card 10001110 == 1; enemy.stats == 2/7; }
}

scenario "元素支配者召唤两个巨像并消耗土之秘术使其进化" {
    seed 55003;
    state {
        player own {
            pp 7/7;
            field { amulet sigil = 90031210 { earthsigil 2; } }
            hand { follower source = 10533110; }
        }
    }
    action { play source; }
    expect {
        legal;
        own.field count card 90031120 == 2;
        sigil.earthsigil == 0;
        all own.field where card 90031120 have ward;
    }
}

scenario "水滴打拍者召唤大海虎鲸并回复主战者" {
    seed 55004;
    state {
        player own {
            leader 10/20;
            pp 6/6;
            hand { follower source = 10541120; }
        }
    }
    action { play source; }
    expect { legal; own.field count card 90041130 == 1; own.leader.life == 12; }
}

scenario "丽金花的挥霍舍弃手牌中的法术并打动随机随从两次" {
    seed 55005;
    state {
        player own {
            pp 2/2;
            hand {
                spell source = 10521310;
                spell fuel = 90054330;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/12; } } }
    }
    action { play source; select fuel; }
    expect { legal; fuel.zone == graveyard; enemy.stats == 2/6; }
}

scenario "水母舞姬的入场曲把大海虎鲸加入手牌" {
    seed 55006;
    state {
        player own {
