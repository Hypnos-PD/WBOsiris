scenario "引路船工召唤三个妖精并在超进化时给予毁灭" {
    seed 55027;
    state {
        turn own 7;
        player own {
            sep 1;
            field { follower source = 10513110; }
            hand { follower fairy = 90011110; }
        }
    }
    action { superevolve source; }
    // 手动超进化同时触发普通的【进化时】，因此召唤 3 个妖精并获得毁灭。
    expect { legal; own.field count card 90011110 == 3; all own.field where card 90011110 have bane; }
}

