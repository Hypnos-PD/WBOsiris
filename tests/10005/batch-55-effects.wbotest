scenario "丽金花云庆让敌方随从消失并把闪耀的金币加入手牌" {
    seed 55032;
    state {
        player own {
            pp 5/5;
            hand { follower source = 10524120; }
        }
        player oppo { field { follower enemy = 10001110; } }
    }
    action { play source; select enemy; }
    expect { legal; enemy.zone == banished; own.hand count card 90021350 == 1; }
}

scenario "丽金花云庆超进化时获得纹章" {
    seed 55033;
    state {
        turn own 7;
        player own {
            sep 1;
            field { follower source = 10524120; }
        }
    }
    action { superevolve source; }
    expect { legal; own.crests count card 10524120 == 1; }
}

scenario "丽金花云庆的纹章在回合结束时加入闪耀的金币" {
    seed 55034;
    state { player own { crests { crest cloud = 10524120; } } }
    action { end_turn; }
    expect { legal; own.hand count card 90021350 == 1; }
}

scenario "回合结束时加入的法术不参与同一次回合结束的条件判定" {
    seed 55035;
    state {
        player own {
            crests { crest cloud = 10524120; }
            field { follower frog = 10522120; }
            hand { spell only = 90054330; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { end_turn; }
    expect {
        legal;
        // 官方 QA（75wdwp8ysf）：按下回合结束时手牌里的法术只有 1 张，
        // 之后纹章加入的闪耀的金币不会让吉祥蛙的能力补发。
        enemy.stats == 2/8;
        own.hand count card 90021350 == 1;
    }
}
