}

scenario "世界的呈现破坏攻击力最大的敌方随从" {
    seed 55019;
    state {
        player own {
            pp 5/5;
            deck top { follower first = 10001110; follower second = 10001110; }
            hand { spell source = 10503310; }
        }
        player oppo {
            field {
                follower strong = 10001110 { stats 5/5; }
                follower weak = 10001110 { stats 1/5; }
            }
        }
    }
    action { play source; }
    expect { legal; strong.zone == graveyard; weak.zone == field; }
}

scenario "爆能强化十点让世界的呈现打击敌方全体与主战者" {
