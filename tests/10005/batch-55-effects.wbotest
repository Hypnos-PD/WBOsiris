scenario "余韵俳谐师的谢幕曲强化手牌" {
    seed 55013;
    state {
        player own {
            field { follower source = 10532120; }
            hand { follower held = 10032120; }
        }
        player oppo { field { follower big = 10001110 { stats 5/5; } } }
    }
    action { attack source into big; }
    expect { legal; source.zone == graveyard; held.cost == 9; }
}

scenario "先见的神官的入场曲与进化时都能造成两点伤害" {
    seed 55014;
    state {
        turn own 5;
        player own {
            ep 1;
            pp 3/3;
            field { follower source = 10561110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/9; } } }
    }
    action { evolve source; select enemy; }
    expect { legal; enemy.stats == 2/7; source has ward; }
}

scenario "吉祥蛙在手牌有两张法术时于回合结束打击敌方全体" {
    seed 55015;
    state {
        player own {
            field { follower frog = 10522120; }
            hand {
                spell first = 90054330;
                spell second = 90054330;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { end_turn; }
    expect { legal; enemy.stats == 2/3; }
}

scenario "牵线搭桥的青鬼让敌方随从在对手回合结束前无法攻击" {
    seed 55016;
    state {
        player own {
            pp 5/5;
            deck top { follower drew = 10001110; }
            hand { follower source = 10552120; }
        }
        player oppo { field { follower enemy = 10001110; } }
    }
    action { play source; select enemy; }
    expect { legal; enemy has cannot_attack; own.hand count card 10001110 == 1; }
}

scenario "致命掠夺者把其他随从都变成骸骨士兵" {
    seed 55017;
    state {
        player own {
            pp 9/9;
            field { follower ally = 10001110 { stats 2/5; } }
            hand { follower source = 10553110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 3/6; } } }
    }
    action { play source; }
    expect { legal; ally.stats == 1/1; enemy.stats == 1/1; }
}

scenario "骸骨士兵被破坏时回复主战者" {
    seed 55018;
