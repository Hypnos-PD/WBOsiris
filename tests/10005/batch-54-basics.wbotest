scenario "失眠女巫的纹章在谢幕时对全体随从造成三点伤害" {
    seed 54034;
    state {
        player own {
            pp 4/4;
            hand { follower source = 10532110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; }
    expect { legal; own.crests count card 10532110 == 1; }
}

scenario "失眠女巫进化时破坏纹章并触发全体三点伤害" {
    seed 54035;
    state {
        turn own 5;
        player own {
            ep 1;
            field { follower source = 10532110; }
            crests { crest witch = 10532110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { evolve source; }
    // 进化后是 5/5，纹章谢幕曲的 3 点伤害让它剩 5/2。
    expect { legal; own.crests count card 10532110 == 0; enemy.stats == 2/5; source.stats == 5/2; }
}
