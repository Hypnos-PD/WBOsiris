scenario "日珥咆哮按战场上的随从张数造成伤害" {
    seed 54015;
    state {
        player own {
            pp 4/4;
            field { follower ally = 10001110 { stats 2/8; } }
            hand { spell source = 10542310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; }
    expect { legal; ally.stats == 2/6; enemy.stats == 2/6; }
}

scenario "虫风花的飞翔分配三点伤害并把妖精加入手牌" {
    seed 54016;
