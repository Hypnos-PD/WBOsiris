wbotest 0.1.0;
use cards "../../cards";

scenario "尽小花的临照抽一张" {
    seed 54001;
    state {
        player own {
            pp 1/1;
            deck top { follower drew = 10001110; }
            hand { spell source = 10571310; }
        }
    }
    action { play source; }
    expect { legal; own.hand count card 10001110 == 1; }
}

scenario "和气蔼蔼的妖精携带突进毁灭与虹吸" {
    seed 54002;
    state { player own { field { follower fairy = 10512120; } } }
    action { end_turn; }
    expect { legal; fairy has rush; fairy has bane; fairy has drain; }
}

scenario "熟虑的狸猫进化时抽一张" {
    seed 54003;
    state {
        turn own 5;
        player own {
            ep 1;
            field { follower source = 10511110; }
            deck top { follower drew = 10001110; }
        }
    }
    action { evolve source; }
    expect { legal; source has stealth; own.hand count card 10001110 == 1; }
}

scenario "优雅的虫风花按连击抽牌" {
    seed 54004;
    state {
        player own {
            pp 3/3;
            combo 2;
            deck top { follower first = 10001110; follower second = 10001110; }
            hand { spell source = 10513310; }
        }
    }
    action { play source; }
    expect { legal; own.hand count card 10001110 == 2; }
}

scenario "清宵玉兔在使用法术时进化" {
    seed 54005;
    state {
        player own {
            pp 1/1;
            field { follower rabbit = 10572120; }
            deck top { follower first = 10001110; follower second = 10001110; }
            hand { spell source = 90054330; }
        }
    }
    action { play source; }
    expect { legal; rabbit.evolved == true; rabbit has ward; }
}

scenario "残虐的炸裂只打击生命值最小的主战者" {
    seed 54006;
    state {
        player own {
            leader 10/20;
            pp 2/2;
            hand { spell source = 10552310; }
        }
    }
    action { play source; }
    expect { legal; own.leader.life == 7; oppo.leader.life == 20; }
}

scenario "雾卷花的激愤让一张手牌返回牌组后抽三张" {
    seed 54007;
    state {
        player own {
            pp 3/3;
            deck top {
                follower first = 10001110;
                follower second = 10001110;
                follower third = 10001110;
                follower fourth = 10001110;
            }
            hand {
                spell source = 10561310;
                follower other = 10001110;
            }
        }
    }
    action { play source; }
    expect { legal; own.hand count card 10001110 == 3; own.deck count card 10001110 == 2; }
}

scenario "明越花的转变舍弃一张手牌后抽两张" {
    seed 54008;
    state {
        player own {
            pp 2/2;
            deck top { follower first = 10001110; follower second = 10001110; }
            hand {
                spell source = 10531310;
                follower other = 10001110;
            }
        }
    }
    action { play source; select other; }
    expect { legal; other.zone == graveyard; own.hand count card 10001110 == 2; }
}

scenario "温柔援军召唤两个骑士" {
    seed 54009;
    state {
        player own {
