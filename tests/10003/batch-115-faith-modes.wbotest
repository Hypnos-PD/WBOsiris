wbotest 0.1.0;
use cards "../../cards";

scenario "混融的继承者消耗信仰值让信仰获得模式选择加成" {
    seed 115001;
    state {
        player own {
            pp 2/2;
            crests { faith karma = 10354110 { counter value 10; } }
            hand { follower source = 10354110; }
        }
    }
    action { play source; }
    expect {
        legal;
        karma.counter.value == 0;
        karma.counter.mode_bonus == 1;
    }
}

scenario "信仰值不足时不消耗也不加成" {
    seed 115002;
    state {
        player own {
            pp 2/2;
            crests { faith karma = 10354110 { counter value 9; } }
            hand { follower source = 10354110; }
        }
    }
    action { play source; }
    expect {
        legal;
        karma.counter.value == 9;
        karma.counter.mode_bonus == 0;
    }
}

scenario "混融的继承者超进化时破坏选中的随从并把同名卡加入手牌" {
    seed 115003;
    state {
        turn own 7;
        player own {
            sep 1;
            field { follower source = 10354110; }
        }
        player oppo {
            field { follower victim = 10001110 { stats 2/12; } }
        }
    }
    action { superevolve source; select victim; }
    expect {
        legal;
        victim.zone == graveyard;
        own.hand count card 10001110 == 1;
    }
}

scenario "信仰的模式选择加成让玩家多选一个模式" {
    seed 115004;
    state {
        player own {
            leader 10/20;
            pp 5/5;
            crests { faith karma = 10354110 { counter mode_bonus 1; } }
            hand { spell source = 10423310; }
        }
    }
    action { play source; mode 3, 4; }
    expect {
        legal;
        // 模式（3）回复 2 点能量点、模式（4）回复主战者 6 点，需要加成才能同时选中。
        own.pp == 2/5;
        own.leader.life == 16;
        // 官方 QA（qrpt1xyqmvgf）：一次选择【模式】只算一次，即使同时选中两个模式信仰值也只 +1。
        karma.counter.value == 1;
    }
}

scenario "一次选择两个模式只让信仰值加一" {
    seed 115005;
    state {
        player own {
            pp 5/5;
            crests { faith karma = 10354110; }
            hand { spell source = 10353310; }
        }
        player oppo {
            leader 20/20;
            field { follower enemy = 10001110 { stats 2/12; } }
        }
    }
    action { play source; mode 1, 4; }
    expect {
        legal;
        // 官方 QA（qrpt1xyqmvgf）：『叫唤与憎恶』一次选中两个模式，信仰值只 +1。
        karma.counter.value == 1;
        own.pp == 3/5;
        enemy.stats == 2/8;
    }
}
