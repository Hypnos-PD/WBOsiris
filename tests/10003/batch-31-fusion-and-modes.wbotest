wbotest 0.1.0;
use cards "../../cards";

scenario "真理的团结者费用不是三时召唤两个复制" {
    seed 31001;
    state {
        player own {
            pp 5/5;
            hand { follower source = 10333110 { cost 5; } }
        }
    }
    action { play source; }
    expect {
        legal;
        source has rush;
        own.field count card 10333110 == 3;
        own.pp == 0/5;
    }
}

scenario "真理的团结者费用为三时不召唤复制" {
    seed 31002;
    state {
        player own {
            pp 3/3;
            hand { follower source = 10333110; }
        }
    }
    action { play source; }
    expect { legal; own.field count card 10333110 == 1; }
}

scenario "真理的团结者超进化时再召唤一个复制" {
    seed 31003;
    state {
        turn own 7;
        player own {
            sep 1;
            field { follower source = 10333110; }
        }
    }
    action { superevolve source; }
    expect {
        legal;
        own.field count card 10333110 == 2;
        source.stats == 6/4;
    }
}

scenario "侮蔑的团结者对全场造成三点伤害" {
    seed 31004;
    state {
        player own {
            pp 6/6;
            field { follower ally = 10001110 { stats 2/8; } }
            hand { follower source = 10343110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; }
    expect { legal; ally.stats == 2/5; enemy.stats == 2/5; source.stats == 5/4; }
}

scenario "侮蔑的团结者生命值三以下时强化手牌的龙族随从" {
    seed 31005;
    state {
        player own {
            field { follower source = 10343110 { stats 5/3; } }
            hand {
                follower dragon = 90041120;
                follower neutral = 10001110;
            }
        }
    }
    action { end_turn; }
    expect {
        legal;
        dragon.stats == 6/6;
        neutral.stats == 2/2;
    }
}

scenario "篡夺的继承者按融合种类造成伤害" {
    seed 31006;
    state {
        turn own 7;
        player own {
            pp 6/6;
            hand {
                follower source = 10324110;
                spell loot1 = 90021310;
                spell loot2 = 90021320;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { fuse source; select loot1, loot2; }
    expect { legal; source.zone == hand; own.hand count card 90021310 == 0; }
}

scenario "篡夺的继承者的入场曲对敌方全体与主战者造成融合种类数伤害" {
    seed 31007;
    state {
        player own {
            pp 6/6;
            hand { follower source = 10324110; }
        }
        player oppo {
            field { follower enemy = 10001110 { stats 2/8; } }
        }
    }
    action { play source; }
    // 没有融合材料时 X = 0，什么都不会发生。
    expect { legal; enemy.stats == 2/8; oppo.leader.life == 20; }
}

scenario "威猛炽焰对自己随从造成一点伤害并抽取龙族随从" {
    seed 31008;
    state {
        player own {
            pp 7/7;
            field { follower ally = 10001110 { stats 2/8; } }
            hand { spell source = 10343310; }
            deck top {
                follower dragon = 90041120;
                follower neutral = 10001110;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; select ally; }
    expect {
        legal;
        ally.stats == 2/7;
        enemy.stats == 2/5;
        own.hand count card 90041120 == 1;
    }
}

scenario "未觉醒时威猛炽焰不抽牌" {
    seed 31009;
    state {
        player own {
            pp 3/3;
            field { follower ally = 10001110 { stats 2/8; } }
            hand { spell source = 10343310; }
            deck top { follower dragon = 90041120; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; select ally; }
    expect { legal; own.hand count card 90041120 == 0; }
}

scenario "奉还的剑闪造成两点伤害并加入黄金短剑" {
    seed 31010;
    state {
        player own {
            pp 2/2;
            hand { spell source = 10323310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; }
    expect {
        legal;
        enemy.stats == 2/6;
        own.hand count card 90021310 == 1;
    }
}

scenario "不弑之乡的入场曲舍弃手牌并抽两张" {
    seed 31011;
    state {
        player own {
            pp 3/3;
            hand {
                amulet source = 10312210;
                follower dropped = 10001110;
            }
            deck top {
                follower first = 10011110;
                follower second = 10011110;
            }
        }
    }
    action { play source; select dropped; }
    expect {
        legal;
        dropped.zone == graveyard;
        own.hand count card 10011110 == 2;
    }
}

scenario "不弑之乡的启动破坏自身并让敌方随从减两点生命" {
    seed 31012;
    state {
        player own { field { amulet village = 10312210; } }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { engage village; select enemy; }
    expect { legal; village.zone == graveyard; enemy.stats == 2/6; }
}

scenario "篡夺的据点的启动破坏自身并按模式加入黄金卡" {
    seed 31013;
    state {
        player own { field { amulet fort = 10322210; } }
    }
    action { engage fort; mode 2; }
    expect {
        legal;
        fort.zone == graveyard;
        own.hand count card 90021320 == 1;
        own.hand count card 90021330 == 1;
    }
}

scenario "混融的肯定者的模式一造成一点全体伤害" {
    seed 31014;
    state {
        player own {
            pp 3/3;
            hand { follower source = 10351110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; mode 1; }
    expect { legal; enemy.stats == 2/7; source.stats == 1/1; }
}

scenario "混融的肯定者的模式二强化自身" {
    seed 31015;
    state {
        player own {
            pp 3/3;
            hand { follower source = 10351110; }
        }
    }
    action { play source; mode 2; }
    expect { legal; source.stats == 3/3; }
}

scenario "破坏的祈祷者破坏自己的其他卡牌并造成两点伤害" {
    seed 31016;
    state {
        turn own 7;
        player own {
            pp 2/2;
            ep 1;
            field {
                follower source = 10372110;
                amulet victim = 10001210;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { evolve source; select victim; }
    expect {
        legal;
        victim.zone == graveyard;
        enemy.stats == 2/6;
        own.ep == 0;
    }
}

scenario "破坏的荒野破坏自己的其他卡牌并抽两张" {
    seed 31017;
    state {
        player own {
            pp 2/2;
            field { amulet victim = 10001210; }
            hand { amulet wilderness = 10372210; }
            deck top {
                follower first = 10011110;
                follower second = 10011110;
            }
        }
    }
    action { play wilderness; select victim; }
    expect {
        legal;
        victim.zone == graveyard;
        own.hand count card 10011110 == 2;
    }
}

scenario "混融的祈祷者的模式二回复主战者两点生命" {
    seed 31018;
    state {
        player own {
            leader 15/20;
            pp 4/4;
            hand { follower source = 10352110; }
        }
    }
    action { play source; mode 2; }
    expect { legal; own.leader.life == 17; }
}

scenario "混融之城的启动破坏自身并按模式抽牌" {
    seed 31019;
    state {
        turn own 4;
        player own {
            pp 1/1;
            field { amulet city = 10352210; }
            deck top { follower drawn = 10011110; }
        }
    }
    action { engage city; mode 1; }
    expect {
        legal;
        city.zone == graveyard;
        drawn.zone == hand;
        own.pp == 0/1;
    }
}

scenario "混融的团结者的模式一召唤复制并给双方突进" {
    seed 31020;
    state {
        player own {
            pp 5/5;
            hand { follower source = 10353110; }
        }
    }
    action { play source; mode 1; }
    expect {
        legal;
        source has rush;
        own.field count card 10353110 == 2;
        all own.field where card 10353110 have rush;
    }
}

scenario "混融的团结者的模式三强化所有同名随从" {
    seed 31021;
    state {
        player own {
            pp 5/5;
            field { follower ally = 10353110; }
            hand { follower source = 10353110; }
        }
    }
    action { play source; mode 3; }
    expect {
        legal;
        ally.stats == 6/6;
        source.stats == 6/6;
    }
}
