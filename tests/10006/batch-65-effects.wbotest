wbotest 0.1.0;
use cards "../../cards";

scenario "古旧天斧在有高费随从时把天斧深渊加入手牌" {
    seed 65001;
    state {
        player own {
            pp 2/2;
            field { follower big = 10401110; }
            hand { follower source = 10674120; }
        }
    }
    action { play source; }
    expect { legal; own.hand count card 90074320 == 1; source has rush; }
}

scenario "没有高费随从时古旧天斧不加入天斧深渊" {
    seed 65002;
    state {
        player own {
            pp 2/2;
            hand { follower source = 10674120; }
        }
    }
    action { play source; }
    expect { legal; own.hand count card 90074320 == 0; }
}

scenario "古旧天刀进化时把天刀深渊加入手牌" {
    seed 65003;
    state {
        turn own 5;
        player own {
            pp 3/3;
            ep 1;
            field { follower source = 10644120; }
        }
    }
    action { evolve source; }
    expect { legal; own.hand count card 90044330 == 1; }
}

scenario "古旧天刀被舍弃时召唤自己" {
    seed 65014;
    state {
        player own {
            pp 3/3;
            field { amulet altar = 10143210; }
            hand { follower mine = 10644120; }
        }
    }
    action { engage altar; select mine; }
    expect { legal; mine.zone == graveyard; own.field count card 10644120 == 1; }
}

scenario "惨烈的天剑模式二打击随机随从" {
    seed 65004;
    state {
        player own {
            pp 1/1;
            hand { spell source = 10623310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/9; } } }
    }
    action { play source; mode 2; }
    expect { legal; enemy.stats == 2/6; }
}

scenario "爆能强化三点让惨烈的天剑发动所有能力" {
    seed 65005;
    state {
        player own {
            pp 3/3;
            deck top { follower drew = 10001110; }
            hand { spell source = 10623310; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/9; } } }
    }
    action { play source; }
    expect { legal; own.hand count card 10001110 == 1; enemy.stats == 2/6; own.pp == 0/3; }
}

scenario "隔断的龙斗士舍弃手牌并重创随机随从" {
    seed 65006;
    state {
        player own {
            pp 6/6;
            hand {
                follower source = 10643110;
                follower fuel = 10001110;
            }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/12; } } }
    }
    action { play source; select fuel; }
    expect { legal; fuel.zone == graveyard; enemy.stats == 2/6; source has ward; source has barrier; }
}

scenario "愚劣的兵器召唤两个自己并在回合结束分配伤害" {
    seed 65007;
    state {
        player own {
            pp 8/8;
            hand { follower source = 10673110; }
        }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { play source; }
    expect { legal; own.field count card 10673110 == 3; }
}

scenario "愚劣的兵器在回合结束时分配三点伤害" {
    seed 65008;
    state {
        player own { field { follower source = 10673110; } }
        player oppo { field { follower enemy = 10001110 { stats 2/8; } } }
    }
    action { end_turn; }
    expect { legal; enemy.stats == 2/5; }
}

scenario "魔恋的天晶模式一召唤疾驰的天晶魔手" {
    seed 65009;
    state {
        player own {
            pp 3/3;
            hand { spell source = 10633310; }
        }
    }
    action { play source; mode 1; }
    expect { legal; own.field count card 10631110 == 1; all own.field where card 10631110 have storm; }
}

scenario "爆能强化五点让魔恋的天晶发动所有能力" {
    seed 65010;
    state {
        player own {
            pp 5/5;
            hand { spell source = 10633310; }
        }
    }
    action { play source; }
    expect { legal; own.field count card 10631110 == 3; own.pp == 0/5; }
}

scenario "断头的斩姬舍弃手牌并加入两张赤流" {
    seed 65011;
    state {
        player own {
            pp 7/7;
            hand {
                follower source = 10644110;
                follower fuel = 10001110;
            }
        }
    }
    action { play source; select fuel; }
    expect { legal; fuel.zone == graveyard; own.hand count card 10642310 == 2; source has aura; }
}

scenario "惨烈的剑王召唤带毁灭的士兵" {
    seed 65012;
    state {
        player own {
            pp 6/6;
            hand { follower source = 10624110; }
        }
    }
    action { play source; }
    expect { legal; all own.field where card 10621110 have bane; }
}

scenario "爆能强化八点让惨烈的剑王额外召唤带虹吸与疾驰的士兵" {
    seed 65013;
    state {
        player own {
            pp 8/8;
            hand { follower source = 10624110; }
        }
    }
    action { play source; }
    expect {
        legal;
        own.field count card 10621110 == 3;
        own.pp == 0/8;
    }
}
