scenario "平庸的制图召唤三种玩具并加生命" {
    seed 64023;
    state {
        player own {
            pp 6/6;
            hand { spell source = 10672310; }
        }
    }
    action { play source; }
    expect {
        legal;
        all own.field where card 10671110 have ward;
        own.field count card 10673110 == 1;
    }
}

scenario "空想的图书管理员召唤猛犸象并在超进化时给突进" {
    seed 64024;
    state {
        turn own 7;
        player own {
            sep 1;
            pp 6/6;
            field {
                follower source = 10631120;
                follower ally = 10001110;
            }
        }
    }
    action { superevolve source; }
    expect { legal; ally has rush; }
}

scenario "魔恋的爱慕召唤天晶魔手并在超进化时获得纹章" {
    seed 64025;
    state {
        turn own 7;
        player own {
            sep 1;
            pp 3/3;
            field { follower source = 10634110; }
        }
    }
    action { superevolve source; }
    expect { legal; own.crests count card 10634110 == 1; }
}

scenario "魔恋的爱慕的纹章强化攻击的天晶魔手" {
    seed 64026;
    state {
        player own {
            crests { crest shim = 10634110; }
            field { follower hand = 10631110 { stats 2/2; } }
        }
    }
    action { attack hand into oppo.leader; }
    expect { legal; hand.stats == 3/2; oppo.leader.life == 17; }
}

scenario "污浊的圣水的启动推进吟唱" {
    seed 64027;
    state {
        player own {
            pp 1/1;
            field { amulet water = 10661210; }
        }
    }
    action { engage water; }
    expect { legal; water.countdown == 2; }
}
