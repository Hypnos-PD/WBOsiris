wbotest 0.1.0;
use cards "../../cards";

scenario "圣德芬在进化六次后于回合开始瞬念召唤并获得纹章" {
    seed 108001;
    state {
        player own {
            evolutions 6;
            deck top {
                follower source = 10404110;
                follower next = 10001110;
            }
        }
    }
    action { advance turn_start own; }
    expect {
        legal;
        // 瞬念召唤后获得纹章并返回手牌。
        own.crests count card 10404110 == 1;
        own.hand count card 10404110 == 1;
        own.field count card 10404110 == 0;
    }
}

scenario "圣德芬在进化次数不足时不瞬念召唤" {
    seed 108002;
    state {
        player own {
            evolutions 5;
            deck top { follower source = 10404110; }
        }
    }
    action { advance turn_start own; }
    expect {
        legal;
        source.zone == deck;
        own.crests count card 10404110 == 0;
        own.hand count card 10404110 == 0;
    }
}

scenario "圣德芬正常打出时不会获得纹章" {
    seed 108003;
    state {
        player own {
            pp 6/6;
            hand { follower source = 10404110; }
        }
    }
    action { play source; }
    expect {
        legal;
        source.zone == field;
        own.crests count card 10404110 == 0;
        own.field count card 10404110 == 1;
    }
}

scenario "圣德芬在解放奥义可用时对随机目标打五次两点" {
    seed 108004;
    state {
        turn own 15;
        player own {
            pp 6/6;
            hand { follower source = 10404110; }
        }
        player oppo { leader 20/20; }
    }
    action { play source; }
    expect {
        legal;
        // 对手没有随从，五次随机目标都打在主战者身上。
        oppo.leader.life == 10;
    }
}

scenario "圣德芬的纹章在回合结束回复全体随从与主战者各一点" {
    seed 108005;
    state {
        player own {
            leader 10/20;
            crests { crest emblem = 10404110; }
            field { follower hurt = 10001110 { stats 2/2; damage_taken 1; } }
        }
    }
    action { advance turn_end own; }
    expect {
        legal;
        own.leader.life == 11;
        hurt.stats == 2/2;
    }
}

scenario "倒计数破坏的谢幕曲排在牌组中发动的瞬念召唤之后" {
    seed 108006;
    state {
        turn own 6;
        player own { }
        player oppo {
            evolutions 6;
            deck top {
                follower source = 10404110;
                follower first = 10001110;
                follower second = 10001110;
                follower third = 10001110;
                follower fourth = 10001110;
            }
            field { amulet sanctuary = 10161210 { countdown 1; } }
        }
    }
    // 结束自己的回合，让对手的回合通过正常的回合开始流程开始（倒计数 → 牌组中发动 → 谢幕曲 → 抽牌）。
    action { end_turn; }
    expect {
        legal;
        // 官方 QA（hz0p-10ss）：倒计数破坏 → 瞬念召唤 → 谢幕曲抽 2 张 → 返回手牌 → 回合开始的抽牌。
        // 若谢幕曲排在瞬念召唤之前，它会把牌组顶的圣德芬抽走，瞬念召唤就不会发生。
        oppo.crests count card 10404110 == 1;
        oppo.hand count card 10404110 == 1;
        // 手牌顺序也固定：谢幕曲抽 2 张 → 圣德芬返回手牌 → 回合开始的抽牌。
        oppo.hand contains [first, second, source, third] ordered;
        sanctuary.zone == graveyard;
    }
}

scenario "纹章的回合开始能力先于瞬念召唤" {
    seed 108007;
    state {
        turn own 6;
        player own { }
        player oppo {
            evolutions 6;
            crests { crest titania = 10214110; }
            deck top {
                follower source = 10404110;
                follower next = 10001110;
            }
        }
    }
    action { end_turn; }
    expect {
        legal;
        // 官方 QA（494pxxx2n）：纹章先加入妖精，然后瞬念召唤并返回手牌，最后回合开始的抽牌。
        oppo.hand count card 90011110 == 1;
        oppo.hand count card 10404110 == 1;
        oppo.crests count card 10404110 == 1;
    }
}
