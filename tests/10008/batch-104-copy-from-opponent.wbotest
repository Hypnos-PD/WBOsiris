wbotest 0.1.0;
use cards "../../cards";

scenario "救世的英姿复制对手手牌里的一张再抽一张" {
    seed 104001;
    state {
        player own {
            pp 3/3;
            deck top { follower drawn = 10011110; }
            hand { spell source = 10802310; }
        }
        player oppo {
            hand { follower theirs = 10001110; }
        }
    }
    action { play source; }
    expect {
        legal;
        own.hand count card 10001110 == 1;
        own.hand count card 10011110 == 1;
    }
}

scenario "救世的英姿在对手没有手牌时只抽一张" {
    seed 104002;
    state {
        player own {
            pp 3/3;
            deck top { follower drawn = 10011110; }
            hand { spell source = 10802310; }
        }
    }
    action { play source; }
    expect {
        legal;
        own.hand count card 10001110 == 0;
        own.hand count card 10011110 == 1;
    }
}
